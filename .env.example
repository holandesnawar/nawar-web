PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# ── CRM (systeme.io) ─────────────────────────────────────────────────────────
# Clave pública de la API. Panel de systeme.io → Ajustes → API pública.
# La usan /api/waitlist, /api/enroll y /api/hooks/inro-systeme.
SYSTEME_API_KEY=

# ── Webhook de Inrō (automatización de DM de Instagram) ──────────────────────
# Secreto compartido que Inrō manda en la cabecera X-Nawar-Secret al llamar a
# /api/hooks/inro-systeme. Sin él la ruta contesta 401 y no procesa nada.
# Genera uno largo y aleatorio, por ejemplo:  openssl rand -hex 32
NAWAR_WEBHOOK_SECRET=

# ── Escuela ──────────────────────────────────────────────────────────────────
# Dirección de la plataforma. Solo hace falta definirla si algún día cambia el
# dominio; el código ya trae https://app.holandesnawar.com por defecto.
PUBLIC_ESCUELA_URL=
