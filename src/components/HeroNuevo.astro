---
interface Props { data?: any }
import { CTA_PRINCIPAL } from '../lib/cta'
const { data } = Astro.props
const badge      = data?.badge      ?? 'Neerlandés para hispanohablantes'
const titleLine1 = data?.titleLine1 ?? 'Aprende neerlandés'
const titleLine2 = data?.titleLine2 ?? 'de verdad'
const subtitle   = data?.subtitle   ?? 'El método que debería haber existido desde siempre para cualquier hispanohablante que quiere aprender neerlandés.'
const bullets    = data?.bullets?.length ? data.bullets : [
  'Explicado desde el español, sin pasar por el inglés',
  'Sin experiencia previa — desde cero hasta conversar',
  'Comunidad activa de +600 hispanohablantes',
]
const ctaText    = data?.ctaText    ?? 'Matricularme'
/* El segundo botón, para quien todavía no está para decidir: abre WhatsApp con
   el mensaje ya escrito. No pide correo, así que no hay nada que guardar ni que
   etiquetar; la conversación empieza directamente contigo. */
const WHATSAPP = '31616084212'
const WHATSAPP_MSG = 'Hola, quiero formarme con NAWAR'
const WHATSAPP_URL = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(WHATSAPP_MSG)}`
---
<section id="inicio" class="hero-section" data-navbar="dark">
  <div class="hero-glow1" aria-hidden="true"></div>
  <div class="hero-glow2" aria-hidden="true"></div>
  <div class="dots-dark" aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;"></div>

  <div class="hero-wrap">

    <!-- LEFT: visual card -->
    <div class="hero-col-card">
      {/* El mockup del hero. Composición a lo Pikingli —una tarjeta de
          pregunta ladeada, un reproductor, un botón con emoji y una
          etiqueta— pero TODO en el cristal de la barra de la landing
          (neutro al 52 %, borde claro, filo de luz), sobre nuestro azul.
          Nada blanco: se probó y no encajaba con el tono del home.
          Es una pregunta de verdad de la lección 1 (goedemorgen). */}
      <div class="mock h-anim" style="--hd:0.2s">

        <div class="mock-card glass">
          <div class="mock-head">
            <span class="mock-kicker">Pregunta 3 / 10</span>
            <span class="mock-live"><span class="mock-live-dot"></span>En vivo</span>
          </div>
          <p class="mock-q">¿Cómo se dice <em>«buenos días»</em>?</p>
          <p class="mock-hint">Escucha y elige la opción correcta</p>
          <div class="mock-opts">
            <div class="mock-opt is-right"><span class="mock-letter">A</span>goedemorgen<span class="mock-tick">✓</span></div>
            <div class="mock-opt"><span class="mock-letter">B</span>goedenavond</div>
            <div class="mock-opt"><span class="mock-letter">C</span>tot ziens</div>
          </div>
          <div class="mock-foot">
            <div class="mock-prog"><div class="mock-prog-fill"></div></div>
            <span class="mock-btn">Confirmar</span>
          </div>
        </div>

        <div class="mock-audio glass" aria-hidden="true">
          <span class="mock-play">▶</span>
          <span class="mock-wave"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
          <span class="mock-time">0:02</span>
        </div>

        <div class="mock-emoji glass" aria-hidden="true">🔊</div>

        <div class="mock-tag glass">
          <span class="mock-tag-flags">🇪🇸🇲🇽🇦🇷</span>
          <div><p>Sesiones en vivo</p><p>incluidas desde el día 1</p></div>
        </div>

      </div>
    </div>

    <!-- RIGHT: text content -->
    <div class="hero-col-text">
      <span class="badge-dark h-anim" style="--hd:0.08s">
        {badge}
      </span>

      <h1 class="hero-title h-anim" style="--hd:0.18s">
        <span class="hero-title-gradient">{titleLine1}</span><br>
        <span style="color: #4da3ff; -webkit-text-fill-color: #4da3ff;">{titleLine2}</span>
      </h1>

      <p class="hero-sub h-anim" style="--hd:0.28s">
        {subtitle}
      </p>

      <ul class="hero-bullets h-anim" style="--hd:0.38s">
        {bullets.map((item: string) => (
          <li>
            <span class="hero-check">
              <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            {item}
          </li>
        ))}
      </ul>

      {/* Dos salidas, según lo decidido que venga el visitante: el que lo tiene
          claro se matricula y el que no, pregunta. Antes había aquí un campo de
          correo, y recogía direcciones sueltas: sin teléfono no se podía llamar
          a nadie y detrás no colgaba ninguna campaña. El correo se sigue
          recogiendo en el banner del pie, que es donde tiene sentido. */}
      <div class="hero-cta-row h-anim" id="lista-espera" style="--hd:0.48s">
        <a href={CTA_PRINCIPAL} class="hero-cta-main">
          {ctaText}
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="hero-cta-alt">
          Más información
        </a>
      </div>
    </div>

  </div>

  <!-- Flags strip -->
  <div class="hero-flags-strip">
    <div style="text-align:center;margin-bottom:20px;">
      <span class="badge-dark" style="white-space:nowrap;">Estudiantes de todo el mundo</span>
    </div>
    <div style="position:relative;overflow:hidden;">
      <div style="pointer-events:none;position:absolute;top:0;bottom:0;left:0;width:80px;background:linear-gradient(to right,#1D0084,transparent);z-index:10;"></div>
      <div style="pointer-events:none;position:absolute;top:0;bottom:0;right:0;width:80px;background:linear-gradient(to left,#1D0084,transparent);z-index:10;"></div>
      <div class="ticker-flags" style="display:flex;gap:12px;white-space:nowrap;will-change:transform;">
        <span class="flag-item">🇲🇽 México</span>
        <span class="flag-item">🇦🇷 Argentina</span>
        <span class="flag-item">🇨🇴 Colombia</span>
        <span class="flag-item">🇨🇱 Chile</span>
        <span class="flag-item">🇵🇪 Perú</span>
        <span class="flag-item">🇻🇪 Venezuela</span>
        <span class="flag-item">🇪🇨 Ecuador</span>
        <span class="flag-item">🇧🇴 Bolivia</span>
        <span class="flag-item">🇵🇾 Paraguay</span>
        <span class="flag-item">🇺🇾 Uruguay</span>
        <span class="flag-item">🇵🇦 Panamá</span>
        <span class="flag-item">🇨🇷 Costa Rica</span>
        <span class="flag-item">🇬🇹 Guatemala</span>
        <span class="flag-item">🇸🇻 El Salvador</span>
        <span class="flag-item">🇩🇴 Rep. Dominicana</span>
        <span class="flag-item">🇨🇺 Cuba</span>
        <span class="flag-item">🇵🇷 Puerto Rico</span>
        <span class="flag-item">🇪🇸 España</span>
        <span class="flag-item">🇲🇽 México</span>
        <span class="flag-item">🇦🇷 Argentina</span>
        <span class="flag-item">🇨🇴 Colombia</span>
        <span class="flag-item">🇨🇱 Chile</span>
        <span class="flag-item">🇵🇪 Perú</span>
        <span class="flag-item">🇻🇪 Venezuela</span>
        <span class="flag-item">🇪🇨 Ecuador</span>
        <span class="flag-item">🇧🇴 Bolivia</span>
        <span class="flag-item">🇵🇾 Paraguay</span>
        <span class="flag-item">🇺🇾 Uruguay</span>
        <span class="flag-item">🇵🇦 Panamá</span>
        <span class="flag-item">🇨🇷 Costa Rica</span>
        <span class="flag-item">🇬🇹 Guatemala</span>
        <span class="flag-item">🇸🇻 El Salvador</span>
        <span class="flag-item">🇩🇴 Rep. Dominicana</span>
        <span class="flag-item">🇨🇺 Cuba</span>
        <span class="flag-item">🇵🇷 Puerto Rico</span>
        <span class="flag-item">🇪🇸 España</span>
      </div>
    </div>
  </div>
</section>

<style>
/* ── Load animation ── */
@keyframes h-in {
  from { opacity: 0; transform: translateY(18px); }
  to   { opacity: 1; transform: translateY(0); }
}
.h-anim {
  opacity: 0;
  animation: h-in 0.75s cubic-bezier(0.22,1,0.36,1) forwards;
  animation-delay: var(--hd, 0s);
}

/* ── Section ── */
.hero-section {
  background: #1D0084;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* ── El mockup del hero ─────────────────────────────────────────
   Vive AQUÍ y no en nawar-sections.css a propósito: la landing usa
   nombres parecidos (.lesson-card, .float-badge) desde la hoja global
   y se trabaja aparte. Astro acota lo de aquí a este componente.

   El cristal es LA RECETA DE LA BARRA DE LA LANDING (.l8nav): neutro
   al 52 %, borde claro al 22 %, filo de luz arriba y sombra larga.
   Neutro y no índigo: es lo que se ve como vidrio y no como una
   mancha más clara del mismo morado. */
.glass {
  background: rgba(20, 22, 28, 0.52);
  -webkit-backdrop-filter: saturate(140%) blur(18px);
  backdrop-filter: saturate(140%) blur(18px);
  border: 1px solid rgba(255,255,255,0.22);
  box-shadow: 0 12px 32px rgba(0,0,0,0.38), inset 0 1px 0 rgba(255,255,255,0.10);
}
.mock {
  position: relative;
  width: 100%; max-width: 400px;
  padding: 26px 34px 38px 18px; /* aire para las piezas que asoman */
}

/* La tarjeta de la pregunta: ladeada, como en la referencia */
.mock-card {
  position: relative; z-index: 1;
  border-radius: 24px; padding: 22px 22px 20px;
  transform: rotate(-3deg);
  color: #fff;
}
.mock-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.mock-kicker {
  font-size: 10.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
  color: rgba(255,255,255,0.62);
}
.mock-live {
  display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;
  padding: 4px 10px; border-radius: 9999px;
  background: rgba(16,185,129,0.16); border: 1px solid rgba(16,185,129,0.40);
  font-size: 11px; font-weight: 600; color: #34d399;
}
.mock-live-dot {
  width: 7px; height: 7px; border-radius: 50%; background: #10b981;
  box-shadow: 0 0 6px #10b981; animation: mock-pulse 1.5s ease-in-out infinite;
}
@keyframes mock-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
.mock-q {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 19px; font-weight: 600; line-height: 1.25; letter-spacing: -0.01em;
  margin-bottom: 4px;
}
.mock-q em { font-style: normal; color: #4da3ff; }
.mock-hint { font-size: 12.5px; color: rgba(255,255,255,0.6); margin-bottom: 16px; }
.mock-opts { display: flex; flex-direction: column; gap: 8px; margin-bottom: 18px; }
.mock-opt {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 12px; border-radius: 12px;
  background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);
  font-size: 14px; font-weight: 600; color: #fff;
}
.mock-opt.is-right { background: rgba(77,163,255,0.16); border-color: #4da3ff; }
.mock-letter {
  width: 22px; height: 22px; border-radius: 50%; flex-shrink: 0;
  display: inline-flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,0.10); font-size: 11px; font-weight: 700;
}
.mock-opt.is-right .mock-letter { background: #4da3ff; color: #0a1656; }
.mock-tick { margin-left: auto; color: #4da3ff; font-weight: 700; }
.mock-foot { display: flex; align-items: center; gap: 14px; }
.mock-prog { flex: 1; height: 6px; border-radius: 9999px; background: rgba(255,255,255,0.12); overflow: hidden; }
.mock-prog-fill { width: 30%; height: 100%; border-radius: 9999px; background: #4da3ff; }
.mock-btn {
  padding: 9px 16px; border-radius: 8px;
  background: #4da3ff; color: #0a1656; font-size: 13px; font-weight: 700;
}

/* El reproductor: pastilla arriba a la derecha, un poco ladeada al otro lado */
.mock-audio {
  /* Un poco más arriba y más a la derecha: la tarjeta va ladeada y su
     esquina derecha sube, y la pastilla pisaba el "En vivo". */
  position: absolute; z-index: 2; top: -14px; right: -16px;
  display: flex; align-items: center; gap: 10px;
  padding: 9px 14px 9px 9px; border-radius: 9999px;
  transform: rotate(3deg);
  color: #fff;
}
.mock-play {
  width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0;
  background: #4da3ff; color: #0a1656;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 10px; padding-left: 2px;
}
.mock-wave { display: inline-flex; align-items: center; gap: 3px; height: 18px; }
.mock-wave i {
  display: block; width: 3px; border-radius: 2px; background: #4da3ff;
  animation: mock-wave 1.1s ease-in-out infinite;
}
.mock-wave i:nth-child(1) { height: 6px;  animation-delay: 0s; }
.mock-wave i:nth-child(2) { height: 14px; animation-delay: .1s; }
.mock-wave i:nth-child(3) { height: 10px; animation-delay: .2s; }
.mock-wave i:nth-child(4) { height: 18px; animation-delay: .3s; }
.mock-wave i:nth-child(5) { height: 8px;  animation-delay: .4s; }
.mock-wave i:nth-child(6) { height: 15px; animation-delay: .5s; }
.mock-wave i:nth-child(7) { height: 9px;  animation-delay: .6s; }
.mock-wave i:nth-child(8) { height: 13px; animation-delay: .7s; }
@keyframes mock-wave { 0%,100% { transform: scaleY(1); } 50% { transform: scaleY(0.45); } }
.mock-time { font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.75); font-variant-numeric: tabular-nums; }

/* El botón redondo con el emoji: como el megáfono de la referencia */
.mock-emoji {
  position: absolute; z-index: 2; right: -8px; top: 46%;
  width: 62px; height: 62px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 27px; line-height: 1;
}

/* La etiqueta de abajo */
.mock-tag {
  position: absolute; z-index: 2; bottom: 0; left: -10px;
  display: flex; align-items: center; gap: 10px;
  padding: 10px 14px; border-radius: 14px;
}
.mock-tag-flags { font-size: 18px; line-height: 1; }
.mock-tag p { font-size: 12px; font-weight: 600; color: #fff; line-height: 1.3; }
.mock-tag p:last-child { font-weight: 400; color: rgba(255,255,255,0.72); }

/* ── Gradient title effect — per-letter (repeats each em) ── */
.hero-title-gradient {
  background: linear-gradient(180deg, rgba(255,255,255,1) 0%, rgba(255,255,255,0.45) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ── Two-column wrapper ── */
.hero-wrap {
  flex: 1;
  max-width: 1152px;
  margin: 0 auto;
  padding: 120px 32px 64px;
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1.15fr;
  gap: 72px;
  align-items: center;
  position: relative;
  z-index: 1;
}

/* ── Left: card column ── */
.hero-col-card {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── Right: text column ── */
.hero-col-text {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

/* ── Title / sub ── */
.hero-col-text .hero-title {
  margin-top: 0;
  margin-bottom: 16px;
}
.hero-col-text .hero-sub {
  font-size: clamp(15px, 1.4vw, 17px);
  max-width: 480px;
  margin-bottom: 24px;
  color: #ffffff;
}

/* ── Bullets ── */
.hero-bullets {
  list-style: none;
  padding: 0;
  margin: 0 0 28px 0;
  display: flex;
  flex-direction: column;
  gap: 13px;
}
.hero-bullets li {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 16px;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.45;
}
.hero-check {
  flex-shrink: 0;
  width: 22px; height: 22px;
  border-radius: 50%;
  background: transparent;
  border: 2px solid #4da3ff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4da3ff;
}

/* ── Form row ── */
.hero-cta-row {
  width: 100%;
  max-width: 540px;
  margin-bottom: 10px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.hero-cta-main,
.hero-cta-alt {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 16px 24px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 700;
  font-family: inherit;
  text-decoration: none;
  white-space: nowrap;
  transition: background .2s, border-color .2s;
}
/* Matricularse: relleno, es la acción principal. */
.hero-cta-main {
  background: #4da3ff;
  color: #1D0084;
  border: 1px solid #4da3ff;
}
.hero-cta-main:hover { background: #5eb4ff; }
/* Preguntar: contorno. Tiene que leerse como la alternativa, no como un
   segundo botón igual de fuerte, o los dos compiten y no se pulsa ninguno. */
.hero-cta-alt {
  background: transparent;
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.35);
}
.hero-cta-alt:hover { border-color: rgba(255, 255, 255, 0.7); }

/* ── Flags ── */
.hero-flags-strip {
  position: relative;
  z-index: 1;
  padding-bottom: 48px;
}
.flag-item {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 7px 15px; border-radius: 9999px;
  font-size: 13px; font-weight: 500; color: rgba(255,255,255,0.82);
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.11);
  flex-shrink: 0;
}
@keyframes ticker-flags-kf {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
.ticker-flags { animation: ticker-flags-kf 16s linear infinite; }
@media (max-width: 900px) {
  .ticker-flags { animation-duration: 4.5s; }
}

/* ── Mobile ── */
@media (max-width: 900px) {
  .hero-wrap {
    grid-template-columns: 1fr;
    padding: 100px 24px 48px;
    gap: 48px;
  }
  .hero-col-card { display: none; }
  .hero-cta-row { flex-direction: column; }
  .hero-cta-main,
  .hero-cta-alt {
    width: 100%;
    justify-content: center;
  }
  .badge-dark { white-space: nowrap; font-size: 10px; }
  .hero-bullets li { font-size: 15px; }
}
@media (max-width: 400px) {
  .badge-dark { font-size: 9px; padding: 5px 12px; }
}
</style>
