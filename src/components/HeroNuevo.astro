---
interface Props { data?: any }
import { CTA_PRINCIPAL } from '../lib/cta'
const { data } = Astro.props
const badge      = data?.badge      ?? 'Neerlandés para hispanohablantes'
const titleLine1 = data?.titleLine1 ?? 'Aprende neerlandés'
const titleLine2 = data?.titleLine2 ?? 'de verdad'
const subtitle   = data?.subtitle   ?? 'El método que debería haber existido desde siempre para cualquier hispanohablante que quiere aprender neerlandés.'
const bullets    = data?.bullets?.length ? data.bullets : [
  'Explicado desde el español, sin pasar por el inglés',
  'Sin experiencia previa — desde cero hasta conversar',
  'Comunidad activa de +600 hispanohablantes',
]
const ctaText    = data?.ctaText    ?? 'Matricularme'
/* El segundo botón, para quien todavía no está para decidir: abre WhatsApp con
   el mensaje ya escrito. No pide correo, así que no hay nada que guardar ni que
   etiquetar; la conversación empieza directamente contigo. */
const WHATSAPP = '31616084212'
const WHATSAPP_MSG = 'Hola, quiero formarme con NAWAR'
const WHATSAPP_URL = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(WHATSAPP_MSG)}`
---
<section id="inicio" class="hero-section" data-navbar="dark">
  <div class="hero-glow1" aria-hidden="true"></div>
  <div class="hero-glow2" aria-hidden="true"></div>
  <div class="dots-dark" aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;"></div>

  <div class="hero-wrap">

    <!-- LEFT: visual card -->
    <div class="hero-col-card">
      <div class="lesson-card h-anim" style="--hd:0.2s">
        <div class="lesson-card-inner">
          <div class="lc-header">
            <div class="lc-icon">🎓</div>
            <div>
              <p class="lc-title">Vista previa de la experiencia</p>
              <p class="lc-sub">Módulo A1 · Primera edición</p>
            </div>
            <span class="lc-live"><span class="lc-live-dot"></span><span class="lc-live-text">En vivo</span></span>
          </div>
          <p class="lc-label">Lección 6</p>
          <p class="lc-lesson-title">Los verbos en presente 🇳🇱</p>
          <div class="lc-prog-row"><span>Formato del módulo</span><span>8 lecciones</span></div>
          <div class="lc-prog-bar"><div class="lc-prog-fill"></div></div>
          <div class="lc-vocab">
            <div class="lc-vitem"><p class="lc-vitem-nl">goedemorgen</p><p class="lc-vitem-es">buenos días</p></div>
            <div class="lc-vitem"><p class="lc-vitem-nl">tot ziens</p><p class="lc-vitem-es">hasta luego</p></div>
            <div class="lc-vitem"><p class="lc-vitem-nl">dank je wel</p><p class="lc-vitem-es">muchas gracias</p></div>
            <div class="lc-vitem"><p class="lc-vitem-nl">alsjeblieft</p><p class="lc-vitem-es">por favor</p></div>
          </div>
        </div>
        <div class="float-badge fb-top">
          <span style="font-size:20px;">🔥</span>
          <div><p>Próxima edición</p><p>Plazas limitadas</p></div>
        </div>
        <div class="float-badge fb-bot">
          <span style="font-size:18px;">🇪🇸🇲🇽🇦🇷</span>
          <div><p>Sesiones en vivo</p><p>incluidas desde el día 1</p></div>
        </div>
      </div>
    </div>

    <!-- RIGHT: text content -->
    <div class="hero-col-text">
      <span class="badge-dark h-anim" style="--hd:0.08s">
        {badge}
      </span>

      <h1 class="hero-title h-anim" style="--hd:0.18s">
        <span class="hero-title-gradient">{titleLine1}</span><br>
        <span style="color: #4da3ff; -webkit-text-fill-color: #4da3ff;">{titleLine2}</span>
      </h1>

      <p class="hero-sub h-anim" style="--hd:0.28s">
        {subtitle}
      </p>

      <ul class="hero-bullets h-anim" style="--hd:0.38s">
        {bullets.map((item: string) => (
          <li>
            <span class="hero-check">
              <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            {item}
          </li>
        ))}
      </ul>

      {/* Dos salidas, según lo decidido que venga el visitante: el que lo tiene
          claro se matricula y el que no, pregunta. Antes había aquí un campo de
          correo, y recogía direcciones sueltas: sin teléfono no se podía llamar
          a nadie y detrás no colgaba ninguna campaña. El correo se sigue
          recogiendo en el banner del pie, que es donde tiene sentido. */}
      <div class="hero-cta-row h-anim" id="lista-espera" style="--hd:0.48s">
        <a href={CTA_PRINCIPAL} class="hero-cta-main">
          {ctaText}
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="hero-cta-alt">
          Más información
        </a>
      </div>
    </div>

  </div>

  <!-- Flags strip -->
  <div class="hero-flags-strip">
    <div style="text-align:center;margin-bottom:20px;">
      <span class="badge-dark" style="white-space:nowrap;">Estudiantes de todo el mundo</span>
    </div>
    <div style="position:relative;overflow:hidden;">
      <div style="pointer-events:none;position:absolute;top:0;bottom:0;left:0;width:80px;background:linear-gradient(to right,#1D0084,transparent);z-index:10;"></div>
      <div style="pointer-events:none;position:absolute;top:0;bottom:0;right:0;width:80px;background:linear-gradient(to left,#1D0084,transparent);z-index:10;"></div>
      <div class="ticker-flags" style="display:flex;gap:12px;white-space:nowrap;will-change:transform;">
        <span class="flag-item">🇲🇽 México</span>
        <span class="flag-item">🇦🇷 Argentina</span>
        <span class="flag-item">🇨🇴 Colombia</span>
        <span class="flag-item">🇨🇱 Chile</span>
        <span class="flag-item">🇵🇪 Perú</span>
        <span class="flag-item">🇻🇪 Venezuela</span>
        <span class="flag-item">🇪🇨 Ecuador</span>
        <span class="flag-item">🇧🇴 Bolivia</span>
        <span class="flag-item">🇵🇾 Paraguay</span>
        <span class="flag-item">🇺🇾 Uruguay</span>
        <span class="flag-item">🇵🇦 Panamá</span>
        <span class="flag-item">🇨🇷 Costa Rica</span>
        <span class="flag-item">🇬🇹 Guatemala</span>
        <span class="flag-item">🇸🇻 El Salvador</span>
        <span class="flag-item">🇩🇴 Rep. Dominicana</span>
        <span class="flag-item">🇨🇺 Cuba</span>
        <span class="flag-item">🇵🇷 Puerto Rico</span>
        <span class="flag-item">🇪🇸 España</span>
        <span class="flag-item">🇲🇽 México</span>
        <span class="flag-item">🇦🇷 Argentina</span>
        <span class="flag-item">🇨🇴 Colombia</span>
        <span class="flag-item">🇨🇱 Chile</span>
        <span class="flag-item">🇵🇪 Perú</span>
        <span class="flag-item">🇻🇪 Venezuela</span>
        <span class="flag-item">🇪🇨 Ecuador</span>
        <span class="flag-item">🇧🇴 Bolivia</span>
        <span class="flag-item">🇵🇾 Paraguay</span>
        <span class="flag-item">🇺🇾 Uruguay</span>
        <span class="flag-item">🇵🇦 Panamá</span>
        <span class="flag-item">🇨🇷 Costa Rica</span>
        <span class="flag-item">🇬🇹 Guatemala</span>
        <span class="flag-item">🇸🇻 El Salvador</span>
        <span class="flag-item">🇩🇴 Rep. Dominicana</span>
        <span class="flag-item">🇨🇺 Cuba</span>
        <span class="flag-item">🇵🇷 Puerto Rico</span>
        <span class="flag-item">🇪🇸 España</span>
      </div>
    </div>
  </div>
</section>

<style>
/* ── Load animation ── */
@keyframes h-in {
  from { opacity: 0; transform: translateY(18px); }
  to   { opacity: 1; transform: translateY(0); }
}
.h-anim {
  opacity: 0;
  animation: h-in 0.75s cubic-bezier(0.22,1,0.36,1) forwards;
  animation-delay: var(--hd, 0s);
}

/* ── Section ── */
.hero-section {
  background: #1D0084;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* ⚠️ Estas reglas viven AQUÍ y no en nawar-sections.css a propósito:
   `.lesson-card` y `.float-badge` las usa también la landing de la
   formación (MetodoFunciona, QueIncluye), que se trabaja aparte. En la
   hoja global este rediseño le habría cambiado el mockup a la landing
   sin que nadie lo pidiera. Astro acota lo de aquí a este componente. */
/* ── El mockup del hero: una pantalla BLANCA sobre el azul ──────
   Antes era un cristal índigo (blanco al 7 % sobre #1D0084): un
   rectángulo un poco más claro que el fondo, con el texto encima.
   Morado sobre morado, y por eso se veía apagado. Lo que hace que
   una "pantalla de la app" se lea como tal es el contraste: una
   tarjeta blanca de verdad, con las esquinas grandes y una sombra
   larga, como enseña Apple sus productos.
   Detrás, dos tarjetas fantasma ladeadas: es lo que da la sensación
   de "pila de lecciones" sin inclinar la que se lee.
   Las dos etiquetas flotantes van al revés: en cristal oscuro (la
   receta de la barra de la landing) para que no se confundan con
   la tarjeta blanca sobre la que se apoyan. */
.lesson-card {
  position: relative; width: 100%; max-width: 400px;
  filter: drop-shadow(0 30px 60px rgba(3, 9, 33, 0.45));
}
.lesson-card::before,
.lesson-card::after {
  content: '';
  position: absolute; inset: 0;
  border-radius: 22px;
  background: rgba(255,255,255,0.10);
  border: 1px solid rgba(255,255,255,0.18);
  z-index: 0;
  pointer-events: none;
}
.lesson-card::before { transform: rotate(-4deg) translate(-6px, 10px); }
.lesson-card::after  { transform: rotate(2.5deg) translate(8px, 6px); background: rgba(255,255,255,0.16); }
.lesson-card-inner {
  position: relative; z-index: 1;
  background: #fff;
  border: 1px solid rgba(255,255,255,0.85);
  border-radius: 22px; padding: 24px;
  box-shadow: inset 0 1px 0 #fff;
}
.lc-header { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
.lc-icon {
  width: 40px; height: 40px; border-radius: 12px;
  background: #F0F5FF; border: 1px solid #DDE6F5;
  display: flex; align-items: center; justify-content: center;
  font-size: 18px; flex-shrink: 0;
}
.lc-title { font-size: 14px; font-weight: 600; color: #1D0084; }
.lc-sub   { font-size: 12px; color: #6B7590; margin-top: 2px; }
.lc-live  {
  margin-left: auto; display: flex; align-items: center; gap: 6px; white-space: nowrap;
  padding: 4px 10px; border-radius: 9999px;
  background: #E8FBF3; border: 1px solid #B9EBD5;
}
.lc-live-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: #10b981; box-shadow: 0 0 6px rgba(16,185,129,0.6);
  animation: pulse-dot 1.5s ease-in-out infinite;
}
@keyframes pulse-dot { 0%,100% { opacity:1; } 50% { opacity:0.4; } }
.lc-live-text { font-size: 11px; font-weight: 600; color: #0E9F6E; }
.lc-label        { font-size: 10px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #8A96AB; margin-bottom: 6px; }
.lc-lesson-title { font-size: 16px; font-weight: 700; color: #1D0084; margin-bottom: 16px; }
.lc-prog-row     { display: flex; justify-content: space-between; font-size: 12px; color: #6B7590; margin-bottom: 8px; }
.lc-prog-bar     { height: 6px; background: #E4EAF8; border-radius: 9999px; margin-bottom: 20px; overflow: hidden; }
.lc-prog-fill    { height: 100%; width: 40%; background: linear-gradient(90deg, #025dc7, #4da3ff); border-radius: 9999px; }
.lc-vocab        { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.lc-vitem        { background: #F0F5FF; border: 1px solid #DDE6F5; border-radius: 12px; padding: 10px 12px; }
.lc-vitem-nl     { font-size: 13px; font-weight: 600; color: #1D0084; margin-bottom: 2px; }
.lc-vitem-es     { font-size: 11px; color: #025dc7; }

/* Etiquetas flotantes: cristal oscuro, la receta de la barra de la
   landing (neutro al 52 %, borde claro, filo de luz arriba). Sobre
   la tarjeta blanca un cristal índigo se vería sucio; el neutro se
   ve como vidrio. */
.float-badge {
  position: absolute; z-index: 2;
  display: flex; align-items: center; gap: 10px;
  padding: 10px 14px; border-radius: 14px;
  background: rgba(20, 22, 28, 0.52);
  -webkit-backdrop-filter: saturate(140%) blur(18px);
  backdrop-filter: saturate(140%) blur(18px);
  border: 1px solid rgba(255,255,255,0.22);
  box-shadow: 0 8px 24px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.10);
}
.float-badge p { font-size: 12px; font-weight: 600; color: #fff; line-height: 1.3; }
.float-badge p:last-child { font-weight: 400; color: rgba(255,255,255,0.72); }
.fb-top { top: -20px; right: -20px; }
.fb-bot { bottom: -20px; left: -20px; }

/* ── Gradient title effect — per-letter (repeats each em) ── */
.hero-title-gradient {
  background: linear-gradient(180deg, rgba(255,255,255,1) 0%, rgba(255,255,255,0.45) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ── Two-column wrapper ── */
.hero-wrap {
  flex: 1;
  max-width: 1152px;
  margin: 0 auto;
  padding: 120px 32px 64px;
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1.15fr;
  gap: 72px;
  align-items: center;
  position: relative;
  z-index: 1;
}

/* ── Left: card column ── */
.hero-col-card {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── Right: text column ── */
.hero-col-text {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

/* ── Title / sub ── */
.hero-col-text .hero-title {
  margin-top: 0;
  margin-bottom: 16px;
}
.hero-col-text .hero-sub {
  font-size: clamp(15px, 1.4vw, 17px);
  max-width: 480px;
  margin-bottom: 24px;
  color: #ffffff;
}

/* ── Bullets ── */
.hero-bullets {
  list-style: none;
  padding: 0;
  margin: 0 0 28px 0;
  display: flex;
  flex-direction: column;
  gap: 13px;
}
.hero-bullets li {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 16px;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.45;
}
.hero-check {
  flex-shrink: 0;
  width: 22px; height: 22px;
  border-radius: 50%;
  background: transparent;
  border: 2px solid #4da3ff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4da3ff;
}

/* ── Form row ── */
.hero-cta-row {
  width: 100%;
  max-width: 540px;
  margin-bottom: 10px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.hero-cta-main,
.hero-cta-alt {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 16px 24px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 700;
  font-family: inherit;
  text-decoration: none;
  white-space: nowrap;
  transition: background .2s, border-color .2s;
}
/* Matricularse: relleno, es la acción principal. */
.hero-cta-main {
  background: #4da3ff;
  color: #1D0084;
  border: 1px solid #4da3ff;
}
.hero-cta-main:hover { background: #5eb4ff; }
/* Preguntar: contorno. Tiene que leerse como la alternativa, no como un
   segundo botón igual de fuerte, o los dos compiten y no se pulsa ninguno. */
.hero-cta-alt {
  background: transparent;
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.35);
}
.hero-cta-alt:hover { border-color: rgba(255, 255, 255, 0.7); }

/* ── Flags ── */
.hero-flags-strip {
  position: relative;
  z-index: 1;
  padding-bottom: 48px;
}
.flag-item {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 7px 15px; border-radius: 9999px;
  font-size: 13px; font-weight: 500; color: rgba(255,255,255,0.82);
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.11);
  flex-shrink: 0;
}
@keyframes ticker-flags-kf {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
.ticker-flags { animation: ticker-flags-kf 16s linear infinite; }
@media (max-width: 900px) {
  .ticker-flags { animation-duration: 4.5s; }
}

/* ── Mobile ── */
@media (max-width: 900px) {
  .hero-wrap {
    grid-template-columns: 1fr;
    padding: 100px 24px 48px;
    gap: 48px;
  }
  .hero-col-card { display: none; }
  .hero-cta-row { flex-direction: column; }
  .hero-cta-main,
  .hero-cta-alt {
    width: 100%;
    justify-content: center;
  }
  .badge-dark { white-space: nowrap; font-size: 10px; }
  .hero-bullets li { font-size: 15px; }
}
@media (max-width: 400px) {
  .badge-dark { font-size: 9px; padding: 5px 12px; }
}
</style>
