---
interface Props { data?: any }
const { data } = Astro.props
const badge = data?.badge ?? 'Proceso de admisión'
const title = data?.title ?? 'Tres pasos.'
const subtitle = data?.subtitle ?? 'Para iniciar tu matrícula solo te pedimos tres datos. Después la completas y hablamos contigo: las plazas son limitadas y queremos que cada persona que entra esté en el sitio adecuado.'
const guaranteeText = data?.guaranteeText ?? 'Garantía de devolución 15 días'
const ctaText = data?.ctaText ?? 'Matricularme'
import { CTA_PRINCIPAL } from '../lib/cta'
---
<div class="proceso-wrapper">
<div class="proceso-outer" data-navbar="dark">
  <section class="proceso-section">
    <div class="proceso-glow-tl" aria-hidden="true"></div>
    <div class="proceso-glow-br" aria-hidden="true"></div>

    <!-- Patrón de puntos azul claro (detrás de las tarjetas) -->
    <div class="proceso-dots-bg" aria-hidden="true"></div>

    <div class="inner" style="position:relative;z-index:1;">

      <div class="proceso-header">
        <span class="badge-dark">{badge}</span>
        <h2 class="proceso-title text-gradient-white">{title}</h2>
        <p class="proceso-sub">{subtitle}</p>
      </div>

      <div class="proceso-steps">

        {/* ⚠️ Los tres pasos describen el camino REAL desde esta página:
            el botón (CTA_PRINCIPAL) lleva a /proceso-de-admision. Ahí la
            persona deja nombre, correo y WhatsApp para ver el vídeo del
            método (paso 1), contesta las preguntas de la matrícula y reserva
            hora (paso 2) y tiene la llamada de admisión, que es el filtro:
            solo si encaja, paga y entra (paso 3). Si CTA_PRINCIPAL cambia de
            destino, hay que reescribir estos pasos (ver src/lib/cta.ts).
            "Tres pasos" y no "Dos clics" (04/10/2026): lo premium selecciona,
            no presume de fácil. Las pantallitas blancas enseñan lo que la
            persona ve de verdad en cada paso; nada inventado. */}
        <!-- Paso 01 -->
        <div class="proceso-card sr">
          <div class="proceso-card-glow" aria-hidden="true"></div>
          <div class="proceso-num">01</div>
          <h3 class="proceso-card-title">Inicia tu matrícula</h3>
          <ul class="proceso-perks">
            <li>
              <span class="proceso-check">
                <svg width="10" height="10" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Para empezar, solo nombre, correo y WhatsApp
            </li>
            <li>
              <span class="proceso-check">
                <svg width="10" height="10" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Ves por dentro cómo funciona el método
            </li>
            <li>
              <span class="proceso-check">
                <svg width="10" height="10" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Plazas limitadas por convocatoria
            </li>
          </ul>
          <div class="proceso-mockup">
            <div class="proceso-mockup-inner">
              <div class="pm-row">
                <span class="pm-label">Nombre</span>
                <span class="pm-value">María García</span>
              </div>
              <div class="pm-row">
                <span class="pm-label">WhatsApp</span>
                <span class="pm-value">+31 6 1234 5678</span>
              </div>
              <div class="pm-row">
                <span class="pm-label">Vídeo del método</span>
                <span class="pm-badge">Desbloqueado</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Paso 02 -->
        <div class="proceso-card sr d1">
          <div class="proceso-card-glow" aria-hidden="true"></div>
          <div class="proceso-num">02</div>
          <h3 class="proceso-card-title">Completa tu matrícula</h3>
          <ul class="proceso-perks">
            <li>
              <span class="proceso-check">
                <svg width="10" height="10" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Unas preguntas sobre tu nivel, tu objetivo y tu tiempo
            </li>
            <li>
              <span class="proceso-check">
                <svg width="10" height="10" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Con eso preparamos la llamada contigo
            </li>
            <li>
              <span class="proceso-check">
                <svg width="10" height="10" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Eliges el día y la hora que te van bien
            </li>
          </ul>
          <div class="proceso-mockup">
            <div class="proceso-mockup-inner">
              <div class="pm-row">
                <span class="pm-label">Nivel</span>
                <span class="pm-value">Desde cero</span>
              </div>
              <div class="pm-row">
                <span class="pm-label">Objetivo</span>
                <span class="pm-value">Trabajo e inburgering</span>
              </div>
              <div class="pm-row">
                <span class="pm-label">Llamada</span>
                <span class="pm-badge">Reservada</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Paso 03 -->
        <div class="proceso-card sr d2">
          <div class="proceso-card-glow" aria-hidden="true"></div>
          <div class="proceso-num">03</div>
          <h3 class="proceso-card-title">Llamada de admisión</h3>
          <ul class="proceso-perks">
            <li>
              <span class="proceso-check">
                <svg width="10" height="10" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Media hora con nuestro equipo, sin compromiso
            </li>
            <li>
              <span class="proceso-check">
                <svg width="10" height="10" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Vemos juntos si la formación encaja contigo
            </li>
            <li>
              <span class="proceso-check">
                <svg width="10" height="10" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Si encaja, entras a la escuela y empiezas
            </li>
          </ul>
          <div class="proceso-mockup">
            <div class="proceso-mockup-inner">
              <div class="pm-row">
                <span class="pm-label">Duración</span>
                <span class="pm-value">Media hora</span>
              </div>
              <div class="pm-row">
                <span class="pm-label">Compromiso</span>
                <span class="pm-value">Ninguno</span>
              </div>
              <div class="pm-row">
                <span class="pm-label">Si encaja</span>
                <span class="pm-badge">Entras a la escuela</span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- CTA final -->
      <div class="proceso-cta-wrap sr">
        <a href={CTA_PRINCIPAL} class="btn-proceso-cta">
          {ctaText}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <p class="proceso-garantia" style="color: rgba(255, 255, 255, 0.85);">
          <span style="flex-shrink:0;width:22px;height:22px;border-radius:50%;background:transparent;border:2px solid #4da3ff;display:inline-flex;align-items:center;justify-content:center;">
            <svg width="11" height="11" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
          </span>
          {guaranteeText}
        </p>
      </div>

    </div>
  </section>
</div>
</div>
