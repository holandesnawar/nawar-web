---
interface Props { data?: any }
const { data } = Astro.props
const badge = data?.badge ?? 'Así de sencillo'
const title = data?.title ?? 'Dos clics. Listo.'
const subtitle = data?.subtitle ?? 'Reserva tu plaza en minutos y recibirás acceso prioritario antes del lanzamiento.'
const guaranteeText = data?.guaranteeText ?? 'Garantía de devolución 15 días'
const ctaText = data?.ctaText ?? 'Unirte'
import { CTA_PRINCIPAL } from '../lib/cta'
---
<div class="proceso-wrapper">
<div class="proceso-outer" data-navbar="dark">
  <section class="proceso-section">
    <div class="proceso-glow-tl" aria-hidden="true"></div>
    <div class="proceso-glow-br" aria-hidden="true"></div>

    <!-- Patrón de puntos azul claro (detrás de las tarjetas) -->
    <div class="proceso-dots-bg" aria-hidden="true"></div>

    <div class="inner" style="position:relative;z-index:1;">

      <div class="proceso-header">
        <span class="badge-dark">{badge}</span>
        <h2 class="proceso-title text-gradient-white">{title}</h2>
        <p class="proceso-sub">{subtitle}</p>
      </div>

      <div class="proceso-steps">

        {/* ⚠️ Los tres pasos describen el camino REAL de la matrícula
            abierta: formulario → pago → correo con el acceso. Antes
            contaban el de la lista de espera ("completamente gratis",
            "acceso garantizado en el lanzamiento"), y eso en una página
            que manda a un pago de 397 € es una promesa falsa.
            Las pantallitas blancas enseñan lo que la persona ve de
            verdad en cada paso; nada inventado. */}
        <!-- Paso 01 -->
        <div class="proceso-card sr">
          <div class="proceso-card-glow" aria-hidden="true"></div>
          <div class="proceso-num">01</div>
          <h3 class="proceso-card-title">Matricúlate en dos minutos</h3>
          <ul class="proceso-perks">
            <li>
              <span class="proceso-check">
                <svg width="10" height="10" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Nombre, correo y teléfono. Nada más
            </li>
            <li>
              <span class="proceso-check">
                <svg width="10" height="10" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Sin cuenta ni contraseña todavía
            </li>
            <li>
              <span class="proceso-check">
                <svg width="10" height="10" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Plazas limitadas por convocatoria
            </li>
          </ul>
          <div class="proceso-mockup">
            <div class="proceso-mockup-inner">
              <div class="pm-row">
                <span class="pm-label">Nombre</span>
                <span class="pm-value">María García</span>
              </div>
              <div class="pm-row">
                <span class="pm-label">Correo</span>
                <span class="pm-value">maria@gmail.com</span>
              </div>
              <div class="pm-row">
                <span class="pm-label">Plaza</span>
                <span class="pm-badge">Reservada</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Paso 02 -->
        <div class="proceso-card sr d1">
          <div class="proceso-card-glow" aria-hidden="true"></div>
          <div class="proceso-num">02</div>
          <h3 class="proceso-card-title">Paga seguro, como prefieras</h3>
          <ul class="proceso-perks">
            <li>
              <span class="proceso-check">
                <svg width="10" height="10" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Tarjeta, iDEAL, Klarna o Bancontact
            </li>
            <li>
              <span class="proceso-check">
                <svg width="10" height="10" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Factura en tu correo al momento
            </li>
            <li>
              <span class="proceso-check">
                <svg width="10" height="10" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Garantía de 15 días: si no te convence, te devolvemos el dinero
            </li>
          </ul>
          <div class="proceso-mockup">
            <div class="proceso-mockup-inner">
              <div class="pm-row">
                <span class="pm-label">Pago</span>
                <span class="pm-badge pm-badge--ok">✓ Confirmado</span>
              </div>
              <div class="pm-row">
                <span class="pm-label">Método</span>
                <span class="pm-value">iDEAL</span>
              </div>
              <div class="pm-row">
                <span class="pm-label">Factura</span>
                <span class="pm-value">Enviada a tu correo</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Paso 03 -->
        <div class="proceso-card sr d2">
          <div class="proceso-card-glow" aria-hidden="true"></div>
          <div class="proceso-num">03</div>
          <h3 class="proceso-card-title">Entra a la escuela hoy mismo</h3>
          <ul class="proceso-perks">
            <li>
              <span class="proceso-check">
                <svg width="10" height="10" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Tu acceso llega por correo en minutos
            </li>
            <li>
              <span class="proceso-check">
                <svg width="10" height="10" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Empiezas el módulo 1, desde el español
            </li>
            <li>
              <span class="proceso-check">
                <svg width="10" height="10" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Clases en vivo con profesores que hablan tu idioma
            </li>
          </ul>
          <div class="proceso-mockup">
            <div class="proceso-mockup-inner">
              <div class="pm-row">
                <span class="pm-label">Progreso</span>
                <span class="pm-value">Módulo 1 · Lección 1</span>
              </div>
              <div class="pm-row">
                <span class="pm-label">Próxima clase en vivo</span>
                <span class="pm-badge">Esta semana</span>
              </div>
              <div class="pm-row">
                <span class="pm-label">Racha</span>
                <span class="pm-value">Día 1</span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- CTA final -->
      <div class="proceso-cta-wrap sr">
        <a href={CTA_PRINCIPAL} class="btn-proceso-cta">
          {ctaText}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <p class="proceso-garantia" style="color: rgba(255, 255, 255, 0.85);">
          <span style="flex-shrink:0;width:22px;height:22px;border-radius:50%;background:transparent;border:2px solid #4da3ff;display:inline-flex;align-items:center;justify-content:center;">
            <svg width="11" height="11" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
          </span>
          {guaranteeText}
        </p>
      </div>

    </div>
  </section>
</div>
</div>
