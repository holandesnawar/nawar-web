---
// ¿La formación es para ti? — sí / no, sin rodeos.
const siItems = [
  'Vives (o vas a vivir) en Países Bajos o Bélgica y quieres integrarte de verdad',
  'Quieres un camino claro y guiado, no apps sueltas y vídeos al azar',
  'Puedes dedicar 20–30 minutos al día, a tu ritmo y desde donde sea',
  'Quieres entender el idioma desde el español, con lógica y sin memorizar a ciegas',
  'Buscas acompañamiento: clases, soporte y una comunidad que avanza contigo',
]
const noItems = [
  'Buscas hablar fluido en dos semanas sin esfuerzo (eso no existe — y quien lo promete, miente)',
  'Prefieres coleccionar apps y cursos sueltos en vez de seguir un sistema',
  'No puedes dedicar ni 15 minutos al día al idioma',
  'Ya tienes nivel B1 o superior (escríbenos: los siguientes niveles llegan pronto)',
]
---
<section class="pt-section" data-navbar="light">
  <div class="inner" style="position:relative;z-index:1;">

    <div class="pt-header sr">
      <span class="badge-light">Seamos honestos</span>
      <h2 class="pt-title">¿La formación es <span class="pt-accent">para ti?</span></h2>
      <p class="pt-sub">No queremos alumnos: queremos alumnos que lleguen a hablar. Por eso te lo decimos claro.</p>
    </div>

    <div class="pt-cards">

      <!-- Es para ti -->
      <div class="pt-card pt-card--yes sr">
        <div class="pt-card-glow" aria-hidden="true"></div>
        <h3 class="pt-card-title">Es para ti si…</h3>
        <ul class="pt-list">
          {siItems.map((item) => (
            <li>
              <span class="pt-icon pt-icon--check">
                <svg width="10" height="10" fill="none" stroke="#4da3ff" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <!-- No es para ti -->
      <div class="pt-card pt-card--no sr d1">
        <h3 class="pt-card-title pt-card-title--no">No es para ti si…</h3>
        <ul class="pt-list pt-list--no">
          {noItems.map((item) => (
            <li>
              <span class="pt-icon pt-icon--x">
                <svg width="10" height="10" fill="none" stroke="#dc2626" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>

<style>
.pt-section { background: #fff; position: relative; overflow: hidden; padding: 96px 0; }
.pt-header { text-align: center; max-width: 720px; margin: 0 auto 52px; }
.pt-title {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: clamp(28px, 4vw, 46px);
  font-weight: 600; letter-spacing: -0.022em; line-height: 1.12;
  color: #101336; margin: 18px 0 16px;
}
.pt-accent { color: #025dc7; }
.pt-sub { font-size: clamp(14px, 1.4vw, 17px); color: #454F6B; line-height: 1.6; }

.pt-cards {
  display: grid; grid-template-columns: 1fr 1fr; gap: 20px;
  max-width: 1000px; margin: 0 auto; align-items: start;
}
@media (max-width: 820px) { .pt-cards { grid-template-columns: 1fr; } }

.pt-card { border-radius: 24px; padding: 36px 32px; position: relative; overflow: hidden; }
.pt-card--yes {
  background: #1D0084; color: #fff;
  background-image: radial-gradient(circle, rgba(255,255,255,0.05) 1px, transparent 1px);
  background-size: 26px 26px;
}
.pt-card-glow {
  position: absolute; top: -30%; right: -20%; width: 420px; height: 320px;
  background: radial-gradient(ellipse at center, rgba(11,109,240,0.45) 0%, transparent 65%);
  pointer-events: none;
}
.pt-card--no {
  background: rgba(240,245,255,0.80);
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(2,93,199,0.12);
  box-shadow: 0 4px 32px rgba(29,0,132,0.06);
}

/* Mismo tratamiento que las tarjetas de PorQueNawar: título limpio,
   sin chip de icono. Es como se hace en el resto de la web. */
.pt-card-title {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: clamp(20px, 2.5vw, 26px);
  font-weight: 600; letter-spacing: -0.018em; line-height: 1.2;
  margin-bottom: 24px; position: relative; z-index: 1;
}
.pt-card-title--no { color: #1D0084; }

.pt-list { list-style: none; display: flex; flex-direction: column; gap: 14px; position: relative; z-index: 1; }
.pt-list li {
  display: flex; align-items: flex-start; gap: 12px;
  font-size: 16px; font-weight: 600; line-height: 1.5; color: #ffffff;
}
.pt-list--no li { color: #1D0084; }
.pt-icon {
  flex-shrink: 0; width: 20px; height: 20px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; margin-top: 1px;
}
.pt-icon--check { background: rgba(77,163,255,0.20); border: 1px solid rgba(77,163,255,0.40); }
.pt-icon--x { background: rgba(220,38,38,0.08); border: 1px solid rgba(220,38,38,0.25); }
</style>
