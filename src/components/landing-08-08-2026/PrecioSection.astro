  margin: 28px 0 18px;
  padding-top: 20px;
  /* Misma línea que la del pie de pagos: a 0,14 sobre el cristal azul
     no se veía y la lista parecía flotar debajo del botón. */
  border-top: 1px solid rgba(255,255,255,0.28);
  display: flex; flex-direction: column; gap: 11px;
}
.pr-reasseg li {
  display: flex; align-items: flex-start; gap: 10px;
