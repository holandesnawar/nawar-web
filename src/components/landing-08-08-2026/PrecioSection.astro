---
// La oferta, en una sola sección y dos columnas: a la izquierda el
// desglose de lo que vale, a la derecha la tarjeta con lo que cuesta.
// ── Desglose de valor ─────────────────────────────────────────
// Estaba en su propia sección, justo encima. Ahora vive en la columna
// izquierda de ésta: era la misma lista que "Tu acceso incluye" pero
// con precios, así que la página contaba dos veces lo mismo en dos
// tarjetas oscuras seguidas. Una sola sección: a la izquierda lo que
// vale, a la derecha lo que cuesta.
const nucleo = [
  { item: 'Programa completo Neerlandés A0 → A1', detalle: '16 semanas de programa estructurado, con 6 meses de acceso', valor: 800, nota: 'lo que cuesta un solo nivel en una academia de NL' },
  { item: 'Escuela interactiva', detalle: 'Flashcards, lectura, escucha con audio nativo y ejercicios', valor: 150 },
  { item: 'Repaso inteligente', detalle: 'Recuerda tus fallos y te los devuelve hasta que los dominas', valor: 90 },
  { item: 'Libros y materiales descargables', detalle: 'Presentaciones, guías y PDFs de cada lección', valor: 120 },
]
const bonus = [
  { item: 'Clase semanal en directo', detalle: '12 clases con profesor, todas grabadas', valor: 780, nota: '12 × 65 € que cuesta una clase suelta' },
  { item: 'Comunidad privada de hispanohablantes', detalle: 'Gente en tu misma situación, no aprendes solo', valor: 120 },
  { item: 'Ejercicios y lecciones extra', detalle: 'Material adicional para repasar sin límite', valor: 90 },
  { item: 'Soporte y resolución de dudas', detalle: 'Preguntas y te responde el equipo', valor: 150 },
  { item: 'Certificado oficial Holandés Nawar', detalle: 'Personalizado, al completar la formación', valor: 60 },
]

// El logo de iDEAL, el de verdad. Los demás están dibujados a mano
// aquí al lado —la V de VISA, los dos círculos de Mastercard—, pero
// éste tiene una forma que no se imita con texto.
//
// ⚠️ Este enlace es una miniatura de la caché de imágenes de Google,
// no un archivo nuestro: esas direcciones caducan sin avisar. En
// cuanto puedas, súbelo a docs.holandesnawar.com/img/Landing/ como el
// resto y cambia esta línea. Mientras tanto, si el enlace muere el
// onerror devuelve el chip de texto de siempre y no se ve un hueco.
// Vaciando la constante también vuelve el texto.
const IDEAL_LOGO = 'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcS4C7eZMNi3ybAuLupOcv_-jPwzJ_s_xL6hxEgiq4CxHHLe88haMW3Plcg&s=10'

const valorTotal = [...nucleo, ...bonus].reduce((a, b) => a + b.valor, 0)
const precio = '397'
const ahorro = valorTotal - Number(precio)
// A mano y no con toLocaleString: el Node que compila no siempre trae
// los datos de idioma, y cuando no los trae devuelve "2360" en vez de
// "2.360" sin avisar. Con el punto de los miles la cifra tachada se lee
// de un vistazo, que es justo para lo que está.
const eur = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.')
const matriculaUrl = '/matricula-formacion-nawar-a0-a1'
---
<div class="pr-wrapper" id="precio">
  <div class="pr-outer" data-navbar="dark">
    <section class="pr-section">
      <div class="pr-bg-glow" aria-hidden="true"></div>
      <div class="dots-dark" aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;opacity:0.5;"></div>
      <div class="inner" style="position:relative;z-index:1;">

        <div class="pr-header sr">
          <span class="badge-dark">
            <svg class="check-icon" fill="none" viewBox="0 0 12 12"><path d="M2 6.5l2.5 2.5 5.5-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Lo que vale de verdad
          </span>
          <h2 class="pr-title">
            <span class="text-gradient-white">Suma todo lo que te llevas.</span><br />
            <span style="color:#4da3ff;-webkit-text-fill-color:#4da3ff;">Después mira el precio.</span>
          </h2>
        </div>

        <div class="pr-layout">

          <!-- Izquierda: el desglose de lo que vale -->
          <div class="pr-includes sr">
            <table class="sv-table">
              <caption class="sv-caption">Desglose del valor de la formación</caption>
              <tbody>
                {nucleo.map((r) => (
                  <tr>
                    <th scope="row">
                      <span class="sv-item">{r.item}</span>
                      <span class="sv-detalle">{r.detalle}</span>
                      {r.nota && <span class="sv-nota">{r.nota}</span>}
                    </th>
                    <td class="sv-valor">{eur(r.valor)}&nbsp;€</td>
                  </tr>
                ))}
                {bonus.map((r, i) => (
                  <tr class="sv-bonus">
                    <th scope="row">
                      <span class="sv-item"><span class="sv-tag">Bonus {String(i + 1).padStart(2, '0')}</span>{r.item}</span>
                      <span class="sv-detalle">{r.detalle}</span>
                      {r.nota && <span class="sv-nota">{r.nota}</span>}
                    </th>
                    <td class="sv-valor">{eur(r.valor)}&nbsp;€</td>
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr class="sv-total">
                  <th scope="row">Valor total</th>
                  <td><span class="sv-strike">{eur(valorTotal)}&nbsp;€</span></td>
                </tr>
              </tfoot>
            </table>
          </div>

          <!-- Derecha: tarjeta de precio con anillo de gradiente -->
          <div class="pr-card-col sr d1">
            <div class="pr-card-ring">
              <div class="pr-card">
                <p class="pr-card-name">Formación Nawar A0 <span class="pr-card-arrow">→</span> A1</p>

                <div class="pr-price-row">
                  <span class="pr-price">{precio}€</span>
                  <span class="pr-price-meta">
                    <span class="pr-price-old">{eur(valorTotal)}€</span>
                    <span class="pr-price-note">pago único</span>
                  </span>
                </div>

                <span class="pr-ahorro">Te ahorras {eur(ahorro)}&nbsp;€</span>

                <a href={matriculaUrl} class="pr-cta">
                  Reservar mi plaza
                  <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </a>

                <ul class="pr-reasseg">
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    {/* Aquí iba un "Quedan X plazas" que rellenaba el
                        script con lo que devolviera la academia. Fuera:
                        aparecía o no según lo que contestara el
                        endpoint en ese momento, así que dos personas
                        veían cosas distintas en la misma tarjeta, y una
                        cifra de escasez que parpadea vale menos que no
                        ponerla. La línea de arriba ya dice que son 40.
                        Para recuperarlo basta con devolver el <strong>
                        con data-plazas-quedan: el script y su estilo
                        siguen en su sitio. */}
                    <span><strong>Solo 40 plazas</strong> en esta convocatoria</span>
                  </li>
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span><strong>Garantía de 15 días.</strong> Si no es para ti, te devolvemos el 100 %.</span>
                  </li>
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span><strong>Acceso inmediato</strong> durante 6 meses, desde cualquier dispositivo</span>
                  </li>
                  {/* Responde a la objeción de "¿397 € por 16 semanas?" sin
                      prometer que el siguiente nivel vaya incluido: lo que
                      se promete es el turno, no el precio. */}
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span><strong>Prioridad en el siguiente nivel.</strong> Al terminar, esta convocatoria entra primero al A1 → A2.</span>
                  </li>
                </ul>

                <div class="pr-payments">
                  {/* Aquí iba un "🔒 Pago seguro" encima de los logos. Fuera:
                      los logos ya dicen eso solos, y la garantía y el pago
                      único están dos líneas más arriba. */}
                  <span class="pr-logos">
                    <span class="pr-logo pr-logo--visa">VISA</span>
                    <span class="pr-logo pr-logo--mc" aria-label="Mastercard">
                      <svg viewBox="0 0 40 24" aria-hidden="true">
                        <circle cx="15.5" cy="12" r="8.5" fill="#EB001B"/>
                        <circle cx="24.5" cy="12" r="8.5" fill="#F79E1B" fill-opacity="0.92"/>
                      </svg>
                    </span>
                    <span class={`pr-logo pr-logo--ideal${IDEAL_LOGO ? ' con-foto' : ''}`} aria-label="iDEAL">
                      {IDEAL_LOGO
                        ? <img
                            src={IDEAL_LOGO}
                            alt="iDEAL"
                            loading="lazy" decoding="async"
                            onerror="this.closest('.pr-logo').classList.add('sin-foto'); this.remove();"
                          />
                        : null}
                      <span class="pr-logo-txt" aria-hidden="true">iDEAL</span>
                    </span>
                    <span class="pr-logo pr-logo--klarna">Klarna</span>
                    <span class="pr-logo pr-logo--bcmc">Bancontact</span>
                  </span>
                  <span class="pr-pay-plazos">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h4m-4 3h10a3 3 0 003-3V9a3 3 0 00-3-3H7a3 3 0 00-3 3v6a3 3 0 003 3z"/></svg>
                    Pago fraccionable con Klarna
                  </span>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>
  </div>
</div>

<style>
/* Antes era una tarjeta oscura flotando sobre azul claro, y entre el
   desglose de valor —que también es oscuro— y ésta quedaba una franja
   clara que partía la oferta en dos. Ahora las dos secciones son el
   mismo bloque azul seguido: se suma lo que vale y, sin respirar, se
   dice lo que cuesta. */
.pr-wrapper { background: #1D0084; padding: 0; }
/* clip y no hidden, con hidden delante como respaldo para navegadores
   viejos. Es la razón por la que la tarjeta de la derecha no se
   quedaba pegada al hacer scroll aunque tuviera position:sticky
   declarado: un ancestro con overflow:hidden se convierte en el
   contenedor de scroll más cercano, y como ese contenedor no scrollea,
   el sticky no se activa nunca. Con clip se recorta igual pero no se
   crea contenedor. */
.pr-outer {
  overflow: hidden;
  overflow: clip;
  position: relative; border-radius: 0; max-width: 100%; margin: 0;
}
/* Ya no continúa el bloque azul del desglose (que ahora vive dentro):
   viene detrás de los bonus, que son claros, así que recupera su aire. */
.pr-section { background: #1D0084; position: relative; overflow: hidden; overflow: clip; padding: 96px 0; }
/* Igual que .np-comp-glow de nawar-plus: azul claro y centrado en la
   sección, no el azul vivo pegado arriba. Es lo que hace que el índigo
   deje de verse plano y la tarjeta de cristal tenga algo que reflejar. */
.pr-bg-glow {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  width: 1000px; height: 660px; border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(77,163,255,0.20) 0%, transparent 65%);
  pointer-events: none;
}
.pr-header { text-align: center; max-width: 760px; margin: 0 auto 48px; }
/* El <br> parte el título en dos, pero a 25 px la primera línea
   ("Todo el camino hasta hablar,") no cabe en un móvil y se iba a
   tres. Por debajo de 640 px baja lo justo para quedarse en dos. */
.pr-title {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: clamp(25px, 4vw, 48px);
  font-weight: 600; letter-spacing: -0.022em; line-height: 1.14;
  margin-top: 14px;
}
@media (max-width: 640px) {
  /* El calc no es capricho: la primera línea sólo cabe si la fuente
     escala con el ancho útil (viewport − 80 px de márgenes), y esa
     relación medida es font ≈ 0,0625 × ancho útil. Con un clamp de
     vw a secas se pasaba y caía a tres líneas por debajo de 400 px. */
  .pr-title {
    font-size: clamp(17px, calc(6.15vw - 5px), 25px);
    letter-spacing: -0.015em;
  }
}


/* ══════════════════════════════════════════════════════════════
   Desglose de valor (columna izquierda)
   Traído tal cual de StackValor.astro, que era su propia sección.
   Se queda con sus clases sv-* para que si algún día vuelve a
   separarse no haya que renombrar nada.
══════════════════════════════════════════════════════════════ */
.sv-table { width: 100%; border-collapse: collapse; text-align: left; }
.sv-caption { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
.sv-table th, .sv-table td { vertical-align: top; padding: 17px 0; font-weight: 400; }
.sv-table tbody tr { border-bottom: 1px solid rgba(255,255,255,0.09); }

.sv-item {
  display: block;
  font-size: 17px; font-weight: 600; color: #fff; line-height: 1.4;
}
/* Sobre azul oscuro, el 74 % de blanco a 13 px se leía a media luz.
   Sube de tamaño y casi a blanco: es la letra que sostiene toda la
   tabla del valor. */
.sv-detalle { display: block; font-size: 15px; color: rgba(255,255,255,0.92); line-height: 1.55; margin-top: 5px; }
/* La nota va bajo el importe, no bajo el texto: así la fila no crece
   una tercera línea y no parece que el párrafo se duplique. */
.sv-nota {
  display: block; font-size: 11.5px; font-weight: 500;
  color: rgba(255,255,255,0.78);
  white-space: normal; text-align: left;
  line-height: 1.45; margin-top: 5px;
}
/* A 9,5 px con 0,13 em de espaciado no se leía qué bonus era */
.sv-tag {
  display: inline-block;
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 12.5px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase;
  color: #0a1656; background: #4da3ff;
  padding: 4px 10px; border-radius: 6px; margin-right: 10px;
  vertical-align: 1px;
}
.sv-valor {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 17px; font-weight: 700; color: #fff;
  text-align: right; white-space: nowrap; padding-left: 20px !important;
  font-variant-numeric: tabular-nums;
}
.sv-bonus .sv-valor { color: #4da3ff; }

.sv-total th, .sv-total td {
  padding-top: 22px !important;
  font-family: 'Poppins', system-ui, sans-serif;
  font-weight: 700;
}
/* La fila del total es la que ancla el precio: se lee antes que nada
   y en 16 px se perdía entre las de arriba. */
.sv-total th { font-size: 34px; color: #fff; letter-spacing: -0.02em; }
.sv-total td {
  text-align: right; font-size: 34px; letter-spacing: -0.02em;
  color: rgba(255,255,255,0.82); font-variant-numeric: tabular-nums;
}
.sv-strike {
  text-decoration: line-through;
  text-decoration-color: rgba(255,107,107,0.85);
  text-decoration-thickness: 2.5px;
}


/* Móvil: la tabla venía de una sección a 820 px y aquí se queda en el
   ancho de la pantalla. Sin apretar, el nombre de cada línea salía en
   cuatro renglones y "Valor total" se partía en dos. La nota de
   contexto pasa debajo del concepto, que es donde hay sitio, en vez de
   debajo del importe. */
@media (max-width: 720px) {
  .pr-includes { padding: 24px 20px; }
  .sv-table th, .sv-table td { padding: 15px 0; }
  .sv-item { font-size: 16px; }
  .sv-valor { font-size: 16px; padding-left: 12px !important; }
  .pr-includes .sv-nota {
    max-width: 100%; text-align: left; margin-left: 0;
    font-size: 11.5px;
  }
  .sv-total th { font-size: 22px; white-space: nowrap; }
  .sv-total td { font-size: 24px; }
  .sv-tag { font-size: 11px; padding: 3px 8px; margin-right: 8px; }
}

/* La tarjeta se queda pegada mientras se recorre el desglose, que es
   largo: así el precio no se pierde de vista y la columna derecha no
   se queda vacía por abajo. Funciona porque .l8 usa overflow:clip y no
   hidden, que convertía todo en contenedor de scroll. */
@media (min-width: 901px) {
  .pr-card-col { position: sticky; top: 96px; align-self: start; }
}
.pr-layout {
  display: grid; grid-template-columns: minmax(0, 1fr) 400px;
  gap: 36px; align-items: start; max-width: 1010px; margin: 0 auto;
}


/* ── Izquierda: incluye ── */
/* El mismo cristal de nawar-plus que la tarjeta de al lado y que el
   desglose de valor, para que las tres piezas de la oferta vayan a
   juego. Antes era un blanco al 5 % y se veía gris al lado. */
.pr-includes {
  position: relative; overflow: hidden;
  background: linear-gradient(160deg, rgba(11,109,240,0.20) 0%, rgba(77,163,255,0.08) 100%);
  border: 1.5px solid rgba(77,163,255,0.50);
  border-radius: 26px; padding: 30px 30px;
}
.pr-includes::before {
  content: ''; position: absolute; z-index: 0; pointer-events: none;
  top: -140px; left: -140px; width: 400px; height: 400px; border-radius: 50%;
  background: radial-gradient(circle, rgba(77,163,255,0.26) 0%, transparent 65%);
}
.pr-includes-head, .pr-list { position: relative; z-index: 1; }
.pr-includes-head { display: flex; align-items: center; gap: 12px; margin-bottom: 22px; }
/* Icono suelto, sin caja: más grande y en azul claro */
.pr-includes-chip {
  width: 30px; height: 30px; border-radius: 0;
  background: none;
  color: #7dbcff;
  display: flex; align-items: center; justify-content: center;
}
.pr-includes-chip svg { width: 30px; height: 30px; stroke-width: 1.7; }
.pr-includes-title {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 19px; font-weight: 600; color: #fff;
}
.pr-list { display: flex; flex-direction: column; gap: 13px; }
.pr-list li {
  display: flex; gap: 12px; align-items: flex-start;
  font-size: 14.5px; line-height: 1.55; color: rgba(255,255,255,0.82);
}
.pr-check {
  flex-shrink: 0; width: 21px; height: 21px; border-radius: 50%; margin-top: 1px;
  background: rgba(77,163,255,0.16); border: 1px solid rgba(77,163,255,0.40);
  display: flex; align-items: center; justify-content: center;
}
.pr-list-bonus {
  margin-top: 6px; padding: 13px 14px;
  background: rgba(77,163,255,0.12);
  border: 1px solid rgba(77,163,255,0.30);
  border-radius: 14px;
  color: #fff !important;
}
.pr-list-bonus strong { font-weight: 600; }
.pr-gift {
  flex-shrink: 0; width: 22px; height: 22px; border-radius: 7px; margin-top: 1px;
  background: #4da3ff;
  display: flex; align-items: center; justify-content: center;
}

/* ── Derecha: tarjeta de precio ── */
.pr-card-col { position: sticky; top: 96px; }

.pr-card-halo {
  position: absolute; inset: -14% -12%;
  background: radial-gradient(ellipse at center, rgba(77,163,255,0.28) 0%, transparent 62%);
  pointer-events: none;
}
/* Sin anillo: en nawar-plus la tarjeta es sólo el cristal con su
   borde de 1,5 px, y el marco de degradado que había aquí encima le
   robaba el acabado. Se queda de envoltorio para no tocar el HTML. */
.pr-card-ring { position: relative; padding: 0; border-radius: 26px; }
/* Copiado literal de .np-comp-plus de nawar-plus, que es la tarjeta
   que Rida quería: cristal azul translúcido, no un azul macizo.
   Lo que fallaba en los intentos anteriores no era el color de la
   tarjeta sino la luz de detrás: en nawar-plus la sección lleva un
   resplandor grande en azul claro centrado, y sin él este cristal
   chupa el índigo de debajo y se apaga. El resplandor de la sección
   está ahora igualado (ver .pr-bg-glow). */
.pr-card {
  background: linear-gradient(160deg, rgba(11,109,240,0.20) 0%, rgba(77,163,255,0.08) 100%);
  border: 1.5px solid rgba(77,163,255,0.50);
  border-radius: 26px; padding: 32px 30px 28px;
  text-align: left; position: relative; overflow: hidden;
}
/* El mismo halo de esquina que .np-comp-card-glow */
.pr-card::before {
  content: ''; position: absolute; z-index: 0; pointer-events: none;
  top: -120px; right: -120px; width: 380px; height: 380px; border-radius: 50%;
  background: radial-gradient(circle, rgba(77,163,255,0.32) 0%, transparent 65%);
}
/* Era un titular de 22 px en blanco y competía con el precio, que es
   lo único que esta tarjeta tiene que decir. El nombre del producto
   hace falta —una tarjeta de precio sin decir de qué es se lee mal—
   pero como antetítulo: pequeño, en versalitas y en el azul claro,
   igual que las etiquetas del resto de la página. */
.pr-card-name {
  position: relative;
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 11.5px; font-weight: 700; line-height: 1.3;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: #7dbcff;
  margin-bottom: 14px;
}
.pr-card-arrow { letter-spacing: 0; }
.pr-price-row { position: relative; display: flex; align-items: flex-end; gap: 12px; }
.pr-price {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 58px; font-weight: 700; line-height: 1;
  letter-spacing: -0.02em;
  color: #fff; -webkit-text-fill-color: #fff;
  text-shadow: 0 2px 18px rgba(6, 0, 60, 0.22);
}
.pr-price-meta { display: flex; flex-direction: column; padding-bottom: 6px; }
.pr-price-old { font-size: 17px; color: rgba(255,255,255,0.62); text-decoration: line-through; font-weight: 600; }
/* Recoge el total de la sección de arriba: 2.360 € tachados, 397 € y
   la diferencia. Los tres números van juntos, que es donde pegan. */
.pr-ahorro {
  position: relative;
  display: inline-flex; align-items: center; align-self: center; margin: 14px 0 0;
