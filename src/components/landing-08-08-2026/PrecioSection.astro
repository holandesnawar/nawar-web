.pr-logo--ideal { color: #CC0066; letter-spacing: -0.01em; padding: 0 7px; }
.pr-logo--ideal img { height: 15px; width: auto; display: block; }
.pr-logo--ideal.con-foto .pr-logo-txt { display: none; }
/* Después de la de arriba a propósito: cuando la foto falla el chip
