---
// El Método Holandés Nawar — pasos a la izquierda, plataforma VIVA a la derecha
// (mockup rico al estilo de la lesson-card del hero: racha, checks, dots, repaso).
const pasos = [
  {
    num: '1',
    title: 'Completa tu matrícula',
    desc: 'Rellenas el formulario, pasas al pago seguro y en minutos tienes tu acceso a la academia en el correo.',
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    num: '2',
    title: 'Avanza por las unidades del programa',
    desc: 'Empiezas con dos módulos abiertos y cada semana se abre uno nuevo, con una semana de repaso cada dos módulos. Cada lección tiene su vídeo, resumen, flashcards, lectura, escucha y ejercicios: terminas, se marca tu check, y siempre sabes qué toca después.',
    icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
  },
  {
    num: '3',
    title: 'Sigue las clases',
    desc: 'Clase en vivo todas las semanas, las 16, también las de repaso: se practica, se conversa y se resuelven las dudas en grupo. Todas quedan grabadas para verlas a tu ritmo.',
    icon: 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z',
  },
  {
    num: '4',
    title: 'Aprovecha todas las herramientas extra',
    desc: 'Repaso inteligente de tus fallos, consultas que el equipo responde para todo el grupo, comunidad privada y materiales descargables.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
]
---
<div class="mf-wrapper">
  <div class="mf-outer" data-navbar="light">
    <section class="mf-section">
      <div class="mf-bg-glow" aria-hidden="true"></div>
      <div class="dots-dark" aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;opacity:0.5;"></div>
      <div class="inner" style="position:relative;z-index:1;">

        <div class="mf-header sr">
          <span class="badge-light">
            <svg class="check-icon" fill="none" viewBox="0 0 12 12"><path d="M2 6.5l2.5 2.5 5.5-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            El método, paso a paso
          </span>
          <h2 class="mf-title">Así funciona <span class="mf-accent">Holandés Nawar</span></h2>
          <p class="mf-sub">Desde que entras hasta que hablas. Un sistema que te lleva de la mano de A0 a A1.</p>
        </div>

        <div class="mf-layout">

          <!-- Pasos -->
          <div class="mf-steps">
            {pasos.map((p, i) => (
              <div class={`mf-step sr${i > 0 ? ` d${i}` : ''}`}>
                <div class="mf-step-line" aria-hidden="true"></div>
                <div class="mf-step-num">{p.num}</div>
                <div class="mf-step-body">
                  <div class="mf-step-head">
                    <span class="mf-step-chip">
                      <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={p.icon}/></svg>
                    </span>
                    <h3 class="mf-step-title">{p.title}</h3>
                  </div>
                  <p class="mf-step-desc">{p.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <!-- Plataforma viva (mockup rico) -->
          <div class="mf-mock-col sr d1" aria-hidden="true">
            <div class="mf-mock">
              <div class="mf-mock-inner">
                <div class="mf-mock-top">
                  <div>
                    <p class="mf-mock-hi">Hola, María 👋</p>
                    <p class="mf-mock-hisub">Continúa donde lo dejaste</p>
                  </div>
                  <div class="mf-streak"><span class="mf-flame">🔥</span> 12 días</div>
                </div>

                <div class="mf-week">
                  {['L','M','X','J','V','S','D'].map((d, i) => (
                    <div class="mf-day">
                      <span class="mf-day-l">{d}</span>
                      <span class={`mf-day-dot ${i < 4 ? 'on' : ''} ${i === 3 ? 'today' : ''}`}>
                        {i < 4 && <svg width="9" height="9" fill="none" stroke="#fff" stroke-width="3.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>}
                      </span>
                    </div>
                  ))}
                </div>

                <div class="mf-lesson">
                  <p class="mf-lesson-kicker">MÓDULO 2 · FAMILIE & VRIENDEN</p>
                  <p class="mf-lesson-name">Les 3 — Kalender en momenten</p>
                  <div class="mf-lesson-dots">
                    <span class="md on"></span><span class="md on"></span><span class="md half"></span><span class="md"></span>
                    <span class="mf-lesson-pct">2 de 4 secciones</span>
                  </div>
                  <div class="mf-lesson-bar"><span style="width:56%"></span></div>
                  <div class="mf-lesson-btn">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/></svg>
                    Seguir con la lección
                  </div>
                </div>

                <div class="mf-repaso">
                  <span class="mf-repaso-ic">
                    <svg width="13" height="13" fill="none" stroke="#B45309" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                  </span>
                  <div>
                    <p class="mf-repaso-t">Tu repaso de hoy</p>
                    <p class="mf-repaso-s">Lezen · 3 fallos por repasar</p>
                  </div>
                  <span class="mf-repaso-go">→</span>
                </div>
              </div>

              <div class="float-badge mf-fb-top">
                <span style="font-size:18px;">🎓</span>
                <div><p>Progreso real</p><p>guardado en tu cuenta</p></div>
              </div>
              <div class="float-badge mf-fb-bot">
                <span style="font-size:18px;">🎧</span>
                <div><p>Audio nativo</p><p>en cada lección</p></div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>
  </div>
</div>

<style>
/* Antes era una tarjeta azul oscuro con esquinas redondeadas flotando
   sobre un fondo azul claro. Ahora es una sección blanca corriente,
   como "Por qué existe Nawar" o "Todo lo que recibes", y todo el
   interior está pasado a la paleta clara. */
.mf-wrapper { background: #fff; padding: 0; }
.mf-outer { position: relative; max-width: 100%; margin: 0; border-radius: 0; }
/* Va detrás de Pilares, que también es blanca: sin recortar el aire de
   arriba quedaban 192 px de blanco liso entre las dos. */
.mf-section { background: #fff; position: relative; overflow: hidden; padding: 40px 0 96px; }
@media (max-width: 640px) { .mf-section { padding: 28px 0 64px; } }
/* El resplandor se queda, muy suave, para que el blanco no sea plano */
.mf-bg-glow {
  position: absolute; top: -20%; left: 50%; transform: translateX(-50%);
  width: 900px; height: 600px;
  background: radial-gradient(ellipse at center, rgba(11,109,240,0.07) 0%, transparent 65%);
  pointer-events: none;
}
.mf-header { text-align: center; max-width: 780px; margin: 0 auto 56px; }
.mf-title {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: clamp(28px, 4vw, 50px);
  font-weight: 600; letter-spacing: -0.022em; line-height: 1.12;
  margin: 18px 0 16px;
}
.mf-sub { font-size: clamp(14px, 1.4vw, 17px); color: #454F6B; line-height: 1.6; }

.mf-layout {
  display: grid; grid-template-columns: minmax(0, 1fr) 380px;
  gap: 48px; align-items: center; max-width: 1020px; margin: 0 auto;
}
@media (max-width: 960px) { .mf-layout { grid-template-columns: 1fr; } .mf-mock-col { display: none; } }

/* ── Pasos ── */
.mf-steps { display: flex; flex-direction: column; }
.mf-step { position: relative; display: flex; gap: 20px; padding: 0 0 34px; }
.mf-step:last-child { padding-bottom: 0; }
.mf-step:last-child .mf-step-line { display: none; }
.mf-step-line {
  position: absolute; left: 21px; top: 46px; bottom: 0; width: 2px;
  background: linear-gradient(to bottom, rgba(2,93,199,0.32), rgba(2,93,199,0.06));
}
.mf-step-num {
  flex-shrink: 0; width: 44px; height: 44px; border-radius: 14px;
  display: flex; align-items: center; justify-content: center;
  background: #1D0084;
  border: none;
  color: #fff; font-family: 'Poppins', system-ui, sans-serif;
  font-size: 18px; font-weight: 700; position: relative; z-index: 1;
}
.mf-step-body {
  flex: 1; background: #fff;
  border: 1px solid #E4EAF8;
  border-radius: 18px; padding: 20px 24px;
  box-shadow: 0 2px 10px rgba(29,0,132,0.04);
  transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
}
.mf-step:hover .mf-step-body { border-color: rgba(2,93,199,0.30); box-shadow: 0 16px 38px rgba(29,0,132,0.10); transform: translateX(4px); }
.mf-step-head { display: flex; align-items: center; gap: 11px; margin-bottom: 8px; }
/* Icono suelto, sin caja. Ahora va sobre tarjeta blanca → azul de marca. */
.mf-step-chip {
  flex-shrink: 0; width: 30px; height: 30px; border-radius: 0;
  display: flex; align-items: center; justify-content: center;
  background: none; color: #025dc7;
}
.mf-step-chip svg { width: 30px; height: 30px; stroke-width: 1.6; }
.mf-step-title { font-family: 'Poppins', system-ui, sans-serif; font-size: 17px; font-weight: 600; color: #101336; line-height: 1.3; }
.mf-step-desc { font-size: 14.5px; color: #454F6B; font-weight: 400; line-height: 1.65; }

/* ── Mockup plataforma ── */
.mf-mock { position: relative; }
/* El mockup era cristal sobre oscuro; sobre blanco se convierte en la
   tarjeta azul de marca, que además lo separa del fondo. */
.mf-mock-inner {
  background: #1D0084;
  background-image: radial-gradient(circle, rgba(255,255,255,0.05) 1px, transparent 1px),
    radial-gradient(circle 420px at 100% 0%, rgba(11,109,240,0.42) 0%, transparent 65%);
  background-size: 26px 26px, auto;
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 24px; padding: 22px;
  box-shadow: 0 30px 70px rgba(29,0,132,0.22);
}
.mf-mock-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }
.mf-mock-hi { font-family: 'Poppins', system-ui, sans-serif; font-size: 15px; font-weight: 600; color: #fff; }
.mf-mock-hisub { font-size: 11px; color: rgba(255,255,255,0.50); margin-top: 2px; }
.mf-streak {
  display: flex; align-items: center; gap: 5px;
  background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12);
  border-radius: 999px; padding: 5px 11px;
  font-size: 12px; font-weight: 700; color: #fff;
}
.mf-flame { font-size: 13px; }

.mf-week { display: flex; justify-content: space-between; margin-bottom: 16px; }
.mf-day { display: flex; flex-direction: column; align-items: center; gap: 4px; }
.mf-day-l { font-size: 9px; font-weight: 700; color: rgba(255,255,255,0.40); }
.mf-day-dot {
  width: 17px; height: 17px; border-radius: 50%;
  background: rgba(255,255,255,0.12);
  display: flex; align-items: center; justify-content: center;
}
.mf-day-dot.on { background: #4da3ff; }
.mf-day-dot.today { box-shadow: 0 0 0 3px rgba(77,163,255,0.30); }

.mf-lesson { background: #fff; border-radius: 16px; padding: 16px; margin-bottom: 12px; }
.mf-lesson-kicker { font-size: 8.5px; font-weight: 700; letter-spacing: 0.1em; color: #025dc7; margin-bottom: 5px; }
.mf-lesson-name { font-family: 'Poppins', system-ui, sans-serif; font-size: 14px; font-weight: 600; color: #101336; margin-bottom: 10px; }
.mf-lesson-dots { display: flex; align-items: center; gap: 5px; margin-bottom: 8px; }
.md { width: 7px; height: 7px; border-radius: 50%; background: #E4EAF8; }
.md.on { background: #10b981; }
.md.half { background: #4da3ff; }
.mf-lesson-pct { font-size: 10px; color: #8A93AB; margin-left: 6px; }
.mf-lesson-bar { height: 7px; border-radius: 999px; background: #F0F4FF; overflow: hidden; margin-bottom: 12px; }
.mf-lesson-bar span { display: block; height: 100%; border-radius: 999px; background: linear-gradient(90deg, #4da3ff, #0b6df0); }
.mf-lesson-btn {
  display: inline-flex; align-items: center; gap: 7px;
  background: #4da3ff; color: #0a1656;
  font-size: 12px; font-weight: 700; border-radius: 10px; padding: 9px 15px;
  box-shadow: none;
}
.mf-repaso {
  display: flex; align-items: center; gap: 11px;
  background: rgba(251,191,36,0.12); border: 1px solid rgba(251,191,36,0.30);
  border-radius: 14px; padding: 11px 14px;
}
.mf-repaso-ic {
  flex-shrink: 0; width: 28px; height: 28px; border-radius: 9px;
  background: rgba(251,191,36,0.25);
  display: flex; align-items: center; justify-content: center;
}
.mf-repaso-t { font-size: 11.5px; font-weight: 700; color: #fff; }
.mf-repaso-s { font-size: 10.5px; color: rgba(255,255,255,0.55); }
.mf-repaso-go { margin-left: auto; color: #fbbf24; font-weight: 700; }

.mf-fb-top { position: absolute; top: -16px; right: -14px; }
.mf-fb-bot { position: absolute; bottom: -16px; left: -14px; }
</style>
