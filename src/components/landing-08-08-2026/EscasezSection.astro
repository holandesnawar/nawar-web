---
// Escasez y urgencia — solo con lo que ya se afirma en la página.
//
// ⚠️ Aquí NO hay ningún contador falso ni ninguna cifra inventada. Las
// tres razones son las que ya aparecen en la sección de precio: 40
// plazas, precio fundador que sube a 497 € y la cohorte arranca junta.
// Si añades una fecha de cierre real, ponla en `cierre` y aparecerá.
// Escasez que no es verdad quema la marca, así que mejor quedarse corto.
const plazas = 40
const precio = 397
const precioDespues = 497
const cierre = ''   // ej.: '14 de septiembre'
const matriculaUrl = '/matricula-formacion-nawar-a0-a1'

const razones = [
  {
    dato: `${plazas} plazas`,
    title: 'El grupo es pequeño a propósito',
    desc: 'La clase semanal en directo deja de funcionar si entra todo el mundo. Cuando se llenan, se cierra.',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  },
  {
    dato: `${precio} € → ${precioDespues} €`,
    title: 'El precio fundador no vuelve',
    desc: `Entras a ${precio} € por ser de la primera cohorte. A partir de la siguiente, la formación pasa a ${precioDespues} €.`,
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  {
    dato: 'Se empieza junto',
    title: 'La cohorte arranca a la vez',
    desc: 'Todos avanzáis por el mismo punto del temario. Por eso no se puede entrar a mitad de camino.',
    icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
  },
]
---
<section class="es-section" data-navbar="light">
  <div class="inner" style="position:relative;z-index:1;">
    <div class="es-box sr">

      <div class="es-head">
        <span class="es-badge">
          <span class="es-badge-dot"></span>
          Cohorte fundadora
        </span>
        <h2 class="es-title">Por qué esto no va a estar siempre</h2>
        {cierre && <p class="es-cierre">Las inscripciones se cierran el <strong>{cierre}</strong>.</p>}
      </div>

      <div class="es-grid">
        {razones.map((r) => (
          <article class="es-item">
            <svg class="es-icon" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={r.icon}/>
            </svg>
            <p class="es-dato">{r.dato}</p>
            <h3 class="es-name">{r.title}</h3>
            <p class="es-desc">{r.desc}</p>
          </article>
        ))}
      </div>

      <div class="es-foot">
        <a href={matriculaUrl} class="es-cta">
          Quiero mi plaza — {precio}&nbsp;€
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <p class="es-nota">Pago único · 15 días de garantía · Acceso inmediato</p>
      </div>

    </div>
  </div>
</section>

<style>
.es-section { background: #fff; position: relative; overflow: hidden; padding: 40px 0 96px; }
/* Antes era una caja gris con tres cajas blancas dentro y quedaba
   apagada. Ahora la sección respira sobre el azul de marca y las tres
   razones son tarjetas de cristal, como el resto de bloques oscuros. */
.es-box {
  max-width: 1000px; margin: 0 auto;
  background: #1D0084;
  background-image: radial-gradient(circle, rgba(255,255,255,0.055) 1px, transparent 1px),
    radial-gradient(circle 620px at 50% 0%, rgba(11,109,240,0.40) 0%, transparent 65%);
  background-size: 26px 26px, auto;
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 30px;
  padding: 54px 44px;
  overflow: hidden;
}
.es-head { text-align: center; max-width: 640px; margin: 0 auto 36px; }
.es-badge {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
  color: #ffc9a8; background: rgba(232,110,40,0.18);
  border: 1px solid rgba(232,110,40,0.42);
  padding: 6px 15px; border-radius: 9999px; margin-bottom: 18px;
}
.es-badge-dot {
  width: 6px; height: 6px; border-radius: 50%; background: #e86e28; flex-shrink: 0;
  animation: es-pulse 1.8s ease-in-out infinite;
}
@keyframes es-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }

.es-title {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: clamp(26px, 3.4vw, 40px);
  font-weight: 600; letter-spacing: -0.022em; line-height: 1.16;
  background: linear-gradient(180deg, #fff 0%, rgba(255,255,255,0.55) 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.es-cierre { font-size: 15px; color: rgba(255,255,255,0.72); line-height: 1.6; margin-top: 12px; }
.es-cierre strong { color: #fff; }

.es-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
.es-item {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 20px;
  padding: 26px 24px;
  display: flex; flex-direction: column; gap: 8px;
  transition: border-color .25s, background .25s, transform .25s;
}
.es-item:hover {
  border-color: rgba(77,163,255,0.38);
  background: rgba(255,255,255,0.08);
  transform: translateY(-3px);
}
.es-icon { color: #7dbcff; width: 30px; height: 30px; margin-bottom: 8px; }
.es-dato {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 21px; font-weight: 700; letter-spacing: -0.02em; color: #4da3ff; line-height: 1.15;
}
.es-name {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 16px; font-weight: 600; color: #fff; line-height: 1.3;
}
.es-desc { font-size: 14px; color: rgba(255,255,255,0.68); line-height: 1.6; }

.es-foot { text-align: center; margin-top: 34px; }
.es-cta {
  display: inline-flex; align-items: center; gap: 9px;
  padding: 17px 30px; border-radius: 13px;
  background: #4da3ff; color: #1D0084;
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 16px; font-weight: 700;
  text-decoration: none;
  transition: background .22s, transform .22s cubic-bezier(.22,1,.36,1);
}
.es-cta:hover { background: #6ab5ff; transform: scale(1.02); }
.es-cta:active { transform: scale(.98); }
.es-nota { font-size: 13px; color: rgba(255,255,255,0.6); margin-top: 14px; }

@media (max-width: 860px) {
  .es-section { padding: 24px 0 64px; }
  .es-box { padding: 34px 22px; border-radius: 26px; }
  .es-grid { grid-template-columns: 1fr; }
  .es-cta { width: 100%; justify-content: center; }
}
</style>
