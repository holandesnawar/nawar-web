---
// Plazas limitadas — el "por qué ahora".
//
// Va después de la garantía y antes de "qué pasa después". Ese es su
// sitio: cuando alguien ya sabe qué es, si le sirve y que no arriesga
// nada, la única objeción que queda es "lo hago más adelante". Puesta
// arriba, una limitación sobre algo que todavía no deseas no dice nada.
//
// ⚠️ Aquí NO hay ningún contador falso ni ninguna cifra inventada. Las
// tres razones son las que ya se sostienen en el resto de la página:
// 40 plazas, un profesor por módulo en directo y un grupo que empieza
// a la vez. Si añades una fecha de cierre real, ponla en `cierre` y
// aparecerá. Escasez que no es verdad quema la marca, así que mejor
// quedarse corto.
//
// Fuera queda a propósito el "precio fundador que sube a 497 €": es una
// promesa a futuro que habría que cumplir, y no la vamos a afirmar.
// Fuera queda también el distintivo de "primera edición" que tenía
// antes: no va a ser verdad siempre y la sección tiene que aguantar
// convocatoria tras convocatoria.
const plazas = 40
const precio = 397
const cierre = ''   // ej.: '14 de septiembre'
const matriculaUrl = '/matricula-formacion-nawar-a0-a1'

const razones = [
  {
    dato: `${plazas} plazas`,
    title: 'El grupo es pequeño a propósito',
    desc: 'La clase semanal en directo deja de funcionar si entra todo el mundo. Cuando se cubren, se cierra.',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  },
  {
    dato: 'Clases en directo',
    title: 'Hay un profesor detrás, no un vídeo',
    desc: 'Cada módulo tiene su profesor y su clase semanal en directo. El aforo de esa sala es el que manda.',
    icon: 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z',
  },
  {
    dato: 'Se empieza junto',
    title: 'El grupo arranca a la vez',
    desc: 'Todos avanzáis por el mismo punto del temario. Por eso no se puede entrar a mitad de camino.',
    icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
  },
]
---
<section class="es-section" data-navbar="light">
  <div class="inner" style="position:relative;z-index:1;">

    <div class="es-head sr">
      <span class="badge-light">
        <svg class="check-icon" fill="none" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6.5l2.5 2.5 5.5-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Plazas limitadas
      </span>
      <h2 class="es-title">Solo <span class="es-accent">{plazas} plazas</span><br />en esta convocatoria.</h2>
      <p class="es-lead">
        No es un truco de venta: es el aforo de la clase semanal en directo.
        Cuando se cubren las {plazas}, se cierra hasta la siguiente.
      </p>
      {cierre && <p class="es-cierre">Las inscripciones se cierran el <strong>{cierre}</strong>.</p>}
    </div>

    <div class="es-grid">
      {razones.map((r) => (
        <article class="es-item sr">
          <span class="es-icon-box">
            <svg class="es-icon" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={r.icon}/>
            </svg>
          </span>
          <p class="es-dato">{r.dato}</p>
          <h3 class="es-name">{r.title}</h3>
          <p class="es-desc">{r.desc}</p>
        </article>
      ))}
    </div>

    <div class="es-foot sr">
      <a href={matriculaUrl} class="es-cta">
        Quiero mi plaza
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
      <p class="es-nota">Pago único · 15 días de garantía · Acceso inmediato</p>
    </div>

  </div>
</section>

<style>
/* Antes era una caja azul oscura sobre fondo blanco. Pasa al lenguaje
   claro del resto de la página —fondo suave y tarjetas blancas— porque
   ya había demasiado azul y porque una sección que grita en oscuro
   justo después de la garantía se lee como presión, no como un dato. */
.es-section { background: #F0F4FF; position: relative; overflow: hidden; padding: 96px 0; }

.es-head { text-align: center; max-width: 680px; margin: 0 auto 48px; }
.es-title {
  font-family: 'Poppins', system-ui, sans-serif;
  font-weight: 600; letter-spacing: -0.022em; line-height: 1.14;
  color: #1D0084;
}
/* El subrayado de rotulador de la página, para que el número sea lo
   primero que se ve al llegar a la sección. */
.es-accent {
  display: inline;
  background-image: linear-gradient(
    to top,
    rgba(122, 185, 255, 0.45) 0em,
    rgba(122, 185, 255, 0.45) 0.24em,
    transparent 0.24em
  );
  padding: 0 0.08em;
  border-radius: 5px;
}
.es-lead { font-size: 17px; line-height: 1.6; color: #454F6B; margin-top: 16px; }
.es-cierre { font-size: 15px; color: #454F6B; line-height: 1.6; margin-top: 12px; }
.es-cierre strong { color: #101336; font-weight: 700; }

.es-grid {
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px; max-width: 1040px; margin: 0 auto;
}
.es-item {
  background: #fff;
  border: 1px solid #E4EAF8;
  border-radius: 20px;
  padding: 26px 24px;
  display: flex; flex-direction: column; align-items: flex-start; gap: 8px;
  box-shadow: 0 2px 10px rgba(29,0,132,0.04);
  transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease;
}
.es-item:hover {
  border-color: rgba(2,93,199,0.30);
  box-shadow: 0 16px 38px rgba(29,0,132,0.10);
  transform: translateY(-3px);
}
/* La misma caja de icono que en "el coste de seguir igual" */
.es-icon-box {
  display: flex; align-items: center; justify-content: center;
  width: 44px; height: 44px; border-radius: 13px;
  background: #F0F4FF; color: #025dc7;
  margin-bottom: 6px;
}
.es-icon { width: 21px; height: 21px; }
.es-dato {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 22px; font-weight: 700; letter-spacing: -0.02em;
  color: #025dc7; line-height: 1.15;
}
.es-name {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 16px; font-weight: 600; color: #101336; line-height: 1.3;
}
.es-desc { font-size: 14.5px; color: #454F6B; line-height: 1.65; }

.es-foot { text-align: center; margin-top: 40px; }
.es-cta {
  display: inline-flex; align-items: center; gap: 9px;
  padding: 17px 30px; border-radius: 13px;
  background: #4da3ff; color: #1D0084;
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 16px; font-weight: 700;
  text-decoration: none;
  transition: background .22s, transform .22s cubic-bezier(.22,1,.36,1);
}
.es-cta:hover { background: #6ab5ff; transform: scale(1.02); }
.es-cta:active { transform: scale(.98); }
.es-nota { font-size: 13px; color: #6B7488; margin-top: 14px; }

@media (max-width: 860px) {
  .es-section { padding: 64px 0; }
  .es-grid { grid-template-columns: 1fr; }
  .es-cta { width: 100%; justify-content: center; }
}
</style>
