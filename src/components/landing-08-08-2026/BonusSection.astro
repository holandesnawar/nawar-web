---
// Los 5 bonus que van dentro del precio.
// Uno por fila, en orden 1 → 5, alternando visual y texto. Cada bonus
// tiene su propia maqueta hecha con CSS (nada de iconos con brillo) y
// el certificado cierra la sección como bonus 5.
const LOGO = 'https://d1yei2z3i6k35z.cloudfront.net/9533860/671a9c9265e23_Logo_Nawar_2.png'

// Las ilustraciones de cada bonus. Cada una tiene detrás su maqueta
// dibujada en CSS, escondida: si la imagen no carga —la URL cambia, el
// archivo se renombra— el <img> se queda a cero de alto y el bloque se
// vería como un hueco, así que el onerror quita la foto y saca el
// dibujo. Peor que la foto, pero nunca un agujero.
// Vaciar una constante deja directamente la maqueta dibujada.
const CLASES_IMG   = 'https://docs.holandesnawar.com/img/Landing/bonus.clases.png'
const COMUNIDAD_IMG = 'https://docs.holandesnawar.com/img/Landing/bonus.comun.png'
const SOPORTE_IMG  = 'https://docs.holandesnawar.com/img/Landing/bonus.soporte.png'

// Bonus 03: tres capturas en abanico, una encima de otra. El PRIMER
// enlace es el que va delante y se ve entero; los otros dos asoman
// por detrás. Si se deja la lista vacía (o con un número distinto de
// tres), vuelve el mockup dibujado en CSS.
// Bonus 05: el certificado de verdad. Tiene que ser una imagen
// (jpg/png/webp); un PDF no se puede pintar en un <img>. Con la
// constante vacía se sigue viendo el diploma dibujado en CSS.
const CERTIFICADO_IMG = 'https://docs.holandesnawar.com/img/Landing/bonus.cert.png'

const EJERCICIOS_IMGS = [
  'https://docs.holandesnawar.com/img/ejercicios2.jpg',
  'https://docs.holandesnawar.com/img/ejercicios1.jpg',
  'https://docs.holandesnawar.com/img/ejerc3.jpg',
]

// Las caritas del grupo en la maqueta de la clase en directo. Son
// siluetas, no personas: antes había iniciales (M, J, L, A) y un
// "+18", que es inventarse quién va a clase y cuántos son.
const carita = (tono: string) =>
  `<svg viewBox="0 0 48 42" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="24" cy="13" r="9" fill="${tono}"/><path d="M8 42c0-8.8 7.2-14 16-14s16 5.2 16 14z" fill="${tono}"/></svg>`
---
<section class="bn-section" data-navbar="light">
  <div class="inner" style="position:relative;z-index:1;">

    <div class="bn-header sr">
      <span class="badge-light">
        <svg class="check-icon" fill="none" viewBox="0 0 12 12"><path d="M2 6.5l2.5 2.5 5.5-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Además, de regalo
      </span>
      <h2 class="bn-title">Cinco <span class="bn-accent">bonus incluidos</span></h2>
      <p class="bn-sub">No pagas nada extra por ellos. Vienen dentro, y son los que hacen que no te quedes a medias.</p>
    </div>

    <div class="bn-rows">

      <!-- ── BONUS 1 — Clase semanal en directo ── -->
      <article class="bn-row bn-row--flip sr">
        <div class="bn-visual">
          {CLASES_IMG && (
            <figure class="bn-foto">
              <img
                src={CLASES_IMG}
                alt="Clase semanal en directo de la formación Nawar A0-A1"
                loading="lazy" decoding="async"
                onerror="this.closest('figure').remove(); document.getElementById('bn-mock-clases').hidden = false;"
              />
            </figure>
          )}
          <div class="bn-mock bn-mock--live" id="bn-mock-clases" hidden={!!CLASES_IMG}>
            <div class="bn-live-top">
              <span class="bn-live-tag"><span class="bn-live-dot"></span>EN DIRECTO</span>
              <span class="bn-live-when">jueves · 19:00</span>
            </div>

            <div class="bn-live-stage">
              <div class="bn-live-cam">
                <svg class="bn-live-ilu" viewBox="0 0 200 113" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <rect x="98" y="16" width="88" height="60" rx="9" fill="#ffffff" fill-opacity="0.10" stroke="#7dbcff" stroke-opacity="0.45" stroke-width="1.3"/>
                  <text x="142" y="44" text-anchor="middle" font-family="Poppins, system-ui, sans-serif" font-size="17" font-weight="700" fill="#ffffff">1 · 2 · 3</text>
                  <text x="142" y="62" text-anchor="middle" font-family="Poppins, system-ui, sans-serif" font-size="9" font-weight="600" fill="#7dbcff">één · twee · drie</text>
                  <path d="M22 113c0-22 12.5-35 28-35s28 13 28 35z" fill="#0b6df0"/>
                  <circle cx="50" cy="60" r="14" fill="#4da3ff"/>
                  <path d="M72 96l23-22" stroke="#4da3ff" stroke-width="8" stroke-linecap="round"/>
                  <path d="M22 14l1.5 3.8 3.8 1.5-3.8 1.5-1.5 3.8-1.5-3.8-3.8-1.5 3.8-1.5z" fill="#7dbcff"/>
                </svg>
                <span class="bn-live-nombre">Tu profesor del módulo 4</span>
              </div>

              <div class="bn-live-mini">
                <span class="bn-mini"><Fragment set:html={carita('#4da3ff')} /></span>
                <span class="bn-mini"><Fragment set:html={carita('#7dbcff')} /></span>
                <span class="bn-mini"><Fragment set:html={carita('#3f6ff0')} /></span>
                <span class="bn-mini bn-mini--tu">tú</span>
              </div>
            </div>

            <p class="bn-live-title">Les 4 — Getallen en leeftijd</p>

            <div class="bn-live-foot">
              <span class="bn-live-btn">Entrar a la clase</span>
              <span class="bn-live-rec">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.5" fill="currentColor"/></svg>
                Se graba
              </span>
            </div>
          </div>
        </div>
        <div class="bn-text">
          <span class="bn-numrow"><span class="bn-num">Bonus 01</span><span class="bn-val">Valor <s>780 €</s> · incluido</span></span>
          <h3 class="bn-name">Clase semanal <span class="bn-name-hl">online en directo</span></h3>
          <p class="bn-desc">Cada semana una clase en vivo con un profesor interno de la formación, asignado según el módulo que estés cursando. Y si no puedes conectarte, queda grabada y siempre está a tu disposición.</p>
        </div>
      </article>

      <!-- ── BONUS 2 — Comunidad ── -->
      <article class="bn-row sr">
        <div class="bn-visual">
          {COMUNIDAD_IMG && (
            <figure class="bn-foto">
              <img
                src={COMUNIDAD_IMG}
                alt="Comunidad privada de alumnos hispanohablantes de Holandés Nawar"
                loading="lazy" decoding="async"
                onerror="this.closest('figure').remove(); document.getElementById('bn-mock-comunidad').hidden = false;"
              />
            </figure>
          )}
          <div class="bn-mock bn-mock--light" id="bn-mock-comunidad" hidden={!!COMUNIDAD_IMG}>
            <div class="bn-chat-top">
              <span class="bn-chat-name">Comunidad Nawar</span>
              <span class="bn-chat-online"><span class="bn-online-dot"></span>34 en línea</span>
            </div>
            <div class="bn-bubble bn-bubble--in">
              <span class="bn-bubble-who">Lucía</span>
              ¿Alguien sabe cuándo se usa <em>er</em>? Me lío un poco
            </div>
            <div class="bn-bubble bn-bubble--out">
              <span class="bn-bubble-who">Manuel</span>
              A mí me pasaba igual. Mira la lección 6, ahí lo explica con ejemplos
            </div>
            <div class="bn-bubble bn-bubble--in">
              <span class="bn-bubble-who">Carlos</span>
              Justo lo pregunté en la clase del jueves
            </div>
          </div>
        </div>
        <div class="bn-text">
          <span class="bn-numrow"><span class="bn-num">Bonus 02</span><span class="bn-val">Valor <s>120 €</s> · incluido</span></span>
          <h3 class="bn-name">Comunidad <span class="bn-name-hl">de hispanohablantes</span></h3>
          <p class="bn-desc">Un grupo privado de personas que están exactamente en tu misma situación. Os apoyáis, compartís dudas y avanzáis juntos en lugar de estudiar en solitario.</p>
        </div>
      </article>

      <!-- ── BONUS 3 — Ejercicios y lecciones extra ── -->
      <article class="bn-row bn-row--flip sr">
        <div class="bn-visual">
          {EJERCICIOS_IMGS.length === 3 ? (
            <div class="bn-fan">
              <div class="bn-fan-stack">
                <figure class="bn-fan-back bn-fan-a" aria-hidden="true"><img src={EJERCICIOS_IMGS[1]} alt="" loading="lazy" decoding="async" /></figure>
                <figure class="bn-fan-back bn-fan-b" aria-hidden="true"><img src={EJERCICIOS_IMGS[2]} alt="" loading="lazy" decoding="async" /></figure>
                <figure class="bn-fan-front">
                  <img src={EJERCICIOS_IMGS[0]} alt="Ejercicios extra de la academia Holandés Nawar" loading="lazy" decoding="async" />
                </figure>
              </div>
            </div>
          ) : (
          <div class="bn-mock bn-mock--light">
            <div class="bn-ex-top">
              <span class="bn-ex-tag">Práctica extra</span>
              <span class="bn-ex-count">4 de 8</span>
            </div>
            <p class="bn-ex-q">¿Cómo se dice «yo vivo»?</p>
            <div class="bn-ex-opts">
              <span class="bn-opt">Ik heet</span>
              <span class="bn-opt bn-opt--ok">Ik woon
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              <span class="bn-opt">Ik werk</span>
            </div>
            <div class="bn-ex-bar"><span style="width:52%"></span></div>
            <p class="bn-ex-note">Repite las veces que quieras</p>
          </div>
          )}
        </div>
        <div class="bn-text">
          <span class="bn-numrow"><span class="bn-num">Bonus 03</span><span class="bn-val">Valor <s>90 €</s> · incluido</span></span>
          <h3 class="bn-name">Ejercicios <span class="bn-name-hl">y lecciones extra</span></h3>
          <p class="bn-desc">Material adicional al temario principal para repasar y practicar todo lo que quieras, tantas veces como necesites hasta que te salga sin pensar.</p>
        </div>
      </article>

      <!-- ── BONUS 4 — Soporte ── -->
      <article class="bn-row sr">
        <div class="bn-visual">
          {SOPORTE_IMG && (
            <figure class="bn-foto">
              <img
                src={SOPORTE_IMG}
                alt="Consulta de un alumno respondida por el equipo Nawar dentro de la academia"
                loading="lazy" decoding="async"
                onerror="this.closest('figure').remove(); document.getElementById('bn-mock-soporte').hidden = false;"
              />
            </figure>
          )}
          <div class="bn-mock bn-mock--dark" id="bn-mock-soporte" hidden={!!SOPORTE_IMG}>
            <div class="bn-sup-top">
              <span class="bn-sup-tag">TU CONSULTA</span>
              <span class="bn-sup-state"><span class="bn-online-dot"></span>Respondida</span>
            </div>
            <div class="bn-sup-q">No entiendo por qué el verbo se va al final en esta frase</div>
            <div class="bn-sup-a">
              <span class="bn-sup-who">Equipo Nawar</span>
              Porque es una subordinada con <em>omdat</em>. Te lo explico paso a paso y te dejo tres ejemplos más.
            </div>
            <p class="bn-sup-foot">Respondido en menos de 24 h</p>
          </div>
        </div>
        <div class="bn-text">
          <span class="bn-numrow"><span class="bn-num">Bonus 04</span><span class="bn-val">Valor <s>150 €</s> · incluido</span></span>
          <h3 class="bn-name">Soporte <span class="bn-name-hl">y resolución de dudas</span></h3>
          <p class="bn-desc">Cuando algo no te cuadra, preguntas y te respondemos. Sin quedarte bloqueado una semana entera con la misma duda ni buscar respuestas sueltas por internet.</p>
        </div>
      </article>

      <!-- ── BONUS 5 — Certificado ── -->
      <article class="bn-row bn-row--flip sr">
        <div class="bn-visual">
          <div class="bn-cert-halo" aria-hidden="true"></div>
          {/* Si la foto del certificado no carga —la URL cambia, el
              archivo se renombra— el <img> se queda a cero de alto y el
              bloque entero se veía como un hueco blanco, que es lo que
              pasó al cambiar de imagen. Ahora el diploma dibujado va
              siempre en el marcado, oculto, y sale en cuanto la foto
              falla. Peor que la foto, pero nunca un agujero. */}
          {CERTIFICADO_IMG && (
            <figure class="bn-cert bn-cert--foto" id="bn-cert-foto">
              <div class="bn-cert-sheen" aria-hidden="true"></div>
              <img
                src={CERTIFICADO_IMG}
                alt="Certificado de finalización de la Formación Neerlandés A0 → A1"
                loading="lazy" decoding="async"
                onerror="this.closest('#bn-cert-foto').remove(); document.getElementById('bn-cert-dibujo').hidden = false;"
              />
            </figure>
          )}
          <div class="bn-cert" id="bn-cert-dibujo" hidden={!!CERTIFICADO_IMG} aria-label="Certificado Holandés Nawar">
            <div class="bn-cert-sheen" aria-hidden="true"></div>
            <div class="bn-cert-border">
              <span class="bn-corner bn-corner--tl" aria-hidden="true"></span>
              <span class="bn-corner bn-corner--tr" aria-hidden="true"></span>
              <span class="bn-corner bn-corner--bl" aria-hidden="true"></span>
              <span class="bn-corner bn-corner--br" aria-hidden="true"></span>

              <div class="bn-cert-head">
                <img src={LOGO} alt="Holandés Nawar" class="bn-cert-logo" width="120" height="30" />
              </div>
              <p class="bn-cert-kicker">— CERTIFICADO DE FINALIZACIÓN —</p>
              <p class="bn-cert-course">Formación Neerlandés A0 → A1</p>
              <p class="bn-cert-grant">Se otorga a</p>
              <div class="bn-cert-nameline">
                <span class="bn-cert-name">Tu nombre</span>
              </div>
              <p class="bn-cert-text">por completar con éxito el programa completo del Método Holandés Nawar</p>
              <div class="bn-cert-foot">
                <div class="bn-cert-sig">
                  <span class="bn-cert-sigline"></span>
                  <span class="bn-cert-siglabel">Director académico</span>
                </div>
                <div class="bn-cert-level">A1</div>
                <div class="bn-cert-seal-wrap">
                  <span class="bn-cert-seal-ring" aria-hidden="true"></span>
                  <div class="bn-cert-seal">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#fff" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="bn-text">
          <span class="bn-numrow"><span class="bn-num">Bonus 05</span><span class="bn-val">Valor <s>60 €</s> · incluido</span></span>
          <h3 class="bn-name">Certificado oficial <span class="bn-name-hl">Holandés Nawar</span></h3>
          <p class="bn-desc">Al completar todos los módulos recibes tu certificado personalizado con tu nombre, que acredita tu paso de A0 a A1. Tu nivel, demostrado y listo para compartir.</p>
        </div>
      </article>

    </div>
  </div>
</section>

<style>
/* El certificado de verdad, con el mismo juego de color que el
   dibujado: la mancha azul que se desplaza y el brillo que cruza.
   Sobre un documento claro la mancha no puede ir en opaco, así que
   se funde en soft-light: tiñe sin tapar lo que pone. */
/* Clase repetida para ganarle a .bn-cert, que se define más abajo con
   la misma especificidad: sin esto la foto se quedaba con el marco
   azul de 10 px del diploma dibujado. */
/* Sin marco, como el resto de ilustraciones: la caja se ajusta a la
   foto (width:fit-content) para que la mancha de color que va encima
   no pinte un rectángulo azul a los lados del certificado. */
.bn-cert.bn-cert--foto {
  padding: 0;
  background: none;
  background-image: none;
  width: fit-content;
  margin: 0 auto;
}
/* width:auto + los dos topes: así entra igual de bien si el
   certificado viene apaisado (llena el ancho) que si viene vertical
   (lo limita el alto y se centra), sin deformarlo ni recortarlo y sin
   que la fila se dispare de alto. */
.bn-cert.bn-cert--foto img {
  position: relative; z-index: 1; display: block;
  width: auto; height: auto;
  max-width: 100%; max-height: 480px;
  margin: 0 auto;
}
/* Sobre el diploma dibujado, que era azul oscuro, valía una mancha
   azul en soft-light. Sobre la foto, que es un documento casi blanco,
   soft-light no se veía: apenas cambia nada sobre blanco. Con
   multiply el mismo azul sí tiñe, y el brillo que lo cruza pasa a ser
   azul en vez de blanco por el mismo motivo.
   Sigue en bucle (para el móvil, que no tiene ratón) y además se
   aviva al pasar el cursor, que es como estaba y como le gustaba. */
.bn-cert.bn-cert--foto::after {
  z-index: 2;
  mix-blend-mode: multiply;
  background: radial-gradient(circle at 32% 28%, rgba(150,198,255,0.92) 0%, rgba(255,255,255,0) 58%);
  opacity: .8;
}
.bn-row:hover .bn-cert.bn-cert--foto::after { opacity: 1; }
.bn-cert.bn-cert--foto .bn-cert-sheen {
  z-index: 3;
  mix-blend-mode: multiply;
  /* Banda más ancha (30-70 en vez de 38-62) y más cargada: sobre un
     certificado casi blanco, un 55 % de azul en una franja estrecha
     se cruzaba la imagen sin que diera tiempo a verlo. */
  background: linear-gradient(115deg, rgba(255,255,255,0) 30%, rgba(140,192,255,0.72) 50%, rgba(255,255,255,0) 70%);
}
/* Al pasar el cursor, una pasada rápida del brillo además del bucle */
.bn-row:hover .bn-cert.bn-cert--foto .bn-cert-sheen {
  animation: bn-cert-sheen 1.5s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ── Baraja de capturas (bonus 03) ────────────────────────────
   El abanico no funcionaba: con tres tarjetas del mismo tamaño y el
   mismo sitio, girar sobre una esquina sólo dejaba asomar un pico de
   las de detrás, y para abrirlo más había que encogerlas.

   Esto es una baraja que se turna: las tres van apiladas con un
   escalón, y cada una pasa por delante durante unos segundos. Así se
   ven las tres enteras, una detrás de otra, sin salir del mismo hueco
   y sin que ninguna tenga que hacerse pequeña.

   La de delante va en el flujo y es la que fija la altura del bloque;
   las otras dos se calcan encima con inset:0. Las tres comparten el
   mismo ciclo, desfasado un tercio, y el salto de delante a detrás va
   tapado con la opacidad a 0 durante esa fracción para que no se vea
   el corte. */
.bn-fan { position: relative; padding: 7% 11% 0 0; }
.bn-fan-stack { position: relative; width: 100%; }
.bn-fan-front,
.bn-fan-back {
  margin: 0;
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid #E4EAF8;
  background: #fff;
  box-shadow: 0 10px 30px rgba(29, 0, 132, 0.13);
  transform-origin: center;
}
.bn-fan-front { position: relative; z-index: 3; }
.bn-fan-front img { width: 100%; height: auto; display: block; }
.bn-fan-back { position: absolute; inset: 0; }
.bn-fan-back img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: left top;
  display: block;
}
/* Posiciones de reposo, por si no llega a arrancar la animación */
.bn-fan-front { transform: translate(0, 0) scale(1); }
.bn-fan-b { transform: translate(5%, -7%) scale(0.95); z-index: 2; }
.bn-fan-a { transform: translate(10%, -14%) scale(0.90); z-index: 1; }

.bn-row.vis .bn-fan-front { animation: bn-deck 13.5s cubic-bezier(0.4,0,0.2,1) infinite; }
.bn-row.vis .bn-fan-b     { animation: bn-deck 13.5s cubic-bezier(0.4,0,0.2,1) -4.5s infinite; }
.bn-row.vis .bn-fan-a     { animation: bn-deck 13.5s cubic-bezier(0.4,0,0.2,1) -9s infinite; }

@keyframes bn-deck {
  /* delante */
  0%,  27%  { transform: translate(0, 0) scale(1);          opacity: 1; z-index: 3; }
  /* se retira: baja un poco y se desvanece */
  32%       { transform: translate(-3%, 9%) scale(0.98);    opacity: 0; z-index: 3; }
  /* reaparece al fondo de la pila */
  34%       { transform: translate(10%, -14%) scale(0.90);  opacity: 1; z-index: 1; }
  61%       { transform: translate(10%, -14%) scale(0.90);  opacity: 1; z-index: 1; }
  /* sube al medio */
  67%, 94%  { transform: translate(5%, -7%) scale(0.95);    opacity: 1; z-index: 2; }
  /* y vuelve a delante */
  100%      { transform: translate(0, 0) scale(1);          opacity: 1; z-index: 3; }
}
@media (prefers-reduced-motion: reduce) {
  .bn-row.vis .bn-fan-front,
  .bn-row.vis .bn-fan-b,
  .bn-row.vis .bn-fan-a { animation: none; }
}
@media (max-width: 860px) {
  .bn-fan { padding: 6% 9% 0 0; }
}

/* Captura real en lugar del mockup. La imagen trae alrededor el marco
   gris de la pantalla de detrás, y lo que interesa es sólo la tarjeta
   blanca de la consulta. Como no se puede recortar el archivo desde
   aquí, se recorta por CSS: la caja va a 16/10 y la imagen se amplía
   un 18 % desde el centro, que es lo que hace falta para que el marco
   gris se quede fuera por los cuatro lados. Si al verlo se comiera
   algo de la tarjeta blanca, basta con bajar ese scale. */
/* La captura anterior traía alrededor el marco gris de la pantalla de
   detrás, y había que recortarlo por CSS: caja de 16/10, cover y un
   scale del 118 % para echar el marco fuera. La nueva ya viene
   encuadrada, así que se muestra entera y manda ella: sin proporción
   fija, sin recorte y sin zoom.

   Y sin fondo. Aquí había dos fondos, no uno: el de la propia captura
   y el de esta caja, que era una tarjeta blanca con borde sobre una
   sección azul clara. La caja se queda transparente y la imagen se
   mezcla en multiply, que sobre un fondo claro deja pasar el color de
   la sección allí donde la captura es blanca. El blanco desaparece y
   sólo queda la conversación.

   Si el fondo de la captura no fuera blanco sino un color macizo,
   multiply lo teñiría en vez de quitarlo: en ese caso la imagen hay
   que exportarla con transparencia. */
.bn-shot {
  margin: 0;
  border-radius: 0;
  border: none;
  background: none;
  overflow: visible;
  mix-blend-mode: multiply;
}
.bn-shot img {
  width: 100%; height: auto;
  display: block;
}

/* ══════════════════════════════════════════════════════════════
   Sección
══════════════════════════════════════════════════════════════ */
.bn-section { background: #F0F4FF; position: relative; overflow: hidden; padding: 96px 0; }
.bn-header { text-align: center; max-width: 720px; margin: 0 auto 64px; }
.bn-title {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: clamp(28px, 4vw, 46px);
  font-weight: 600; letter-spacing: -0.022em; line-height: 1.12;
  color: #101336; margin-top: 18px;
}
.bn-accent { color: #025dc7; }
.bn-sub { font-size: clamp(14px, 1.4vw, 17px); color: #454F6B; line-height: 1.6; margin-top: 14px; }

/* ── Filas: visual + texto, alternando lado ──────────────────
   Antes cada bonus era una tarjeta blanca de media página con la
   maqueta encajada dentro, y todo quedaba pequeño. Ahora la fila no
   tiene caja: la ilustración va suelta y grande a un lado, el texto
   al otro con el titular a tamaño de titular, y cada bonus ocupa el
   ancho entero de la sección. Empieza con el texto a la izquierda y
   van alternando. */
.bn-rows { display: flex; flex-direction: column; gap: 84px; max-width: 1180px; margin: 0 auto; }
.bn-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 56px;
  align-items: center;
  background: none;
  border: none;
  border-radius: 0;
  padding: 0;
  box-shadow: none;
}
.bn-row--flip .bn-visual { order: 2; }
.bn-row--flip .bn-text   { order: 1; }

.bn-visual { position: relative; min-width: 0; }
.bn-text   { min-width: 0; }

/* Las ilustraciones van sin marco: ni tarjeta, ni borde, ni sombra.
   Traen su propio fondo blanco y la sección es azul clarito, así que
   se mezclan en multiply: sobre un fondo claro el blanco desaparece
   y sólo queda el dibujo. Si alguna llega con transparencia de
   verdad, multiply no le hace nada y se ve igual. */
.bn-foto { margin: 0; mix-blend-mode: multiply; }
.bn-foto img { width: 100%; height: auto; display: block; }
/* Las maquetas dibujadas son el plan B de cada foto: van en el
   marcado siempre, ocultas. Sin esto no se esconderían, porque
   .bn-mock trae display:flex y le gana al display:none del atributo. */
.bn-mock[hidden] { display: none; }

.bn-numrow {
  display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 18px;
}
.bn-val {
  font-size: 13px; font-weight: 600; color: #333D5C;
  background: #F0F4FF; border: 1px solid #DCE5F7;
  padding: 5px 12px; border-radius: 100px;
}
.bn-val s { color: #8A93AB; }
/* Iba a 11 px con 0,16 em de espaciado y costaba leer "Bonus 01".
   El azul vivo tampoco pegaba con los fondos de la página, así que
   ahora es el mismo índigo de marca con un punto del azul medio. */
.bn-num {
  display: inline-block;
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 14px; font-weight: 800; letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #fff;
  background: linear-gradient(135deg, #1D0084 0%, #26139c 55%, #123a9e 100%);
  border-radius: 8px;
  padding: 6px 13px;
}
.bn-name {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: clamp(26px, 3.1vw, 40px);
  font-weight: 600; letter-spacing: -0.022em; line-height: 1.16;
  color: #101336; margin-bottom: 16px;
}
/* La segunda mitad del titular en el azul de marca, como en el resto
   de titulares de la página */
.bn-name-hl { color: #025dc7; }
.bn-desc { font-size: 17px; color: #454F6B; line-height: 1.72; max-width: 540px; }

/* ══════════════════════════════════════════════════════════════
   Maquetas — planas, sin brillos de color
══════════════════════════════════════════════════════════════ */
.bn-mock {
  border-radius: 18px;
  padding: 20px;
  display: flex; flex-direction: column; gap: 11px;
}
.bn-mock--dark {
  background: #1D0084;
  background-image: radial-gradient(circle, rgba(255,255,255,0.055) 1px, transparent 1px);
  background-size: 24px 24px;
  color: #fff;
}
.bn-mock--light { background: #F7F9FF; border: 1px solid #E4EAF8; }

/* ── Bonus 1 — la clase en directo ───────────────────────────
   Era un rectángulo índigo plano con puntitos y cuatro iniciales
   inventadas dentro: correcto y soso, y encima decía cuánta gente
   había en clase, que no lo sabemos.

   Ahora es la misma pieza de cristal azul que la tarjeta de precio
   y el cierre de la oferta —degradado sobre índigo, halo en la
   esquina y el punteado de fondo—, y dentro se ve la clase: el
   profesor en la pizarra dibujado con los mismos azules de los
   iconos de la página, y debajo el grupo en siluetas, con tu hueco
   marcado. */
.bn-mock--live {
  position: relative;
  overflow: hidden;
  color: #fff;
  gap: 12px;
  background-color: #1D0084;
  background-image:
    radial-gradient(circle, rgba(255,255,255,0.055) 1px, transparent 1px),
    linear-gradient(160deg, rgba(11,109,240,0.34) 0%, rgba(77,163,255,0.10) 100%);
  background-size: 24px 24px, auto;
  border: 1.5px solid rgba(77,163,255,0.42);
}
.bn-mock--live::before {
  content: '';
  position: absolute; top: -150px; right: -130px;
  width: 300px; height: 300px; border-radius: 50%;
  background: radial-gradient(circle, rgba(77,163,255,0.34) 0%, transparent 70%);
  pointer-events: none;
}
.bn-mock--live > * { position: relative; z-index: 1; }

.bn-live-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.bn-live-tag {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 9.5px; font-weight: 800; letter-spacing: 0.12em;
  color: #ffd9d9; background: rgba(255,86,86,0.16);
  border: 1px solid rgba(255,86,86,0.34);
  padding: 4px 10px; border-radius: 100px;
}
/* El punto rojo late, como en cualquier retransmisión. Es la única
   animación de la maqueta y va suelta, sin depender del scroll. */
.bn-live-dot {
  position: relative;
  width: 6px; height: 6px; border-radius: 50%;
  background: #ff5656; flex-shrink: 0;
}
.bn-live-dot::after {
  content: ''; position: absolute; inset: 0; border-radius: 50%;
  background: #ff5656;
  animation: bn-live-pulso 2s ease-out infinite;
}
@keyframes bn-live-pulso {
  0%        { transform: scale(1);   opacity: .55; }
  70%, 100% { transform: scale(2.6); opacity: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .bn-live-dot::after { animation: none; }
}
.bn-live-when { font-size: 11.5px; color: rgba(255,255,255,0.62); font-weight: 600; white-space: nowrap; }

/* La ventana de la clase: el profesor grande y el grupo debajo */
.bn-live-stage { display: flex; flex-direction: column; gap: 8px; }
.bn-live-cam {
  position: relative;
  aspect-ratio: 16 / 9;
  border-radius: 14px;
  overflow: hidden;
  background: linear-gradient(150deg, rgba(11,109,240,0.55) 0%, rgba(29,0,132,0.30) 100%);
  border: 1px solid rgba(255,255,255,0.16);
}
.bn-live-ilu { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
/* A la derecha: el profesor está dibujado a la izquierda y la
   etiqueta le tapaba la cara. */
.bn-live-nombre {
  position: absolute; right: 9px; bottom: 8px;
  font-size: 10.5px; font-weight: 600; color: rgba(255,255,255,0.92);
  background: rgba(16,19,54,0.45);
  padding: 3px 8px; border-radius: 7px;
  white-space: nowrap;
}
.bn-live-mini { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
.bn-mini {
  height: 46px;
  border-radius: 10px;
  overflow: hidden;
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.13);
  display: flex; align-items: flex-end; justify-content: center;
}
.bn-mini :global(svg) { width: 48%; max-width: 46px; height: auto; display: block; }
.bn-mini--tu {
  align-items: center;
  background: rgba(77,163,255,0.18);
  border-color: rgba(122,185,255,0.62);
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 12px; font-weight: 700; color: #cfe4ff; letter-spacing: 0.02em;
}

.bn-live-title {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 16px; font-weight: 700; color: #fff; line-height: 1.3;
}
.bn-live-foot { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 1px; }
.bn-live-btn {
  font-size: 12.5px; font-weight: 700; color: #1D0084;
  background: #4da3ff; padding: 8px 15px; border-radius: 9px;
}
.bn-live-rec {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 11.5px; color: rgba(255,255,255,0.62); font-weight: 600;
}

/* Bonus 2 — comunidad */
.bn-chat-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.bn-chat-name { font-family: 'Poppins', system-ui, sans-serif; font-size: 13px; font-weight: 700; color: #101336; }
.bn-chat-online {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 11px; font-weight: 600; color: #16a34a; white-space: nowrap;
}
.bn-online-dot { width: 6px; height: 6px; border-radius: 50%; background: #16a34a; flex-shrink: 0; }
.bn-bubble {
  font-size: 12.5px; line-height: 1.5; color: #3A4460;
  padding: 9px 12px; border-radius: 12px; max-width: 88%;
}
.bn-bubble em { font-style: normal; font-weight: 700; color: #025dc7; }
.bn-bubble-who { display: block; font-size: 10px; font-weight: 700; color: #8A93AB; margin-bottom: 2px; }
.bn-bubble--in { background: #fff; border: 1px solid #E4EAF8; border-bottom-left-radius: 4px; align-self: flex-start; }
.bn-bubble--out { background: #1D0084; color: rgba(255,255,255,0.92); border-bottom-right-radius: 4px; align-self: flex-end; }
.bn-bubble--out .bn-bubble-who { color: rgba(255,255,255,0.55); }
.bn-bubble--out em { color: #7dbcff; }

/* Bonus 3 — ejercicios */
.bn-ex-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.bn-ex-tag {
  font-size: 9.5px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase;
  color: #025dc7; background: #E8F0FF; padding: 4px 10px; border-radius: 100px; white-space: nowrap;
}
.bn-ex-count { font-size: 11px; font-weight: 600; color: #8A93AB; white-space: nowrap; }
.bn-ex-q { font-family: 'Poppins', system-ui, sans-serif; font-size: 15px; font-weight: 700; color: #101336; }
.bn-ex-opts { display: flex; flex-direction: column; gap: 7px; }
.bn-opt {
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
  font-size: 12.5px; font-weight: 500; color: #454F6B;
  background: #fff; border: 1px solid #E4EAF8;
  padding: 9px 12px; border-radius: 10px;
}
.bn-opt--ok {
  color: #15803d; font-weight: 700;
  background: rgba(22,163,74,0.07); border-color: rgba(22,163,74,0.30);
}
.bn-ex-bar { height: 5px; background: #E4EAF8; border-radius: 100px; overflow: hidden; }
.bn-ex-bar span { display: block; height: 100%; background: #4da3ff; border-radius: 100px; }
.bn-ex-note { font-size: 11px; color: #8A93AB; }

/* Bonus 4 — soporte */
.bn-sup-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.bn-sup-tag { font-size: 9.5px; font-weight: 800; letter-spacing: 0.12em; color: rgba(255,255,255,0.6); }
.bn-sup-state { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 700; color: #6ee7a0; white-space: nowrap; }
.bn-sup-state .bn-online-dot { background: #6ee7a0; }
.bn-sup-q {
  font-size: 13px; line-height: 1.5; color: #fff;
  background: rgba(255,255,255,0.09); border: 1px solid rgba(255,255,255,0.14);
  padding: 11px 13px; border-radius: 12px; border-bottom-right-radius: 4px;
}
.bn-sup-a {
  font-size: 12.5px; line-height: 1.55; color: rgba(255,255,255,0.85);
  background: rgba(77,163,255,0.14); border: 1px solid rgba(77,163,255,0.30);
  padding: 11px 13px; border-radius: 12px; border-bottom-left-radius: 4px;
}
.bn-sup-a em { font-style: normal; font-weight: 700; color: #9ecdff; }
.bn-sup-who { display: block; font-size: 10px; font-weight: 700; color: #9ecdff; margin-bottom: 3px; letter-spacing: 0.04em; }
.bn-sup-foot { font-size: 11px; color: rgba(255,255,255,0.5); }

/* ══ Certificado — estilos originales de nawar-web ══ */
.bn-cert-num {
  display: inline-block;
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 10px; font-weight: 800; letter-spacing: 0.14em;
  color: #fff; background: linear-gradient(135deg, #4da3ff, #0b6df0);
  padding: 3px 9px; border-radius: 6px; margin-right: 7px;
  vertical-align: 1px;
}
/* ── Certificado ── */
.bn-cert-col { position: relative; }
/* Antes la fila era una tarjeta con 30 px de relleno y el halo se
   quedaba dentro. Sin tarjeta, con -12%/-14% se salía de la pantalla
   por los lados en móvil, así que se recorta a lo que sobra. */
.bn-cert-halo {
  position: absolute; inset: -5% -6%;
  background: radial-gradient(ellipse at center, rgba(11,109,240,0.14) 0%, transparent 62%);
  pointer-events: none;
}
.bn-cert {
  position: relative;
  background: #1D0084; border-radius: 20px; padding: 10px;
  overflow: hidden;
  background-image: radial-gradient(circle, rgba(255,255,255,0.06) 1px, transparent 1px),
    radial-gradient(circle 480px at 100% 0%, rgba(11,109,240,0.42) 0%, transparent 65%),
    radial-gradient(circle 380px at 0% 100%, rgba(11,109,240,0.20) 0%, transparent 65%);
  background-size: 28px 28px, auto, auto;
}
/* El diploma no se mueve; lo que se mueve es el color: una mancha
   azul que va y viene por dentro y un brillo que lo cruza.
   Van en bucle y no colgando de :hover, porque en el móvil el hover
   no existe y allí el efecto no se veía nunca. Arrancan al entrar en
   pantalla: la fila lleva .sr y el observador del layout le pone
   .vis, así que la animación empieza justo al llegar scrolleando. */
.bn-cert::after {
  content: ''; position: absolute; inset: -45%; z-index: 0; pointer-events: none;
  background: radial-gradient(circle at 32% 28%, rgba(77,163,255,0.55) 0%, transparent 55%);
  opacity: .5;
  transform: translate3d(-7%, -7%, 0);
}
.bn-row.vis .bn-cert::after { animation: bn-cert-glow 4.5s ease-in-out infinite alternate; }
@keyframes bn-cert-glow {
  from { transform: translate3d(-7%, -7%, 0)  scale(1);    opacity: .45; }
  to   { transform: translate3d(16%, 13%, 0)  scale(1.12); opacity: .95; }
}
.bn-cert-sheen {
  position: absolute; inset: 0; pointer-events: none; z-index: 2;
  background: linear-gradient(115deg, transparent 38%, rgba(255,255,255,0.16) 50%, transparent 62%);
  transform: translateX(-130%);
}
/* De una pasada cada 6,5 s a una cada 3,6 s, y la pasada ocupa más
   parte del ciclo (el 44 % en vez del 45 % de un ciclo casi doble):
   antes el brillo cruzaba en menos de tres segundos y luego se
   quedaba casi cuatro parado fuera de cuadro, así que en la práctica
   casi nunca coincidía con que estuvieras mirando. */
.bn-row.vis .bn-cert-sheen { animation: bn-cert-sheen 3.6s ease-in-out 0.4s infinite; }
@keyframes bn-cert-sheen {
  0%   { transform: translateX(-130%); }
  44%  { transform: translateX(130%); }
  100% { transform: translateX(130%); }
}
@media (prefers-reduced-motion: reduce) {
  .bn-row.vis .bn-cert::after,
  .bn-row.vis .bn-cert-sheen { animation: none; }
}
.bn-cert-border {
  position: relative; z-index: 1;
  border: 1px solid rgba(255,255,255,0.24); border-radius: 16px;
  box-shadow: inset 0 0 0 4px rgba(255,255,255,0.04);
  padding: 36px 32px 28px; text-align: center;
}
.bn-corner { position: absolute; width: 16px; height: 16px; opacity: 0.75; }
.bn-corner--tl { top: 8px; left: 8px; border-top: 2px solid #4da3ff; border-left: 2px solid #4da3ff; border-top-left-radius: 6px; }
.bn-corner--tr { top: 8px; right: 8px; border-top: 2px solid #4da3ff; border-right: 2px solid #4da3ff; border-top-right-radius: 6px; }
.bn-corner--bl { bottom: 8px; left: 8px; border-bottom: 2px solid #4da3ff; border-left: 2px solid #4da3ff; border-bottom-left-radius: 6px; }
.bn-corner--br { bottom: 8px; right: 8px; border-bottom: 2px solid #4da3ff; border-right: 2px solid #4da3ff; border-bottom-right-radius: 6px; }
.bn-cert-logo { height: 34px; margin: 0 auto 18px; display: block; }
.bn-cert-kicker { font-size: 10px; font-weight: 700; letter-spacing: 0.30em; color: #4da3ff; margin-bottom: 8px; }
.bn-cert-course {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 19px; font-weight: 600; color: #fff; margin-bottom: 18px;
}
.bn-cert-grant { font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.40); margin-bottom: 10px; }
.bn-cert-nameline { border-bottom: 1px solid rgba(255,255,255,0.30); max-width: 260px; margin: 0 auto 8px; padding-bottom: 7px; }
.bn-cert-name {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 24px; font-style: italic; color: rgba(255,255,255,0.94);
  letter-spacing: 0.01em;
}
.bn-cert-text { font-size: 12px; color: rgba(255,255,255,0.55); line-height: 1.55; max-width: 300px; margin: 0 auto 26px; }
.bn-cert-foot {
  display: flex; align-items: flex-end; justify-content: space-between;
  /* El sello llegaba a tocar la esquina decorativa de abajo */
  padding: 0 4px 6px;
}
.bn-cert-sig { text-align: left; }
.bn-cert-sigline { display: block; width: 110px; border-bottom: 1px solid rgba(255,255,255,0.35); margin-bottom: 5px; }
.bn-cert-siglabel { font-size: 10px; color: rgba(255,255,255,0.45); }
.bn-cert-level {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 13px; font-weight: 700; letter-spacing: 0.08em;
  color: rgba(255,255,255,0.55);
  border: 1px solid rgba(255,255,255,0.22); border-radius: 999px;
  padding: 4px 13px; margin-bottom: 4px;
}

.bn-cert-seal-wrap { position: relative; width: 56px; height: 56px; }
.bn-cert-seal-ring {
  position: absolute; inset: -5px;
  border: 1px dashed rgba(77,163,255,0.55); border-radius: 50%;
}
.bn-cert-seal {
  width: 56px; height: 56px; border-radius: 50%;
  background: linear-gradient(135deg, #4da3ff, #0b6df0);
  display: flex; align-items: center; justify-content: center;
  box-shadow: none;
}
.bn-cert-caption { text-align: center; margin-top: 24px; font-size: 14.5px; color: #101336; position: relative; }


/* ══════════════════════════════════════════════════════════════
   Responsive
══════════════════════════════════════════════════════════════ */


/* Interior del diploma. Ya no hay 16/9 que respetar: el bloque ocupa
   media columna como los demás bonus y crece con su contenido, así
   que sólo hace falta apretar los tamaños. */
.bn-cert-border {
  display: flex; flex-direction: column;
  padding: clamp(14px, 2.2vw, 22px) clamp(16px, 2.6vw, 26px) !important;
  gap: 6px;
}
.bn-cert-head { margin-bottom: 0 !important; }
.bn-cert-logo { height: clamp(18px, 2vw, 26px) !important; }
.bn-cert-kicker { font-size: clamp(7px, 0.75vw, 9px) !important; margin: 4px 0 !important; letter-spacing: .18em !important; }
.bn-cert-course { font-size: clamp(13px, 1.5vw, 19px) !important; margin: 0 !important; }
.bn-cert-grant { font-size: clamp(8px, 0.85vw, 10px) !important; margin: 2px 0 0 !important; }
.bn-cert-nameline { margin: 0 !important; padding-bottom: 4px !important; }
.bn-cert-name { font-size: clamp(16px, 2vw, 25px) !important; }
.bn-cert-text { font-size: clamp(8.5px, 0.9vw, 11px) !important; margin: 2px 0 0 !important; }
.bn-cert-foot { margin-top: 0 !important; padding-top: 0 !important; align-items: flex-end; }
.bn-cert-seal { width: clamp(30px, 3.6vw, 44px) !important; height: clamp(30px, 3.6vw, 44px) !important; }
.bn-cert-seal svg { width: 55% !important; height: 55% !important; }
.bn-cert-seal-ring { inset: -5px !important; }
.bn-cert-level { font-size: clamp(9px, 1vw, 12px) !important; padding: 3px 10px !important; }
.bn-cert-sigline { width: clamp(48px, 6vw, 88px) !important; }
.bn-cert-siglabel { font-size: clamp(6.5px, 0.7vw, 8.5px) !important; }

@media (max-width: 760px) {
  .bn-cert-border { gap: 7px; }
}

@media (max-width: 400px) {
 .bn-cert-level { display: none; }
}

