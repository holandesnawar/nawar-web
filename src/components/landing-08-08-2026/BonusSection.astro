/* ── Certificado ── */
.bn-cert-col { position: relative; }
.bn-cert-halo {
  position: absolute; inset: -12% -14%;
  background: radial-gradient(ellipse at center, rgba(11,109,240,0.14) 0%, transparent 62%);
  pointer-events: none;
}
.bn-cert {
  position: relative;
  background: #1D0084; border-radius: 20px; padding: 10px;
  overflow: hidden;
  background-image: radial-gradient(circle, rgba(255,255,255,0.06) 1px, transparent 1px),
    radial-gradient(circle 480px at 100% 0%, rgba(11,109,240,0.42) 0%, transparent 65%),
    radial-gradient(circle 380px at 0% 100%, rgba(11,109,240,0.20) 0%, transparent 65%);
  background-size: 28px 28px, auto, auto;
}
/* El diploma no se mueve; lo que se mueve es el color: una mancha
   azul que va y viene por dentro y un brillo que lo cruza.
   Van en bucle y no colgando de :hover, porque en el móvil el hover
   no existe y allí el efecto no se veía nunca. Arrancan al entrar en
   pantalla: la fila lleva .sr y el observador del layout le pone
   .vis, así que la animación empieza justo al llegar scrolleando. */
.bn-cert::after {
  content: ''; position: absolute; inset: -45%; z-index: 0; pointer-events: none;
  background: radial-gradient(circle at 32% 28%, rgba(77,163,255,0.55) 0%, transparent 55%);
  opacity: .5;
  transform: translate3d(-7%, -7%, 0);
}
.bn-row.vis .bn-cert::after { animation: bn-cert-glow 4.5s ease-in-out infinite alternate; }
@keyframes bn-cert-glow {
  from { transform: translate3d(-7%, -7%, 0)  scale(1);    opacity: .45; }
  to   { transform: translate3d(16%, 13%, 0)  scale(1.12); opacity: .95; }
}
.bn-cert-sheen {
  position: absolute; inset: 0; pointer-events: none; z-index: 2;
  background: linear-gradient(115deg, transparent 38%, rgba(255,255,255,0.16) 50%, transparent 62%);
  transform: translateX(-130%);
}
/* De una pasada cada 6,5 s a una cada 3,6 s, y la pasada ocupa más
   parte del ciclo (el 44 % en vez del 45 % de un ciclo casi doble):
   antes el brillo cruzaba en menos de tres segundos y luego se
   quedaba casi cuatro parado fuera de cuadro, así que en la práctica
   casi nunca coincidía con que estuvieras mirando. */
.bn-row.vis .bn-cert-sheen { animation: bn-cert-sheen 3.6s ease-in-out 0.4s infinite; }
@keyframes bn-cert-sheen {
  0%   { transform: translateX(-130%); }
  44%  { transform: translateX(130%); }
  100% { transform: translateX(130%); }
}
@media (prefers-reduced-motion: reduce) {
  .bn-row.vis .bn-cert::after,
  .bn-row.vis .bn-cert-sheen { animation: none; }
}
