---
/**
 * blackfriday.holandesnawar.com/bedrijven — la página del ebook de Black
 * Friday («Holandés sin miedo», 1 €) EN NEERLANDÉS, para EMPRESAS (10/11/2026,
 * usuario: "una página como la del ebook pero en neerlandés completa, con
 * Black Friday, para usar ese link estilo B2B").
 *
 * COPIA de EbookBF.astro con los textos en neerlandés y dirigidos al
 * empresario: el ebook explica el neerlandés EN ESPAÑOL, para sus empleados
 * hispanohablantes. Misma compra (la escuela, /api/v1/ebook/pago, 1 €), mismo
 * diseño y mismas piezas. Si se cambia la página del ebook, mirar si traerlo.
 *
 * Diferencias con la española:
 *  - Sin «Oferta desbloqueada» (aquí no se llega desde la portada de la lista).
 *  - Al pagar, Stripe vuelve AQUÍ (?compra=…) y la página dice «Bedankt»; no
 *    a /oferta, que es la formación en español para el alumno.
 *  - Las opiniones son las mismas de lectores reales, traducidas, y lo dice.
 *  - Condiciones de Black Friday para equipos: sin cifra (decisión del
 *    usuario): se cuentan por WhatsApp.
 * ⚠️ El correo con el PDF, el recibo y la caja de Stripe salen en español.
 */
import Layout from '../../layouts/Layout.astro'
import FAQNuevo from '../FAQNuevo.astro'
import { icono } from './iconos'
import PieLegal from './PieLegal.astro'
import LibroAnimado from './LibroAnimado.astro'
import {
  BF_HASTA_TEXTO, EBOOK_LECTORES, EBOOK_MOCKUP, EBOOK_MOCKUP_ABIERTO, EBOOK_NOMBRE, EBOOK_PAGINAS, EBOOK_PAGINAS_TXT, EBOOK_PRECIO, EBOOK_PRECIO_NORMAL, EBOOK_SUB,
} from '../../lib/blackFriday'
import '../../styles/nawar-sections.css'
import '../../styles/fuentes-locales.css'
import '../../styles/black-friday.css'

interface Props {
  canal: 'organico' | 'ads'
}
const { canal } = Astro.props

const LOGO = 'https://d1yei2z3i6k35z.cloudfront.net/9533860/671a9c9265e23_Logo_Nawar_2.png'
const WWW = 'https://www.holandesnawar.com'
const PRECIO = `€ ${EBOOK_PRECIO}`
const euros = (n: number) => `€ ${n.toLocaleString('nl-NL', { minimumFractionDigits: Number.isInteger(n) ? 0 : 2 })}`
const PRECIO_NORMAL = euros(EBOOK_PRECIO_NORMAL)
/** −92 %: lo que se ahorra sobre el precio de siempre. */
const DESCUENTO = Math.round((1 - EBOOK_PRECIO / EBOOK_PRECIO_NORMAL) * 100)

const WHATSAPP = '31616084212'
const WA = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent('Hallo! Ik wil meer weten over het ebook en de Black Friday-voorwaarden voor mijn team.')}`

const BULLETS = [
  `${EBOOK_PAGINAS} pagina's in pdf, uitgelegd in het Spaans`,
  'Oefeningen bij elk onderwerp, met alle antwoorden',
  'Binnen een minuut in je mailbox en voor altijd van jou',
]

/**
 * Las caras de quien ya lo tiene: las iniciales de las tres opiniones de
 * abajo, que son de lectores de verdad. ⚠️ Nada de fotos de banco: junto a
 * «ya lo tienen» serían clientes inventados. Con fotos de verdad (y su
 * permiso), van en `foto`.
 */
const CARAS = [
  { ini: 'D', foto: '', color: '#4da3ff' },
  { ini: 'M', foto: '', color: '#5ad1c5' },
  { ini: 'L', foto: '', color: '#8e9cff' },
  { ini: '+', foto: '', color: '#025dc7' },
]

/**
 * «Todo lo que te llevas por 1 €». Solo cosas que se entregan de verdad: el
 * único precio es el del ebook (el de su página); lo demás va «incluido».
 */
const PILA = [
  { ico: '📘', t: `Het ebook «${EBOOK_NOMBRE}»`, d: `${EBOOK_PAGINAS} pagina's in pdf om vanaf nul te beginnen, niveau A0-A1.`, v: PRECIO_NORMAL },
  { ico: '✍️', t: 'Oefeningen met alle antwoorden', d: 'Bij elk onderwerp, om zelfstandig te oefenen en te controleren.', v: 'Inbegrepen' },
  { ico: '💬', t: 'Zinnen en woorden voor elke dag', d: 'De basis om zich op de werkvloer te redden, vertaald en uitgelegd.', v: 'Inbegrepen' },
  { ico: '♾️', t: 'Voor altijd beschikbaar', d: 'Op telefoon, tablet, laptop of geprint.', v: 'Inbegrepen' },
  { ico: '🎁', t: 'Bonus: Black Friday-voorwaarden voor je team', d: 'Wil je dat je hele team Nederlands leert? Vraag naar de speciale Black Friday-voorwaarden voor bedrijven.', v: 'Bonus', bonus: true },
]

/** La cinta que pasa bajo la cabecera. */
const CINTA = [
  `${EBOOK_PAGINAS} pagina's`,
  'Uitgelegd in het Spaans',
  'Oefeningen met antwoorden',
  'Voor altijd van jou',
  `Black Friday: −${DESCUENTO}%`,
  'Direct te downloaden',
]

const paraTi = [
  { icon: '🌱', title: 'Je medewerkers beginnen bij nul', desc: 'Ze spreken Spaans en nog (bijna) geen Nederlands. Dit ebook geeft ze een heldere start, uitgelegd in hun eigen taal.' },
  { icon: '🛠️', title: 'Ze moeten zich op het werk redden', desc: 'Begroeten, zich voorstellen, getallen, de basiszinnen: de eerste stap naar instructies en collega’s begrijpen.' },
  { icon: '🤝', title: 'Je wilt laten zien dat je ze steunt', desc: 'Voor € 1 per persoon geef je ze iets concreets om mee te beginnen. Klein gebaar, groot verschil in het team.' },
]

const incluye = [
  `${EBOOK_PAGINAS} pagina's met de basis van de Nederlandse grammatica`,
  'Essentiële woordenschat in elke les',
  'Praktische oefeningen aan het eind van elke les',
  'Alle uitleg en vertalingen in het Spaans',
  'Antwoorden op alle oefeningen',
  'Levenslang toegang in pdf, op elk apparaat',
]

/**
 * «Así es por dentro»: tres dobles páginas de verdad (fotogramas del vídeo de
 * la cabecera, sobre #F0F5FF). Los títulos son los que llevan esas páginas.
 */
const DENTRO = [
  { img: '/img/black-friday/por-dentro-1.webp', alt: 'Pagina’s «Hoe gebruik je dit boek» en «Klanken»', t: 'De klanken', d: 'Hoe lettercombinaties klinken, met voorbeelden: kaas → queso, lezen → leer.' },
  { img: '/img/black-friday/por-dentro-2.webp', alt: 'Pagina’s «De familie» en «Onbepaalde lidwoorden»', t: 'De familie en het lidwoord «een»', d: 'Familiewoorden in een stamboom en wanneer je «een» gebruikt, met een belangrijke tip.' },
  { img: '/img/black-friday/por-dentro-3.webp', alt: 'Pagina’s «De nummers» en «Hebben en zijn»', t: 'De getallen en hebben / zijn', d: 'De getallen, de vervoeging in een tabel en herhalingsoefeningen.' },
]

const ebookTestimonials = [
  // 02/11, noche (usuario: "quita los dos puntos y que suene más cotidiano,
  // nada de «me gustó especialmente que incluye», suena a chatbot"): lo mismo
  // que dijo cada uno, dicho como se habla.
  // Las mismas opiniones de lectores reales de la página española, traducidas
  // (la sección lo dice: «vertaald uit het Spaans»).
  { name: 'Daniel Jiménez', stars: 5, title: 'Helder en goed georganiseerd', text: 'Heel duidelijk en goed opgebouwd als je net met Nederlands begint. Het wordt simpel uitgelegd, met voorbeelden die je meteen snapt. Dank je!' },
  { name: 'Manuel Gutiérrez', stars: 5, title: 'Vanaf dag één bruikbaar', text: 'Met voorbeelden uit het dagelijks leven, en wat je leert kun je bijna meteen gebruiken. De oefeningen dwingen je te oefenen, en dat is fijn als je begint.' },
  { name: 'Lorena Gómez', stars: 5, title: 'Beginnen zonder frustratie', text: 'Ideaal als je net met de taal begint. Je krijgt precies genoeg om te starten en verder te komen zonder gefrustreerd te raken.' },
]

const faqEbook = {
  badge: 'Vragen?',
  title: 'Veelgestelde vragen',
  items: [
    { question: 'In welke taal is het ebook?', answer: 'Het ebook leert Nederlands, maar alle uitleg en vertalingen zijn in het Spaans. Het is gemaakt voor Spaanstaligen die bij nul beginnen, zonder omweg via het Engels.' },
    { question: 'Voor wie is het?', answer: 'Voor Spaanstalige medewerkers die net beginnen met Nederlands (niveau A0-A1), of die de basis willen opfrissen.' },
    { question: 'Wat staat erin?', answer: `${EBOOK_PAGINAS} pagina's in 7 lessen met de basisgrammatica, de belangrijkste woorden en zinnen voor elke dag. Elke les eindigt met oefeningen, en achterin staan alle antwoorden.` },
    { question: 'Ik heb meerdere medewerkers. Hoe werkt dat?', answer: 'Elke aankoop is één ebook voor één persoon, op naam en e-mailadres van de lezer. Je kunt je medewerkers deze pagina sturen, of ons een bericht sturen: dan regelen we het voor je hele team.' },
    { question: 'Hoe ontvang je het?', answer: `Direct na de betaling komt er een e-mail met de link om «${EBOOK_NOMBRE}» als pdf te downloaden. Die e-mail is in het Spaans, net als het ebook. Niet ontvangen? Kijk in je spam of promoties.` },
    { question: 'Waarom kost het maar € 1?', answer: `Het is onze Black Friday-actie (de normale prijs is ${PRECIO_NORMAL}). Alleen tot maandag 30 november.` },
    { question: 'Hoe kan ik betalen?', answer: 'Met creditcard, iDEAL of Bancontact, in een beveiligde betaalomgeving zonder deze pagina te verlaten. Je krijgt een betaalbewijs per e-mail.' },
    { question: 'Kan mijn hele team Nederlands leren?', answer: 'Ja. Naast het ebook hebben we een complete opleiding van nul tot A1 in 16 weken, uitgelegd in het Spaans, met live lessen en conversatiegroepen. Voor bedrijven gelden er tijdens Black Friday speciale voorwaarden: stuur ons een bericht.' },
    { question: 'Hoe neem ik contact op?', answer: 'Mail naar info@holandesnawar.com of stuur ons een bericht via WhatsApp.' },
  ],
}

const flecha = `<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>`
const check = `<svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>`
---

<Layout
  fuentesLocales
  lang="nl"
  title={`${EBOOK_NOMBRE} · Nederlands voor je Spaanstalige medewerkers voor ${PRECIO} — Black Friday | Holandés Nawar`}
  description={`Het ebook «${EBOOK_NOMBRE}»: ${EBOOK_PAGINAS} pagina's Nederlands vanaf nul, uitgelegd in het Spaans. Voor ${PRECIO}, alleen tijdens Black Friday.`}
  noindex={true}
>
  <div class="eb" data-canal={canal}>
    <!-- Al volver de pagar (?compra=cs_…): «Bedankt», sin parpadeo. -->
    <script is:inline>
      (function () {
        try {
          if (/^cs_/.test(new URLSearchParams(location.search).get('compra') || '')) {
            document.documentElement.classList.add('bz-gekocht')
          }
        } catch (e) {}
      })()
    </script>
    <!-- ════ NAVBAR: logo + comprar ════ -->
    <header class="ebook-nav" id="ebook-nav">
      <div class="ebook-nav-inner">
        <!-- Sin enlace a la home (03/11, usuario): no se sale del embudo por el logo. -->
        <span class="ebook-nav-logo">
          <img src={LOGO} alt="Holandés Nawar" />
        </span>
        <button type="button" class="ebook-nav-cta bf-solo-activa" data-bf-comprar>
          Bestel voor {PRECIO}
          <Fragment set:html={flecha} />
        </button>
      </div>
    </header>

    <!-- ════ HERO: Black Friday ════ -->
    <section class="ebook-hero" data-navbar="dark">
      <div class="ebook-hero-glow1" aria-hidden="true"></div>
      <div class="ebook-hero-glow2" aria-hidden="true"></div>
      <div class="dots-dark" aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;opacity:0.5;"></div>

      <div class="ebook-hero-wrap">
        <div class="ebook-hero-text">
          <p class="bz-bedankt h-anim" style="--hd:0.04s">
            <span class="eb-desbloq-ico" set:html={icono('check', 13, 3)} />
            <span><strong>Bedankt!</strong> Het ebook is onderweg naar de mailbox. Niet ontvangen? Kijk in de spam.</span>
          </p>
          <span class="badge-dark h-anim" style="--hd:0.08s">
            <span class="eb-punto" aria-hidden="true"></span>
            Black Friday · Voor bedrijven
          </span>

          <h1 class="hero-title h-anim" style="--hd:0.18s">
            <span class="hero-title-gradient">Nederlands voor je team</span>
            <em>voor minder dan een koffie.</em>
          </h1>

          <p class="hero-sub h-anim" style="--hd:0.28s">
            Geef je Spaanstalige medewerkers een vliegende start. «{EBOOK_NOMBRE}»: {EBOOK_PAGINAS_TXT} pagina's Nederlands
            vanaf nul, met grammatica, woordenschat en oefeningen uitgelegd in hun eigen taal.
          </p>

          <!-- El precio: el de siempre tachado (es el de verdad, el de /ebook-a0-a1). -->
          <div class="eb-precio h-anim bf-solo-activa" style="--hd:0.34s">
            <div class="eb-precio-fila">
              <span class="eb-precio-ya">{PRECIO}</span>
              <span class="eb-precio-antes"><s>{PRECIO_NORMAL}</s><small>normale prijs</small></span>
              <span class="eb-precio-dto">−{DESCUENTO}&nbsp;%</span>
            </div>
            <p class="eb-precio-hasta">Black Friday-prijs per medewerker</p>
          </div>

          <ul class="hero-bullets h-anim" style="--hd:0.4s">
            {BULLETS.map((b) => <li><span class="hero-check" set:html={check} />{b}</li>)}
          </ul>

          <div class="eb-cta-fila h-anim bf-solo-activa" style="--hd:0.48s">
            <button type="button" class="ebook-cta-primary ebook-cta-big bf-brillo" data-bf-comprar>
              Bestel voor {PRECIO}
              <Fragment set:html={flecha} />
            </button>
            <!-- La nota a mano: la flecha sale del texto y su punta se queda en el
                 borde del botón, a media altura (31/10: "no señala justo al botón"). -->
            <span class="eb-mano" aria-hidden="true">
              <svg class="eb-mano-flecha" viewBox="0 0 56 44" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M53 7C40 5 24 22 6 26" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                <path d="M14 19L5.5 26 15 31" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="eb-mano-txt">nog vandaag!</span>
            </span>
          </div>

          <!-- Quien ya lo tiene. -->
          <div class="eb-caras h-anim" style="--hd:0.58s">
            <span class="eb-caras-fila" aria-hidden="true">
              {CARAS.map((c) => (
                <span class="eb-cara" style={`--c:${c.color}`}>{c.foto ? <img src={c.foto} alt="" /> : c.ini}</span>
              ))}
            </span>
            <span class="eb-caras-txt">
              <span class="eb-estrellas" aria-label="5 van 5 sterren">★★★★★</span>
              Al meer dan 100 lezers
            </span>
          </div>

          <div class="eb-fin bf-fin">
            <p><strong>De Black Friday-actie is afgelopen.</strong> Wil je je team toch laten starten? Stuur ons een bericht.</p>
            <a class="ebook-cta-primary" href={WA} target="_blank" rel="noopener">Stuur een bericht <Fragment set:html={flecha} /></a>
          </div>
        </div>

        <!-- El libro que se abre y pasa las hojas, en bucle (30/10, usuario:
             "mete esto en la columna derecha… en bucle, queda muy guapo").
             Desde el 02/11 no es un vídeo: es la animación de Claude Design
             dibujada por el navegador, con fondo transparente
             (LibroAnimado.astro). -->
        <div class="ebook-hero-visual h-anim" style="--hd:0.2s">
          <div class="eb-libro">
            <LibroAnimado etiqueta={`${EBOOK_NOMBRE}: de voorkant en de pagina's van het boek`} />
            <span class="eb-sello bf-solo-activa" aria-hidden="true">
              <small>Black Friday</small>
              <span class="eb-sello-fila"><b>{PRECIO}</b><s>{PRECIO_NORMAL}</s></span>
            </span>
            <div class="float-badge fb-top">
              <span class="eb-fb-ico" set:html={icono('libro', 18, 2)} />
              <div>
                <p>{EBOOK_PAGINAS} pagina's</p>
                <p>in pdf, voor altijd</p>
              </div>
            </div>
            <div class="float-badge fb-bot">
              <span class="eb-fb-ico" set:html={icono('idioma', 18, 2)} />
              <div>
                <p>Uitleg in het Spaans</p>
                <p>Voor Spaanstaligen</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════ La cinta: lo que te llevas, pasando ════ -->
    <div class="eb-cinta" aria-hidden="true">
      <div class="eb-cinta-pista">
        {[0, 1].map(() => (
          <span class="eb-cinta-grupo">
            {CINTA.map((t) => <span class="eb-cinta-item"><i>✦</i>{t}</span>)}
          </span>
        ))}
      </div>
    </div>

    <!-- ════ OPINIONES (light) ════ -->
    <section id="opiniones" class="section-light ebook-testimonials" data-navbar="light">
      <div class="dots-light" aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;opacity:0.5;"></div>
      <div class="inner" style="position:relative;z-index:1;">
        <div class="ebook-test-header">
          <span class="badge-light">Echte lezers</span>
          <h2 class="title" style="color:#1D0084;margin:0;">Dit zeggen lezers van het ebook</h2>
          <p class="bz-vertaald">Vertaald uit het Spaans</p>
        </div>
        <div class="ebook-test-grid">
          {ebookTestimonials.map((t) => (
            <article class="ebook-test-card sr-s">
              <div class="ebook-test-head">
                <p class="ebook-test-name"><span class="eb-cara eb-cara-op" aria-hidden="true">{t.name.charAt(0)}</span>{t.name}</p>
                <div class="ebook-test-stars" aria-label={`${t.stars} van 5 sterren`}>
                  {Array.from({ length: t.stars }).map(() => (
                    <svg viewBox="0 0 20 20" fill="#F58220" width="14" height="14">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  ))}
                </div>
              </div>
              <p class="ebook-test-title">{t.title}</p>
              <p class="ebook-test-text">{t.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ════ TODO LO QUE TE LLEVAS POR 1 € (light) ════ -->
    <section class="section-light eb-pila-sec" data-navbar="light">
      <div class="inner">
        <div class="eb-pila-cab">
          <span class="badge-light">Black Friday</span>
          <h2 class="title" style="color:#1D0084;margin:0;">Dit krijgen ze <span class="eb-pila-acento">voor {PRECIO}</span></h2>
        </div>
        <div class="eb-pila">
          <ul class="eb-pila-lista">
            {PILA.map((p) => (
              <li class:list={['eb-pila-item sr-s', { 'eb-pila-bonus': p.bonus }]}>
                <span class="eb-pila-ico" aria-hidden="true">{p.ico}</span>
                <span class="eb-pila-txt"><b>{p.t}</b><span>{p.d}</span></span>
                <span class="eb-pila-valor">{p.v}</span>
              </li>
            ))}
          </ul>
          <div class="eb-pila-total">
            <div class="eb-pila-total-fila">
              <span>Normale prijs</span>
              <s>{PRECIO_NORMAL}</s>
            </div>
            <div class="eb-pila-total-fila eb-pila-hoy">
              <span>Black Friday-prijs</span>
              <b>{PRECIO}</b>
            </div>
            <div class="bf-solo-activa eb-pila-cta">
              <button type="button" class="ebook-cta-primary ebook-cta-big bf-brillo" data-bf-comprar>
                Bestel voor {PRECIO}
                <Fragment set:html={flecha} />
              </button>
              <!-- Dos líneas centradas, el candado dentro de la primera (02/11:
                   "que esté recto y en dos párrafos… el candado a la izquierda
                   queda raro"). -->
              <p class="eb-pila-nota">
                <span class="eb-pila-nota-1"><Fragment set:html={icono('candado', 14, 2)} />Veilig betalen met creditcard, iDEAL of Bancontact</span>
                <span>Direct te downloaden</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════ PARA TI SI… (dark) ════ -->
    <section class="section-dark py-section" data-navbar="dark" style="position:relative;overflow:hidden;">
      <div class="hero-glow1" aria-hidden="true" style="top:-160px;right:-100px;"></div>
      <div class="dots-dark" aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;opacity:0.6;"></div>
      <div class="inner" style="position:relative;z-index:1;">
        <div class="ebook-para-header">
          <span class="badge-dark">Voor jouw bedrijf</span>
          <h2 class="title" style="margin-bottom:0;">
            <span class="text-gradient-white">Dit ebook is iets voor jou</span><br class="hidden md:block" />
            <span style="color:#4da3ff;-webkit-text-fill-color:#4da3ff;">als je dit herkent</span>
          </h2>
        </div>
        <div class="ebook-para-grid">
          {paraTi.map((p) => (
            <article class="ebook-para-card sr">
              <div class="ebook-para-icon">{p.icon}</div>
              <h3 class="ebook-para-title">{p.title}</h3>
              <p class="ebook-para-desc">{p.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ════ ASÍ ES POR DENTRO (light) ════
         31/10, usuario: "queda un poco corta… algo sobre las lecciones para
         convencer más". Tres dobles páginas DE VERDAD del libro, sacadas del
         vídeo de la cabecera (public/img/black-friday/por-dentro-*.webp), con
         su tema. Nada inventado: los títulos son los de esas páginas. -->
    <section class="section-light eb-dentro-sec" data-navbar="light">
      <div class="inner">
        <div class="eb-pila-cab">
          <span class="badge-light">Een kijkje binnen</span>
          <h2 class="title eb-dentro-titulo" style="color:#1D0084;margin:0;">Zo zien de pagina's van <span class="eb-nowrap">«{EBOOK_NOMBRE}»</span> eruit</h2>
          <p class="eb-dentro-sub">Heldere uitleg, vertaalde voorbeelden en oefeningen om te herhalen. Alles in het Spaans.</p>
        </div>
        <div class="eb-dentro">
          {DENTRO.map((d) => (
            <figure class="eb-dentro-item sr-s">
              <div class="eb-dentro-foto"><img src={d.img} alt={d.alt} width="784" height="557" loading="lazy" decoding="async" /></div>
              <figcaption><b>{d.t}</b><span>{d.d}</span></figcaption>
            </figure>
          ))}
        </div>
        <div class="bf-solo-activa eb-dentro-cta">
          <button type="button" class="ebook-cta-primary ebook-cta-big bf-brillo" data-bf-comprar>
            Bestel voor {PRECIO}
            <Fragment set:html={flecha} />
          </button>
        </div>
      </div>
    </section>

    <!-- ════ QUÉ INCLUYE + comprar ════ -->
    <section id="que-incluye" class="section-dark py-section" data-navbar="dark" style="position:relative;overflow:hidden;">
      <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:1000px;height:700px;background:radial-gradient(ellipse at center,rgba(11,109,240,0.30) 0%,transparent 65%);pointer-events:none;" aria-hidden="true"></div>
      <div class="inner" style="position:relative;z-index:1;">
        <div class="ebook-incluye-grid">
          <div class="ebook-incluye-img-wrap sr">
            <img src={EBOOK_MOCKUP_ABIERTO} alt="Het ebook opengeslagen, met de inhoud in het Spaans en het Nederlands" class="ebook-incluye-img" loading="lazy" decoding="async" />
          </div>
          <div class="ebook-incluye-text sr d1">
            <span class="badge-dark">Wat staat erin?</span>
            <h2 class="value-title">
              <span class="text-gradient-white">Alles wat ze nodig hebben</span><br class="eb-br-pc" />
              <span style="color:#4da3ff;-webkit-text-fill-color:#4da3ff;">voor niveau A0 – A1</span>
            </h2>
            <ul class="ebook-incluye-list">
              {incluye.map((item) => (
                <li><span class="ebook-incluye-check" set:html={check} /><span>{item}</span></li>
              ))}
            </ul>
            <div class="ebook-incluye-cta bf-solo-activa">
              <button type="button" class="ebook-cta-primary ebook-cta-big bf-brillo" data-bf-comprar>
                Bestel voor {PRECIO}
                <Fragment set:html={flecha} />
              </button>
              <p class="ebook-incluye-note">Black Friday-prijs · Direct te downloaden als pdf</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════ FAQ ════ -->
    <FAQNuevo data={faqEbook} />

    <!-- ════ CIERRE + pie ════ -->
    <section class="section-dark eb-cierre" data-navbar="dark">
      <div class="hero-glow1" aria-hidden="true" style="top:-200px;left:50%;transform:translateX(-50%);"></div>
      <div class="dots-dark" aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;opacity:0.5;"></div>
      <div class="inner eb-cierre-in">
        <span class="badge-dark">Black Friday</span>
        <h2 class="title" style="margin:0;">
          <span class="text-gradient-white">Laat je team vandaag starten,</span>
          <span style="color:#4da3ff;-webkit-text-fill-color:#4da3ff;white-space:nowrap;">voor {PRECIO}</span>
        </h2>
        <div class="bz-slot-regels">
          <p>«{EBOOK_NOMBRE}», {EBOOK_PAGINAS_TXT} pagina's.</p>
          <p>Binnen een minuut in de mailbox.</p>
          <p class="bf-solo-activa">Normaal <s>{PRECIO_NORMAL}</s>, nu {PRECIO}.</p>
        </div>
        <p class="bz-team">Voor je hele team?<br /><a href={WA} target="_blank" rel="noopener">Vraag naar de Black Friday-voorwaarden voor bedrijven</a></p>
        <div class="bf-solo-activa">
          <button type="button" class="ebook-cta-primary ebook-cta-big" data-bf-comprar>
            Bestel voor {PRECIO}
            <Fragment set:html={flecha} />
          </button>
        </div>
        <div class="eb-fin bf-fin">
          <p><strong>De Black Friday-actie is afgelopen.</strong></p>
          <a class="ebook-cta-primary" href={WA} target="_blank" rel="noopener">Stuur een bericht <Fragment set:html={flecha} /></a>
        </div>
      </div>
      <!-- El pie de /formacion-nawar, como /oferta (30/10, usuario: "igual para el ebook"). -->
      <PieLegal fondo="oscuro" lang="nl" />
    </section>

    <!-- ════ La compra: datos y la caja de Stripe, en una ventana ════ -->
    <div class="eb-modal" id="eb-modal" hidden>
      <div class="eb-modal-fondo" data-cerrar></div>
      <div class="eb-modal-caja" role="dialog" aria-modal="true" aria-labelledby="eb-modal-titulo">
        <div class="eb-modal-barra">
          <span class="eb-modal-seguro"><Fragment set:html={icono('candado', 15, 2)} />Veilig betalen</span>
          <button type="button" class="eb-modal-x" data-cerrar aria-label="Sluiten">×</button>
        </div>

        <div class="eb-resumen">
          <img class="eb-resumen-foto" src={EBOOK_MOCKUP} alt="" aria-hidden="true" onerror="this.remove()" />
          <div class="eb-resumen-txt">
            <b>{EBOOK_NOMBRE}</b>
            <span>Ebook A0-A1 in pdf · {EBOOK_PAGINAS} pagina's</span>
          </div>
          <span class="eb-resumen-precios"><b class="eb-resumen-precio">{PRECIO}</b><s>{PRECIO_NORMAL}</s></span>
        </div>

        <form class="eb-paso" data-paso="datos" id="eb-form" novalidate>
          <h2 class="eb-modal-titulo" id="eb-modal-titulo">Voor wie is het ebook?</h2>
          <p class="eb-modal-lead">Vul de naam en het e-mailadres in van de medewerker die het gaat lezen. Het komt direct na de betaling binnen.</p>
          <div class="eb-hp" aria-hidden="true"><label>Niet invullen <input type="text" name="website" id="eb-hp" tabindex="-1" autocomplete="off" /></label></div>
          <label class="eb-label" for="eb-nombre">Naam</label>
          <input id="eb-nombre" class="eb-input" type="text" autocomplete="off" placeholder="Naam van de lezer" required />
          <label class="eb-label" for="eb-email">E-mailadres</label>
          <input id="eb-email" class="eb-input" type="email" autocomplete="off" placeholder="naam@voorbeeld.nl" required />
          <p class="eb-err" id="eb-err" role="alert"></p>
          <button type="submit" class="bf-btn eb-ir" id="eb-ir">Naar veilig betalen <Fragment set:html={icono('flecha', 16, 2.5)} /></button>
          <p class="eb-legal">
            Met je bestelling ga je akkoord met het <a href={`${WWW}/politica-de-privacidad`} target="_blank" rel="noopener">privacybeleid</a>.
            De lezer ontvangt het ebook en onze e-mails (in het Spaans) en kan zich altijd afmelden.
          </p>
        </form>

        <div class="eb-paso" data-paso="pago" hidden>
          <div class="eb-pagando">
            <span>Voor <b id="eb-quien"></b></span>
            <button type="button" class="eb-cambiar" id="eb-cambiar">Wijzigen</button>
          </div>
          <!-- 29/10: el WhatsApp ya no se pide en la portada; lo pide aquí la
               caja de Stripe, con el nombre de «Teléfono». El aviso que había
               encima («En Teléfono, pon el número con el que usas
               WhatsApp…») se quitó el 02/11 por la noche: "queda feo". -->
          <div class="eb-stripe" id="eb-stripe"><p class="eb-cargando">Veilige betaling laden…</p></div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { leerUTM, guardarUTM } from '../../lib/utm'
  import { contextoDelLead } from '../../lib/recorrido'
  import { CLAVE_DATOS, type DatosAdmision } from '../../lib/admision'
  import { CLAVE_DESBLOQUEADA, EBOOK_PRECIO, META_EBOOK, arrancarCuentaAtras, bfRuta, bfTerminado, datoDeLaDireccion } from '../../lib/blackFriday'
  import { ESCUELA_URL } from '../../lib/escuela'
  guardarUTM()
  // Sin cuenta atrás en la página: solo pone `bf-terminado` en <html> pasado
  // el lunes 30, para esconder los botones de compra.
  arrancarCuentaAtras()

  const raiz = document.querySelector<HTMLElement>('.eb') as HTMLElement
  const canal = raiz.dataset.canal === 'ads' ? 'ads' : 'organico'
  const fbq = (...a: unknown[]) => { try { (window as any).fbq?.(...a) } catch {} }
  fbq('track', 'ViewContent', { content_name: META_EBOOK, value: EBOOK_PRECIO, currency: 'EUR' })

  // ── La barra de arriba: transparente arriba del todo y azul en cuanto se
  //    baja un poco, sobre cualquier sección. (02/11: antes se volvía
  //    transparente sobre las secciones oscuras y el texto de la cabecera
  //    pasaba por debajo del logo y del botón.)
  const nav = document.getElementById('ebook-nav') as HTMLElement | null
  if (nav) {
    const pintar = () => {
      const op = Math.min(1, Math.max(0, window.scrollY / 40))
      nav.style.backgroundColor = `rgba(29,0,132,${op.toFixed(3)})`
    }
    pintar()
    window.addEventListener('scroll', pintar, { passive: true })
  }

  const modal = document.getElementById('eb-modal') as HTMLElement
  const form = document.getElementById('eb-form') as HTMLFormElement
  const nombreEl = document.getElementById('eb-nombre') as HTMLInputElement
  const emailEl = document.getElementById('eb-email') as HTMLInputElement
  const err = document.getElementById('eb-err') as HTMLElement
  const ir = document.getElementById('eb-ir') as HTMLButtonElement
  const pasos = Array.from(modal.querySelectorAll<HTMLElement>('.eb-paso'))
  const cajaStripe = document.getElementById('eb-stripe') as HTMLElement

  // Quien vuelve (o llega desde un correo con ?nombre=&email=): sus datos puestos.
  const leer = <T,>(k: string): T | null => { try { const v = localStorage.getItem(k); return v ? (JSON.parse(v) as T) : null } catch { return null } }
  const previos = leer<DatosAdmision>(CLAVE_DATOS)
  const q = new URLSearchParams(location.search)
  nombreEl.value = (datoDeLaDireccion(q, 'nombre') || previos?.first_name || '').slice(0, 120)
  emailEl.value = (datoDeLaDireccion(q, 'email') || previos?.email || '').slice(0, 200)

  // Viene de desbloquear la oferta: su nombre en el aviso, y que el navegador
  // lo recuerde (sin el ?desbloqueada= en la dirección, por si la comparte).
  // Aquí no hay «oferta desbloqueada»: se llega por el enlace B2B.
  const desbloqueada = false
  if (desbloqueada) {
    const pila = nombreEl.value.trim().split(/\s+/)[0]
    if (pila) (document.getElementById('eb-desbloq-t') as HTMLElement).textContent = `Oferta desbloqueada, ${pila}.`
    try { localStorage.setItem(CLAVE_DESBLOQUEADA, '1') } catch {}
    if (q.has('desbloqueada')) {
      try {
        const u = new URL(location.href)
        u.searchParams.delete('desbloqueada')
        history.replaceState(null, '', u.toString())
      } catch {}
    }
  }

  const verPaso = (p: string) => pasos.forEach((x) => { x.hidden = x.dataset.paso !== p })
  let pagoMontado: { destroy: () => void } | null = null

  const datosValidos = () => !!nombreEl.value.trim() && /^\S+@\S+\.\S+$/.test(emailEl.value.trim())
  const abrir = () => {
    if (bfTerminado()) return
    modal.hidden = false
    document.documentElement.classList.add('eb-modal-abierto')
    if (pagoMontado) return
    // Desbloqueada y con sus datos: directo a la caja, sin volver a escribirlos.
    if (desbloqueada && datosValidos()) {
      ;(document.getElementById('eb-quien') as HTMLElement).textContent = `${nombreEl.value.trim()} · ${emailEl.value.trim().toLowerCase()}`
      verPaso('pago')
      form.requestSubmit()
      return
    }
    verPaso('datos')
    setTimeout(() => (nombreEl.value ? emailEl : nombreEl).focus({ preventScroll: true }), 60)
  }
  const cerrar = () => {
    modal.hidden = true
    document.documentElement.classList.remove('eb-modal-abierto')
  }
  document.querySelectorAll('[data-bf-comprar]').forEach((b) => b.addEventListener('click', abrir))
  modal.querySelectorAll('[data-cerrar]').forEach((b) => b.addEventListener('click', cerrar))
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) cerrar() })

  // La caja de Stripe, cargada solo cuando hace falta.
  const cargarStripe = () =>
    new Promise<any>((ok, mal) => {
      if ((window as any).Stripe) return ok((window as any).Stripe)
      const sc = document.createElement('script')
      sc.src = 'https://js.stripe.com/v3/'
      sc.async = true
      sc.onload = () => ((window as any).Stripe ? ok((window as any).Stripe) : mal(new Error('stripe')))
      sc.onerror = () => mal(new Error('stripe'))
      document.head.appendChild(sc)
    })

  const mostrarError = (t: string) => { verPaso('datos'); err.textContent = t; err.classList.add('visible') }

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    err.classList.remove('visible')
    const nombre = nombreEl.value.trim()
    const email = emailEl.value.trim().toLowerCase()
    if (!nombre || !/^\S+@\S+\.\S+$/.test(email)) return mostrarError('Vul een naam en een geldig e-mailadres in.')
    ir.classList.add('enviando')

    // (Sin guardar los datos para el formulario de la llamada: quien rellena
    // aquí suele ser el empresario con los datos de otra persona.)

    // El campo trampa: un bot lo rellena; una persona no lo ve.
    if ((document.getElementById('eb-hp') as HTMLInputElement).value.trim()) {
      ir.classList.remove('enviando')
      return mostrarError('De betaling kon niet worden voorbereid. Probeer het zo opnieuw.')
    }

    const u = leerUTM()
    const { recorrido, referrer } = contextoDelLead()
    try {
      // Directo a la escuela desde el navegador, NO por una ruta de esta web:
      // la escuela pone un tope de intentos por IP, y por Vercel todos los
      // compradores saldrían con las mismas IP. Los errores llegan como
      // {detail}: 400 datos, 429 demasiados intentos, 502 Stripe, 503 la
      // oferta ya cerró. Se enseñan tal cual. Después de pagar, Stripe le
      // lleva a `vuelta` con ?compra={CHECKOUT_SESSION_ID} (lo añade la escuela).
      const r = await fetch(`${ESCUELA_URL}/api/v1/ebook/pago`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          nombre, email, canal,
          utm_source: u.utmSource, utm_medium: u.utmMedium, utm_campaign: u.utmCampaign,
          utm_content: u.utmContent, utm_term: u.utmTerm, utm_placement: u.utmPlacement,
          recorrido, referrer,
          vuelta: bfRuta('/bedrijven'),
        }),
      })
      const d = await r.json().catch(() => null)
      if (!r.ok || !d?.client_secret || !d?.publishable_key) {
        ir.classList.remove('enviando')
        return mostrarError(typeof d?.detail === 'string' ? d.detail : 'De betaling kon niet worden voorbereid. Probeer het zo opnieuw.')
      }
      ;(document.getElementById('eb-quien') as HTMLElement).textContent = `${nombre} · ${email}`
      verPaso('pago')
      const Stripe = await cargarStripe()
      const stripe = Stripe(d.publishable_key)
      const checkout = await stripe.initEmbeddedCheckout({ fetchClientSecret: async () => d.client_secret })
      cajaStripe.innerHTML = ''
      checkout.mount(cajaStripe)
      pagoMontado = checkout
      fbq('track', 'InitiateCheckout', { content_name: META_EBOOK, value: EBOOK_PRECIO, currency: 'EUR' })
    } catch {
      verPaso('datos')
      mostrarError('De betaling kon niet laden. Controleer je verbinding en probeer het opnieuw.')
    } finally {
      ir.classList.remove('enviando')
    }
  })

  // Cambiar el nombre o el correo: se quita la caja y se vuelve a los datos.
  document.getElementById('eb-cambiar')?.addEventListener('click', () => {
    try { pagoMontado?.destroy() } catch {}
    pagoMontado = null
    cajaStripe.innerHTML = '<p class="eb-cargando">Veilige betaling laden…</p>'
    verPaso('datos')
  })
</script>

<style>
  /* Lo propio de la página para empresas. */
  .bz-bedankt { display: none; align-items: center; gap: 10px; margin: 0 0 20px; padding: 10px 16px 10px 11px; border-radius: 12px;
    background: rgba(34,197,94,0.13); border: 1px solid rgba(134,239,172,0.38); color: rgba(255,255,255,0.95); font-size: 14.5px; line-height: 1.5; }
  :global(html.bz-gekocht) .bz-bedankt { display: flex; }
  .bz-vertaald { margin: 10px 0 0; font-size: 13px; color: #5B6382; }
    .bz-slot-regels { display: flex; flex-direction: column; gap: 2px; }
  .bz-slot-regels p { margin: 0; font-size: 17px; line-height: 1.55; color: rgba(255,255,255,0.93); }
  .bz-slot-regels s { color: rgba(255,255,255,0.75); }
  .bz-team { margin: 4px 0 6px; font-size: 15px; line-height: 1.55; color: rgba(255,255,255,0.85); }
  /* «Wat staat erin?»: una línea por color, nunca tres. */
  .ebook-incluye-text .value-title { font-size: clamp(28px, 2.9vw, 42px); }
  .ebook-incluye-text .value-title > span { white-space: nowrap; }
  @media (max-width: 640px) {
    .ebook-incluye-text .value-title { font-size: min(30px, calc((100vw - 48px) / 13.5)); }
  }
  .bz-team a { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  /* ════ Oferta desbloqueada (viene de la portada de Black Friday) ════ */
  /* En UNA línea (02/11, noche: "en un párrafo, no en dos"): sin partir y,
     si el nombre es muy largo, se corta con «…» antes que pasar a dos. */
  .eb-desbloq {
    display: none; align-items: center; gap: 10px; max-width: 100%; margin: 0 0 20px; padding: 10px 16px 10px 11px; border-radius: 12px;
    background: rgba(34,197,94,0.13); border: 1px solid rgba(134,239,172,0.38); color: rgba(255,255,255,0.93); font-size: 14.5px; line-height: 1.5;
    white-space: nowrap;
  }
  .eb-desbloq-txt { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  /* Con la pastilla, la cabecera sube (02/11, noche: "mucho margen arriba y
     abajo nada"): menos aire bajo la barra y el botón deja de tocar el borde
     de la pantalla. */
  @media (min-width: 901px) {
    :global(html.bf-desbloqueada) .ebook-hero-wrap { padding-top: 92px; padding-bottom: 56px; }
  }
  .eb-desbloq strong { color: #fff; font-weight: 600; }
  :global(html.bf-desbloqueada) .eb-desbloq { display: flex; }
  @media (max-width: 640px) {
    .eb-desbloq { padding: 9px 14px 9px 10px; }
  }
  .eb-desbloq-ico {
    flex-shrink: 0; width: 22px; height: 22px; margin-top: 0; border-radius: 50%; background: #22c55e; color: #fff;
    display: inline-flex; align-items: center; justify-content: center;
  }

  /* ════ Lo de /ebook-a0-a1, tal cual (menos «Por qué este eBook») ════ */
  .ebook-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 50; background-color: rgba(29, 0, 132, 0); }
  .ebook-nav-inner { max-width: 1152px; margin: 0 auto; padding: 0 24px; height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .ebook-nav-logo { display: inline-flex; align-items: center; flex-shrink: 0; }
  .ebook-nav-logo img { height: 44px; width: auto; object-fit: contain; display: block; }
  .ebook-nav-cta {
    display: inline-flex; align-items: center; gap: 8px; padding: 11px 22px; border-radius: 8px;
    background: #4da3ff; color: #1D0084; font-size: 14px; font-weight: 700; text-decoration: none; border: none;
    font-family: inherit; cursor: pointer; transition: background 0.2s; white-space: nowrap;
  }
  .ebook-nav-cta:hover { background: #3391f0; }
  /* En el móvil, la barra con el mismo aire arriba y abajo del botón y la
     cabecera justo debajo (02/11: "arriba apenas hay margen y abajo sobra"):
     barra de 76 px (20 por arriba y por abajo) y el texto a 16 px de ella
     (`.ebook-hero-wrap`, padding-top 92). */
  @media (max-width: 600px) {
    .ebook-nav-inner { height: 76px; padding: 0 24px; }
    .ebook-nav-logo img { height: 36px; }
    .ebook-nav-cta { padding: 10px 14px; font-size: 13px; gap: 6px; }
    .ebook-nav-cta :global(svg) { width: 12px; height: 12px; }
  }

  @keyframes h-in { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
  .h-anim { opacity: 0; animation: h-in 0.75s cubic-bezier(0.22,1,0.36,1) forwards; animation-delay: var(--hd, 0s); }

  /* El relleno de abajo deja sitio a la cola de la «j» (con el degradado
     recortado al texto, se cortaba en el borde de la línea). */
  .hero-title-gradient {
    padding-bottom: 0.14em; margin-bottom: -0.14em;
    background: linear-gradient(180deg, rgba(255,255,255,1) 0%, rgba(255,255,255,0.45) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .hero-bullets { list-style: none; padding: 0; margin: 0 0 26px; display: flex; flex-direction: column; gap: 13px; }
  .hero-bullets li { display: flex; align-items: center; gap: 12px; font-size: 16px; font-weight: 600; color: #ffffff; line-height: 1.45; }
  .hero-check {
    flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; background: transparent; border: 2px solid #4da3ff;
    display: flex; align-items: center; justify-content: center; color: #4da3ff;
  }
  .hero-sub { font-size: clamp(15px, 1.4vw, 17px); max-width: 480px; margin-bottom: 22px; color: #ffffff; line-height: 1.6; }
  .hero-title {
    font-family: 'Poppins', system-ui, sans-serif; font-size: clamp(32px, 3.1vw, 42px);
    font-weight: 700; letter-spacing: -0.03em; line-height: 1.08; color: #fff; margin: 0 0 18px;
  }
  .hero-title > span, .hero-title em { display: block; }
  .hero-title em { font-style: normal; color: #4da3ff; -webkit-text-fill-color: #4da3ff; }
  /* En el móvil, dos líneas y no cuatro (30/10, usuario): cada mitad del
     titular en su línea y la letra a la medida de la columna (la mitad más
     larga, «por menos que un café.», mide 11,8 veces su letra). */
  @media (max-width: 767px) {
    /* En neerlandés el titular es más largo: aquí sí parte de línea. */
    .hero-title { font-size: min(30px, calc((100vw - 48px) / 13)); }
  }

  .ebook-hero { background: #1D0084; position: relative; overflow: hidden; min-height: 100vh; display: flex; align-items: center; }
  .ebook-hero-glow1 { position: absolute; top: -120px; right: -80px; width: 700px; height: 700px; border-radius: 50%; background: radial-gradient(circle, rgba(11,109,240,0.40) 0%, transparent 65%); pointer-events: none; }
  .ebook-hero-glow2 { position: absolute; bottom: -200px; left: -100px; width: 600px; height: 600px; border-radius: 50%; background: radial-gradient(circle, rgba(11,109,240,0.18) 0%, transparent 65%); pointer-events: none; }
  .ebook-hero-wrap {
    max-width: 1152px; margin: 0 auto; padding: 116px 32px 72px; width: 100%;
    display: grid; grid-template-columns: 1.2fr 1fr; gap: 56px; align-items: center; position: relative; z-index: 1;
  }
  .ebook-hero-text { display: flex; flex-direction: column; align-items: flex-start; }
  .ebook-hero-text .hero-sub { max-width: 520px; }
  .ebook-hero-visual { display: flex; align-items: center; justify-content: center; }
  .ebook-mockup-wrap { position: relative; width: 100%; max-width: 460px; filter: drop-shadow(0 30px 60px rgba(0,0,0,0.45)); }
  .ebook-mockup-img { position: relative; z-index: 1; width: 100%; height: auto; display: block; transform: rotate(var(--rot, -2deg)); }

  .ebook-cta-primary {
    display: inline-flex; align-items: center; gap: 8px; padding: 14px 26px; border-radius: 8px;
    background: #4da3ff; color: #1D0084; font-size: 14px; font-weight: 700; text-decoration: none; border: none;
    font-family: inherit; cursor: pointer; transition: background 0.2s;
  }
  .ebook-cta-primary:hover { background: #3391f0; }
  .ebook-cta-big { padding: 16px 32px; font-size: 16px; }

  .ebook-para-header { text-align: center; max-width: 760px; margin: 0 auto 36px; }
  .ebook-para-grid { display: grid; grid-template-columns: 1fr; gap: 18px; }
  @media (min-width: 768px) { .ebook-para-grid { grid-template-columns: 1fr 1fr 1fr; } }
  .ebook-para-card {
    position: relative; overflow: hidden; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.10);
    border-radius: 20px; padding: 28px 24px; transition: border-color 0.25s, background 0.25s, transform 0.25s;
  }
  .ebook-para-card:hover { border-color: rgba(77,163,255,0.35); background: rgba(255,255,255,0.08); transform: translateY(-3px); }
  .ebook-para-icon { font-size: 30px; margin-bottom: 14px; }
  .ebook-para-title { font-family: 'Poppins', system-ui, sans-serif; font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 10px; letter-spacing: -0.01em; }
  .ebook-para-desc { font-size: 14.5px; color: rgba(255,255,255,0.85); line-height: 1.65; }

  .ebook-incluye-grid { display: grid; grid-template-columns: 1fr; gap: 56px; align-items: center; }
  @media (min-width: 1024px) { .ebook-incluye-grid { grid-template-columns: 1fr 1fr; gap: 72px; } }
  .ebook-incluye-img-wrap { display: flex; align-items: center; justify-content: center; }
  .ebook-incluye-img { width: 100%; max-width: 520px; height: auto; filter: drop-shadow(0 20px 50px rgba(0,0,0,0.35)); transform: rotate(2deg); transition: transform 0.5s cubic-bezier(0.22,1,0.36,1); }
  .ebook-incluye-img-wrap:hover .ebook-incluye-img { transform: rotate(0deg) scale(1.02); }
  .ebook-incluye-text { display: flex; flex-direction: column; align-items: flex-start; }
  .ebook-incluye-text .value-title { margin-bottom: 28px; }
  .ebook-incluye-list { list-style: none; padding: 0; margin: 0 0 36px; display: flex; flex-direction: column; gap: 14px; width: 100%; }
  .ebook-incluye-list li { display: flex; align-items: flex-start; gap: 12px; font-size: 16px; font-weight: 500; color: #fff; line-height: 1.55; }
  /* Los checks, como los de la home (30/10, usuario): un aro de 2 px en azul,
     sin relleno, y la palomita más gruesa. Antes era un círculo translúcido
     con el borde fino, que sobre el azul apenas se veía. */
  .ebook-incluye-check {
    flex-shrink: 0; margin-top: 1px; width: 22px; height: 22px; border-radius: 50%; background: transparent;
    border: 2px solid #4da3ff; color: #4da3ff; display: flex; align-items: center; justify-content: center;
  }
  .ebook-incluye-check :global(svg) { width: 12px; height: 12px; stroke-width: 2.6; }
  .ebook-incluye-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .ebook-incluye-note { font-size: 13px; color: rgba(255,255,255,0.78); }
  /* En una columna, el botón a lo ancho y la nota centrada (02/11: "los
     botones en móvil no están centrados, están más a la izquierda": este
     medía lo que la nota de debajo). */
  @media (max-width: 1023px) {
    .ebook-incluye-cta { width: 100%; align-items: stretch; }
    .ebook-incluye-cta .ebook-cta-primary { justify-content: center; }
    .ebook-incluye-note { text-align: center; }
  }

  .ebook-testimonials { padding: 96px 0 64px; position: relative; overflow: hidden; }
  .ebook-test-header { text-align: center; max-width: 920px; margin: 0 auto 48px; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  @media (min-width: 768px) { .ebook-test-header .title { white-space: nowrap; } }
  .ebook-test-grid { display: grid; grid-template-columns: 1fr; gap: 18px; max-width: 1100px; margin: 0 auto; }
  @media (min-width: 768px) { .ebook-test-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .ebook-test-grid { grid-template-columns: 1fr 1fr 1fr; } }
  .ebook-test-card {
    background: #fff; border: 1px solid #DDE6F5; border-radius: 18px; padding: 26px 24px; display: flex; flex-direction: column; gap: 12px;
    box-shadow: 0 2px 12px rgba(29,0,132,0.04); transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .ebook-test-card:hover { border-color: rgba(2,93,199,0.22); box-shadow: 0 8px 32px rgba(2,93,199,0.08); transform: translateY(-2px); }
  .ebook-test-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .ebook-test-name { font-size: 14px; font-weight: 700; color: #1D0084; margin: 0; }
  .ebook-test-stars { display: flex; gap: 2px; flex-shrink: 0; }
  .ebook-test-title { font-size: 15px; font-weight: 800; color: #1D0084; margin: 0; line-height: 1.35; }
  .ebook-test-text { font-size: 14px; font-weight: 500; color: rgba(29,0,132,0.88); line-height: 1.7; margin: 0; }

  /* ════ Lo nuevo: el final de la oferta, el cierre y el pie ════ */
  .eb-fin p { margin: 8px 0 16px; font-size: 16px; line-height: 1.6; color: rgba(255,255,255,0.93); max-width: 520px; }
  .eb-fin p strong { color: #fff; }
  .eb-cierre { position: relative; overflow: hidden; padding: 96px 24px 0; }
  .eb-cierre-in { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; max-width: 760px; }
  .eb-cierre-sub { margin: 0 0 10px; font-size: 17px; line-height: 1.6; color: rgba(255,255,255,0.93); }
  .eb-cierre .eb-fin { text-align: center; }

  /* ════ La ventana de la compra ════ */
  :global(html.eb-modal-abierto) { overflow: hidden; }
  .eb-modal { position: fixed; inset: 0; z-index: 80; display: flex; align-items: center; justify-content: center; padding: 24px; }
  .eb-modal[hidden] { display: none; }
  .eb-modal-fondo { position: absolute; inset: 0; background: rgba(7,4,40,0.72); }
  .eb-modal-caja {
    position: relative; width: 100%; max-width: 520px; max-height: calc(100vh - 48px); overflow-y: auto; overscroll-behavior: contain;
    background: #fff; color: #0a1656; border-radius: 20px; padding: 0 26px 26px; box-shadow: 0 40px 90px -30px rgba(3,9,33,0.7);
  }
  .eb-modal-barra { display: flex; align-items: center; justify-content: space-between; padding: 14px 0 10px; }
  .eb-modal-seguro { display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; font-weight: 600; color: #171a2e; }
  .eb-modal-seguro :global(svg) { color: #15803d; }
  .eb-modal-x { width: 38px; height: 38px; margin-right: -8px; border: 0; background: transparent; font-size: 28px; line-height: 1; color: #171a2e; cursor: pointer; border-radius: 10px; }
  .eb-modal-x:hover { background: #F0F5FF; }
  .eb-resumen { display: flex; align-items: center; gap: 14px; padding: 12px 14px; border-radius: 14px; background: #F0F5FF; }
  .eb-resumen-foto { flex-shrink: 0; width: 56px; height: 56px; object-fit: contain; }
  .eb-resumen-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .eb-resumen-txt b { font-family: 'Poppins', system-ui, sans-serif; font-size: 16px; font-weight: 600; color: #1D0084; }
  .eb-resumen-txt span { font-size: 13px; color: #171a2e; }
  /* El precio de hoy arriba y el de siempre debajo, sin pegarse (31/10:
     "el 12,50 y el 1 € están muy juntos"). */
  .eb-resumen-precios { flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: 4px; line-height: 1; }
  .eb-resumen-precio { font-family: 'Poppins', system-ui, sans-serif; font-size: 24px; font-weight: 700; color: #1D0084; line-height: 1; }
  .eb-resumen-precios s { font-size: 13px; font-weight: 500; color: #475069; text-decoration-color: #DC2626; text-decoration-thickness: 1.5px; white-space: nowrap; }
  .eb-modal-titulo { margin: 22px 0 4px; font-family: 'Poppins', system-ui, sans-serif; font-size: 22px; font-weight: 600; letter-spacing: -0.018em; color: #1D0084; }
  .eb-modal-lead { margin: 0 0 6px; font-size: 14.5px; color: #171a2e; }
  .eb-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .eb-label { display: block; margin: 16px 0 6px; font-size: 13px; font-weight: 600; letter-spacing: 0.01em; color: #0a1656; }
  .eb-input {
    width: 100%; background: #F0F5FF; border: 1px solid transparent; border-radius: 12px; padding: 13px 15px; font-size: 16px; font-family: inherit;
    color: #1D0084; outline: none; transition: background .15s, border-color .15s, box-shadow .15s;
  }
  .eb-input::placeholder { color: rgba(29,0,132,0.45); }
  .eb-input:focus { background: #fff; border-color: #4da3ff; box-shadow: 0 0 0 3px rgba(77,163,255,0.22); }
  .eb-err { display: none; margin: 14px 0 0; padding: 11px 14px; border-radius: 12px; background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; font-size: 13.5px; line-height: 1.5; }
  .eb-err:global(.visible) { display: block; }
  .eb-ir { width: 100%; margin-top: 20px; }
  .eb-legal { margin: 14px 0 0; font-size: 12.5px; line-height: 1.55; color: #171a2e; }
  .eb-legal a { color: #025dc7; text-decoration: underline; }
  .eb-pagando { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 16px 0 14px; padding: 11px 14px; border-radius: 12px; border: 1px solid #DDE6F5; font-size: 13.5px; color: #171a2e; }
  .eb-pagando b { color: #1D0084; font-weight: 600; word-break: break-all; }
  .eb-cambiar { flex-shrink: 0; border: 0; background: none; color: #025dc7; font: inherit; font-weight: 600; text-decoration: underline; cursor: pointer; padding: 0; }
  .eb-stripe { min-height: 320px; }
  .eb-cargando { margin: 0; padding: 60px 0; text-align: center; font-size: 14.5px; color: #171a2e; }

  /* ════ 29/10: más vida y la oferta clara ════ */
  .eb-punto { width: 7px; height: 7px; border-radius: 9999px; background: #4ade80; animation: eb-punto 2s ease-in-out infinite; }
  @keyframes eb-punto { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  /* El precio: el de siempre tachado, el de hoy en grande y el descuento. */
  .eb-precio { margin: 0 0 24px; }
  .eb-precio-fila { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 16px; }
  .eb-precio-ya { font-family: 'Poppins', system-ui, sans-serif; font-size: 60px; font-weight: 700; line-height: 1; letter-spacing: -0.04em; color: #fff; }
  .eb-precio-antes { display: inline-flex; flex-direction: column; gap: 2px; line-height: 1.05; }
  .eb-precio-antes s { font-family: 'Poppins', system-ui, sans-serif; font-size: 24px; font-weight: 600; color: rgba(255,255,255,0.78); text-decoration-color: #ff6b6b; text-decoration-thickness: 2px; }
  .eb-precio-antes small { font-size: 12px; color: rgba(255,255,255,0.8); }
  .eb-precio-dto {
    padding: 7px 13px; border-radius: 9999px; background: #DC2626; color: #fff; font-size: 15px; font-weight: 800; letter-spacing: 0.01em;
    animation: eb-late 2.6s ease-in-out infinite;
  }
  @keyframes eb-late { 0%, 70%, 100% { transform: scale(1); } 80% { transform: scale(1.08); } 90% { transform: scale(0.98); } }
  .eb-precio-hasta { margin: 10px 0 0; font-size: 13.5px; color: rgba(255,255,255,0.88); }

  /* El botón con la nota a mano (la de la landing: «empieza hoy»). */
  .eb-cta-fila { display: flex; align-items: flex-start; gap: 14px; margin: 2px 0 26px; }
  /* El salto de «Todo lo que necesitas / para tu nivel A0 – A1», solo con las
     dos columnas: en una sola, el título corre solo. */
  .eb-br-pc { display: none; }
  @media (min-width: 1024px) { .eb-br-pc { display: inline; } }
  /* La flecha sale del texto (arriba a la derecha) y su punta se queda a 8 px
     del botón, a media altura: el botón mide 56 px y la punta cae a 28. */
  .eb-mano { display: inline-flex; align-items: flex-start; color: #4da3ff; margin-left: -6px; }
  .eb-mano-txt { font-family: 'Caveat', 'Segoe Script', cursive; font-size: 27px; font-weight: 700; line-height: 1; color: #fff; transform: rotate(-6deg); white-space: nowrap; margin: -10px 0 0 -2px; }
  .eb-mano-flecha { width: 50px; height: 40px; margin-top: 4px; flex-shrink: 0; }

  /* Las caras de quien ya lo tiene. */
  .eb-caras { display: flex; align-items: center; gap: 12px; }
  .eb-caras-fila { display: inline-flex; }
  .eb-cara {
    width: 36px; height: 36px; border-radius: 9999px; background: var(--c, #EAF3FF); color: #0a1656; border: 2px solid #1D0084;
    display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; overflow: hidden; flex-shrink: 0;
  }
  .eb-cara + .eb-cara { margin-left: -10px; }
  .eb-cara img { width: 100%; height: 100%; object-fit: cover; }
  .eb-caras-txt { display: flex; flex-direction: column; gap: 1px; font-size: 14px; font-weight: 600; color: #fff; line-height: 1.3; }
  .eb-estrellas { color: #F58220; letter-spacing: 2px; font-size: 13px; }
  .ebook-test-name { display: inline-flex; align-items: center; gap: 10px; }
  .eb-cara-op { width: 32px; height: 32px; border: 0; background: #EAF3FF; color: #1D0084; }

  /* El libro y el sello del precio. */
  .eb-flota { animation: eb-flota 6s ease-in-out infinite; }
  @keyframes eb-flota { 0%, 100% { transform: rotate(var(--rot, -2deg)) translateY(0); } 50% { transform: rotate(var(--rot, -2deg)) translateY(-14px); } }
  /* El sello del precio (31/10: "se ve algo barato"): ya no es el círculo
     rojo, sino una tarjeta blanca como las otras dos que flotan junto al libro
     («70 páginas», «100% en español»): «Black Friday» en rojo, pequeño y en
     mayúsculas, y debajo el 1 € con el precio de siempre tachado. Sin sombra
     y sin giro. */
  .eb-sello {
    position: absolute; z-index: 2; top: 6%; left: -4%; display: flex; flex-direction: column; gap: 6px;
    padding: 12px 16px 13px; border-radius: 14px; background: #fff; border: 1px solid #DDE6F5; color: #1D0084;
  }
  .eb-sello small { font-size: 10.5px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; line-height: 1; color: #C81E1E; }
  .eb-sello-fila { display: flex; align-items: baseline; gap: 9px; }
  .eb-sello b { font-family: 'Poppins', system-ui, sans-serif; font-size: 32px; font-weight: 700; line-height: 1; letter-spacing: -0.03em; color: #1D0084; }
  .eb-sello s { font-size: 14px; font-weight: 600; color: #475069; text-decoration-color: #DC2626; text-decoration-thickness: 1.5px; }
  .ebook-mockup-wrap .float-badge { z-index: 2; }

  /* ════ 02/11: el libro animado, sin fondo ════
     LibroAnimado (la animación de Claude Design, dibujada por el navegador)
     es transparente: el libro va directamente sobre la cabecera. Ya no hay
     vídeo, ni máscara, ni halo azul alrededor. */
  /* El aire de arriba deja el sello y «70 páginas» por encima del libro: el
     libro abierto ocupa casi todo el ancho y, sin él, tapaban las esquinas de
     las páginas. */
  .eb-libro { position: relative; width: 100%; max-width: 540px; padding-top: 48px; }
  /* El sello, en la esquina de arriba a la izquierda. */
  .eb-libro .eb-sello { top: -8px; left: -22px; }
  .eb-libro .float-badge { z-index: 2; box-shadow: none; border: 1px solid #DDE6F5; }
  /* Un poco más abajo (02/11, noche). */
  .eb-libro .fb-top { top: 2px; right: -18px; }
  /* Debajo del bloque, sin tocar el libro (30/10: "un poco más abajo para
     que no toque el libro"). */
  .eb-libro .fb-bot { bottom: -52px; left: 6%; }
  .eb-fb-ico { flex-shrink: 0; width: 34px; height: 34px; border-radius: 10px; background: #EAF3FF; color: #025dc7; display: inline-flex; align-items: center; justify-content: center; }
  /* Los botones de esta página, sin el halo de luz por fuera (30/10: "quita las
     sombras exteriores de botones e iconos, no queda bien"). El destello que
     los cruza se queda. */
  .eb :global(.bf-brillo) { box-shadow: inset 0 1px 0 rgba(255,255,255,0.45); }

  /* La cinta que pasa bajo la cabecera. */
  .eb-cinta { background: #4da3ff; color: #0a1656; overflow: hidden; padding: 15px 0; border-top: 1px solid rgba(255,255,255,0.35); }
  .eb-cinta-pista { display: flex; width: max-content; animation: eb-cinta 32s linear infinite; }
  .eb-cinta-grupo { display: flex; gap: 44px; padding-right: 44px; }
  .eb-cinta-item { display: inline-flex; align-items: center; gap: 12px; font-size: 15px; font-weight: 700; letter-spacing: 0.01em; white-space: nowrap; }
  .eb-cinta-item i { font-style: normal; color: #1D0084; font-size: 13px; }
  @keyframes eb-cinta { to { transform: translateX(-50%); } }

  /* Así es por dentro. */
  /* Va después de «Para ti si…» (oscura): necesita su aire arriba, como las
     demás (02/11: en el móvil la etiqueta casi tocaba la sección de arriba). */
  .eb-dentro-sec { position: relative; padding: 96px 0; }
  .eb-nowrap { white-space: nowrap; }
  .eb-dentro-sub { margin: 0; font-size: 16.5px; line-height: 1.6; color: #171a2e; max-width: 560px; }
  .eb-dentro { display: grid; grid-template-columns: 1fr; gap: 22px; max-width: 1060px; margin: 0 auto; }
  @media (min-width: 900px) { .eb-dentro { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .eb-dentro-item { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .eb-dentro-foto { border-radius: 18px; background: #F0F5FF; border: 1px solid #DDE6F5; padding: 14px 12px; }
  .eb-dentro-foto img { display: block; width: 100%; height: auto; }
  .eb-dentro-item figcaption { display: flex; flex-direction: column; gap: 4px; padding: 0 4px; }
  .eb-dentro-item figcaption b { font-size: 16.5px; font-weight: 700; color: #1D0084; line-height: 1.35; }
  .eb-dentro-item figcaption span { font-size: 14.5px; line-height: 1.55; color: #171a2e; }
  .eb-dentro-cta { display: flex; justify-content: center; margin-top: 40px; }
  @media (max-width: 767px) {
    .eb-dentro-sec { padding: 64px 0; }
    /* El título no cabe en una línea (antes se salía por los dos lados): en
       dos, «Así son las páginas de» / «Holandés sin miedo». */
    .eb-pila-cab .eb-dentro-titulo { white-space: normal !important; font-size: min(28px, calc((100vw - 48px) / 11.6)) !important; line-height: 1.18; }
    .eb-dentro-cta, .eb-dentro-cta .ebook-cta-primary { width: 100%; justify-content: center; }
  }

  /* Todo lo que te llevas por 1 €. */
  .eb-pila-sec { position: relative; padding: 96px 0; }
  .eb-pila-cab { text-align: center; max-width: 760px; margin: 0 auto 40px; display: flex; flex-direction: column; align-items: center; gap: 12px; }
