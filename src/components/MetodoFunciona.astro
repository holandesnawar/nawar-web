---
// Te presentamos el Método Holandés Nawar — así funciona, paso a paso.
const pasos = [
  {
    num: '1',
    icon: '🎯',
    title: 'Realiza tu prueba de nivel',
    desc: 'En 10 minutos sabemos exactamente de dónde partes y empiezas justo donde te toca — ni aburrido ni perdido.',
  },
  {
    num: '2',
    icon: '📚',
    title: 'Avanza por las unidades del programa',
    desc: 'Cada lección tiene su vídeo, resumen, flashcards, lectura, escucha y ejercicios. Terminas, se marca tu check, y siempre sabes qué toca después.',
  },
  {
    num: '3',
    icon: '🎥',
    title: 'Sigue las clases',
    desc: 'Clase en vivo cada semana para practicar y resolver dudas — y todas quedan grabadas para verlas a tu ritmo.',
  },
  {
    num: '4',
    icon: '⚡',
    title: 'Aprovecha todas las herramientas extra',
    desc: 'Repaso inteligente de tus fallos, consultas respondidas por el equipo, comunidad privada y materiales descargables.',
  },
]
---
<div class="mf-wrapper">
  <div class="mf-outer" data-navbar="dark">
    <section class="mf-section">
      <div class="mf-bg-glow" aria-hidden="true"></div>
      <div class="dots-dark" aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;opacity:0.5;"></div>
      <div class="inner" style="position:relative;z-index:1;">

        <div class="mf-header sr">
          <span class="badge-dark">Te presentamos</span>
          <h2 class="mf-title">
            <span class="text-gradient-white">El Método</span>
            <span style="color:#4da3ff;-webkit-text-fill-color:#4da3ff;"> Holandés Nawar</span>
          </h2>
          <p class="mf-sub">Así funciona, paso a paso. Sin misterios: un sistema que te lleva de la mano de A0 a A1.</p>
        </div>

        <div class="mf-steps">
          {pasos.map((p, i) => (
            <div class={`mf-step sr${i > 0 ? ` d${i}` : ''}`}>
              <div class="mf-step-line" aria-hidden="true"></div>
              <div class="mf-step-num">{p.num}</div>
              <div class="mf-step-body">
                <div class="mf-step-head">
                  <span class="mf-step-icon">{p.icon}</span>
                  <h3 class="mf-step-title">{p.title}</h3>
                </div>
                <p class="mf-step-desc">{p.desc}</p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>
  </div>
</div>

<style>
.mf-wrapper { background: #F0F4FF; padding: 64px 48px 80px; }
@media (max-width: 640px) { .mf-wrapper { padding: 40px 16px 56px; } }
.mf-outer {
  overflow: hidden; position: relative; border-radius: 32px;
  max-width: 1280px; margin: 0 auto;
}
.mf-section { background: #1D0084; position: relative; overflow: hidden; padding: 80px 0; }
.mf-bg-glow {
  position: absolute; top: -20%; left: 50%; transform: translateX(-50%);
  width: 900px; height: 600px;
  background: radial-gradient(ellipse at center, rgba(11,109,240,0.30) 0%, transparent 65%);
  pointer-events: none;
}
.mf-header { text-align: center; max-width: 780px; margin: 0 auto 56px; }
.mf-title {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: clamp(28px, 4vw, 50px);
  font-weight: 600; letter-spacing: -0.022em; line-height: 1.12;
  margin: 18px 0 16px;
}
.mf-sub { font-size: clamp(14px, 1.4vw, 17px); color: rgba(255,255,255,0.65); line-height: 1.6; }

.mf-steps { max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; gap: 0; }
.mf-step { position: relative; display: flex; gap: 22px; padding: 0 0 40px; }
.mf-step:last-child { padding-bottom: 0; }
.mf-step:last-child .mf-step-line { display: none; }
.mf-step-line {
  position: absolute; left: 23px; top: 48px; bottom: 0; width: 2px;
  background: linear-gradient(to bottom, rgba(77,163,255,0.45), rgba(77,163,255,0.08));
}
.mf-step-num {
  flex-shrink: 0; width: 48px; height: 48px; border-radius: 16px;
  display: flex; align-items: center; justify-content: center;
  background: rgba(77,163,255,0.14); border: 1px solid rgba(77,163,255,0.35);
  color: #4da3ff; font-family: 'Poppins', system-ui, sans-serif;
  font-size: 19px; font-weight: 700; position: relative; z-index: 1;
}
.mf-step-body {
  flex: 1; background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.10);
  border-radius: 20px; padding: 22px 26px;
  transition: border-color 0.25s ease, background 0.25s ease;
}
.mf-step:hover .mf-step-body { border-color: rgba(77,163,255,0.40); background: rgba(255,255,255,0.07); }
.mf-step-head { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
.mf-step-icon { font-size: 20px; line-height: 1; }
.mf-step-title {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 18px; font-weight: 600; color: #fff; line-height: 1.3;
}
.mf-step-desc { font-size: 14.5px; color: rgba(255,255,255,0.60); line-height: 1.65; }
@media (max-width: 640px) {
  .mf-step { gap: 14px; }
  .mf-step-body { padding: 18px 18px; }
}
</style>
