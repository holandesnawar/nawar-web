---
import '../styles/global.css'
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'

interface Props {
  title?: string
  description?: string
  keywords?: string
  ogImage?: string
  canonicalURL?: string
  noindex?: boolean
}

const {
  title = 'Nawar — Aprende neerlandés online',
  description = 'Academia de neerlandés para hispanohablantes. Clases en vivo, método desde el español y comunidad activa.',
  keywords = 'neerlandés, holandés, curso online, hispanohablantes, clases en vivo, Países Bajos',
  ogImage = 'https://www.holandesnawar.com/og-image.png',
  canonicalURL = Astro.url.href,
  noindex = false,
} = Astro.props

const siteURL = 'https://www.holandesnawar.com'

/* Píxel de Meta (conjunto de datos "Hebben&Zijn").
   Va en el layout, o sea en TODAS las páginas, y tiene que ser así:
   el visitante llega por el anuncio a la landing pero se matricula en
   otra página distinta, y si el píxel no está también allí la
   conversión no se le atribuye al anuncio.
   Vaciando esta constante se apaga en todo el sitio de una vez. */
const META_PIXEL = '1410831147818099'
/* El código va montado aquí arriba y no dentro del marcado: un
   literal de varias líneas con llaves dentro rompe al compilador de
   Astro, que se cree que las llaves son suyas.
   Sólo mide PageView. Los eventos de conversión —Lead al enviar la
   matrícula, Purchase al pagar— son un paso aparte y no están. */
const META_PIXEL_SNIPPET = `!function(f,b,e,v,n,t,s)
{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};
if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
n.queue=[];t=b.createElement(e);t.async=!0;
t.src=v;s=b.getElementsByTagName(e)[0];
s.parentNode.insertBefore(t,s)}(window,document,'script',
'https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '${META_PIXEL}');
fbq('track', 'PageView');`
const META_PIXEL_NOSCRIPT = `<img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=${META_PIXEL}&ev=PageView&noscript=1" />`
---

<!doctype html>
<html lang="es" style="background:#1D0084">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <!-- Meta / Facebook domain verification -->
    <meta name="facebook-domain-verification" content="qc4fd8gdjluvk1lnj4gsj8bc3oe7kh" />

    <title>{title}</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HolandésNawar" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Descubre el primer método de neerlandés creado para hispanohablantes — Holandés Nawar" />
    <meta property="og:locale" content="es_ES" />

    <!-- Asocia el dominio a la página de Facebook/Instagram @holandes.nawar -->
    <meta property="fb:pages" content="61557311332541" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@holandesnawar" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Descubre el primer método de neerlandés creado para hispanohablantes — Holandés Nawar" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "EducationalOrganization",
        "name": "HolandésNawar",
        "url": "https://www.holandesnawar.com",
        "logo": "https://docs.holandesnawar.com/iconos/logo.png",
        "description": "Academia de neerlandés online exclusiva para hispanohablantes. Método práctico, clases en vivo y comunidad activa.",
        "inLanguage": "es",
        "areaServed": {
          "@type": "Place",
          "name": "Países Bajos"
        },
        "teaches": "Neerlandés (holandés)",
        "sameAs": [
          "https://www.instagram.com/holandesnawar",
          "https://www.youtube.com/@holandesnawar"
        ]
      }
    </script>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-S3GJTLQHRJ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-S3GJTLQHRJ');
    </script>

    {/* Píxel de Meta. is:inline para que salga tal cual y se
        ejecute en la cabecera: si no, Astro se lo lleva a un módulo
        aparte y se carga más tarde, que para medir es justo lo que
        no interesa. */}
    {META_PIXEL && <script is:inline set:html={META_PIXEL_SNIPPET} />}
    {META_PIXEL && <noscript set:html={META_PIXEL_NOSCRIPT} />}

    <!-- Fonts: Inter + Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --font-inter: 'Inter', system-ui, sans-serif;
        --font-poppins: 'Poppins', system-ui, sans-serif;
      }
    </style>
  </head>
  <body class="min-h-screen antialiased" style="background:#1D0084">
    <slot />

    <!-- Metricool tracking pixel — métricas de visitas del blog/web -->
    <img
      src="https://tracker.metricool.com/c3po.jpg?hash=2df77e6320bc7d718f71d0b1461f5004"
      alt=""
      aria-hidden="true"
      width="1"
      height="1"
      style="display:none"
    />

    <!-- Vercel Analytics — pageviews y visitantes anónimos -->
    <Analytics />
    <!-- Vercel Speed Insights — Core Web Vitals (LCP, CLS, INP) para SEO -->
    <SpeedInsights />

    <!-- Scroll reveal: sequential stagger for .sr/.sr-s, bidirectional for .sr-bi -->
    <script>
      // Sequential stagger state
      let batchCount = 0
      let batchTimer: ReturnType<typeof setTimeout> | null = null
      const STEP = 0.08        // seconds between each element in a batch
      const MAX_DELAY = 0.32   // cap so last element never waits more than this
      const RESET_AFTER = 600  // ms of silence before resetting counter

      function resetBatch() {
        batchCount = 0
        batchTimer = null
      }

      // One-way observer — triggers as soon as element enters viewport
      const obsOnce = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return
            const el = e.target as HTMLElement
            if (batchTimer) clearTimeout(batchTimer)
            batchTimer = setTimeout(resetBatch, RESET_AFTER)
            const extra = Math.min(batchCount * STEP, MAX_DELAY)
            el.style.animationDelay = extra > 0 ? `${extra.toFixed(2)}s` : ''
            el.classList.add('vis')
            batchCount++
            obsOnce.unobserve(el)
          })
        },
        { threshold: 0.06, rootMargin: '0px 0px 0px 0px' }
      )

      // Bidirectional observer (keeps observing to reverse on exit)
      let biCount = 0
      let biTimer: ReturnType<typeof setTimeout> | null = null

      const obsBi = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            const el = e.target as HTMLElement
            if (e.isIntersecting) {
              if (biTimer) clearTimeout(biTimer)
              biTimer = setTimeout(() => { biCount = 0; biTimer = null }, RESET_AFTER)
              const delay = Math.min(biCount * STEP, MAX_DELAY)
              el.style.transitionDelay = delay > 0 ? `${delay.toFixed(2)}s` : '0s'
              el.classList.add('vis')
              biCount++
            } else {
              el.style.transitionDelay = '0s'
              el.classList.remove('vis')
            }
          })
        },
        { threshold: 0.06, rootMargin: '0px 0px 0px 0px' }
      )

      document.querySelectorAll('.sr, .sr-s').forEach((el) => obsOnce.observe(el))
      document.querySelectorAll('.sr-bi').forEach((el) => obsBi.observe(el))
    </script>
  </body>
</html>
