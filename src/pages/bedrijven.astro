---
/**
 * /bedrijven — la página para EMPRESAS, en neerlandés (10/11/2026).
 *
 * Segunda vuelta, mirando udia.es/empresas: más corta, con el dolor del
 * empresario a la vista y una CALCULADORA: cuántos empleados hispanohablantes
 * tienen problemas con el neerlandés → horas y dinero perdidos al año.
 * Todos los botones van a WhatsApp con «quiero formar a mi equipo de N
 * personas», con el N de la calculadora.
 *
 * Reglas al tocarla:
 * - SOLO datos reales de la formación (16 semanas, 10 módulos, masterclass
 *   semanal, grupos de conversación, consultas en menos de 24 h, certificado,
 *   6 meses de acceso). Sin precio (no está decidido) ni opiniones.
 * - La calculadora es una ESTIMACIÓN y lo dice: sus supuestos van escritos
 *   debajo (CALC). Si se cambian, cambiar también el texto.
 * - Lleva el aviso de cookies (`consentimiento`): Google y Meta solo se
 *   cargan si se aceptan.
 * - Fuera de Google de momento (noindex).
 */
import Layout from '../layouts/Layout.astro'

const WHATSAPP = '31616084212'
// Supuestos de la calculadora (por empleado con dificultades con el idioma):
// horas por semana que se pierden entre el empleado y el compañero que le
// traduce, repite o arregla lo mal entendido; semanas laborables; coste/hora.
const CALC = { horasSemana: 2, semanas: 46, euroHora: 25, porDefecto: 5, max: 100 }

const LOGO = '/img/black-friday/logo-nawar.webp'

const ICONO: Record<string, string> = {
  wa: 'M7.9 20A9 9 0 1 0 4 16.1L2 22z',
  pijl: 'M5 12h14M12 5l7 7-7 7',
  tolk: 'M5 8l6 6M4 14l6-6 2-3M2 5h12M7 2h1M22 22l-5-10-5 10M14 18h6',
  herhaal: 'M17 1l4 4-4 4M3 11V9a4 4 0 0 1 4-4h14M7 23l-4-4 4-4M21 13v2a4 4 0 0 1-4 4H3',
  fout: 'M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0zM12 9v4M12 17h.01',
  deur: 'M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9',
  boek: 'M4 19.5A2.5 2.5 0 0 1 6.5 17H20V2H6.5A2.5 2.5 0 0 0 4 4.5v15zM4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5',
  live: 'M23 7l-7 5 7 5V7zM14 5H3a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2z',
  groep: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  vraag: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z',
  mobiel: 'M17 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zM12 18h.01',
  cert: 'M12 15a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM8.2 13.9 7 23l5-3 5 3-1.2-9.1',
  klok: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM12 6v6l4 2',
  euro: 'M4 10h12M4 14h9M19 6a7.7 7.7 0 0 0-5.2-2A7.9 7.9 0 0 0 6 12c0 4.4 3.5 8 7.8 8 2 0 3.8-.8 5.2-2',
  dag: 'M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zM16 2v4M8 2v4M3 10h18',
}

const PIJN = [
  { i: 'tolk', t: 'Collega’s die moeten vertalen', d: 'Iemand uit het team stopt met zijn eigen werk om uit te leggen wat er bedoeld wordt.' },
  { i: 'herhaal', t: 'Alles twee keer zeggen', d: 'Instructies, planningen en afspraken worden herhaald, of overgezet naar het Engels.' },
  { i: 'fout', t: 'Werk dat over moet', d: 'Een half begrepen opdracht wordt verkeerd uitgevoerd. Dat kost tijd, materiaal en soms een klant.' },
  { i: 'deur', t: 'Goede mensen die vertrekken', d: 'Wie er in het team niet bij hoort, haakt sneller af. Dan begin je opnieuw met werven.' },
]

const INHOUD = [
  { i: 'boek', t: 'Lessen in hun eigen taal', d: 'Video, woordenschat, oefeningen, lezen, luisteren en spreken. Alles uitgelegd in het Spaans.' },
  { i: 'live', t: 'Elke week een live masterclass', d: 'Eén onderwerp per week, live uitgelegd door een docent en direct toe te passen.' },
  { i: 'groep', t: 'Twee keer per week spreken', d: 'Conversatiegroepen in kleine groepjes, met begeleiding. Zo durven ze het te gebruiken.' },
  { i: 'vraag', t: 'Antwoord binnen 24 uur', d: 'Iets niet begrepen? Ze stellen hun vraag aan de docenten en krijgen snel uitleg.' },
  { i: 'mobiel', t: '20 tot 30 minuten per dag', d: 'Op telefoon of laptop, wanneer het uitkomt. Geen lokaal, geen reistijd.' },
  { i: 'cert', t: 'Certificaat bij afronding', d: 'Een duidelijk eindpunt: van nul tot niveau A1 in 16 weken.' },
]

const MODULES = [
  'Over jezelf', 'Familie en vrienden', 'Eten en drinken', 'Het werk', 'Hobby’s en vrije tijd',
  'Thuis en wonen', 'Gezondheid', 'Vervoer en reizen', 'De stad en afspraken', 'Dagelijks leven',
]

const VRAGEN = [
  { v: 'Moeten ze al Nederlands spreken?', a: 'Nee. De opleiding begint bij nul en bouwt op tot niveau A1.' },
  { v: 'Voor wie is het?', a: 'Voor Spaanstalige medewerkers in Nederland en België. De uitleg is in het Spaans, de taal die ze leren is Nederlands.' },
  { v: 'Hoeveel tijd kost het?', a: 'Het programma duurt 16 weken, met 20 tot 30 minuten per dag en een live les per week. Ze hebben 6 maanden toegang.' },
  { v: 'Onder of na werktijd?', a: 'Dat bepaal je zelf. Alles is online, dus beide kan.' },
  { v: 'Wat kost het?', a: 'Dat hangt af van het aantal medewerkers. Stuur ons een bericht en je krijgt binnen 24 uur een voorstel op maat.' },
]

const fmt = (n: number) => n.toLocaleString('nl-NL')
const uren0 = CALC.porDefecto * CALC.horasSemana * CALC.semanas
const euro0 = uren0 * CALC.euroHora
const dagen0 = Math.round(uren0 / 8)
const tekst0 = `Hallo! Ik wil mijn team van ${CALC.porDefecto} medewerkers Nederlands laten leren bij Holandés Nawar.`
const WA0 = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(tekst0)}`
---

<Layout
  lang="nl"
  consentimiento={true}
  title="Nederlands voor je Spaanstalige medewerkers | Holandés Nawar"
  description="Je Spaanstalige medewerkers leren Nederlands van nul tot A1 in 16 weken, uitgelegd in het Spaans. Bereken wat de taalbarrière jouw bedrijf nu kost."
  noindex={true}
>
  <header class="bz-bar">
    <div class="bz-wrap bz-bar-in">
      <img src={LOGO} alt="Holandés Nawar" class="bz-logo" width="120" height="34" />
      <a href={WA0} class="bz-bar-cta" data-wa target="_blank" rel="noopener">Ik wil mijn team opleiden</a>
    </div>
  </header>

  <!-- Cabecera -->
  <section class="bz-hero">
    <div class="bz-glow1" aria-hidden="true"></div>
    <div class="bz-glow2" aria-hidden="true"></div>
    <div class="bz-dots" aria-hidden="true"></div>
    <div class="bz-wrap bz-hero-in">
      <div>
        <span class="bz-pill">Opleiding voor bedrijven</span>
        <h1 class="bz-h1">Stop met vertalen, herhalen en herstellen</h1>
        <p class="bz-lead">
          Je Spaanstalige medewerkers leren Nederlands van nul tot A1 in 16 weken, uitgelegd in hun eigen taal.
          Zelfstandiger op de werkvloer, beter in het team.
        </p>
        <div class="bz-ctas">
          <a href="#rekenen" class="bz-btn">Bereken wat het je kost
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONO.pijl} /></svg>
          </a>
          <a href={WA0} class="bz-btn-ghost" data-wa target="_blank" rel="noopener">Praat met ons team
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONO.wa} /></svg>
          </a>
        </div>
      </div>
      <div class="bz-hero-img">
        <img src="/img/black-friday/escuela-todo.webp" alt="Het platform van Holandés Nawar op laptop en telefoon" width="1200" height="900" />
      </div>
    </div>
  </section>

  <!-- Calculadora -->
  <section id="rekenen" class="bz-sec bz-donker">
    <div class="bz-dots" aria-hidden="true"></div>
    <div class="bz-wrap bz-midden">
      <span class="bz-label bz-label-licht">Rekenhulp</span>
      <h2 class="bz-h2 bz-wit">Wat kost de taalbarrière jouw bedrijf?</h2>
      <p class="bz-sub">Kies hoeveel Spaanstalige medewerkers moeite hebben met het Nederlands.</p>

      <div class="bz-calc" data-calc={JSON.stringify(CALC)}>
        <span class="bz-calc-label">Medewerkers</span>
        <output class="bz-calc-n" id="bz-n">{CALC.porDefecto}</output>
        <input type="range" id="bz-range" min="1" max={CALC.max} value={CALC.porDefecto} aria-label="Aantal medewerkers" />
        <div class="bz-chips">
          {[1, 3, 5, 10, 25, 50].map((n) => <button type="button" data-n={n}>{n}</button>)}
        </div>

        <div class="bz-uitkomst">
          <div class="bz-tegel">
            <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONO.klok} /></svg>Uren verloren per jaar</span>
            <strong id="bz-uren">{fmt(uren0)} u</strong>
          </div>
          <div class="bz-tegel">
            <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONO.euro} /></svg>Geschatte kosten per jaar</span>
            <strong id="bz-euro">€ {fmt(euro0)}</strong>
          </div>
          <div class="bz-tegel">
            <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONO.dag} /></svg>Dat zijn volle werkdagen</span>
            <strong id="bz-dagen">{fmt(dagen0)}</strong>
          </div>
        </div>
        <p class="bz-noot">
          Indicatieve schatting: {CALC.horasSemana} uur per week per medewerker aan vertalen, herhalen, uitleggen en
          herstellen (de medewerker en de collega die helpt samen), {CALC.semanas} werkweken en € {CALC.euroHora} per uur.
        </p>
        <a href={WA0} class="bz-btn bz-btn-groot" data-wa target="_blank" rel="noopener">
          <span id="bz-cta">Ik wil mijn team van {CALC.porDefecto} opleiden</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONO.wa} /></svg>
        </a>
        <p class="bz-onder">Antwoord binnen 24 uur · Voorstel op maat</p>
      </div>
    </div>
  </section>

  <!-- El dolor -->
  <section class="bz-sec">
    <div class="bz-wrap">
      <span class="bz-label">Herkenbaar?</span>
      <h2 class="bz-h2">Goede mensen, maar de taal zit in de weg</h2>
      <div class="bz-grid2">
        {PIJN.map((p) => (
          <div class="bz-kaart">
            <svg class="bz-ico" viewBox="0 0 24 24" aria-hidden="true"><path d={ICONO[p.i]} /></svg>
            <div>
              <h3 class="bz-h3">{p.t}</h3>
              <p>{p.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Qué incluye -->
  <section class="bz-sec bz-licht">
    <div class="bz-wrap">
      <span class="bz-label">Wat ze krijgen</span>
      <h2 class="bz-h2">Een complete opleiding, niet een losse cursus</h2>
      <p class="bz-sub bz-sub-donker">
        De meeste taalcursussen leggen alles uit in het Nederlands of Engels. Wie bij nul begint, haakt daar af.
        Bij ons is de uitleg in het Spaans, dus ze begrijpen vanaf les één wat ze doen.
      </p>
      <div class="bz-grid3">
        {INHOUD.map((v) => (
          <div class="bz-kaart bz-kaart-wit">
            <svg class="bz-ico" viewBox="0 0 24 24" aria-hidden="true"><path d={ICONO[v.i]} /></svg>
            <div>
              <h3 class="bz-h3">{v.t}</h3>
              <p>{v.d}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="bz-modules">
        <span class="bz-modules-titel">10 modules over werk en dagelijks leven</span>
        <ol>
          {MODULES.map((m, n) => <li><b>{n + 1}</b>{m}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <!-- Pasos -->
  <section class="bz-sec">
    <div class="bz-wrap">
      <span class="bz-label">Zo werkt het</span>
      <h2 class="bz-h2">In drie stappen van start</h2>
      <div class="bz-stappen">
        <div><span class="bz-nr"><i>1</i></span><h3 class="bz-h3">Stuur ons een bericht</h3><p>Vertel hoeveel medewerkers het betreft en in welke sector je werkt.</p></div>
        <div><span class="bz-nr"><i>2</i></span><h3 class="bz-h3">Voorstel op maat</h3><p>Binnen 24 uur krijg je een voorstel met plaatsen, startdatum en prijs.</p></div>
        <div><span class="bz-nr"><i>3</i></span><h3 class="bz-h3">Je team begint</h3><p>Ze krijgen toegang tot het platform en de live lessen en starten bij les 1.</p></div>
      </div>
    </div>
  </section>

  <!-- Preguntas -->
  <section class="bz-sec bz-licht">
    <div class="bz-wrap bz-smal">
      <span class="bz-label">Veelgestelde vragen</span>
      <h2 class="bz-h2">Goed om te weten</h2>
      <div class="bz-faq">
        {VRAGEN.map((q) => (
          <details>
            <summary>{q.v}</summary>
            <p>{q.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Cierre -->
  <section class="bz-sec bz-donker bz-slot">
    <div class="bz-glow1" aria-hidden="true"></div>
    <div class="bz-dots" aria-hidden="true"></div>
    <div class="bz-wrap bz-smal bz-midden">
      <h2 class="bz-h2 bz-wit">Klaar om je team verder te helpen?</h2>
      <p class="bz-sub">Stuur ons een bericht. Je krijgt binnen 24 uur een voorstel op maat, zonder verplichtingen.</p>
      <a href={WA0} class="bz-btn bz-btn-groot" data-wa target="_blank" rel="noopener">
        Ik wil mijn team opleiden
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONO.wa} /></svg>
      </a>
      <p class="bz-onder">of mail naar <a href="mailto:info@holandesnawar.com">info@holandesnawar.com</a></p>
    </div>
  </section>

  <footer class="bz-voet">
    <div class="bz-wrap bz-voet-in">
      <span>© {new Date().getFullYear()} Holandés Nawar</span>
      <span class="bz-voet-links">
        <a href="https://www.holandesnawar.com/">holandesnawar.com</a>
        <a href="/politica-de-privacidad">Privacybeleid</a>
        <button type="button" onclick="window.nawarCookies && window.nawarCookies.abrir()">Cookies</button>
      </span>
    </div>
  </footer>
</Layout>

<script is:inline define:vars={{ WHATSAPP }}>
  (function () {
    var caja = document.querySelector('[data-calc]')
    if (!caja) return
    var C = JSON.parse(caja.getAttribute('data-calc'))
    var range = document.getElementById('bz-range')
    var fmt = function (n) { return Math.round(n).toLocaleString('nl-NL') }
    function pinta(n) {
      n = Math.max(1, Math.min(C.max, Math.round(n)))
      range.value = n
      range.style.setProperty('--p', ((n - 1) / (C.max - 1)) * 100 + '%')
      var uren = n * C.horasSemana * C.semanas
      document.getElementById('bz-n').textContent = n
      document.getElementById('bz-uren').textContent = fmt(uren) + ' u'
      document.getElementById('bz-euro').textContent = '€ ' + fmt(uren * C.euroHora)
      document.getElementById('bz-dagen').textContent = fmt(uren / 8)
      document.getElementById('bz-cta').textContent = 'Ik wil mijn team van ' + n + ' opleiden'
      caja.querySelectorAll('[data-n]').forEach(function (b) { b.classList.toggle('on', +b.dataset.n === n) })
      var tekst = 'Hallo! Ik wil mijn team van ' + n + (n === 1 ? ' medewerker' : ' medewerkers') + ' Nederlands laten leren bij Holandés Nawar.'
      var url = 'https://wa.me/' + WHATSAPP + '?text=' + encodeURIComponent(tekst)
      document.querySelectorAll('[data-wa]').forEach(function (a) { a.href = url })
    }
    range.addEventListener('input', function () { pinta(+range.value) })
    caja.querySelectorAll('[data-n]').forEach(function (b) {
      b.addEventListener('click', function () { pinta(+b.dataset.n) })
    })
    pinta(+range.value)
  })()
</script>

<style>
  :global(body) { background: #fff; }
  .bz-wrap { max-width: 1104px; margin: 0 auto; padding: 0 24px; position: relative; }
  .bz-smal { max-width: 760px; }
  .bz-midden { text-align: center; }
  p { margin: 0; }

  .bz-bar { position: sticky; top: 0; z-index: 50; background: rgba(29, 0, 132, .92); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(255,255,255,.08); }
  .bz-bar-in { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .bz-logo { height: 34px; width: auto; }
  .bz-bar-cta { font: 700 14px/1 Inter, system-ui, sans-serif; color: #0a1656; background: #4da3ff; padding: 12px 16px; border-radius: 8px; text-decoration: none; }
  .bz-bar-cta:hover { background: #5eb4ff; }

  .bz-hero { position: relative; overflow: hidden; background: #1D0084; color: #fff; padding: 64px 0 72px; }
  .bz-glow1 { position: absolute; width: 760px; height: 760px; right: -220px; top: -320px; background: radial-gradient(circle, rgba(11,109,240,.42) 0%, transparent 65%); pointer-events: none; }
  .bz-glow2 { position: absolute; width: 620px; height: 620px; left: -260px; bottom: -340px; background: radial-gradient(circle, rgba(11,109,240,.2) 0%, transparent 65%); pointer-events: none; }
  .bz-dots { position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(255,255,255,.06) 1px, transparent 1px); background-size: 28px 28px; pointer-events: none; }
  .bz-hero-in { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .bz-pill { display: inline-block; font: 700 12px/1 Inter, system-ui, sans-serif; letter-spacing: .08em; text-transform: uppercase; color: #fff; background: #025dc7; padding: 8px 12px; border-radius: 999px; }
  .bz-h1 { font: 700 clamp(36px, 5vw, 58px)/1.06 Poppins, system-ui, sans-serif; letter-spacing: -.035em; margin: 20px 0 18px; color: #fff; }
  .bz-lead { font: 400 18.5px/1.6 Inter, system-ui, sans-serif; color: rgba(255,255,255,.92); max-width: 540px; }
  .bz-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .bz-btn, .bz-btn-ghost { display: inline-flex; align-items: center; justify-content: center; gap: 10px; font: 700 15.5px/1 Inter, system-ui, sans-serif; padding: 16px 22px; border-radius: 10px; text-decoration: none; }
  .bz-btn { color: #0a1656; background: #4da3ff; }
  .bz-btn:hover { background: #5eb4ff; }
  .bz-btn-ghost { color: #fff; border: 1px solid rgba(255,255,255,.3); background: rgba(255,255,255,.04); font-weight: 600; }
  .bz-btn-ghost:hover { border-color: #fff; }
  .bz-btn svg, .bz-btn-ghost svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .bz-hero-img img { width: 100%; height: auto; display: block; }

  .bz-sec { position: relative; padding: 88px 0; background: #fff; overflow: hidden; }
  .bz-licht { background: #F0F5FF; }
  .bz-donker { background: #1D0084; }
  .bz-label { display: block; font: 700 12px/1 Inter, system-ui, sans-serif; letter-spacing: .14em; text-transform: uppercase; color: #025dc7; margin-bottom: 14px; }
  .bz-label-licht { color: #4da3ff; }
  .bz-h2 { font: 700 clamp(28px, 3.6vw, 42px)/1.15 Poppins, system-ui, sans-serif; letter-spacing: -.025em; color: #1D0084; margin: 0 0 16px; max-width: 760px; }
  .bz-midden .bz-h2 { margin-left: auto; margin-right: auto; }
  .bz-wit { color: #fff; }
  .bz-sub { font: 400 18px/1.6 Inter, system-ui, sans-serif; color: rgba(255,255,255,.9); max-width: 640px; margin: 0 auto; }
  .bz-sub-donker { color: #171a2e; margin: 0 0 36px; max-width: 720px; }
  .bz-h3 { font: 600 17.5px/1.35 Poppins, system-ui, sans-serif; color: #0a1656; margin: 0 0 6px; }

  /* Calculadora */
  .bz-calc { margin: 40px auto 0; max-width: 940px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); border-radius: 26px; padding: 40px 40px 32px; }
  .bz-calc-label { display: block; font: 500 15px/1 Inter, system-ui, sans-serif; color: rgba(255,255,255,.75); }
  .bz-calc-n { display: block; font: 700 76px/1.1 Poppins, system-ui, sans-serif; color: #fff; margin: 6px 0 14px; }
  #bz-range { -webkit-appearance: none; appearance: none; width: 100%; max-width: 620px; height: 8px; border-radius: 999px; outline: none; cursor: pointer;
    background: linear-gradient(to right, #4da3ff var(--p, 4%), rgba(255,255,255,.85) var(--p, 4%)); }
  #bz-range::-webkit-slider-thumb { -webkit-appearance: none; width: 24px; height: 24px; border-radius: 50%; background: #4da3ff; border: 3px solid #fff; box-shadow: 0 2px 10px rgba(0,0,0,.3); }
