  { naam: 'Paul Plaat', rol: 'Onderwijskundig leider', bio: 'Bewaakt de inhoud en de opbouw van alle modules.', foto: '/img/equipo/paul.webp' },
  { naam: 'Bas Wanders', rol: 'Docent', bio: 'Moedertaalspreker, geeft les en werkt mee aan de modules.', foto: '/img/equipo/bas.webp' },
