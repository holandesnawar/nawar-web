---
/**
 * /proceso-de-admision — pasos 1 y 2 del embudo nuevo (02/10).
 *
 * Paso 1: el vídeo se ve bloqueado. Al darle al play sale una ventanita con
 * tres datos (nombre, correo y WhatsApp con su prefijo). Al mandarlos, la
 * escuela ya tiene el lead (sale en Panel → Llamadas como "No terminó",
 * marcado "Proceso de admisión") y el vídeo arranca.
 *
 * Paso 2: el vídeo. El botón "Siguiente paso" está a la vista desde el
 * principio pero BLOQUEADO, y se desbloquea y se ilumina al terminar el
 * vídeo (pedido del usuario: que se vea que hay un paso más y que se gana
 * viendo el vídeo). Si el reproductor no deja saber cuándo termina (un
 * bloqueador, un fallo de red), el botón se abre solo: nadie se queda
 * atascado por un fallo nuestro.
 *
 * El paso 3 vive en /proceso-de-admision/paso-3, con los datos ya puestos.
 * Ver src/lib/admision.ts para el porqué de todo el embudo.
 */
import Layout from '../../layouts/Layout.astro'
import { PREFIJOS, PREVIEW_DESDE, PREVIEW_HASTA, VIDEO_DURACION, VIDEO_PORTADA, VIDEO_URL, leerVideo } from '../../lib/admision'

export const prerender = true

const video = leerVideo(VIDEO_URL)
const opciones = PREFIJOS.map((p, i) => ({ ...p, valor: `${i}` }))
---

<Layout
  title="Proceso de admisión — Holandés Nawar"
  description="Proceso de admisión a la Formación Nawar A0-A1."
  noindex={true}
>
  <div class="ad-page">
    <div class="ad-glow1" aria-hidden="true"></div>
    <div class="ad-glow2" aria-hidden="true"></div>
    <div class="ad-dots" aria-hidden="true"></div>

    <div class="ad-shell">
      <a href="/" class="ad-logo-link" aria-label="Volver al inicio">
        <img src="https://d1yei2z3i6k35z.cloudfront.net/9533860/671a9c9265e23_Logo_Nawar_2.png" alt="Holandés Nawar" class="ad-logo" width="150" height="38" />
      </a>

      <!-- Los tres pasos, siempre a la vista: que se sepa que esto es un proceso. -->
      <div class="ad-pasos" id="ad-pasos" data-paso="1">
        <p class="ad-eyebrow">Proceso de admisión · <span id="ad-paso-texto">Paso 1 de 3</span></p>
        <ol class="ad-linea">
          <li data-n="1"><span class="ad-bolita">1</span><span class="ad-paso-nombre">Datos</span></li>
          <li data-n="2"><span class="ad-bolita">2</span><span class="ad-paso-nombre">Método</span></li>
          <li data-n="3"><span class="ad-bolita">3</span><span class="ad-paso-nombre">Matrícula</span></li>
        </ol>
      </div>

      <h1 class="ad-title">El método para llegar al A1 en&nbsp;16&nbsp;semanas</h1>
      <p class="ad-lead">
        <strong>Mira el vídeo entero:</strong> verás cómo es la formación por dentro y si encaja contigo.
        Al terminar, se abre el último paso de tu matrícula.
      </p>

      <!-- El vídeo: bloqueado hasta dejar los datos. -->
      <div class="ad-video" id="ad-video" data-proveedor={video.proveedor} data-src={video.src} data-preview-desde={PREVIEW_DESDE} data-preview-hasta={PREVIEW_HASTA}>
        <!-- La previsualización: el vídeo en silencio y en bucle, detrás del
             candado, para que se vea lo que hay dentro (03/10). -->
        <div class="ad-preview" id="ad-preview" aria-hidden="true"></div>
        <button type="button" class="ad-candado" id="ad-candado" aria-label="Desbloquear el vídeo"
          style={VIDEO_PORTADA ? `background-image:linear-gradient(rgba(10,22,86,0.55),rgba(10,22,86,0.75)),url('${VIDEO_PORTADA}')` : undefined}>
          <span class="ad-play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l10.9-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14Z"/></svg>
          </span>
          <span class="ad-barra">
            <span class="ad-candado-texto">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
              Deja tus datos para verlo
            </span>
            {VIDEO_DURACION ? <span class="ad-duracion">{VIDEO_DURACION}</span> : null}
          </span>
        </button>
        <div class="ad-reproductor" id="ad-reproductor" hidden></div>
      </div>

      <!-- El botón del paso 3: siempre a la vista, bloqueado hasta el final del vídeo. -->
      <div class="ad-seguir">
        <a href="/proceso-de-admision/paso-3" class="ad-btn-seguir" id="ad-seguir" aria-disabled="true" tabindex="-1">
          <svg class="ad-ico-candado" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
          <span>Completar mi matrícula</span>
          <span class="ad-flecha" aria-hidden="true">›</span>
        </a>
        <p class="ad-seguir-nota" id="ad-seguir-nota">Se desbloquea al terminar el vídeo.</p>
      </div>
    </div>

    <!-- Paso 1: la ventanita de datos. -->
    <div class="ad-modal" id="ad-modal" hidden>
      <div class="ad-modal-fondo" data-cerrar></div>
      <div class="ad-modal-caja" role="dialog" aria-modal="true" aria-labelledby="ad-modal-titulo">
        <button type="button" class="ad-cerrar" data-cerrar aria-label="Cerrar">×</button>
        <p class="ad-modal-eyebrow">Paso 1 de 3 · Tus datos</p>
        <h2 class="ad-modal-titulo" id="ad-modal-titulo">Desbloquea el vídeo</h2>
        <p class="ad-modal-lead">Déjanos tus datos y empieza tu proceso de admisión.</p>
        <form id="ad-form" novalidate>
          <div class="ad-honeypot" aria-hidden="true">
            <label>No rellenar <input type="text" id="ad-hp" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <label class="ad-label" for="ad-nombre">Nombre</label>
          <input id="ad-nombre" type="text" class="ad-input" placeholder="Tu nombre" autocomplete="given-name" required />

          <label class="ad-label" for="ad-email">Correo</label>
          <input id="ad-email" type="email" class="ad-input" placeholder="correo@ejemplo.com" autocomplete="email" required />

          <label class="ad-label" for="ad-tel">WhatsApp</label>
          <div class="ad-tel">
            <!-- Cerrado enseña solo bandera y prefijo; al abrirlo, la lista con
                 el país. El select va encima, transparente, para que el
                 desplegable sea el del móvil (el que mejor se usa). -->
            <div class="ad-input ad-prefijo">
              <span id="ad-prefijo-ver" aria-hidden="true">{opciones[0].bandera} {opciones[0].prefijo}</span>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              <select id="ad-prefijo" aria-label="Prefijo del país">
                {opciones.map((p) => <option value={p.valor} data-prefijo={p.prefijo} data-pais={p.pais} data-bandera={p.bandera}>{p.bandera} {p.pais} ({p.prefijo})</option>)}
              </select>
            </div>
            <input id="ad-tel" type="tel" class="ad-input" placeholder="6 12345678" autocomplete="tel-national" inputmode="tel" required />
          </div>

          <p class="ad-err" id="ad-err">Revisa el nombre, el correo y el número.</p>
          <button type="submit" class="ad-btn" id="ad-enviar">
            Ver el vídeo
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
          <p class="ad-legal">Al continuar aceptas la <a href="/politica-de-privacidad" target="_blank" rel="noopener">política de privacidad</a>. Nada de spam.</p>
        </form>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { leerUTM, guardarUTM } from '../../lib/utm'
  import { contextoDelLead } from '../../lib/recorrido'
  import { CLAVE_DATOS, CLAVE_POSICION, CLAVE_VIDEO, telefonoCompleto, type DatosAdmision } from '../../lib/admision'
  guardarUTM()

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T
  const caja = $('ad-video')
  const candado = $('ad-candado')
  const reproductor = $('ad-reproductor')
  const modal = $('ad-modal')
  const form = $<HTMLFormElement>('ad-form')
  const seguir = $<HTMLAnchorElement>('ad-seguir')
  const nota = $('ad-seguir-nota')
  const pasos = $('ad-pasos')
  const pasoTexto = $('ad-paso-texto')
  const proveedor = caja.dataset.proveedor || ''
  const src = caja.dataset.src || ''



  // ── Lo que se recuerda en el navegador ────────────────────────────────
  // Si vuelve mañana, no tiene que volver a dar los datos ni a ver el vídeo.
  const leer = <T,>(k: string): T | null => {
    try { const v = localStorage.getItem(k); return v ? (JSON.parse(v) as T) : null } catch { return null }
  }
  const guardar = (k: string, v: unknown) => { try { localStorage.setItem(k, JSON.stringify(v)) } catch {} }

  let datos = leer<DatosAdmision>(CLAVE_DATOS)
  let estadoVideo: 'empezado' | 'visto' = leer<string>(CLAVE_VIDEO) === 'visto' ? 'visto' : 'empezado'

  // ── La línea de pasos ─────────────────────────────────────────────────
  const marcarPaso = (n: number) => {
    pasos.dataset.paso = String(n)
    pasoTexto.textContent = `Paso ${Math.min(n, 3)} de 3`
  }

  // ── Avisar a la escuela (por la misma puerta que /agendar) ───────────
  // `matricula`: solo al rellenar la ventanita. Ahí la escuela crea su
  // matrícula (solicitud) con de dónde viene; lo demás la va completando.
  // `hito`: los dos momentos que van también a systeme.io con su etiqueta
  // (dejó los datos, vio el vídeo entero).
  const avisar = (video: 'empezado' | 'visto', matricula = false, hito: '' | 'datos' | 'video' = '') => {
    if (!datos) return
    try {
      fetch('/api/cualificacion', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        keepalive: true,
        body: JSON.stringify({
          parcial: true,
          matricula,
          hito,
          embudo: 'admision',
          video,
          first_name: datos.first_name,
          last_name: '',
          email: datos.email,
          phone: datos.phone,
          website: ($('ad-hp') as HTMLInputElement).value,
          respuestas: {},
          textos: {},
          ...contextoDelLead(),
          ...leerUTM(),
        }),
      }).catch(() => {})
    } catch {}
  }

  // Píxel de Meta: dejar los datos cuenta como solicitud (el mismo evento y
  // la misma marca de sesión que /agendar, para no contar dos veces a quien
  // pase por los dos). Terminar el vídeo, su propio evento.
  const pixel = (evento: 'datos' | 'video') => {
    const fbq = (window as any).fbq
    try {
      if (evento === 'datos') {
        if (sessionStorage.getItem('lead-agendar')) return
        sessionStorage.setItem('lead-agendar', '1')
        fbq?.('track', 'SubmitApplication', { content_name: 'Proceso de admisión' })
      } else {
        if (sessionStorage.getItem('admision-video')) return
        sessionStorage.setItem('admision-video', '1')
        fbq?.('trackCustom', 'AdmisionVideoVisto')
      }
    } catch {}
  }

  // ── El botón del paso 3 ───────────────────────────────────────────────
  const desbloquear = (porFallo = false) => {
    seguir.setAttribute('aria-disabled', 'false')
    seguir.removeAttribute('tabindex')
    seguir.classList.add('abierto')
    nota.textContent = porFallo ? 'Ya puedes seguir con tu matrícula.' : '¡Vídeo terminado! Ya puedes seguir con tu matrícula.'
    nota.classList.add('abierto')
    marcarPaso(3)
  }
  seguir.addEventListener('click', (e) => {
    if (seguir.getAttribute('aria-disabled') === 'true') {
      e.preventDefault()
      nota.classList.remove('sacudir'); void nota.offsetWidth; nota.classList.add('sacudir')
    }
  })

  const videoTerminado = () => {
    if (estadoVideo !== 'visto') {
      estadoVideo = 'visto'
      guardar(CLAVE_VIDEO, 'visto')
      try { localStorage.removeItem(CLAVE_POSICION) } catch {}
      avisar('visto', false, 'video')
      pixel('video')
    }
    desbloquear()
  }

  // ── El reproductor, según dónde esté el vídeo ─────────────────────────
  // Una sola carga por script, aunque lo pidan la previsualización y el
  // reproductor a la vez.
  const scripts: Record<string, Promise<void>> = {}
  const cargarScript = (url: string) => (scripts[url] ??= new Promise<void>((ok, mal) => {
    const s = document.createElement('script')
    s.src = url; s.async = true
    s.onload = () => ok(); s.onerror = () => { delete scripts[url]; mal(new Error(url)) }
    document.head.appendChild(s)
  }))

  const ponerIframe = () => {
    const f = document.createElement('iframe')
    f.src = src
    f.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media'
    f.allowFullscreen = true
    f.title = 'Vídeo del proceso de admisión'
    f.loading = 'eager'
    reproductor.appendChild(f)
    return f
  }

  // ── Sin saltos: solo play y pausa (03/10, pedido del usuario) ──────────
  // Mientras no lo haya visto entero, si alguien arrastra la barra (adelante
  // o atrás) se le devuelve a donde iba. Y el final solo cuenta si de verdad
  // llegó hasta ahí. Quien ya lo vio entero puede moverse a su gusto.
  //
  // Seguir donde lo dejó (03/10: "que no tenga que volver a iniciar"): el
  // segundo al que llegó se guarda en el navegador y, si vuelve, el vídeo
  // arranca desde ahí. Sin eso, como no se puede adelantar, tendría que
  // verlo entero otra vez.
  let tope = Math.max(0, Number(leer<number>(CLAVE_POSICION)) || 0)
  let duracion = 0
  let guardadoEn = 0
  const libre = () => estadoVideo === 'visto'
  const vigilar = (t: number, irA: (s: number) => void) => {
    if (libre() || !isFinite(t)) return
    if (Math.abs(t - tope) > 1.5) irA(tope)
    else if (t > tope) {
      tope = t
      if (tope - guardadoEn >= 2) { guardadoEn = tope; guardar(CLAVE_POSICION, Math.floor(tope)) }
    }
  }
  /** Desde dónde arranca el reproductor: donde lo dejó (un pelín antes, para
   *  que no empiece a media palabra), o desde el principio. */
  const inicio = () => (libre() || tope < 3 ? 0 : Math.max(0, tope - 2))
  const terminadoDeVerdad = () => {
    if (libre() || !isFinite(duracion) || !duracion || tope >= duracion - 4) videoTerminado()
  }

  // ── La previsualización ───────────────────────────────────────────────
  // Mientras está bloqueado, un trozo del vídeo (del segundo PREVIEW_DESDE al
  // PREVIEW_HASTA) suena en silencio y en bucle de fondo (03/10: "que vean
  // lo que les espera dentro", "no todo el vídeo"). En silencio el navegador
  // sí deja arrancarlo solo, también en el iPhone. No se puede tocar: el clic
  // va siempre al candado. Al desbloquear se quita y entra el reproductor de
  // verdad, desde el principio y con sonido.
  const preview = $('ad-preview')
  const desde = Number(caja.dataset.previewDesde || 0)
  const hasta = Number(caja.dataset.previewHasta || 0)
  const enBucle = (t: number, irA: (s: number) => void) => {
    if (hasta > desde && (t >= hasta || t < desde - 1)) irA(desde)
  }
  const ponerPreview = async () => {
    if (!src || (proveedor !== 'bunny' && proveedor !== 'mp4')) return
    caja.classList.add('con-preview')
    if (proveedor === 'mp4') {
      const v = document.createElement('video')
      v.src = src; v.muted = true; v.autoplay = true; v.playsInline = true
      v.addEventListener('loadedmetadata', () => { v.currentTime = desde })
      v.addEventListener('timeupdate', () => enBucle(v.currentTime, (t) => (v.currentTime = t)))
      preview.appendChild(v)
      v.play().catch(() => {})
      return
    }
    // ⚠️ player.js PRIMERO y el iframe después: si el reproductor termina de
    // cargar antes que el script, su aviso de "listo" se pierde, no llegan
    // los tiempos y el trozo no se corta (pasó: se veía el vídeo entero).
    try {
      await cargarScript('https://assets.mediadelivery.net/playerjs/player-0.1.0.min.js')
    } catch {}
    if (!preview.isConnected || !caja.classList.contains('con-preview')) return
    // Dos maneras de cortar el trozo, y van las dos a la vez (03/10: con
    // solo la primera "se ve el vídeo entero"):
    //  1. player.js: al pasar del segundo final, vuelve al inicial. Depende de
    //     que Bunny mande los tiempos, y no siempre llegan.
    //  2. El reloj: si en ese rato no ha llegado ningún tiempo, se monta un
    //     reproductor nuevo que arranca otra vez en el segundo inicial (`t=`),
    //     encima del viejo, y el viejo se quita cuando el nuevo ya se ve. Así
    //     el bucle no depende de nada de Bunny salvo el `t=`.
    let ultimaSenal = 0
    const montar = () => {
      const f = document.createElement('iframe')
      f.src = `${src}&muted=true&t=${desde}`
      f.allow = 'autoplay; encrypted-media'
      f.tabIndex = -1
      f.title = ''
      preview.appendChild(f)
      try {
        const p = new (window as any).playerjs.Player(f)
        p.on('ready', () => {
          p.mute?.()
          p.setCurrentTime(desde)
          p.play?.()
          p.on('timeupdate', (e: { seconds: number }) => {
            ultimaSenal = Date.now()
            enBucle(e?.seconds, (t) => p.setCurrentTime(t))
          })
        })
      } catch {}
      // El reproductor anterior se va cuando el nuevo ya ha tenido tiempo de
      // arrancar: sin pantallazo negro en medio.
      const viejos = Array.from(preview.querySelectorAll('iframe')).filter((x) => x !== f)
      if (viejos.length) setTimeout(() => viejos.forEach((x) => x.remove()), 1800)
    }
    montar()
    const tramo = Math.max(3, hasta - desde) * 1000
    let montadoEn = Date.now()
    const reloj = window.setInterval(() => {
      if (!caja.classList.contains('con-preview')) { clearInterval(reloj); return }
      const conTiempos = Date.now() - ultimaSenal < 3000
      // Se monta el nuevo un pelín antes del final del tramo, porque tarda en
      // arrancar.
      if (!conTiempos && Date.now() - montadoEn >= tramo - 1200) {
        montadoEn = Date.now()
        montar()
      }
    }, 500)
  }
  const quitarPreview = () => {
    preview.innerHTML = ''
    caja.classList.remove('con-preview')
  }

  const arrancarVideo = async () => {
    quitarPreview()
    candado.hidden = true
    reproductor.hidden = false
    marcarPaso(estadoVideo === 'visto' ? 3 : 2)
    if (!src) {
      // Sin vídeo puesto todavía: aviso y el paso 3 abierto.
      reproductor.innerHTML = '<p class="ad-sin-video">El vídeo se está preparando. Mientras tanto, puedes seguir con tu matrícula.</p>'
      desbloquear(true)
      return
    }
    try {
      if (proveedor === 'mp4') {
        const v = document.createElement('video')
        v.src = src; v.controls = true; v.playsInline = true; v.autoplay = true
        v.addEventListener('loadedmetadata', () => {
          duracion = v.duration || 0
          if (inicio() > 0) { tope = inicio(); v.currentTime = tope }
        })
        v.addEventListener('timeupdate', () => vigilar(v.currentTime, (t) => (v.currentTime = t)))
        v.addEventListener('ended', terminadoDeVerdad)
        reproductor.appendChild(v)
        v.play().catch(() => {})
      } else if (proveedor === 'bunny') {
        // player.js antes que el iframe (ver la previsualización).
        await cargarScript('https://assets.mediadelivery.net/playerjs/player-0.1.0.min.js')
        const f = ponerIframe()
        const p = new (window as any).playerjs.Player(f)
        p.on('ready', () => {
          if (inicio() > 0) { tope = inicio(); p.setCurrentTime(tope) }
          p.getDuration((d: number) => (duracion = d || 0))
          p.on('timeupdate', (e: { seconds: number; duration?: number }) => {
            if (e?.duration) duracion = e.duration
            vigilar(e?.seconds, (t) => p.setCurrentTime(t))
          })
          p.on('ended', terminadoDeVerdad)
        })
      } else if (proveedor === 'vimeo') {
        const f = ponerIframe()
        await cargarScript('https://player.vimeo.com/api/player.js')
        const vp = new (window as any).Vimeo.Player(f)
        if (inicio() > 0) { tope = inicio(); vp.setCurrentTime(tope).catch(() => {}) }
        vp.on('timeupdate', (e: { seconds: number; duration: number }) => {
          duracion = e.duration || duracion
          vigilar(e.seconds, (t) => vp.setCurrentTime(t))
        })
        vp.on('ended', terminadoDeVerdad)
      } else if (proveedor === 'youtube') {
        const f = ponerIframe()
        f.id = 'ad-yt'
        await new Promise<void>((ok, mal) => {
          ;(window as any).onYouTubeIframeAPIReady = () => ok()
          cargarScript('https://www.youtube.com/iframe_api').catch(mal)
        })
        const yt = new (window as any).YT.Player('ad-yt', {
          events: {
            onReady: () => {
              if (inicio() > 0) { tope = inicio(); yt.seekTo(tope, true) }
              // YouTube no avisa del tiempo: se mira cada medio segundo.
              setInterval(() => {
                duracion = yt.getDuration?.() || duracion
                vigilar(yt.getCurrentTime?.() ?? 0, (t) => yt.seekTo(t, true))
              }, 500)
            },
            onStateChange: (e: { data: number }) => { if (e.data === 0) terminadoDeVerdad() },
          },
        })
      }
    } catch {
      // No se pudo saber cuándo termina (script bloqueado, red…): mejor
      // abrir el paso 3 que dejar a alguien atascado.
      desbloquear(true)
    }
  }

  // ── Paso 1: la ventanita ──────────────────────────────────────────────
  const abrirModal = () => {
    modal.hidden = false
    document.body.style.overflow = 'hidden'
    setTimeout(() => ($('ad-nombre') as HTMLInputElement).focus(), 60)
  }
  const cerrarModal = () => {
    modal.hidden = true
    document.body.style.overflow = ''
  }
  const selPrefijo = $<HTMLSelectElement>('ad-prefijo')
  selPrefijo.addEventListener('change', () => {
    const o = selPrefijo.options[selPrefijo.selectedIndex]
    $('ad-prefijo-ver').textContent = `${o.dataset.bandera} ${o.dataset.prefijo}`
  })
  modal.querySelectorAll('[data-cerrar]').forEach((el) => el.addEventListener('click', cerrarModal))
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) cerrarModal() })

  candado.addEventListener('click', () => (datos ? arrancarVideo() : abrirModal()))

  form.addEventListener('submit', (e) => {
    e.preventDefault()
    const nombre = ($('ad-nombre') as HTMLInputElement).value.trim()
    const email = ($('ad-email') as HTMLInputElement).value.trim().toLowerCase()
    const sel = $('ad-prefijo') as HTMLSelectElement
    const opcion = sel.options[sel.selectedIndex]
    const numero = ($('ad-tel') as HTMLInputElement).value
    const phone = telefonoCompleto(opcion.dataset.prefijo || '', numero)
    const ok = nombre.length > 0 && /\S+@\S+\.\S+/.test(email) && phone.replace(/\D/g, '').length >= 8
    $('ad-err').classList.toggle('visible', !ok)
    if (!ok) return
    datos = { first_name: nombre, email, phone, pais: opcion.dataset.pais || '' }
    guardar(CLAVE_DATOS, datos)
    avisar(estadoVideo, true, 'datos')
    pixel('datos')
    cerrarModal()
    arrancarVideo()
  })

  // ── Al volver ─────────────────────────────────────────────────────────
  if (estadoVideo === 'visto' && datos) desbloquear()
  else if (datos) marcarPaso(2)
  ponerPreview()
</script>

