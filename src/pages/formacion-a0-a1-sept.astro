    <!-- ══════════════════════════════════════════════════════════
         BARRA STICKY MÓVIL
    ══════════════════════════════════════════════════════════ -->
    <div class="mobile-sticky" id="l8-sticky">
      <div class="mobile-sticky-price is-oculto" id="l8-sticky-precio">
        <s>{VALOR_TOTAL}&nbsp;€</s>
        <strong>{PRECIO}&nbsp;€</strong>
      </div>
      <a href={CHECKOUT_URL} class="btn btn-sticky">Obtener acceso</a>
    </div>

  </div>
