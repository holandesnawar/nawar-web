    <section class="consequences">
      <div class="container">
        <div class="consequences-inner" data-anim="fade-up">
          <div>
            <span class="badge-light"><svg class="check-icon" fill="none" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6.5l2.5 2.5 5.5-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>El coste de seguir igual</span>
