<script>
  /* ── Contador de 7 días: nav + tarjeta de precio ─────────── */
  ;(function initCountdown() {
    const KEY = 'nawar_offer_end_l8'
    const WEEK = 7 * 24 * 60 * 60 * 1000

    let end = parseInt(localStorage.getItem(KEY) || '', 10)
    if (!end || isNaN(end) || end < Date.now()) {
      end = Date.now() + WEEK
      localStorage.setItem(KEY, String(end))
    }

    const pad = (n: number) => (n < 10 ? '0' : '') + n
    const navEl = document.getElementById('l8-timer')
    const priceEl = document.getElementById('l8-price-countdown')

    const tick = () => {
      const diff = Math.max(0, end - Date.now())
      const d = Math.floor(diff / 86400000)
      const h = Math.floor((diff % 86400000) / 3600000)
      const m = Math.floor((diff % 3600000) / 60000)
      const s = Math.floor((diff % 60000) / 1000)
      if (navEl) navEl.textContent = `${d}D ${pad(h)}H ${pad(m)}M ${pad(s)}S`
      if (priceEl) priceEl.textContent = `${d}d ${pad(h)}h ${pad(m)}m ${pad(s)}s`
      if (diff === 0) clearInterval(iv)
    }
    const iv = setInterval(tick, 1000)
    tick()
  })()

  /* ── Animaciones de entrada [data-anim] ──────────────────── */
  ;(function initScrollAnimations() {
    const items = document.querySelectorAll('[data-anim]')
    if (!items.length) return
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          const el = entry.target as HTMLElement
          const parent = el.parentElement
          const siblings = parent
            ? [...parent.children].filter(
                (s) => s.hasAttribute('data-anim') && !s.classList.contains('visible')
              )
            : [el]
          const idx = siblings.indexOf(el)
          setTimeout(() => el.classList.add('visible'), idx >= 0 ? idx * 80 : 0)
          obs.unobserve(el)
        })
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    )
    items.forEach((el) => obs.observe(el))
  })()

  /* ── El precio de la barra fija no se enseña de entrada ────
     Iba visible desde el banner y destripaba la cifra antes de haber
     contado nada de lo que incluye. Ahora aparece al llegar a la
     sección de precio y, una vez fuera, ya se queda: el observador se
     desconecta en cuanto dispara. */
  ;(function initPrecioBarra() {
    const precio = document.getElementById('l8-sticky-precio')
    const seccion = document.getElementById('precio')
    if (!precio || !seccion) return
    if (!('IntersectionObserver' in window)) { precio.classList.remove('is-oculto'); return }
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return
          precio.classList.remove('is-oculto')
          obs.disconnect()
        })
      },
      { threshold: 0, rootMargin: '0px 0px -25% 0px' }
    )
    obs.observe(seccion)
  })()

  /* ── Puerta 1: los botones ────────────────────────────────
     Esta página es estática, así que el estado de la matrícula se
     resuelve en cliente. Por defecto los botones se quedan como
     están —abiertos—, y sólo si /api/plazas dice que está cerrada se
     reescriben para llevar a la lista de espera. Si la llamada falla
     no se toca nada: cerrar por un timeout sería dejar de vender, y
     la matrícula redirige igualmente por servidor.

     Se buscan por destino y no por una clase: así entran todos los
     que hay hoy (banner, navbar, barra fija, banda intermedia, stack
     y tarjeta de precio) y los que se añadan mañana. */
  ;(function initPuertas() {
    const DESTINO = '/matricula-formacion-nawar-a0-a1'
    const ESPERA = '/lista-de-espera'

    function textoDe(a: HTMLAnchorElement): Text | null {
      // Solo el texto: los <svg> de la flecha se quedan donde están.
      for (const n of Array.from(a.childNodes)) {
        if (n.nodeType === Node.TEXT_NODE && (n.textContent ?? '').trim()) return n as Text
      }
      return null
    }

    function cerrar() {
      document.querySelectorAll<HTMLAnchorElement>(`a[href="${DESTINO}"]`).forEach((a) => {
        a.href = ESPERA
        const t = textoDe(a)
        // La barra fija de abajo es estrecha y no traga la frase entera.
        const corto = a.closest('.mobile-sticky') || a.classList.contains('l8nav-cta')
        if (t) t.textContent = corto ? 'Lista de espera' : 'Apúntate a la lista de espera'
      })
      // Con las puertas cerradas el precio tachado y el "quedan X" sobran.
      document.querySelectorAll<HTMLElement>('[data-plazas-quedan]').forEach((el) => {
        el.hidden = true
      })
    }

    fetch('/api/plazas', { headers: { accept: 'application/json' } })
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        if (!d) return
        if (d.abierta === false) return cerrar()
        // Escasez de verdad: sale de los cobros, no es un número inventado.
        if (typeof d.quedan === 'number' && d.quedan > 0) {
          document.querySelectorAll<HTMLElement>('[data-plazas-quedan]').forEach((el) => {
            el.textContent = d.quedan === 1 ? 'Queda 1 plaza' : `Quedan ${d.quedan} plazas`
            el.hidden = false
          })
        }
      })
      .catch(() => {})
  })()

  /* ── Acordeón de FAQ ─────────────────────────────────────── */
  ;(function initFAQ() {
    const items = document.querySelectorAll('.faq-item')
    items.forEach((item) => {
      const btn = item.querySelector('.faq-question')
      if (!btn) return
      btn.addEventListener('click', () => {
        const wasOpen = item.classList.contains('open')
        items.forEach((i) => {
          i.classList.remove('open')
          i.querySelector('.faq-question')?.setAttribute('aria-expanded', 'false')
        })
        if (!wasOpen) {
          item.classList.add('open')
          btn.setAttribute('aria-expanded', 'true')
        }
      })
    })
  })()

  /* ── Punto de la sección sticky ──────────────────────────── */
  ;(function initStickyDot() {
    const section = document.querySelector('.differentiators')
    const dot = document.getElementById('sf-dot')
    if (!section || !dot) return
    const START = 0.05
    const END = 0.95
    let ticking = false
    const update = () => {
      const { top, height } = section.getBoundingClientRect()
      const travel = height - window.innerHeight
      const raw = travel > 0 ? -top / travel : 0
      const progress = START + Math.min(Math.max(raw, 0), 1) * (END - START)
      ;(dot as HTMLElement).style.top = progress * 100 + '%'
      ticking = false
    }
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update)
          ticking = true
        }
      },
      { passive: true }
    )
    update()
  })()

  /* ── Barra sticky móvil: se esconde sobre la oferta ──────── */
  ;(function initMobileSticky() {
    const bar = document.getElementById('l8-sticky')
    const offer = document.getElementById('oferta')
    if (!bar || !offer) return
    const obs = new IntersectionObserver(
      (entries) => entries.forEach((e) => bar.classList.toggle('hidden', e.isIntersecting)),
      { threshold: 0.1 }
    )
    obs.observe(offer)
  })()

  /* ── Scroll suave con margen para el nav fijo ────────────── */
  ;(function initSmoothScroll() {
    const OFFSET = 88
    document.querySelectorAll('a[href^="#"]').forEach((link) => {
      link.addEventListener('click', (e) => {
        const id = link.getAttribute('href')!.slice(1)
        const target = document.getElementById(id)
        if (!target) return
        e.preventDefault()
        window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - OFFSET, behavior: 'smooth' })
      })
    })
  })()

  /* ── Barra de progreso del mockup del hero ───────────────── */
  ;(function animateMockupProgress() {
    const fill = document.querySelector('.mockup-progress-fill') as HTMLElement | null
    if (!fill) return
    fill.style.width = '0%'
    const obs = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return
          setTimeout(() => (fill.style.width = '65%'), 400)
          obs.unobserve(e.target)
        }),
      { threshold: 0.3 }
    )
    obs.observe(fill)
  })()
</script>
