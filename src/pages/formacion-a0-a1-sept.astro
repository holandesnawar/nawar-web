  description="La formación de neerlandés diseñada para hispanohablantes. +15 h de vídeo, ejercicios online, clase semanal en directo, comunidad y certificado. Acceso completo por 397 €."
  keywords="curso neerlandés online, formación neerlandés hispanohablantes, aprender holandés desde el español, inburgering, neerlandés A0 A1"
  noindex={true}
>
  <div class="l8">

    <svg class="nw-sprite" aria-hidden="true" focusable="false">
      <defs>

        <!-- Vídeo / lecciones grabadas -->
