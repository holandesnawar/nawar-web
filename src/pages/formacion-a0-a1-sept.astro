---
import Layout from '../layouts/Layout.astro'

/* Sistema de diseño compartido de nawar-web — importado, no modificado */
import '../styles/nawar-sections.css'
import '../styles/landing-08-08-2026.css'

/* Secciones de la landing de venta (rama claude/nifty-allen-bPkds),
   copiadas a una carpeta propia para no tocar nada del repo */
import PilaresSection from '../components/landing-08-08-2026/PilaresSection.astro'
import MetodoFunciona from '../components/landing-08-08-2026/MetodoFunciona.astro'
import QueIncluye from '../components/landing-08-08-2026/QueIncluye.astro'
import BonusSection from '../components/landing-08-08-2026/BonusSection.astro'
import ParaTiSection from '../components/landing-08-08-2026/ParaTiSection.astro'
import PrecioSection from '../components/landing-08-08-2026/PrecioSection.astro'
// El desglose de valor ya no es una sección aparte: vive dentro de
// PrecioSection, en su columna izquierda. El componente se queda en el
// repo por si algún día vuelve a separarse.
// import StackValor from '../components/landing-08-08-2026/StackValor.astro'
import MarcaSection from '../components/landing-08-08-2026/MarcaSection.astro'
// Fuera de la página hasta tener datos reales: los cinco profesores
// son de relleno (se llaman todos "Nombre Apellido", las frases están
// inventadas y las fotos son avatares dibujados). El componente se
// queda en src/components/landing-08-08-2026/ para volver a meterlo en
// cuanto haya nombres, frases y fotos de verdad.
// import ProfesoresSection from '../components/landing-08-08-2026/ProfesoresSection.astro'
import CronogramaSection from '../components/landing-08-08-2026/CronogramaSection.astro'
import PresentacionNawar from '../components/landing-08-08-2026/PresentacionNawar.astro'
import CadaUnidad from '../components/landing-08-08-2026/CadaUnidad.astro'
// Vuelve, sin el distintivo de "primera edición" que era lo que no
// iba a ser verdad siempre. Ahora habla de la convocatoria y del
// aforo de la clase en directo, que sí aguanta edición tras edición.
import EscasezSection from '../components/landing-08-08-2026/EscasezSection.astro'

/* Copias propias de dos componentes de nawar-web: se veían rotos en
   móvil y hay que retocarlos sin alterar los que usa la web */
import PorQueNawar from '../components/landing-08-08-2026/PorQueNawar.astro'
import AccesoIncluye from '../components/landing-08-08-2026/AccesoIncluye.astro'
import TestimonialsSection from '../components/landing-08-08-2026/TestimonialsSection.astro'

export const prerender = true

/* ─────────────────────────────────────────────────────────────
   AJUSTES RÁPIDOS
   ⚠️ CHECKOUT_URL sigue apuntando al enlace de pago de 297 €.
      Hay que crear el enlace de 397 € en Stripe y pegarlo aquí
      antes de mandar tráfico a esta página.
   ⚠️ Los valores del stack (VALOR_TOTAL y el campo `valor` de
      cada línea) son una propuesta. Cámbialos por los tuyos.
───────────────────────────────────────────────────────────── */
/* Todos los CTA pasan por el formulario de matriculación: recoge los
   datos y los pre-rellena en el checkout de Stripe, que es lo que
   reduce los abandonos. Ya no se enlaza a Stripe directamente. */
const CHECKOUT_URL = '/matricula-formacion-nawar-a0-a1'
const PRECIO = '397'
const VALOR_TOTAL = '2.360'
const AHORRO = '100'
const LOGO = 'https://d1yei2z3i6k35z.cloudfront.net/9533860/671a9c9265e23_Logo_Nawar_2.png'

/* Dolores — carta con lista numerada */
const dolores = [
  'llevas meses, o años, diciéndote que esta semana sí empiezas con el neerlandés',
  'escuchas holandés a tu alrededor y sientes que nunca llegará el día en que lo entiendas',
  'en el trabajo te pierdes conversaciones importantes porque no tienes el nivel',
  'en el médico, el ayuntamiento o el banco siempre dependes de alguien para comunicarte',
  'has probado apps, PDFs, YouTube y clases sueltas, y sigues igual que hace un año',
  'sientes que el idioma levanta un muro entre tú y el país en el que vives',
]

/* Ancla de precio */
const stats = [
  { num: '€800', label: 'lo que cuesta un solo nivel (A1, A2 o B1) en una academia de neerlandés en Países Bajos' },
  { num: '€65', label: 'el precio de una única clase suelta con un profesor de neerlandés' },
  { num: '83%', label: 'de hispanohablantes en Países Bajos abandonan el neerlandés durante el primer año' },
]

/* Stack de valor — el corazón de la oferta */
const stack = [
  { nombre: 'Formación completa A0 → A1', detalle: '7 módulos y +15 h de vídeo estructurado, explicado desde el español', valor: '€800', bonus: false },
  { nombre: 'Plataforma con ejercicios interactivos', detalle: 'Feedback inmediato, vocabulario con audio nativo, diálogos y seguimiento de tu progreso', valor: '€150', bonus: false },
  { nombre: 'Clase semanal en directo', detalle: 'Con profesor interno según tu módulo. Todas quedan grabadas', valor: '€780', bonus: true },
  { nombre: 'Comunidad privada de hispanohablantes', detalle: 'Gente en tu misma situación, no aprendes solo', valor: '€120', bonus: true },
  { nombre: 'Ejercicios y lecciones extra', detalle: 'Material adicional para repasar y practicar sin límite', valor: '€90', bonus: true },
  { nombre: 'Soporte y resolución de dudas', detalle: 'Preguntas y te respondemos. No te quedas atascado', valor: '€150', bonus: true },
  { nombre: 'Certificado oficial A0-A1', detalle: 'Personalizado con tu nombre al completar la formación', valor: '€60', bonus: true },
]

/* Los 5 bonus */
const bonuses = [
  {
    n: '01', icon: 'i-calendar', valor: '€780',
    title: 'Clase semanal online en directo',
    desc: 'Cada semana una clase en vivo con un profesor interno de la formación, asignado según el módulo que estés cursando. ¿No puedes conectarte? La clase queda grabada y siempre está a tu disposición.',
  },
  {
    n: '02', icon: 'i-users', valor: '€120',
    title: 'Comunidad de hispanohablantes',
    desc: 'Un grupo privado de personas que están exactamente en tu misma situación: aprendiendo neerlandés desde el español. Os apoyáis, compartís dudas y avanzáis juntos en lugar de estudiar en solitario.',
  },
  {
    n: '03', icon: 'i-book', valor: '€90',
    title: 'Ejercicios y lecciones extra',
    desc: 'Material adicional al temario principal para repasar y practicar todo lo que quieras. Vuelve sobre lo que se te resiste tantas veces como necesites hasta que te salga sin pensar.',
  },
  {
    n: '04', icon: 'i-support', valor: '€150',
    title: 'Soporte y resolución de dudas',
    desc: 'Cuando algo no te cuadra, preguntas y te respondemos. Sin quedarte bloqueado una semana entera con la misma duda ni buscar respuestas sueltas por internet.',
  },
  {
    n: '05', icon: 'i-award', valor: '€60', gold: true,
    title: 'Certificado oficial A0-A1',
    desc: 'Al completar todos los módulos recibes tu certificado personalizado con tu nombre, que acredita tu nivel de neerlandés y el trabajo que has hecho.',
  },
]

/* Lo que entra en el precio */
const incluidoEnPrecio = [
  'Formación completa A0 → A1 con acceso de por vida',
  'Plataforma con ejercicios interactivos y seguimiento',
  'Clase semanal en directo + todas las grabaciones',
  'Comunidad privada de hispanohablantes',
  'Ejercicios y lecciones extra para repasar',
  'Soporte y resolución de dudas',
  'Certificado oficial A0-A1 personalizado',
  'Actualizaciones de contenido incluidas',
]

const faqs = [
  {
    q: '¿Por qué cuesta 397 € si dices que vale más de 2.000 €?',
    a: 'Porque el coste de sumar un alumno más a una formación grabada es mínimo, y prefiero que entre mucha gente a un precio que puedan pagar antes que unos pocos a precio de academia. Ese es todo el truco: una academia te cobra 800 € por un solo nivel porque paga aula, horarios y profesor por hora. Aquí eso no existe.',
  },
  {
    q: '¿Es para principiantes absolutos?',
    a: 'Sí. La formación está diseñada desde cero, pensando en alguien que nunca ha estudiado neerlandés o que tiene nociones muy básicas. No necesitas saber nada previo para empezar.',
  },
  {
    q: '¿Cuándo tengo acceso?',
    a: 'El acceso es inmediato. En cuanto completas el pago recibirás un email con tus datos de acceso a la plataforma. Puedes empezar en minutos.',
  },
  {
    q: '¿Durante cuánto tiempo tengo acceso?',
    a: 'El acceso es de larga duración. Puedes acceder a todos los contenidos y a las actualizaciones futuras de la formación.',
  },
  {
    q: '¿Y si no tengo mucho tiempo?',
    a: 'La formación está diseñada para adaptarse a tu ritmo. Con 20-30 minutos al día puedes avanzar de forma constante. Tú decides cuándo y cuánto estudias. No hay fechas límite ni presión.',
  },
  {
    q: '¿Qué pasa si no me gusta?',
    a: 'Tienes 15 días de garantía de devolución total y sin preguntas. Si en ese tiempo sientes que no es para ti, te devolvemos el dinero completo. Sin burocracia.',
  },
  {
    q: '¿Hay soporte si tengo dudas?',
    a: 'Sí. Tienes acceso a la comunidad de estudiantes donde puedes resolver dudas, además de la clase semanal en directo con el profesor, que es el espacio perfecto para preguntar cualquier cosa.',
  },
  {
    q: '¿Cómo funcionan las clases semanales?',
    a: 'Cada semana hay una clase en directo con uno de los profesores de la formación, asignado según el módulo que estés cursando. Es un espacio para repasar, practicar y resolver dudas en grupo. Las grabaciones están disponibles si no puedes asistir en vivo.',
  },
  {
    q: '¿Puedo hacerlo desde el móvil?',
    a: 'Sí. La plataforma está optimizada para móvil, tablet y escritorio. Puedes estudiar desde cualquier dispositivo y continuar donde lo dejaste.',
  },
  {
    q: '¿Está pensado para hispanohablantes?',
    a: 'Completamente. Todas las explicaciones, comparativas gramaticales y materiales están pensados desde el español. No es una traducción de una formación en inglés: está construido desde cero para hispanohablantes.',
  },
  {
    q: '¿Necesito saber algo de neerlandés antes?',
    a: 'No. Empezamos desde absolutamente cero. El primer módulo cubre los fundamentos básicos desde el principio, sin asumir conocimiento previo.',
  },
  {
    q: '¿Cómo es la comunidad?',
    a: 'Un grupo de hispanohablantes aprendiendo neerlandés en la misma situación que tú. Es un espacio para compartir dudas, avances, motivación y práctica. No es un grupo silencioso: es una comunidad activa.',
  },
  {
    q: '¿Me sirve para el inburgering o el examen NT2?',
    a: 'Esta formación cubre el nivel A0 → A1, que es la base sobre la que se construye todo lo demás: la gramática, el vocabulario y las frases del día a día. Es el punto de partida para preparar el inburgering, pero no es un curso de preparación del examen en sí. Si tu objetivo es presentarte pronto, escríbenos y te decimos con franqueza si te encaja.',
  },
  {
    q: '¿Puedo pagar a plazos?',
    a: 'Sí. En el pago puedes elegir Klarna y fraccionar el importe. También aceptamos tarjeta, iDEAL y Bancontact, que son los métodos habituales en Países Bajos y Bélgica.',
  },
  {
    q: '¿Y si me arrepiento dentro de un mes?',
    a: 'La garantía cubre los primeros 15 días, que es tiempo de sobra para ver los primeros módulos completos, entrar a una clase en directo y decidir con criterio. Pasado ese plazo el acceso sigue siendo tuyo, así que no pierdes nada de lo que has pagado.',
  },
  {
    q: '¿Cuándo empiezo?',
    a: 'En cuanto completes el pago tienes acceso inmediato a toda la plataforma. Puedes empezar hoy mismo, en los próximos minutos si quieres.',
  },
]

const arrow = 'M17 8l4 4m0 0l-4 4m4-4H3'
---

<Layout
