---
import Layout from '../layouts/Layout.astro'
import { getEstadoPlazas, RUTA_LISTA_ESPERA } from '../lib/plazas'

export const prerender = false

// ── Puerta 2: el enlace que ya circula ──
// El enlace de la matrícula va dentro de correos ya enviados y se reenvía por
// WhatsApp, así que cambiar el botón de la landing no basta. Con las puertas
// cerradas, quien llegue aquí acaba en la lista de espera y punto: sin página
// intermedia ni cartel de "plazas agotadas".
const plazas = await getEstadoPlazas()
if (!plazas.abierta) return Astro.redirect(RUTA_LISTA_ESPERA, 302)
---

<Layout
  title="Matrícula — Formación Nawar A0-A1"
  description="Reserva tu plaza en la Formación Nawar A0-A1 y empieza a aprender neerlandés desde cero: método desde el español, clases en vivo y una comunidad que te acompaña."
>
  <!-- Banner de error global -->
  <div id="err" class="mx-toast" role="alert">
    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/>
    </svg>
    <span id="errText"></span>
    <a id="errLink" class="mx-toast-link" href="/lista-de-espera">Apúntate a la lista de espera</a>
    <button class="mx-toast-close" type="button" id="errClose" aria-label="Cerrar">×</button>
  </div>

  <div class="mx-page">
    <div class="mx-glow1" aria-hidden="true"></div>
    <div class="mx-glow2" aria-hidden="true"></div>
    <div class="mx-dots" aria-hidden="true"></div>

    <div class="mx-shell">
      <!-- Logo -->
      <a href="/" class="mx-logo-link" aria-label="Volver al inicio">
        <img
          src="https://d1yei2z3i6k35z.cloudfront.net/9533860/671a9c9265e23_Logo_Nawar_2.png"
          alt="Holandés Nawar"
          class="mx-logo"
          width="150"
          height="38"
        />
      </a>

      <!-- Header -->
      <header class="mx-header">
        {/* Sin palomita: un check delante dice "hecho", y aquí no hay nada
            hecho todavía — es el primero de dos pasos.
            El contador de pasos SÍ va aquí: la pantalla de pago de la escuela
            dice "Paso 2 de 2", así que sin esto el comprador aterrizaba en un
            paso 2 sin haber visto nunca un paso 1, y mientras rellenaba esta
            pantalla no sabía cuánto le quedaba. */}
        <span class="mx-badge">
          Paso 1 de 2 · Formación A0 → A1
        </span>
        <h1 class="mx-title"><span class="mx-title-gradient">Reserva tu plaza</span></h1>
        {/* Una sola línea de texto en toda la pantalla, a propósito (sept 2026).
            Antes había tres: "Estás a un paso de tu primera clase", "Completa
            tus datos y pasa al pago seguro" —que narra lo que ya se ve: tres
            campos y un botón que pone "Continuar al pago"— y el aviso de que
            tras pagar llega un correo para crear la cuenta. Esa última es
            información buena contada en el momento equivocado: nadie que aún
            no ha pagado se pregunta cómo entrará después, y va en la página de
            bienvenida, donde la duda sí existe.
            Lo que queda no es relleno: dice que al pulsar TODAVÍA no se le
            cobra, que es la duda real de quien tiene delante un botón con la
            palabra "pago". */}
        <p class="mx-lead">Rellena tus datos y en el siguiente paso eliges cómo pagar.</p>
      </header>

      <!-- Formulario directo sobre el azul (sin tarjeta) -->
      <form id="form" class="mx-form" novalidate>
        {/* Honeypot anti-bot */}
        <div class="mx-honeypot" aria-hidden="true">
          <label>No rellenar
            <input type="text" id="mx-honeypot" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div class="mx-row">
          <div class="mx-field">
            <label class="mx-label" for="first_name">Nombre <span class="mx-req">*</span></label>
            <input id="first_name" name="first_name" type="text" class="mx-input" placeholder="Tu nombre" autocomplete="given-name" required />
            <span class="mx-err" data-for="first_name">Completa este campo</span>
          </div>
          <div class="mx-field">
            <label class="mx-label" for="last_name">Apellidos <span class="mx-req">*</span></label>
            <input id="last_name" name="last_name" type="text" class="mx-input" placeholder="Tus apellidos" autocomplete="family-name" required />
            <span class="mx-err" data-for="last_name">Completa este campo</span>
          </div>
        </div>

        <div class="mx-row">
          <div class="mx-field">
            <label class="mx-label" for="email">Correo electrónico <span class="mx-req">*</span></label>
            <input id="email" name="email" type="email" class="mx-input" placeholder="tu@email.com" autocomplete="email" required />
            <span class="mx-err" data-for="email">Introduce un email válido</span>
          </div>
        </div>

        {/* Aquí estaba el Teléfono, y se fue por el mismo motivo que País y
            Ciudad: no lo lee nadie. En la escuela solo viaja a la ficha de
            Stripe para rellenar un campo que Stripe ya pide él si lo necesita,
            y en systeme.io la mayoría de los compradores son contactos que YA
            existen (vienen de la lista de espera), donde el número no se
            acaba escribiendo. O sea: un campo de fricción justo antes de
            pagar a cambio de un dato que se pierde.
            Si algún día hacen falta los teléfonos, el sitio es DESPUÉS de
            pagar —en la escuela, con el alumno ya dentro— no antes.
            `/api/enroll` sigue aceptando `phone` por si vuelve. */}

        {/* Aquí vivían País y Ciudad. Se quitaron: no los leía nadie —se
            escribían en la fila de matrícula y en los metadatos de Stripe y ahí
            se quedaban, sin que ninguna pantalla, correo ni estadística los
            usara— así que eran dos campos de fricción a cambio de nada. El país
            de la tarjeta ya lo pide Stripe en el paso 2, que es donde importa. */}

        <div class="mx-btn-wrap">
          <button id="submit" type="submit" class="mx-btn">
            <span id="mx-btn-text">Continuar al pago</span>
            <svg id="mx-btn-arrow" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
            <svg id="mx-btn-spinner" class="mx-spinner" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="display:none;" aria-hidden="true">
              <path stroke-linecap="round" d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
            </svg>
          </button>

          <p class="mx-legal">
            {/* Las condiciones de contratación van AQUÍ y no solo en el pie: la
                ley pide que el comprador pueda leerlas antes de pagar, y esta
                es la última pantalla antes del cobro. */}
            Al continuar confirmo que he leído y acepto las
            <a href="/condiciones-de-contratacion" target="_blank" rel="noreferrer">Condiciones de contratación</a>,
            los
            <a href="/terminos-y-condiciones" target="_blank" rel="noreferrer">Términos</a>
            y la
            <a href="/politica-de-privacidad" target="_blank" rel="noreferrer">Política de privacidad</a>.
          </p>
        </div>
      </form>
    </div>
  </div>
</Layout>

<style>
  /* ── Página ── */
  .mx-page {
    min-height: 100vh;
    background: #1D0084;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 52px 32px 96px;
  }
  .mx-glow1 {
    position: absolute; top: -140px; left: 50%; transform: translateX(-50%);
    width: 960px; height: 560px;
    background: radial-gradient(ellipse at center, rgba(11,109,240,0.5) 0%, transparent 65%);
    pointer-events: none;
  }
  .mx-glow2 {
    position: absolute; bottom: -60px; right: -80px;
    width: 600px; height: 400px;
    background: radial-gradient(ellipse at center, rgba(77,163,255,0.16) 0%, transparent 65%);
    pointer-events: none;
  }
  .mx-dots {
    position: absolute; inset: 0; pointer-events: none; opacity: 0.4;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  /* ── Shell ── */
  .mx-shell {
    position: relative; z-index: 1;
    width: 100%; max-width: 700px;
    display: flex; flex-direction: column; align-items: flex-start;
    color: #fff;
  }

  /* ── Logo ── */
  .mx-logo-link { display: inline-block; margin-bottom: 44px; }
  .mx-logo { height: 38px; width: auto; object-fit: contain; }

  /* ── Badge ── */
  .mx-badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 16px; border-radius: 9999px;
    background: #025dc7;
    border: 1px solid rgba(77, 163, 255, 0.2);
    color: #e0f2ff;
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase;
    margin-bottom: 6px;
  }

  /* ── Header ── */
  .mx-header {
    width: 100%;
    display: flex; flex-direction: column; align-items: flex-start;
    gap: 14px; margin-bottom: 48px;
  }
  .mx-title {
    font-family: var(--font-poppins), system-ui, sans-serif;
    font-size: clamp(38px, 5.5vw, 56px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
    margin: 0; margin-top: 10px;
  }
  .mx-title-gradient {
    background: linear-gradient(180deg, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.45) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  /* Al quedarse sola bajo el titular, esta línea pasó de negrita a peso normal:
     en 700 competía con el titular y sonaba a segundo titular. Debajo de un
     título de 56 px, lo que se necesita es una voz más baja, no otra igual.
     (Aquí vivía también `.mx-body`, la regla del párrafo que se quitó.) */
  .mx-lead {
    font-size: clamp(15px, 1.5vw, 18px);
    font-weight: 400; line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    max-width: 600px; margin: 0;
  }

  /* ── Form (directo sobre el azul, sin tarjeta) ── */
  .mx-form {
    width: 100%;
    display: flex; flex-direction: column; gap: 32px;
  }

  .mx-honeypot {
    position: absolute !important; left: -10000px !important;
    width: 1px !important; height: 1px !important;
    overflow: hidden !important; opacity: 0 !important; pointer-events: none !important;
  }

  .mx-row { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .mx-field { display: flex; flex-direction: column; gap: 8px; position: relative; }

  .mx-label { font-size: 14px; font-weight: 600; color: #fff; line-height: 1.4; }
  .mx-req { color: rgba(255, 255, 255, 0.45); font-weight: 500; }
  .mx-hint { font-weight: 400; font-size: 12px; color: rgba(255, 255, 255, 0.5); }

  /* Input — solo línea inferior */
  .mx-input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1.5px solid rgba(255, 255, 255, 0.28);
    border-radius: 0;
    padding: 10px 0;
    color: #fff; font-size: 16px; font-family: inherit;
    outline: none; transition: border-color 0.2s; box-sizing: border-box;
  }
  .mx-input::placeholder { color: rgba(255, 255, 255, 0.28); }
  .mx-input:focus { border-bottom-color: #4da3ff; }
  .mx-input.invalid { border-bottom-color: rgba(255, 100, 100, 0.8); }

  .mx-err { display: none; font-size: 12px; color: rgba(255, 120, 120, 0.9); font-weight: 500; }
  .mx-err.visible { display: block; }

  /* El estilo del desplegable se fue con el campo País: ya no queda ningún
     <select> en el formulario. */

  /* ── Botón ── */
  .mx-btn-wrap {
    display: flex; flex-direction: column; align-items: flex-start;
    gap: 14px; padding-top: 8px;
  }
  .mx-btn {
    display: flex; align-items: center; justify-content: center; gap: 9px;
    width: 100%; padding: 16px 36px;
    border-radius: 12px; border: none; cursor: pointer;
    background: #4da3ff; color: #1D0084;
    font-size: 17px; font-weight: 700; font-family: inherit;
    transition: background-color 0.15s;
  }
  .mx-btn:hover:not(:disabled) { background: #6cb5ff; }
  .mx-btn:disabled { opacity: 0.7; cursor: not-allowed; }

  @keyframes mx-spin { to { transform: rotate(360deg); } }
  .mx-spinner { animation: mx-spin 0.8s linear infinite; }

  /* ── Legal ── */
  .mx-legal {
    width: 100%; text-align: center;
    font-size: 12px; line-height: 1.6;
    color: rgba(255, 255, 255, 0.4); margin: 0;
  }
  .mx-legal a {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: underline; text-decoration-color: rgba(255, 255, 255, 0.2);
  }
  .mx-legal a:hover { color: rgba(255, 255, 255, 0.75); }

  /* ── Toast de error ── */
  .mx-toast {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    display: none; align-items: center; gap: 10px;
    padding: 13px 18px;
    background: #ef4444; color: #fff;
    font-size: 14px; font-weight: 500;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  }
  .mx-toast.show { display: flex; }
  .mx-toast span { flex: 1; }
  /* Solo aparece cuando el aviso es "puertas cerradas" */
  .mx-toast-link {
    display: none; flex-shrink: 0;
    color: #fff; font-weight: 700; text-decoration: underline;
    text-underline-offset: 3px; white-space: nowrap;
  }
  .mx-toast-link.show { display: inline; }
  .mx-toast-close {
    background: transparent; border: none; color: #fff;
    font-size: 20px; font-weight: 700; line-height: 1;
    cursor: pointer; padding: 2px 6px;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .mx-page { padding: 36px 20px 72px; }
    .mx-row { grid-template-columns: 1fr; gap: 28px; }
    .mx-title { font-size: clamp(28px, 9vw, 38px); }
    .mx-btn { width: 100%; justify-content: center; }
    .mx-btn-wrap { align-items: stretch; }
  }
</style>

<script>
  const form = document.getElementById('form') as HTMLFormElement | null
  const btn = document.getElementById('submit') as HTMLButtonElement | null
  const btnText = document.getElementById('mx-btn-text') as HTMLElement | null
  const btnArrow = document.getElementById('mx-btn-arrow') as HTMLElement | null
  const spinner = document.getElementById('mx-btn-spinner') as HTMLElement | null
  const toast = document.getElementById('err') as HTMLElement | null
  const toastText = document.getElementById('errText') as HTMLElement | null
  const toastClose = document.getElementById('errClose') as HTMLButtonElement | null

  function setLoading(on: boolean) {
    if (!btn) return
    btn.disabled = on
    if (btnText) btnText.textContent = on ? 'Preparando tu pago…' : 'Continuar al pago'
    if (btnArrow) btnArrow.style.display = on ? 'none' : 'block'
    if (spinner) spinner.style.display = on ? 'block' : 'none'
  }

  const toastLink = document.getElementById('errLink')

  function showToast(msg: string, conEnlace = false) {
    if (toastText) toastText.textContent = msg
    toastLink?.classList.toggle('show', conEnlace)
    toast?.classList.add('show')
    window.scrollTo({ top: 0, behavior: 'smooth' })
  }
  toastClose?.addEventListener('click', () => toast?.classList.remove('show'))

  function showError(id: string, show: boolean) {
    const input = document.getElementById(id) as HTMLInputElement | null
    const err = document.querySelector(`[data-for="${id}"]`) as HTMLElement | null
    input?.classList.toggle('invalid', show)
    err?.classList.toggle('visible', show)
  }

  function validate(): boolean {
    const first = (document.getElementById('first_name') as HTMLInputElement)?.value?.trim()
    const last = (document.getElementById('last_name') as HTMLInputElement)?.value?.trim()
    const email = (document.getElementById('email') as HTMLInputElement)?.value?.trim()
    let ok = true
    showError('first_name', !first); if (!first) ok = false
    showError('last_name', !last); if (!last) ok = false
    const emailBad = !email || !email.includes('@')
    showError('email', emailBad); if (emailBad) ok = false
    return ok
  }

  ;['first_name', 'last_name', 'email'].forEach((id) => {
    document.getElementById(id)?.addEventListener('input', () => showError(id, false))
  })

  form?.addEventListener('submit', async (ev) => {
    ev.preventDefault()
    toast?.classList.remove('show')
    if (!validate()) return
    setLoading(true)

    const payload = {
      first_name: (document.getElementById('first_name') as HTMLInputElement).value.trim(),
      last_name: (document.getElementById('last_name') as HTMLInputElement).value.trim(),
      email: (document.getElementById('email') as HTMLInputElement).value.trim().toLowerCase(),
      website: (document.getElementById('mx-honeypot') as HTMLInputElement | null)?.value ?? '',
    }

    try {
      const res = await fetch('/api/enroll', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
      const data = await res.json().catch(() => null)
      // 403 = puertas cerradas mientras tenía el formulario abierto. Se enseña
      // el motivo que manda el servidor y una salida, no un "error inesperado".
      if (res.status === 403) {
        showToast(
          (data && data.detail) ||
            'Las plazas de esta convocatoria están completas. Apúntate a la lista de espera y te avisamos de la próxima.',
          true
        )
        setLoading(false)
        return
      }
      if (!res.ok || !data || !data.payment_url) {
        showToast((data && data.detail) || 'No se pudo crear la matrícula. Vuelve a intentarlo en un momento.')
        setLoading(false)
        return
      }
      window.location.href = data.payment_url
    } catch {
      showToast('Hubo un problema de red. Revisa tu conexión y vuelve a intentarlo.')
      setLoading(false)
    }
  })
</script>
