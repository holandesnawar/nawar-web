---
/**
 * Gracias de la matrícula de anuncios. Aquí aterriza quien acaba de
 * dejar sus datos en /matricula-formacion-nawar-a0-a1-ads.
 *
 * Cuidado con lo que dice esta página: la persona NO ha pagado. Decirle
 * "ya estás matriculado" la deja creyendo que está dentro, y la llamada
 * empieza rebajándole la expectativa, que es la peor forma de empezar
 * una venta. Lo que sí es verdad y sí compromete: le guardamos la plaza
 * mientras hablamos. Eso es lo que se cuenta.
 *
 * Aquí se dispara el evento Lead del píxel: es el punto en el que Meta
 * mide bien —una URL propia, después de que la petición haya salido
 * bien— y no al pulsar el botón.
 *
 * Va sin indexar: es una página de embudo.
 */
import Layout from '../../layouts/Layout.astro'

export const prerender = true

/** El remitente real de systeme.io. Tiene que ser el de verdad o el
 *  consejo de "míralo en spam" no sirve de nada. */
const REMITENTE = 'info@holandesnawar.com'

/* Aquí vivían las constantes de WhatsApp, para el bloque de
   "¿Prefieres no esperar?". El bloque se fue y ellas con él: una
   constante que no usa nadie es una invitación a volver a pintar
   algo que se quitó a propósito. */

const LOGO = 'https://d1yei2z3i6k35z.cloudfront.net/9533860/671a9c9265e23_Logo_Nawar_2.png'

/* Los tres pasos que vienen. Están escritos en segunda persona y con
   plazo en el primero: la duda de quien acaba de dejar su teléfono es
   "¿cuándo me escriben?", y dejarla sin responder es lo que hace que
   la gente se enfríe antes de la conversación. */
const pasos = [
  {
    n: '01',
    t: 'Te escribimos',
    d: 'En menos de 24 horas, por WhatsApp al número que nos has dejado.',
  },
  {
    n: '02',
    t: 'Resolvemos tus dudas',
    d: 'Vemos de dónde partes, cómo funciona la formación y si te encaja de verdad.',
  },
  {
    n: '03',
    t: 'Completas la matrícula',
    d: 'Si lo ves claro, completamos la matrícula y entras en la escuela.',
  },
]
---

<Layout
  title="Plaza reservada — Formación Nawar A0-A1"
  description="Hemos recibido tu solicitud. El equipo de Holandés Nawar te contacta para completar la matrícula."
  noindex={true}
>
  <div class="gr-page">
    <div class="gr-glow1" aria-hidden="true"></div>
    <div class="gr-glow2" aria-hidden="true"></div>
    <div class="gr-dots" aria-hidden="true"></div>

    <div class="gr-shell">

      <a href="/" class="gr-logo-link" aria-label="Volver al inicio">
        <img src={LOGO} alt="Holandés Nawar" class="gr-logo" />
      </a>

      <div class="gr-header">
        <span class="gr-check" aria-hidden="true">
          <svg width="30" height="30" fill="none" stroke="currentColor" stroke-width="3.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
        </span>
        <h1 class="gr-title"><span class="gr-title-gradient">Tu plaza está reservada.</span></h1>
        <p class="gr-lead">
          Hemos recibido tu solicitud. Te la guardamos mientras hablamos:
          el equipo te escribe para completar la matrícula contigo y
          resolver lo que necesites antes de decidir.
        </p>
      </div>

      <ol class="gr-pasos">
        {pasos.map((p) => (
          <li class="gr-paso">
            <span class="gr-paso-n" aria-hidden="true">{p.n}</span>
            <div>
              <p class="gr-paso-t">{p.t}</p>
              <p class="gr-paso-d">{p.d}</p>
            </div>
          </li>
        ))}
      </ol>


      <div class="gr-spam">
        <div class="gr-spam-icon" aria-hidden="true">📩</div>
        <div>
          <p class="gr-spam-title">Mira también tu correo</p>
          <p class="gr-spam-text">
            Te llegará confirmación desde <strong>{REMITENTE}</strong>. Si ha
            caído en spam o en promociones, muévela a la bandeja de entrada:
            así lo que te mandemos después llega bien.
          </p>
        </div>
      </div>

    </div>
  </div>
</Layout>

<script>
  /* El lead para Meta se cuenta aquí, no al pulsar el botón: es lo que
     Meta mide bien y lo que no se infla si la petición falla. La marca
     en sessionStorage evita contar dos veces a quien recarga. Va con ?.
     porque el píxel puede no estar (bloqueadores) y esta página tiene
     que verse igual. */
  const evento = () =>
    (window as any).fbq?.('track', 'Lead', {
      content_name: 'Matrícula Formación Nawar A0-A1 (ads)',
      currency: 'EUR',
    })
  try {
    if (!sessionStorage.getItem('lead-matricula-ads')) {
      evento()
      sessionStorage.setItem('lead-matricula-ads', '1')
    }
  } catch {
    evento()
  }
</script>

<style>
  /* Mismo lenguaje que las demás páginas de gracias: azul de marca, dos
     manchas de luz y la trama de puntos. */
  .gr-page {
    min-height: 100vh;
    background: #1D0084;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 52px 32px 96px;
  }
  .gr-glow1 {
    position: absolute; top: -140px; left: 50%; transform: translateX(-50%);
    width: 960px; height: 560px;
    background: radial-gradient(ellipse at center, rgba(11,109,240,0.5) 0%, transparent 65%);
    pointer-events: none;
  }
  .gr-glow2 {
    position: absolute; bottom: -60px; right: -80px;
    width: 600px; height: 400px;
    background: radial-gradient(ellipse at center, rgba(77,163,255,0.16) 0%, transparent 65%);
    pointer-events: none;
  }
  .gr-dots {
    position: absolute; inset: 0; pointer-events: none; opacity: 0.4;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .gr-shell {
    position: relative; z-index: 1;
    width: 100%; max-width: 700px;
    display: flex; flex-direction: column;
    align-items: flex-start;
  }
  .gr-logo-link { display: inline-block; margin-bottom: 44px; }
  .gr-logo { height: 38px; width: auto; object-fit: contain; }

  .gr-header {
    width: 100%;
    display: flex; flex-direction: column; align-items: flex-start;
    gap: 14px;
    margin-bottom: 40px;
  }
  /* Igual que en la otra página de gracias de anuncios: más presente
     que en las de la web, porque aquí es lo primero que se ve y tiene
     que decir "hecho" de un vistazo. */
  .gr-check {
    display: inline-flex; align-items: center; justify-content: center;
    width: 64px; height: 64px; border-radius: 50%;
    background: rgba(77,163,255,0.14);
    border: 3px solid #4da3ff;
    color: #4da3ff;
    box-shadow: 0 0 0 8px rgba(77,163,255,0.12), 0 10px 30px rgba(77,163,255,0.25);
    margin-bottom: 8px;
  }
  .gr-title {
    font-family: var(--font-poppins), system-ui, sans-serif;
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
    margin: 0;
  }
  .gr-title-gradient {
    background: linear-gradient(180deg, rgba(255,255,255,1) 0%, rgba(255,255,255,0.45) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  /* El degradado, una vez por línea. Sin esto, cuando el titular parte
     en dos —en móvil parte siempre— la primera línea sale blanca y la
     segunda gris, y parece que cambie de color a media frase. Acotarlo
     a la altura de una línea y repetirlo le da a cada línea el mismo
     tratamiento, parta donde parta. Misma solución que en el titular de
     las guías. */
  .gr-title-gradient {
    background-size: 100% 1.08em;
    background-repeat: repeat;
  }

  .gr-lead {
    font-family: var(--font-inter), system-ui, sans-serif;
    font-size: 17px; line-height: 1.65;
    color: #ffffff;
    margin: 0; max-width: 560px;
  }

  /* ── Los tres pasos ── */
  .gr-pasos {
    width: 100%;
    list-style: none;
    margin: 0 0 36px; padding: 0;
    display: flex; flex-direction: column; gap: 22px;
  }
  .gr-paso { display: flex; gap: 16px; align-items: flex-start; }
  .gr-paso-n {
    flex-shrink: 0;
    font-family: var(--font-poppins), system-ui, sans-serif;
    font-size: 13px; font-weight: 700;
    letter-spacing: 0.06em;
    color: #4da3ff;
    /* Ancho fijo: sin él, "01" y "03" no miden lo mismo con la fuente
       real y los tres títulos empiezan cada uno en un sitio. */
    width: 26px;
    padding-top: 2px;
  }
  .gr-paso-t {
    font-family: var(--font-poppins), system-ui, sans-serif;
    font-size: 16.5px; font-weight: 700; color: #fff;
    letter-spacing: -0.01em;
    margin: 0 0 3px;
  }
  .gr-paso-d {
    font-family: var(--font-inter), system-ui, sans-serif;
    font-size: 15px; line-height: 1.6;
    color: rgba(255,255,255,0.82);
    margin: 0; max-width: 520px;
  }

  /* ── Aviso del correo ──
     Lleva el azul que tenía el bloque de WhatsApp, no el gris de antes:
     sobre el fondo de marca el gris casi no se ve y la caja parecía un
     recuadro apagado, mientras que el azul la separa del fondo y la deja
     a la altura de lo que cuenta. Mismo radio y mismo grosor de borde. */
  .gr-spam {
    width: 100%;
    display: flex; gap: 14px; align-items: flex-start;
    border: 1px solid rgba(77,163,255,0.28);
    border-radius: 16px;
    background: rgba(77,163,255,0.08);
    padding: 20px 22px;
  }
  .gr-spam-icon { font-size: 22px; line-height: 1.2; flex-shrink: 0; }
  .gr-spam-title {
    font-family: var(--font-poppins), system-ui, sans-serif;
    font-size: 15.5px; font-weight: 700; color: #fff;
    margin: 0 0 4px;
  }
  .gr-spam-text {
    font-family: var(--font-inter), system-ui, sans-serif;
    font-size: 14.5px; line-height: 1.6;
    color: rgba(255,255,255,0.92);
    margin: 0;
  }
  .gr-spam-text strong { color: #fff; font-weight: 600; }

  /* Aquí iba "Volver al inicio". Fuera, por lo mismo que en la otra
     página de gracias de anuncios: es una puerta de salida al final de
     un embudo, justo donde lo que toca es esperar nuestro mensaje o
     escribirnos. */

  @media (max-width: 640px) {
    .gr-page { padding: 36px 20px 72px; }
    .gr-logo-link { margin-bottom: 32px; }
    .gr-spam { flex-direction: column; gap: 10px; }
  }
</style>
