    margin-top: 28px; display: inline-flex; align-items: center; gap: 9px; padding: 13px 22px; border-radius: 12px;
    background: #1D0084; color: #fff; font-weight: 700; font-size: 15px; text-decoration: none; transition: background .15s;
  }
  .fv-btn-sec:hover { background: #2a12a0; }

  /* ── Cabecera ───────────────────────────────────────────────────────── */
  .fv-hero { position: relative; background: #1D0084; color: #fff; overflow: hidden; padding: 0 24px 96px; }
  .fv-hero .fv-dots { opacity: 0.45; }
