---
/**
 * /formacion/v2 — la página de la formación para los anuncios (07/10, EN
 * PRUEBAS, fuera de Google y sin enlazar desde la web).
 *
 * Idea del usuario, copiada del embudo de UDIA: una página que EXPLICA la
 * formación (no que vende: sin precio), con el formulario de tres datos
 * arriba del todo. Al mandarlo, el vídeo (/formacion/v2/video) con el botón
 * de la llamada bloqueado y una cuenta atrás; y de ahí el formulario de
 * admisión (/formacion/v2/formulario). El closer llama en cuanto entra el lead.
 *
 * Cuarta vuelta (07/10, "ponte serio, esto va en el CTA de un buen UGC"):
 *  - cabecera sin botón en la barra, con un titular largo que ocupa y el
 *    formulario de cristal oscuro (la caja blanca sobre el azul "chocaba");
 *  - los iconos, solos, sin baldosa detrás (como en las landings);
 *  - "Lo que cambia" es un antes / después, no cinco tarjetas iguales;
 *  - "Así es una semana" son piezas claras con los ejercicios REALES de
 *    courseData.ts (Les 1, Jezelf voorstellen), no el panel azul;
 *  - Metodología se quita (ya lo cuenta la semana) y "¿A quién?" pasa a
 *    "¿Te reconoces?";
 *  - el cierre es otra vez el formulario, con los tres pasos de la admisión.
 *
 * Lo que manda, por encima de todo: los dolores REALES de quien vive en
 * Países Bajos sin el idioma. El texto es propio de esta página.
 *
 * A la escuela llega como el proceso de admisión (`embudo: 'admision'`), así
 * que el panel lo trata igual. Ver V2 en src/lib/admision.ts.
 */
import Layout from '../../../layouts/Layout.astro'
import FormSolicitud from '../../../components/formacion-v2/FormSolicitud.astro'

export const prerender = true

const LOGO = 'https://d1yei2z3i6k35z.cloudfront.net/9533860/671a9c9265e23_Logo_Nawar_2.png'

/** Las ilustraciones y el certificado de las landings (BonusSection). Traen
 *  su propio fondo blanco: van sobre blanco y sin marco. */
const IMG = {
  clases: 'https://docs.holandesnawar.com/img/Landing/bonus.clases.png',
  comunidad: 'https://docs.holandesnawar.com/img/Landing/bonus.comun.png',
  ejercicios: 'https://docs.holandesnawar.com/img/Landing/bonus.ejercicios.png',
  soporte: 'https://docs.holandesnawar.com/img/Landing/bonus.soporte.png',
  certificado: 'https://docs.holandesnawar.com/img/Landing/Certificado.final.landing.png',
  certFondo: 'https://docs.holandesnawar.com/img/Landing/fondo.certificado.png',
}

/** Iconos de línea (24×24, trazo), en un solo sitio. Se pintan SOLOS, sin
 *  baldosa de color detrás (usuario, 07/10: "como en la landing"). */
const ICONOS: Record<string, string> = {
  medico: '<path d="M11 2v2"/><path d="M5 2v2"/><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/>',
  carta: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  familia: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  charla: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><path d="M8 12h.01"/><path d="M12 12h.01"/><path d="M16 12h.01"/>',
  compra: '<circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>',
  candado: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  libro: '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
  video: '<path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"/><rect x="2" y="6" width="14" height="12" rx="2"/>',
  consulta: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .8-1 1.5"/><path d="M12 15h.01"/>',
  grupo: '<path d="M18 21a8 8 0 0 0-16 0"/><circle cx="10" cy="8" r="5"/><path d="M22 20c0-3.37-2-6.5-4-8a5 5 0 0 0-.45-8.3"/>',
  premio: '<path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/><circle cx="12" cy="8" r="6"/>',
  reloj: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
  maletin: '<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/>',
  telefono: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
  diana: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>',
  altavoz: '<path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"/><path d="M16 9a5 5 0 0 1 0 6"/><path d="M19.364 18.364a9 9 0 0 0 0-12.728"/>',
  micro: '<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/>',
}
const icono = (n: string, tam = 22, trazo = 1.8) =>
  `<svg viewBox="0 0 24 24" width="${tam}" height="${tam}" fill="none" stroke="currentColor" stroke-width="${trazo}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONOS[n]}</svg>`
/** Las palabras entre [ ] salen resaltadas. */
const resaltar = (t: string) => t.replace(/\[([^\]]+)\]/g, '<span class="fv-chip">$1</span>')

/** Los dolores (usuario, 07/10: "lo más importante son los dolores reales:
 *  depender de otros, no poder hablar, ir al médico, no poder hacer nada
 *  sin nadie"). Situaciones concretas, sin adornos. */
const DOLORES = [
  { i: 'medico', t: 'Al médico, siempre acompañado', d: 'Alguien tiene que entrar contigo para explicar qué te pasa y entender lo que te dicen. Hasta para pedir cita.' },
  { i: 'carta', t: 'Llega una carta y ya no estás tranquilo', d: 'La gemeente, el seguro, el colegio. Foto al traductor del móvil y a cruzar los dedos para no equivocarte.' },
  { i: 'familia', t: 'Tu pareja o tus hijos hablan por ti', d: 'En la tienda, en la reunión del colegio, al teléfono. Te ayudan con todo el cariño, pero tú quieres poder hacerlo solo.' },
  { i: 'charla', t: 'Fuera de la conversación', d: 'Con los vecinos, en el trabajo, en un cumpleaños. Sonríes, asientes y esperas a que alguien te lo cuente después.' },
  { i: 'compra', t: 'Lo básico, en inglés o por señas', d: 'La compra, el tren, una pregunta en la ventanilla. Sales del paso, pero así nunca terminas de sentirte de aquí.' },
  { i: 'candado', t: 'Puertas que ni te planteas abrir', d: 'Un trabajo mejor, amigos holandeses, algo tuyo. Todo pasa por el idioma, y el idioma se queda para “algún día”.' },
]

/** Antes / después (sustituye a las cinco tarjetas de "Tu día a día", que
 *  eran "sosas"). El "hoy" es corto a propósito: ya se ha contado arriba, y
 *  aquí solo hace de espejo para que pese el "con Nawar". Nivel A1: nada de
 *  prometer trabajos ni exámenes. */
const CAMBIO = [
  { i: 'medico', t: 'En el médico', hoy: 'Alguien entra contigo para explicar qué te pasa.', con: 'Pides la cita y explicas qué te pasa con tus palabras.' },
  { i: 'carta', t: 'Con las cartas', hoy: 'Foto al traductor y a cruzar los dedos.', con: 'Entiendes los avisos sencillos y sabes qué te piden.' },
  { i: 'familia', t: 'En casa', hoy: 'Tu pareja o tus hijos hacen de intérpretes.', con: 'Hablas tú. Ellos dejan de traducirte.' },
  { i: 'charla', t: 'Con la gente', hoy: 'Sonríes y asientes mientras hablan los demás.', con: 'Entras en la conversación con vecinos y compañeros.' },
  { i: 'maletin', t: 'En el trabajo', hoy: 'Todo en inglés, siempre un paso por detrás.', con: 'Te presentas y te entiendes en lo del día a día.' },
]

/** Cómo es tu semana: lo que HACE el alumno, cada paso con su pieza de la
 *  escuela al lado. Las piezas usan contenido REAL de courseData.ts (Les 1,
 *  Jezelf voorstellen; el diálogo "Kennismaken in het café"; m1l1e-3 y
 *  m1l1sp-3). Si se cambia ese contenido, que siga siendo de verdad. */
const SEMANA = [
  { t: 'Sigues las lecciones de la semana', d: 'Cada semana se abre lo que toca: vídeo corto explicado en español, vocabulario con audio, lectura, escucha y ejercicios. Con 20-30 minutos al día vas al día.' },
  { t: 'Hablas en la clase en directo', d: 'Una vez por semana, con un profesor que habla español y con tu grupo. Dices en voz alta lo que has aprendido. Si no puedes ir, queda grabada.' },
  { t: 'Preguntas cuando te atascas', d: 'Tus dudas las responde el equipo. Nadie se queda una semana bloqueado con la misma pregunta.' },
  { t: 'Te vales por ti mismo', d: 'Practicas las situaciones de verdad hasta que te salen solas. Y al terminar, tu certificado con tu nombre.' },
]

/** Competencias al terminar: nivel A1, situaciones de la vida real. */
const SABRAS = [
  '[Presentarte] y hablar de ti, de tu familia y de tu trabajo.',
  'Pedir [cita con el médico] y explicar qué te pasa con frases sencillas.',
  'Hacer [la compra], pedir en un café y pagar sin pasarte al inglés.',
  'Entender [horarios y fechas]: el tren, el colegio, una cita.',
  'Leer [mensajes y avisos cortos] y saber qué te están pidiendo.',
  'Dar [tus datos]: deletrear tu nombre, tu dirección y tu teléfono.',
  'Mantener [una conversación corta] con un vecino o un compañero.',
  'Seguir avanzando [por tu cuenta], porque ya entiendes cómo funciona el idioma.',
]

/** Lo que tienes dentro, con las ilustraciones de las landings. */
const DENTRO = [
  { img: IMG.clases, i: 'video', t: 'Clase en directo cada semana', d: 'Con un profesor que habla español y con tu grupo. Hablas desde la primera semana, y si un día no puedes, la tienes grabada.' },
  { img: IMG.ejercicios, i: 'libro', t: 'Lecciones y ejercicios interactivos', d: 'Vídeos cortos, vocabulario con audio, lecturas y ejercicios que se corrigen solos. Tu progreso, siempre a la vista.' },
  { img: IMG.soporte, i: 'consulta', t: 'Consultas con el equipo', d: '¿Algo no te cuadra? Preguntas y te respondemos, sin esperar a la clase.' },
  { img: IMG.comunidad, i: 'grupo', t: 'Comunidad privada', d: 'Tu grupo avanza contigo: dudas, victorias y práctica entre semana.' },
]

/**
 * El plan de estudios por ETAPAS (07/10: "sin hacer lo típico de por
 * módulos"; antes la fase 4 era un módulo solo con "≈ 3 semanas" y no
 * cuadraba). Cada etapa dice qué se trabaja (los temas, mezclados) y el HITO
 * con el que termina; los módulos van debajo, pequeños, como referencia.
 * Los nombres de los módulos son los de la escuela (el goteo: Over jou,
 * Familie & vrienden, Eten en drinken, Het werk, Hobby's & vrije tijd, Thuis
 * & wonen, Gezondheid, Vervoer & reizen, De stad & afspraken, Dagelijks
 * leven) y las semanas salen de sus fechas de apertura.
 * ⚠️ Los temas de los módulos 1 a 4 son sus lecciones reales (courseData.ts);
 * los del 5 al 10 están deducidos del nombre del módulo: confirmarlos con el
 * usuario y cambiarlos aquí cuando estén escritos.
 */
const FASES = [
  {
    n: '01', c: '#4da3ff', nombre: 'Los cimientos', sub: 'Te presentas y te haces entender', semanas: 'Semanas 1-4',
    objetivo: 'Pasas de cero a mantener tu primera conversación: quién eres, tu familia, tu día y lo que quieres tomar.',
    temas: ['Saludar, presentarte y dar tus datos', 'Los verbos en presente y el orden de la frase', 'Números, precios, días, meses y la hora', 'Tu familia, tu rutina y tus planes', 'Pedir en un café y moverte por el supermercado', 'La pronunciación que más cuesta: vocales largas, ei, ij, ui'],
    hito: 'Te presentas y mantienes tu primera conversación en la clase en directo.',
    modulos: ['Sobre ti', 'Familia y amigos', 'Comer y beber'],
  },
  {
    n: '02', c: '#5ad1c5', nombre: 'Tu vida aquí', sub: 'Trabajo, tiempo libre y casa', semanas: 'Semanas 5-10',
    objetivo: 'Hablas de lo que te preguntan en cualquier conversación: a qué te dedicas, qué te gusta y dónde vives.',
    temas: ['Tu profesión, tus horarios y tu experiencia', 'Poder, querer, tener que: los verbos modales', 'Decir para qué haces las cosas', 'Tus aficiones y quedar con alguien', 'Tu casa, tu barrio y tus vecinos', 'Escribir un correo sencillo'],
    hito: 'Hablas de tu trabajo y de tu vida sin pasarte al inglés.',
    modulos: ['El trabajo', 'Tiempo libre', 'Casa y vivienda'],
  },
  {
    n: '03', c: '#8e9cff', nombre: 'Valerte por ti mismo', sub: 'Salud, transporte y citas', semanas: 'Semanas 11-13',
    objetivo: 'Resuelves solo las situaciones que hoy te obligan a pedir ayuda.',
    temas: ['El huisarts: pedir cita y explicar qué te pasa', 'El cuerpo, los síntomas y la farmacia', 'El tren, el autobús y los horarios', 'Preguntar cómo llegar y orientarte', 'Pedir, cambiar y confirmar una cita'],
    hito: 'Vas al médico o haces una gestión sin que nadie te acompañe.',
    modulos: ['Salud', 'Transporte y viajes', 'La ciudad y las citas'],
  },
  {
    n: '04', c: '#c9b6ff', nombre: 'Consolidación', sub: 'Todo junto, y el A1 cerrado', semanas: 'Semanas 14-16',
    objetivo: 'Juntas todo lo aprendido y lo usas con soltura en tu día a día. Aquí el nivel se asienta.',
    temas: ['Situaciones de la vida diaria, de principio a fin', 'Repaso guiado de todo el nivel', 'Refuerzo de lo que más te cuesta', 'Práctica oral en la clase en directo', 'Revisión final de tu progreso'],
    hito: 'Cierras el nivel A1 y recibes tu certificado.',
    modulos: ['Vida diaria', 'Repaso final'],
  },
]

/** "¿Te reconoces?" (sustituye a "¿A quién va dirigido?", que era una lista
 *  plana). Son lo que PIENSA quien llega, no opiniones de alumnos: no llevan
 *  nombre ni foto y no se presentan como testimonios. ⚠️ Nunca convertirlas
 *  en testimonios inventados. */
const PERFILES = [
  { q: 'Llevo años aquí y sigo tirando de inglés.', r: 'Empiezas por lo que usas cada día, no por listas de palabras.' },
  { q: 'Me mudo en unos meses y quiero llegar con base.', r: 'Llegas sabiendo presentarte, comprar y pedir una cita.' },
  { q: 'Empiezo de cero. No sé ni cómo se saluda.', r: 'Todo explicado en español, desde la primera palabra.' },
  { q: 'Probé apps y no paso de ahí.', r: 'Aquí hay un camino, clase en directo y alguien que te corrige.' },
]
const NO_ES = ['Ya tienes un A2 o más', 'Buscas algo sin práctica ni esfuerzo', 'No tienes ni dos horas a la semana']

/** Los tres pasos de la admisión, para el cierre. */
const PASOS_ADMISION = [
  { t: 'Dejas tus datos', d: 'Nombre, correo y WhatsApp. Treinta segundos.' },
  { t: 'Ves la formación por dentro', d: 'Un vídeo de 3 minutos: cómo se aprende y qué te vas a encontrar.' },
  { t: 'Hablamos contigo', d: 'Una llamada corta para ver si encaja contigo. Sin compromiso.' },
]

const MARQUESINA = ['Los cimientos', 'Tu vida aquí', 'Valerte por ti mismo', 'Consolidación', 'Certificado Nawar']
---

<Layout
  title="Formación Nawar A0-A1 · Neerlandés de cero a A1 — Holandés Nawar"
  description="Neerlandés de cero a A1 para hispanohablantes, en 16 semanas y explicado en español. Clase en directo cada semana, consultas con el equipo y certificado."
  noindex={true}
>
  <div class="fv">
    <!-- ═══ Cabecera + formulario ═══ -->
    <header class="fv-hero">
      <div class="fv-capas" aria-hidden="true">
        <span class="fv-luz1"></span><span class="fv-luz2"></span><span class="fv-malla"></span><span class="fv-dots"></span>
      </div>

      <nav class="fv-nav">
        <a href="/" aria-label="Holandés Nawar"><img src={LOGO} alt="Holandés Nawar" class="fv-logo" width="150" height="38" /></a>
      </nav>

      <div class="fv-hero-in">
        <div class="fv-hero-texto">
          <span class="fv-badge-dark">Formación Nawar A0-A1<span class="fv-solo-pc">&nbsp;· Para hispanohablantes</span></span>
          <h1 class="fv-h1">
            Aprende neerlandés desde cero y <span class="fv-h1-azul">deja de depender de otros</span> en Países Bajos
          </h1>
          <p class="fv-hero-sub">
            16 semanas explicadas en español, con clase en directo cada semana y un equipo que te acompaña
            hasta que vas al médico, haces tus gestiones y hablas con la gente <strong>tú solo</strong>.
          </p>
        </div>

        <div class="fv-hero-form">
          <FormSolicitud
            suf="a"
            eyebrow="Admisión abierta"
            titulo="Solicita información"
            lead="Déjanos tus datos: te enseñamos la formación por dentro y te escribimos para ver si encaja contigo."
          />
        </div>

        <ul class="fv-pruebas">
          <li set:html={`${icono('check', 17, 2.4)}<span>Explicado en español</span>`} />
          <li set:html={`${icono('check', 17, 2.4)}<span>Clase en directo cada semana</span>`} />
          <li set:html={`${icono('check', 17, 2.4)}<span>Certificado al terminar</span>`} />
        </ul>
      </div>
    </header>

    <!-- La cinta, como UDIA: las cuatro etapas y el certificado. -->
    <div class="fv-cinta" aria-hidden="true">
      <div class="fv-cinta-pista">
        {[0, 1, 2, 3].map(() => (
          <span class="fv-cinta-grupo">{MARQUESINA.map((m) => <span>{m}<i>·</i></span>)}</span>
        ))}
      </div>
    </div>

    <!-- ═══ Los dolores ═══ -->
    <section class="fv-sec fv-blanco">
      <div class="fv-in">
        <div class="fv-cab">
          <span class="fv-badge">¿Te suena?</span>
          <h2 class="fv-h2">Vivir aquí <span class="fv-acento">dependiendo de otros</span> cansa</h2>
          <p class="fv-lead">Llevas tiempo en Países Bajos y para lo importante todavía necesitas a alguien al lado.</p>
        </div>
        <div class="fv-dolores">
          {DOLORES.map((d) => (
            <article class="fv-dolor">
              <span class="fv-dolor-ico" set:html={icono(d.i, 26, 1.6)} />
              <div>
                <h3>{d.t}</h3>
                <p>{d.d}</p>
              </div>
            </article>
          ))}
        </div>
        <p class="fv-giro">
          No es falta de capacidad. Es que nunca has tenido <strong>un método pensado para ti</strong>: en español, paso a paso y con alguien que te corrija.
          <span>Para eso existe la Formación Nawar <span class="fv-nw">A0-A1</span>.</span>
        </p>
      </div>
    </section>

    <!-- ═══ Antes / después ═══ -->
    <section class="fv-sec fv-claro fv-cambio-sec">
      <div class="fv-in">
        <div class="fv-cab">
          <span class="fv-badge">Lo que cambia</span>
          <h2 class="fv-h2">Lo que hoy hacen por ti, <span class="fv-acento">en 16 semanas lo haces tú</span></h2>
        </div>

        <div class="fv-cambio" role="table" aria-label="Antes y después de la formación">
          <div class="fv-cambio-fila fv-cambio-cab" role="row">
            <span role="columnheader"></span>
            <span role="columnheader" class="fv-cambio-hoy">Hoy</span>
            <span role="columnheader" class="fv-cambio-con">Con la Formación Nawar</span>
          </div>
          {CAMBIO.map((c, k) => (
            <div class={`fv-cambio-fila${k === CAMBIO.length - 1 ? ' ultima' : ''}`} role="row">
              <span class="fv-cambio-t" role="cell"><span set:html={icono(c.i, 22, 1.7)} />{c.t}</span>
              <span class="fv-cambio-hoy" role="cell">
                <span class="fv-cambio-x" set:html={icono('x', 15, 2.2)} />{c.hoy}
              </span>
              <span class="fv-cambio-con" role="cell">
                <span class="fv-cambio-ok" set:html={icono('check', 16, 2.6)} />{c.con}
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ Así es una semana: piezas de la escuela, con ejercicios reales ═══ -->
    <section class="fv-sec fv-blanco" id="semana">
      <div class="fv-in fv-sem">
        <div class="fv-sem-cab">
          <span class="fv-badge">Cómo se aprende</span>
          <h2 class="fv-h2">Así es una semana en <span class="fv-acento">Nawar</span></h2>
          <p class="fv-lead">No es ver vídeos y ya. Cada semana tiene cuatro cosas claras que hacer, y ninguna la haces solo.</p>
        </div>

        <ol class="fv-sem-pasos" id="fv-sem-pasos">
          {SEMANA.map((s, k) => (
            <li>
              <button type="button" class={`fv-sem-paso${k === 0 ? ' activo' : ''}`} data-paso={k} aria-expanded={k === 0 ? 'true' : 'false'}>
                <span class="fv-sem-n">{`0${k + 1}`}</span>
                <span class="fv-sem-txt">
                  <b>{s.t}</b>
                  <span class="fv-sem-d">{s.d}</span>
                </span>
                <span class="fv-sem-barra" aria-hidden="true"><i></i></span>
              </button>
            </li>
          ))}
        </ol>

        <div class="fv-escena" id="fv-escena">
          <div class="fv-escena-capas" aria-hidden="true"><span class="e1"></span><span class="e2"></span><span class="e3"></span></div>

          <!-- 1 · La lección (Les 1 — Jezelf voorstellen) y su flashcard -->
          <div class="fv-mock activo" data-paso="0">
            <div class="mk-card mk-leccion">
              <p class="mk-mini">Módulo 1 · Over jou</p>
              <p class="mk-titulo">Les 1 — Jezelf voorstellen</p>
              <p class="mk-sub">Presentarte: saludos, nombre, edad, nacionalidad y residencia</p>
              <div class="mk-prog"><i style="width:42%"></i></div>
              <ul class="mk-secciones">
                <li class="hecha"><span set:html={icono('check', 12, 3)} />Samenvatting</li>
                <li class="hecha"><span set:html={icono('check', 12, 3)} />Flashcards</li>
                <li class="ahora"><span></span>Oefening</li>
                <li><span></span>Lezen</li>
                <li><span></span>Luisteren</li>
              </ul>
            </div>
            <div class="mk-card mk-flash">
              <span class="mk-audio" set:html={icono('altavoz', 16, 2)} />
              <p class="mk-art">de</p>
              <p class="mk-palabra">naam</p>
              <p class="mk-trad">el nombre</p>
              <p class="mk-ej">Mijn naam is Maria.</p>
            </div>
          </div>

          <!-- 2 · La clase en directo (diálogo "Kennismaken in het café") -->
          <div class="fv-mock" data-paso="1" aria-hidden="true">
            <div class="mk-card mk-clase">
              <div class="mk-clase-top"><span class="mk-vivo"><i></i>En directo</span><span>Clase semanal · Módulo 1</span></div>
              <div class="mk-pantalla">
                <p class="mk-mini">Kennismaken in het café</p>
                <p class="mk-linea"><b>Anna</b> Waar kom je vandaan?</p>
                <p class="mk-linea"><b>David</b> Ik kom uit Argentinië, uit Buenos Aires.</p>
                <p class="mk-linea"><b>Anna</b> Wat leuk! En waar woon je nu?</p>
              </div>
              <div class="mk-caras">
                <span class="mk-cara prof">Profe</span>
                <span class="mk-cara">L</span>
                <span class="mk-cara">M</span>
                <span class="mk-cara tu">Tú</span>
              </div>
            </div>
            <div class="mk-card mk-turno">
              <span class="mk-turno-ico" set:html={icono('micro', 16, 2)} />
              <div><p class="mk-mini">Tu turno</p><p class="mk-turno-txt">Ik woon in Utrecht. En jij?</p></div>
            </div>
          </div>

          <!-- 3 · Una consulta respondida (la explicación de m1l1e-3) -->
          <div class="fv-mock" data-paso="2" aria-hidden="true">
            <div class="mk-card mk-chat">
              <p class="mk-mini">Consultas</p>
              <div class="mk-burbuja yo">¿Por qué se dice <b>«Hoe heet u?»</b> y no <b>«Hoe heet jij?»</b>?</div>
              <div class="mk-resp">
                <span class="mk-avatar">N</span>
                <div class="mk-burbuja equipo">
                  <span class="mk-quien">Equipo Nawar</span>
                  <b>U</b> es de usted: con alguien mayor, en la gemeente o en el médico. <b>Jij</b>, con amigos y compañeros. Las dos están bien; cambia el trato.
                </div>
              </div>
              <p class="mk-hora">Respondida hoy</p>
            </div>
          </div>

          <!-- 4 · Una situación de verdad (m1l1sp-3) y el certificado -->
          <div class="fv-mock" data-paso="3" aria-hidden="true">
            <div class="mk-card mk-ejer">
              <p class="mk-mini">Spreken · ¿Qué dices?</p>
              <p class="mk-pregunta">Te despides de un amigo y os veis mañana. ¿Qué dices?</p>
              <div class="mk-op ok"><span>A</span>Tot morgen!</div>
              <div class="mk-op apag"><span>B</span>Tot straks!</div>
              <div class="mk-op apag"><span>C</span>Goedemiddag!</div>
              <p class="mk-bien"><b>¡Correcto!</b> «Tot straks» es para el mismo día; «tot morgen», para mañana.</p>
            </div>
            <div class="mk-card mk-cert">
              <span set:html={icono('premio', 18, 2)} />
              <div><p class="mk-mini">Al terminar</p><p class="mk-cert-txt">Certificado Nawar A0-A1</p></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ Lo que tienes dentro: las ilustraciones de las landings ═══ -->
    <section class="fv-sec fv-claro">
      <div class="fv-in">
        <div class="fv-cab">
          <span class="fv-badge">Por qué esta formación</span>
          <h2 class="fv-h2">Una formación, <span class="fv-acento">no un curso de vídeos</span></h2>
          <p class="fv-lead">Lo que hace que esta vez sí llegues al final.</p>
        </div>
        <div class="fv-dentro">
          {DENTRO.map((d) => (
            <article class="fv-den">
              <figure class="fv-den-foto">
                <img src={d.img} alt={d.t} loading="lazy" decoding="async"
                  onerror="this.closest('figure').classList.add('sin-foto'); this.remove();" />
                <span class="fv-den-plan-b" set:html={icono(d.i, 40, 1.4)} />
              </figure>
              <div class="fv-den-txt">
                <h3>{d.t}</h3>
                <p>{d.d}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ El plan de estudios, por etapas (oscuro, como UDIA) ═══ -->
    <section class="fv-sec fv-prog-sec" id="programa">
      <span class="fv-dots" aria-hidden="true"></span>
      <div class="fv-in">
        <div class="fv-cab fv-cab-izq">
          <span class="fv-badge-dark">4 etapas · 16 semanas · certificado</span>
          <h2 class="fv-h2 fv-h2-blanco">Plan de estudios: <span class="fv-azul">de cero a A1</span></h2>
          <p class="fv-lead fv-lead-blanco">Metodología progresiva: <span class="fv-flujo">entender → hablar → resolver → consolidar</span>, con un hito concreto al final de cada etapa.</p>
        </div>
      </div>

      <div class="fv-in">
        <!-- Móvil: las etapas pegadas arriba al bajar, con la raya de progreso. -->
        <div class="fv-fases-barra" id="fv-fases-barra">
          <div class="fv-fases-pills" id="fv-fases-pills">
            {FASES.map((f) => (
              <a href={`#fase-${f.n}`} class="fv-pill" data-fase={f.n} style={`--c:${f.c}`}><b>{f.n}</b>{f.nombre}</a>
            ))}
            <a href="#fase-cert" class="fv-pill" data-fase="cert" style="--c:#9fd0ff"><b>✓</b>Certificado</a>
          </div>
          <div class="fv-fases-raya" aria-hidden="true"><span class="fv-raya-fill"></span></div>
        </div>

        <div class="fv-prog">
          <aside class="fv-prog-nav" aria-label="Etapas del plan de estudios">
            <div class="fv-prog-nav-caja">
              <div class="fv-prog-nav-top">
                <p class="fv-prog-nav-titulo">Recorrido</p>
                <p class="fv-prog-nav-paso" id="fv-prog-paso">Etapa 1 / 4</p>
              </div>
              <div class="fv-fases-raya fv-raya-lateral" aria-hidden="true"><span class="fv-raya-fill"></span></div>
              <ol>
                {FASES.map((f) => (
                  <li><a href={`#fase-${f.n}`} data-fase={f.n} style={`--c:${f.c}`}><span class="fv-prog-bola">{f.n}</span><span><b>{f.nombre}</b><small>{f.semanas}</small></span></a></li>
                ))}
                <li><a href="#fase-cert" data-fase="cert" style="--c:#9fd0ff"><span class="fv-prog-bola">✓</span><span><b>Certificado</b><small>Al terminar</small></span></a></li>
              </ol>
            </div>
          </aside>

          <div class="fv-prog-fases" id="fv-prog-fases">
            {FASES.map((f) => (
              <article class="fv-fase" id={`fase-${f.n}`} data-fase={f.n} style={`--c:${f.c}`}>
                <div class="fv-fase-chips">
                  <span class="fv-fase-chip fv-fase-chip-c">Etapa {f.n}</span>
                  <span class="fv-fase-chip"><Fragment set:html={icono('reloj', 13, 2)} />{f.semanas}</span>
                </div>
                <div class="fv-fase-cab">
                  <span class="fv-fase-n">{f.n}</span>
                  <div>
                    <h3>{f.nombre}</h3>
                    <p>{f.sub}</p>
                  </div>
                </div>
                <div class="fv-fase-promesa">
                  <span>Objetivo</span>
                  <p>{f.objetivo}</p>
                </div>
                <p class="fv-fase-sub">Lo que trabajas</p>
                <ul class="fv-fase-temas">{f.temas.map((t) => <li>{t}</li>)}</ul>
                <div class="fv-fase-hito">
                  <span class="fv-fase-hito-ico" set:html={icono('diana', 18, 2)} />
                  <p><b>Hito al terminar:</b> {f.hito}</p>
                </div>
                <p class="fv-fase-mods"><span>Incluye</span>{f.modulos.map((m) => <i>{m}</i>)}</p>
              </article>
            ))}

            <!-- El certificado de verdad (el de las landings), con su plan B. -->
            <article class="fv-fase fv-fase-cert" id="fase-cert" data-fase="cert" style="--c:#9fd0ff">
              <div class="fv-fase-chips">
                <span class="fv-fase-chip fv-fase-chip-c">Certificación</span>
                <span class="fv-fase-chip"><Fragment set:html={icono('premio', 13, 2)} />Al completar la formación</span>
              </div>
              <h3 class="fv-cert-titulo">Certificado de finalización Nawar</h3>
              <div class="fv-cert-visual">
                <figure class="fv-cert-foto" id="fv-cert-foto">
                  <img class="fv-cert-fondo" src={IMG.certFondo} alt="" loading="lazy" decoding="async"
                    onerror="this.closest('#fv-cert-foto').classList.add('sin-fondo'); this.remove();" />
                  <span class="fv-cert-papel">
                    <img src={IMG.certificado} alt="Certificado de finalización de la Formación Nawar A0-A1" loading="lazy" decoding="async"
                      onerror="this.closest('#fv-cert-foto').remove(); document.getElementById('fv-cert-dibujo').hidden = false;" />
                  </span>
                </figure>
                <div class="fv-cert-dibujo" id="fv-cert-dibujo" hidden aria-hidden="true">
                  <p class="fv-cert-marca">Holandés Nawar</p>
                  <p class="fv-cert-tipo">Certificado de finalización</p>
                  <p class="fv-cert-nombre">Tu nombre aquí</p>
                  <p class="fv-cert-texto">ha completado la <strong>Formación Nawar A0-A1</strong> de neerlandés</p>
                </div>
              </div>
              <div class="fv-cert-tres">
                <div><span>Cómo se consigue</span><p>Completando la formación.</p></div>
                <div><span>Qué acredita</span><p>Tu nivel A1 y el trabajo que has hecho, con tu nombre.</p></div>
                <div><span>Y después</span><p>Te contamos el siguiente paso para seguir hacia el A2.</p></div>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ ¿Te reconoces? ═══ -->
    <section class="fv-sec fv-blanco">
      <div class="fv-in">
        <div class="fv-cab">
          <span class="fv-badge">Para quién es</span>
          <h2 class="fv-h2">¿Te reconoces <span class="fv-acento">en alguna?</span></h2>
          <p class="fv-lead">Para estas personas está hecha la formación.</p>
        </div>
        <div class="fv-perfiles">
          {PERFILES.map((p) => (
            <article class="fv-perfil">
              <span class="fv-comillas" aria-hidden="true">“</span>
              <p class="fv-perfil-q">{p.q}</p>
              <p class="fv-perfil-r"><span set:html={icono('check', 16, 2.6)} />{p.r}</p>
            </article>
          ))}
        </div>
        <div class="fv-noes">
          <p class="fv-noes-t">No es para ti si…</p>
          <ul>
            {NO_ES.map((t) => <li><span set:html={icono('x', 14, 2.4)} />{t}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- ═══ Competencias al terminar (panel oscuro, como UDIA) ═══ -->
    <section class="fv-sec fv-blanco fv-comp-sec">
      <div class="fv-in">
        <div class="fv-comp">
          <div class="fv-comp-cab">
            <span class="fv-badge-dark">Competencias al terminar</span>
            <h2 class="fv-h2 fv-h2-blanco">En 16 semanas, <span class="fv-azul">esto lo haces tú</span></h2>
            <p class="fv-lead fv-lead-blanco">El nivel A1: lo que necesitas para moverte solo en el día a día.</p>
          </div>
          <ol class="fv-comp-lista">
            {SABRAS.map((x, k) => (
              <li><span class="fv-num">{k + 1}</span><p set:html={resaltar(x)} /></li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- ═══ Cierre: la admisión en tres pasos y el formulario otra vez ═══ -->
    <section class="fv-cierre">
      <div class="fv-capas" aria-hidden="true">
        <span class="fv-luz1"></span><span class="fv-luz2"></span><span class="fv-malla"></span><span class="fv-dots"></span>
      </div>
      <div class="fv-cierre-in">
        <div class="fv-cierre-texto">
          <span class="fv-badge-dark">Plazas limitadas por convocatoria</span>
          <h2 class="fv-h2 fv-h2-blanco">Tu admisión empieza <span class="fv-azul">en 30 segundos</span></h2>
          <ol class="fv-pasos">
            {PASOS_ADMISION.map((p, k) => (
              <li><span class="fv-pasos-n">{k + 1}</span><div><b>{p.t}</b><p>{p.d}</p></div></li>
            ))}
          </ol>
        </div>
        <FormSolicitud suf="b" eyebrow="Sin compromiso" titulo="Solicita información" />
      </div>

      <footer class="fv-pie">
        <img src={LOGO} alt="Holandés Nawar" class="fv-logo-pie" width="110" height="28" />
        <nav>
          <a href="/politica-de-privacidad">Privacidad</a>
          <a href="/condiciones-de-contratacion">Condiciones</a>
          <a href="mailto:info@holandesnawar.com">info@holandesnawar.com</a>
        </nav>
        <p>© Holandés Nawar</p>
      </footer>
    </section>

    <!-- Móvil: el botón siempre a mano cuando no se ve ningún formulario. -->
    <div class="fv-pegado" id="fv-pegado" aria-hidden="true">
      <span class="fv-pegado-ico" set:html={icono('telefono', 19, 2)} />
      <span class="fv-pegado-txt"><b>Sin compromiso</b>Solicitar información</span>
      <a href="#solicitud-a" class="fv-pegado-btn" data-ir-form tabindex="-1" aria-label="Solicitar información">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</Layout>

<script>
  import { leerUTM, guardarUTM } from '../../../lib/utm'
  import { contextoDelLead } from '../../../lib/recorrido'
  import { CLAVE_DATOS, V2, telefonoCompleto, type DatosAdmision } from '../../../lib/admision'
  guardarUTM()

  const leer = <T,>(k: string): T | null => {
    try { const v = localStorage.getItem(k); return v ? (JSON.parse(v) as T) : null } catch { return null }
  }
  const guardar = (k: string, v: unknown) => { try { localStorage.setItem(k, JSON.stringify(v)) } catch {} }
  const previos = leer<DatosAdmision>(CLAVE_DATOS)
  let enviado = false

  // ── Los formularios (hay dos: arriba y al final) ──────────────────────
  document.querySelectorAll<HTMLFormElement>('[data-fv-form]').forEach((form) => {
    const campo = <T extends HTMLElement>(n: string) => form.querySelector(`[data-campo="${n}"]`) as T
    const nombreEl = campo<HTMLInputElement>('nombre')
    const emailEl = campo<HTMLInputElement>('email')
    const telEl = campo<HTMLInputElement>('tel')
    const sel = campo<HTMLSelectElement>('prefijo')
    const pintarPrefijo = () => {
      const o = sel.options[sel.selectedIndex]
      campo('prefijo-ver').textContent = `${o.dataset.bandera} ${o.dataset.prefijo}`
    }
    sel.addEventListener('change', pintarPrefijo)

    // Quien vuelve: sus datos ya puestos.
    if (previos) {
      nombreEl.value = previos.first_name || ''
      emailEl.value = previos.email || ''
      const op = Array.from(sel.options).find((o) => previos.phone?.startsWith(o.dataset.prefijo || '~') && o.dataset.pais === previos.pais)
      if (op) {
        sel.value = op.value
        pintarPrefijo()
        telEl.value = previos.phone.slice((op.dataset.prefijo || '').length)
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault()
      if (enviado) return
      const nombre = nombreEl.value.trim()
      const email = emailEl.value.trim().toLowerCase()
      const opcion = sel.options[sel.selectedIndex]
      const phone = telefonoCompleto(opcion.dataset.prefijo || '', telEl.value)
      const ok = nombre.length > 0 && /\S+@\S+\.\S+/.test(email) && phone.replace(/\D/g, '').length >= 8
      campo('err').classList.toggle('visible', !ok)
      if (!ok) return
      enviado = true
      const boton = campo<HTMLButtonElement>('enviar')
      boton.disabled = true
      boton.classList.add('enviando')

      const datos: DatosAdmision = { first_name: nombre, email, phone, pais: opcion.dataset.pais || '' }
      guardar(CLAVE_DATOS, datos)

      // A la escuela, como la ventanita del proceso de admisión: ya es una
      // matrícula ("pidió plaza") y entra en systeme.io con «Admisión - datos».
      try {
        fetch('/api/cualificacion', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          keepalive: true,
          body: JSON.stringify({
            parcial: true,
            matricula: true,
            hito: 'datos',
            embudo: 'admision',
            origen: V2.origen,
            video: 'empezado',
            first_name: nombre,
            last_name: '',
            email,
            phone,
            website: campo<HTMLInputElement>('hp').value,
            respuestas: {},
            textos: {},
            ...contextoDelLead(),
            ...leerUTM(),
          }),
        }).catch(() => {})
      } catch {}

      // Píxel: la misma marca que el proceso de admisión, para no contar doble.
      try {
        if (!sessionStorage.getItem('lead-agendar')) {
          sessionStorage.setItem('lead-agendar', '1')
          ;(window as any).fbq?.('track', 'SubmitApplication', { content_name: 'Formación v2' })
        }
      } catch {}

      // `d=1`: por si el navegador no deja guardar nada (ventana privada), que
      // la página del vídeo no le devuelva aquí.
      setTimeout(() => { window.location.href = `${V2.video}?d=1` }, 250)
    })
  })

  // ── Ir al formulario: al más cercano (el de arriba o el del final) ────
  const cajas = Array.from(document.querySelectorAll<HTMLElement>('[data-fv-caja]'))
  document.querySelectorAll<HTMLAnchorElement>('[data-ir-form]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault()
      const y = window.scrollY + window.innerHeight / 2
      const destino = cajas.reduce((m, c) => {
        const cy = c.getBoundingClientRect().top + window.scrollY
        const my = m.getBoundingClientRect().top + window.scrollY
        return Math.abs(cy - y) < Math.abs(my - y) ? c : m
      }, cajas[0])
      destino.scrollIntoView({ behavior: 'smooth', block: 'center' })
      setTimeout(() => (destino.querySelector('[data-campo="nombre"]') as HTMLInputElement)?.focus({ preventScroll: true }), 500)
    })
  })

  // ── Así es una semana: un paso y su pieza ─────────────────────────────
  // Pasa sola cada 6 s mientras se ve, hasta que la persona toca un paso.
  const pasos = Array.from(document.querySelectorAll<HTMLButtonElement>('.fv-sem-paso'))
  const mocks = Array.from(document.querySelectorAll<HTMLElement>('.fv-mock'))
  const semana = document.getElementById('semana') as HTMLElement
  let pasoActivo = 0
  const verPaso = (k: number) => {
    pasoActivo = k
    pasos.forEach((p, j) => { p.classList.toggle('activo', j === k); p.setAttribute('aria-expanded', j === k ? 'true' : 'false') })
    mocks.forEach((m, j) => { m.classList.toggle('activo', j === k); m.setAttribute('aria-hidden', j === k ? 'false' : 'true') })
  }
  let reloj: number | undefined
  const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const parar = () => { window.clearInterval(reloj); reloj = undefined; semana.classList.remove('auto') }
  const arrancar = () => {
    if (quieto || reloj !== undefined || semana.dataset.tocado) return
    semana.classList.add('auto')
    reloj = window.setInterval(() => verPaso((pasoActivo + 1) % pasos.length), 6000)
  }
  pasos.forEach((p, k) => p.addEventListener('click', () => {
    semana.dataset.tocado = '1'
    parar()
    verPaso(k)
  }))
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(([en]) => (en.isIntersecting ? arrancar() : parar()), { threshold: 0.35 }).observe(semana)
  }

  // ── El plan de estudios: etapa activa, su color y la raya de progreso ─
  // ⚠️ 07/10, "vibra al scrollear despacio" (dos veces). Antes se medía en
  // cada fotograma del scroll y la raya seguía al dedo: en el iPhone, tocar
  // un elemento pegajoso a la vez que el desplazamiento por inercia tiembla.
  // Ahora NO hay código en el scroll: un IntersectionObserver avisa al cambiar
  // de etapa, y solo entonces se toca la barra (la raya avanza por etapas,
  // con una transición de CSS).
  const contenedor = document.getElementById('fv-prog-fases') as HTMLElement
  const fases = Array.from(contenedor.querySelectorAll<HTMLElement>('.fv-fase'))
  const enlaces = Array.from(document.querySelectorAll<HTMLAnchorElement>('.fv-pill, .fv-prog-nav a'))
  const pills = document.getElementById('fv-fases-pills') as HTMLElement
  const rayas = Array.from(document.querySelectorAll<HTMLElement>('.fv-raya-fill'))
  const pasoTxt = document.getElementById('fv-prog-paso') as HTMLElement
  let activa = ''
  const marcar = (id: string) => {
    if (id === activa) return
    activa = id
    const orden = fases.findIndex((f) => f.dataset.fase === id)
    enlaces.forEach((a) => {
      const j = fases.findIndex((f) => f.dataset.fase === a.dataset.fase)
      a.classList.toggle('activo', j === orden)
      a.classList.toggle('hecho', j < orden)
    })
    fases.forEach((f, j) => f.classList.toggle('activa', j === orden))
    pasoTxt.textContent = id === 'cert' ? 'Certificado' : `Etapa ${orden + 1} / ${fases.length - 1}`
    rayas.forEach((x) => (x.style.transform = `scaleX(${(orden + 1) / fases.length})`))
    const pill = pills.querySelector<HTMLElement>(`[data-fase="${id}"]`)
    if (pill && pills.scrollWidth > pills.clientWidth) {
      const izq = pill.offsetLeft - 16
      const der = pill.offsetLeft + pill.offsetWidth - pills.clientWidth + 16
      if (pills.scrollLeft > izq) pills.scrollLeft = izq
      else if (pills.scrollLeft < der) pills.scrollLeft = der
    }
  }
  marcar(fases[0].dataset.fase || '')
  if ('IntersectionObserver' in window) {
    // Una franja fina al 40 % de la pantalla: la etapa que la cruza es la
    // que se está leyendo.
    const io = new IntersectionObserver((entradas) => {
      for (const e of entradas) if (e.isIntersecting) marcar((e.target as HTMLElement).dataset.fase || '')
    }, { rootMargin: '-40% 0px -59% 0px' })
    fases.forEach((f) => io.observe(f))
  }
  enlaces.forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault()
    const destino = document.getElementById(a.getAttribute('href')!.slice(1))
    if (!destino) return
    const barra = window.matchMedia('(max-width: 1023px)').matches ? 72 : 24
    window.scrollTo({ top: destino.getBoundingClientRect().top + window.scrollY - barra, behavior: 'smooth' })
  }))

  // ── Móvil: el botón pegado abajo cuando no se ve ningún formulario ────
  const pegado = document.getElementById('fv-pegado') as HTMLElement
  if ('IntersectionObserver' in window && cajas.length) {
    const visibles = new Set<Element>()
    const pintar = () => {
      const pasadoElPrimero = cajas[0].getBoundingClientRect().bottom < 0
      const ver = visibles.size === 0 && pasadoElPrimero
      pegado.classList.toggle('visible', ver)
      pegado.setAttribute('aria-hidden', ver ? 'false' : 'true')
    }
    const io = new IntersectionObserver((entradas) => {
      entradas.forEach((e) => (e.isIntersecting ? visibles.add(e.target) : visibles.delete(e.target)))
      pintar()
    })
    cajas.forEach((c) => io.observe(c))
  }
</script>

