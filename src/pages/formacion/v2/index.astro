---
/**
 * /formacion/v2 — la página de la formación para los anuncios (07/10, EN
 * PRUEBAS, fuera de Google y sin enlazar desde la web).
 *
 * Idea del usuario, copiada del embudo de UDIA: una página que EXPLICA la
 * formación (no que vende: sin precio), con el formulario de tres datos
 * arriba del todo. Al mandarlo, el vídeo (/formacion/v2/video) con el botón
 * de la llamada bloqueado y una cuenta atrás; y de ahí el formulario de
 * admisión (/formacion/v2/formulario). El closer llama en cuanto entra el lead.
 *
 * Lo que manda aquí, por encima de todo: los dolores REALES de quien vive en
 * Países Bajos sin el idioma (depender de otros para el médico, las cartas,
 * hablar con la gente). El texto es propio de esta página, no copiado de las
 * landings; lo que sí se comparte es la marca (Poppins, azules, subrayado).
 *
 * A la escuela llega como el proceso de admisión (`embudo: 'admision'`), así
 * que el panel lo trata igual. Ver V2 en src/lib/admision.ts.
 */
import Layout from '../../../layouts/Layout.astro'
import { PREFIJOS, V2 } from '../../../lib/admision'

export const prerender = true

const LOGO = 'https://d1yei2z3i6k35z.cloudfront.net/9533860/671a9c9265e23_Logo_Nawar_2.png'
const opciones = PREFIJOS.map((p, i) => ({ ...p, valor: `${i}` }))

/** Iconos de línea (24×24, trazo), en un solo sitio. */
const ICONOS: Record<string, string> = {
  medico: '<path d="M11 2v2"/><path d="M5 2v2"/><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/>',
  carta: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  familia: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  charla: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><path d="M8 12h.01"/><path d="M12 12h.01"/><path d="M16 12h.01"/>',
  compra: '<circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>',
  candado: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  libro: '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
  video: '<path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"/><rect x="2" y="6" width="14" height="12" rx="2"/>',
  consulta: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .8-1 1.5"/><path d="M12 15h.01"/>',
  grupo: '<path d="M18 21a8 8 0 0 0-16 0"/><circle cx="10" cy="8" r="5"/><path d="M22 20c0-3.37-2-6.5-4-8a5 5 0 0 0-.45-8.3"/>',
  calendario: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/>',
  premio: '<path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/><circle cx="12" cy="8" r="6"/>',
  progreso: '<path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="m19 9-5 5-4-4-3 3"/>',
  escudo: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
}
const icono = (n: string, tam = 22) =>
  `<svg viewBox="0 0 24 24" width="${tam}" height="${tam}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONOS[n]}</svg>`

/** Los dolores. Lo más importante de la página (usuario, 07/10): depender
 *  de otros para cosas de todos los días. Situaciones concretas, en primera
 *  línea, sin adornos. */
const DOLORES = [
  { i: 'medico', t: 'En el médico, alguien tiene que traducir por ti', d: 'Explicar qué te pasa, entender lo que te dicen, pedir otra cita. Y siempre con alguien al lado, porque solo no te atreves.' },
  { i: 'carta', t: 'Llega una carta y no sabes qué te piden', d: 'La gemeente, el seguro, el colegio. Foto al traductor del móvil y a cruzar los dedos para no equivocarte.' },
  { i: 'familia', t: 'Tu pareja o tus hijos hablan por ti', d: 'En la tienda, en la reunión del colegio, al teléfono. Te ayudan con todo el cariño, pero tú querrías poder hacerlo solo.' },
  { i: 'charla', t: 'Te quedas fuera de la conversación', d: 'Con los vecinos, en el trabajo, en un cumpleaños. Sonríes, asientes y esperas a que alguien te lo cuente después.' },
  { i: 'compra', t: 'Lo básico, siempre en inglés o por señas', d: 'La compra, el tren, una pregunta en la ventanilla. Sales del paso, pero así nunca terminas de sentirte de aquí.' },
  { i: 'candado', t: 'Hay cosas que ni te planteas', d: 'Un trabajo mejor, amigos holandeses, montar algo tuyo. Todo pasa por el idioma, y el idioma se queda para “algún día”.' },
]

/** Lo que sabrás hacer al terminar: nivel A1, situaciones de la vida real.
 *  Las palabras en `[ ]` salen resaltadas. */
const SABRAS = [
  '[Presentarte] y hablar de ti, de tu familia y de tu trabajo.',
  '[Pedir una cita] y explicar con frases sencillas qué necesitas.',
  '[Hacer la compra], pedir en un café y pagar sin pasarte al inglés.',
  'Entender [horas, días y fechas]: el tren, el colegio, una cita.',
  'Leer [mensajes y avisos cortos] y saber qué te están pidiendo.',
  'Dar [tus datos]: deletrear tu nombre, tu dirección y tu teléfono.',
  'Mantener [una conversación corta] con un vecino o un compañero.',
  'Seguir avanzando [por tu cuenta], porque ya entiendes cómo funciona el idioma.',
]
const resaltar = (t: string) => t.replace(/\[([^\]]+)\]/g, '<span class="fv-chip">$1</span>')

/** Cómo se aprende: lo que HACE el alumno cada semana (06/10: "dejar de
 *  vender vídeos y decir las acciones que tienes que hacer"). */
const CAMINO = [
  { i: 'libro', etiqueta: 'A tu ritmo', t: 'Sigues las lecciones de la semana', d: 'Cada semana se abre lo que toca: un vídeo corto explicado en español, vocabulario con audio, lecturas y ejercicios. Con 20-30 minutos al día vas al día, y siempre sabes qué viene después.' },
  { i: 'video', etiqueta: 'En directo · cada semana', t: 'Hablas en la clase semanal', d: 'Una vez por semana, conversación en directo con un profesor que habla español. Dices en voz alta lo que has aprendido. ¿No puedes ir? Queda grabada.' },
  { i: 'consulta', etiqueta: 'Consultas · comunidad', t: 'Preguntas cuando te atascas', d: 'Tus dudas las responde el equipo, y en la comunidad compartes avances con tu grupo. Nada de quedarte una semana bloqueado con la misma pregunta.' },
  { i: 'premio', etiqueta: 'Certificado Nawar', t: 'Te vales por ti mismo', d: 'Te presentas, haces la compra, pides una cita y entiendes lo básico sin depender de nadie. Y te llevas tu certificado con tu nombre.' },
]

/** El programa por fases. Las cuatro primeras son los módulos que YA están
 *  en la escuela (courseData.ts), con sus lecciones de verdad. De los demás
 *  no se inventa el temario: se cuenta cómo se abren. */
const FASES = [
  {
    n: '01', nombre: 'Primeros pasos', modulo: 'Módulo 1 · Sobre ti',
    promesa: 'Te presentas, das tus datos y pronuncias bien desde el primer día.',
    temas: ['Presentarte: saludos, nombre, edad, de dónde eres y dónde vives', 'Los pronombres y los verbos en presente', 'Los números y los precios', 'El alfabeto: deletrear tu nombre y tu dirección', 'Las vocales que más cuestan: a/aa, e/ee, o/oo', 'Extra: colores, países e idiomas, preguntas básicas'],
  },
  {
    n: '02', nombre: 'Tu gente y tu semana', modulo: 'Módulo 2 · Familia y amigos',
    promesa: 'Hablas de tu familia, organizas tu semana y cuentas tu rutina.',
    temas: ['La familia y cómo presentar a alguien', 'Hacer frases: el orden de la frase en neerlandés', 'Días, meses y palabras para hacer planes', 'de, het, een y los posesivos', 'A qué hora: om, op, in y tu rutina diaria', 'Los sonidos ei, ij y ui'],
  },
  {
    n: '03', nombre: 'En la calle', modulo: 'Módulo 3 · Compras y comida',
    promesa: 'Te mueves por el supermercado y por un café: pides, preguntas y pagas.',
    temas: ['Comida y bebida', 'Pedir: Ik wil… / Mag ik…?', 'Hacer preguntas: wie, wat, waar, hoeveel…', 'Unir frases: en, maar, of, want', 'Cantidades, pedir más y decir qué te gusta', 'Pagar y repartir la cuenta como en Países Bajos'],
  },
  {
    n: '04', nombre: 'El trabajo', modulo: 'Módulo 4 · El trabajo',
    promesa: 'Hablas de tu profesión, de tus horarios y de lo que puedes o tienes que hacer.',
    temas: ['Profesiones y vocabulario del trabajo', 'hebben y zijn en el trabajo', 'Decir para qué haces las cosas: om… te', 'La hora y los horarios', 'Poder, querer, tener que: los verbos modales', 'La g y la ch, el sonido más neerlandés', 'Extra: escribir un correo formal e informal'],
  },
]

const INCLUYE = [
  { i: 'video', t: 'Clase en directo cada semana', d: 'Conversación con un profesor que habla español. Y si no puedes ir, la grabación.' },
  { i: 'consulta', t: 'Consultas con el equipo', d: 'Preguntas lo que no entiendes y te respondemos. Sin esperar a la clase.' },
  { i: 'libro', t: 'La escuela online', d: 'Vídeos cortos, vocabulario con audio, lecturas y ejercicios que se corrigen solos.' },
  { i: 'progreso', t: 'Tu progreso, siempre a la vista', d: 'Sabes qué has hecho, qué te falta y qué repasar. Retomas donde lo dejaste.' },
  { i: 'grupo', t: 'Comunidad privada', d: 'Tu grupo, avanzando contigo. Dudas, victorias y práctica entre semana.' },
  { i: 'calendario', t: '6 meses de acceso', d: '16 semanas de programa y margen de sobra para repasar lo que quieras.' },
]

const PARA_TI = [
  'Vives en [Países Bajos o Bélgica], o te mudas pronto',
  'Empiezas [de cero] o con muy poca base',
  'Quieres que te lo expliquen [en español]',
  'Buscas [un camino guiado], no apps sueltas',
  'Puedes dedicarle [unas horas a la semana]',
]
const NO_PARA_TI = [
  'Buscas algo milagroso que no pida práctica',
  'Ya tienes un nivel A2 o más',
  'No tienes ni dos horas a la semana para esto',
]

const DUDAS = [
  { q: '¿Qué pasa cuando dejo mis datos?', a: 'Ves un vídeo corto con cómo funciona la formación por dentro y alguien del equipo te escribe por WhatsApp. Si quieres, ahí mismo reservas una llamada: vemos de dónde partes y si encaja contigo. Dejar tus datos no te compromete a nada.' },
  { q: '¿Necesito saber algo de neerlandés?', a: 'No. La formación empieza desde cero, pensada para quien nunca lo ha estudiado o tiene nociones sueltas. Todo se explica en español.' },
  { q: '¿Cuánto tiempo necesito a la semana?', a: 'Con 20-30 minutos al día vas al día, más la clase semanal. Y cada dos módulos hay una semana sin contenido nuevo para ponerte al día si vas justo.' },
  { q: '¿Hay horarios fijos?', a: 'Solo la clase en directo, una vez por semana. Si no puedes ir, queda grabada. Las lecciones las haces cuando te venga bien.' },
  { q: '¿Cuánto tiempo tengo acceso?', a: 'Seis meses desde que entras. El programa son 16 semanas, así que al terminar te queda margen para repasar lo que quieras.' },
  { q: '¿Y si no es lo que esperaba?', a: 'Tienes 15 días de garantía de devolución. Si en ese tiempo ves que no es para ti, te devolvemos el dinero completo.' },
]

const MARQUESINA = ['Escuchar', 'Entender', 'Hablar', 'Valerte por ti mismo', 'Certificado Nawar']
---

<Layout
  title="Formación Nawar A0-A1 · Neerlandés de cero a A1 — Holandés Nawar"
  description="Neerlandés de cero a A1 para hispanohablantes, en 16 semanas y explicado en español. Clase en directo cada semana, consultas con el equipo y certificado."
  noindex={true}
>
  <div class="fv">
    <!-- ═══ Cabecera + formulario ═══ -->
    <header class="fv-hero">
      <div class="fv-glow1" aria-hidden="true"></div>
      <div class="fv-glow2" aria-hidden="true"></div>
      <div class="fv-dots" aria-hidden="true"></div>

      <nav class="fv-nav">
        <a href="/" aria-label="Holandés Nawar"><img src={LOGO} alt="Holandés Nawar" class="fv-logo" width="150" height="38" /></a>
        <a href="#solicitud" class="fv-nav-cta" data-ir-form>Solicitar mi plaza</a>
      </nav>

      <div class="fv-hero-in">
        <div class="fv-hero-texto">
          <span class="fv-badge-dark">Formación A0-A1 · Plazas limitadas</span>
          <h1 class="fv-h1">
            <span class="fv-h1-blanco">Neerlandés de cero <span class="fv-nw">a A1,</span></span>
            <span class="fv-h1-azul">para valerte <span class="fv-nw">por ti mismo</span></span>
          </h1>
          <p class="fv-hero-sub">
            Un camino de 16 semanas, explicado en español, para ir al médico, hacer tus gestiones y hablar con la gente
            <strong>sin que nadie tenga que hacerlo por ti.</strong>
          </p>
          <ul class="fv-hero-lista">
            <li><span class="fv-tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span>Clase en directo cada semana con un profesor que habla español</li>
            <li><span class="fv-tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span>El equipo responde tus dudas cuando te atascas</li>
            <li><span class="fv-tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span>Certificado Nawar al terminar</li>
          </ul>
        </div>

        <!-- El formulario: tres datos, como UDIA. -->
        <div class="fv-form-caja" id="solicitud">
          <p class="fv-form-eyebrow">Admisión · Sin compromiso</p>
          <h2 class="fv-form-titulo">Solicita tu plaza</h2>
          <p class="fv-form-lead">Déjanos tus datos: te enseñamos cómo funciona por dentro y te escribimos para ver si encaja contigo.</p>
          <form id="fv-form" novalidate>
            <div class="fv-honeypot" aria-hidden="true">
              <label>No rellenar <input type="text" id="fv-hp" name="website" tabindex="-1" autocomplete="off" /></label>
            </div>
            <label class="fv-label" for="fv-nombre">Nombre</label>
            <input id="fv-nombre" type="text" class="fv-input" placeholder="Tu nombre" autocomplete="given-name" required />

            <label class="fv-label" for="fv-email">Correo</label>
            <input id="fv-email" type="email" class="fv-input" placeholder="correo@ejemplo.com" autocomplete="email" required />

            <label class="fv-label" for="fv-tel">WhatsApp</label>
            <div class="fv-tel">
              <!-- Cerrado enseña bandera y prefijo; el select va encima,
                   transparente, para que el desplegable sea el del móvil. -->
              <div class="fv-input fv-prefijo">
                <span id="fv-prefijo-ver" aria-hidden="true">{opciones[0].bandera} {opciones[0].prefijo}</span>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                <select id="fv-prefijo" aria-label="Prefijo del país">
                  {opciones.map((p) => <option value={p.valor} data-prefijo={p.prefijo} data-pais={p.pais} data-bandera={p.bandera}>{p.bandera} {p.pais} ({p.prefijo})</option>)}
                </select>
              </div>
              <input id="fv-tel" type="tel" class="fv-input" placeholder="6 12345678" autocomplete="tel-national" inputmode="tel" required />
            </div>

            <p class="fv-err" id="fv-err">Revisa el nombre, el correo y el número.</p>
            <button type="submit" class="fv-btn" id="fv-enviar">
              Solicitar mi plaza
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>
            <p class="fv-legal">Al continuar aceptas la <a href="/politica-de-privacidad" target="_blank" rel="noopener">política de privacidad</a>. Nada de spam.</p>
          </form>
        </div>
      </div>
    </header>

    <!-- La cinta, como UDIA: el camino en cinco palabras. -->
    <div class="fv-cinta" aria-hidden="true">
      <div class="fv-cinta-pista">
        {[0, 1, 2, 3].map(() => (
          <span class="fv-cinta-grupo">{MARQUESINA.map((m) => <span>{m}<i>·</i></span>)}</span>
        ))}
      </div>
    </div>

    <!-- ═══ Los dolores ═══ -->
    <section class="fv-sec fv-blanco">
      <div class="fv-in">
        <div class="fv-cab">
          <span class="fv-badge">¿Te suena?</span>
          <h2 class="fv-h2">Vivir en Países Bajos <span class="fv-acento">dependiendo de otros</span> cansa</h2>
          <p class="fv-lead">No es que no lo intentes. Es que cada día hay un momento en el que necesitas a alguien.</p>
        </div>
        <div class="fv-dolores">
          {DOLORES.map((d) => (
            <article class="fv-dolor">
              <span class="fv-dolor-ico" set:html={icono(d.i)} />
              <h3>{d.t}</h3>
              <p>{d.d}</p>
            </article>
          ))}
        </div>
        <div class="fv-giro">
          <p>
            No es falta de ganas ni de capacidad. Es que nadie te ha dado <strong>un camino claro, en tu idioma y con alguien al lado</strong>.
            Eso es la Formación Nawar.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══ Lo que sabrás hacer ═══ -->
    <section class="fv-sec fv-claro">
      <div class="fv-in">
        <div class="fv-sabras">
          <div class="fv-cab fv-cab-izq">
            <span class="fv-badge">Al terminar</span>
            <h2 class="fv-h2">Lo que <span class="fv-acento">sabrás hacer</span> en 16 semanas</h2>
            <p class="fv-lead">El nivel A1: lo que necesitas para moverte solo en el día a día. Sin memorizar listas, practicando situaciones de verdad.</p>
            <a href="#solicitud" class="fv-btn-sec" data-ir-form>Quiero empezar mi admisión
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
          <ol class="fv-sabras-lista">
            {SABRAS.map((s, i) => (
              <li><span class="fv-num">{String(i + 1).padStart(2, '0')}</span><p set:html={resaltar(s)} /></li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- ═══ El camino ═══ -->
    <section class="fv-sec fv-blanco">
      <div class="fv-in">
        <div class="fv-cab">
          <span class="fv-badge">El camino</span>
          <h2 class="fv-h2">Así se aprende <span class="fv-acento">en Nawar</span></h2>
          <p class="fv-lead">No es ver vídeos y ya. Cada semana tiene cuatro cosas claras que hacer, y ninguna la haces solo.</p>
        </div>
        <ol class="fv-camino">
          {CAMINO.map((c, i) => (
            <li class="fv-paso">
              <div class="fv-paso-cab">
                <span class="fv-paso-n">{i + 1}</span>
                <span class="fv-paso-linea" aria-hidden="true"></span>
              </div>
              <div class="fv-paso-caja">
                <span class="fv-paso-ico" set:html={icono(c.i, 20)} />
                <span class="fv-paso-etiqueta">{c.etiqueta}</span>
                <h3>{c.t}</h3>
                <p>{c.d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ═══ El programa ═══ -->
    <section class="fv-sec fv-claro" id="programa">
      <div class="fv-in">
        <div class="fv-cab fv-cab-izq">
          <span class="fv-badge">10 módulos · 16 semanas · certificado</span>
          <h2 class="fv-h2">El <span class="fv-acento">programa</span>, por dentro</h2>
          <p class="fv-lead">Progresivo y práctico: cada módulo se apoya en el anterior y termina con algo que ya sabes hacer.</p>
        </div>

        <div class="fv-prog">
          <aside class="fv-prog-nav" aria-label="Fases del programa">
            <div class="fv-prog-nav-caja">
              <p class="fv-prog-nav-titulo">Recorrido</p>
              <ol>
                {FASES.map((f) => (
                  <li><a href={`#fase-${f.n}`} data-fase={f.n}><span class="fv-prog-bola">{f.n}</span>{f.nombre}</a></li>
                ))}
