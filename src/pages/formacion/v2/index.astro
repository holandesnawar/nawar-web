<script>
  import { leerUTM, guardarUTM } from '../../../lib/utm'
  import { contextoDelLead } from '../../../lib/recorrido'
  import { CLAVE_DATOS, V2, telefonoCompleto, type DatosAdmision } from '../../../lib/admision'
  guardarUTM()

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T
  const form = $<HTMLFormElement>('fv-form')
  const leer = <T,>(k: string): T | null => {
    try { const v = localStorage.getItem(k); return v ? (JSON.parse(v) as T) : null } catch { return null }
  }
  const guardar = (k: string, v: unknown) => { try { localStorage.setItem(k, JSON.stringify(v)) } catch {} }

  // ── El prefijo ────────────────────────────────────────────────────────
  const sel = $<HTMLSelectElement>('fv-prefijo')
  const pintarPrefijo = () => {
    const o = sel.options[sel.selectedIndex]
    $('fv-prefijo-ver').textContent = `${o.dataset.bandera} ${o.dataset.prefijo}`
  }
  sel.addEventListener('change', pintarPrefijo)

  // Quien vuelve: sus datos ya puestos.
  const previos = leer<DatosAdmision>(CLAVE_DATOS)
  if (previos) {
    ;($('fv-nombre') as HTMLInputElement).value = previos.first_name || ''
    ;($('fv-email') as HTMLInputElement).value = previos.email || ''
    const op = Array.from(sel.options).find((o) => previos.phone?.startsWith(o.dataset.prefijo || '~') && o.dataset.pais === previos.pais)
    if (op) {
      sel.value = op.value
      pintarPrefijo()
      ;($('fv-tel') as HTMLInputElement).value = previos.phone.slice((op.dataset.prefijo || '').length)
    }
  }

  // ── Ir al formulario (los botones de la página) ───────────────────────
  document.querySelectorAll<HTMLAnchorElement>('[data-ir-form]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault()
      $('solicitud').scrollIntoView({ behavior: 'smooth', block: 'center' })
      setTimeout(() => ($('fv-nombre') as HTMLInputElement).focus({ preventScroll: true }), 450)
    })
  })

  // ── Mandar ────────────────────────────────────────────────────────────
  form.addEventListener('submit', (e) => {
    e.preventDefault()
    const nombre = ($('fv-nombre') as HTMLInputElement).value.trim()
    const email = ($('fv-email') as HTMLInputElement).value.trim().toLowerCase()
    const opcion = sel.options[sel.selectedIndex]
    const phone = telefonoCompleto(opcion.dataset.prefijo || '', ($('fv-tel') as HTMLInputElement).value)
    const ok = nombre.length > 0 && /\S+@\S+\.\S+/.test(email) && phone.replace(/\D/g, '').length >= 8
    $('fv-err').classList.toggle('visible', !ok)
    if (!ok) return
    const boton = $<HTMLButtonElement>('fv-enviar')
    boton.disabled = true
    boton.classList.add('enviando')

    const datos: DatosAdmision = { first_name: nombre, email, phone, pais: opcion.dataset.pais || '' }
    guardar(CLAVE_DATOS, datos)

    // A la escuela, como la ventanita del proceso de admisión: ya es una
    // matrícula ("pidió plaza") y entra en systeme.io con «Admisión - datos».
    try {
      fetch('/api/cualificacion', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        keepalive: true,
        body: JSON.stringify({
          parcial: true,
          matricula: true,
          hito: 'datos',
          embudo: 'admision',
          origen: V2.origen,
          video: 'empezado',
          first_name: nombre,
          last_name: '',
          email,
          phone,
          website: ($('fv-hp') as HTMLInputElement).value,
          respuestas: {},
          textos: {},
          ...contextoDelLead(),
          ...leerUTM(),
        }),
      }).catch(() => {})
    } catch {}

    // Píxel: la misma marca que el proceso de admisión, para no contar doble.
    try {
      if (!sessionStorage.getItem('lead-agendar')) {
        sessionStorage.setItem('lead-agendar', '1')
        ;(window as any).fbq?.('track', 'SubmitApplication', { content_name: 'Formación v2' })
      }
    } catch {}

    // `d=1`: por si el navegador no deja guardar nada (ventana privada), que
    // la página del vídeo no le devuelva aquí.
    setTimeout(() => { window.location.href = `${V2.video}?d=1` }, 250)
  })

  // ── El programa: la fase que se ve, marcada a la izquierda ────────────
  const enlaces = Array.from(document.querySelectorAll<HTMLAnchorElement>('.fv-prog-nav a'))
  const fases = Array.from(document.querySelectorAll<HTMLElement>('.fv-fase'))
  const fill = $('fv-prog-fill')
  const marcar = (id: string) => {
    const i = enlaces.findIndex((a) => a.dataset.fase === id)
    enlaces.forEach((a, j) => { a.classList.toggle('activo', j === i); a.classList.toggle('hecho', j < i) })
    if (fill) fill.style.width = `${Math.round(((i + 1) / enlaces.length) * 100)}%`
  }
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entradas) => {
      entradas.forEach((en) => { if (en.isIntersecting) marcar((en.target as HTMLElement).dataset.fase || '') })
    }, { rootMargin: '-45% 0px -50% 0px' })
    fases.forEach((f) => io.observe(f))
  }
  marcar('01')
  enlaces.forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault()
    document.getElementById(a.getAttribute('href')!.slice(1))?.scrollIntoView({ behavior: 'smooth', block: 'start' })
  }))

  // ── Móvil: el botón pegado abajo cuando el formulario no se ve ────────
  const pegado = $('fv-pegado')
  const caja = $('solicitud')
  const final = document.querySelector('.fv-final') as HTMLElement
  if ('IntersectionObserver' in window) {
    let formVisible = true
    let finalVisible = false
    const pintar = () => {
      const ver = !formVisible && !finalVisible && caja.getBoundingClientRect().top < 0
      pegado.classList.toggle('visible', ver)
      pegado.setAttribute('aria-hidden', ver ? 'false' : 'true')
    }
    new IntersectionObserver(([en]) => { formVisible = en.isIntersecting; pintar() }).observe(caja)
    new IntersectionObserver(([en]) => { finalVisible = en.isIntersecting; pintar() }).observe(final)
  }
</script>

<style>
