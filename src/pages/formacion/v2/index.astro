  .fv-dots { position: absolute; inset: 0; pointer-events: none; opacity: 0.5; background-image: radial-gradient(circle, rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 28px 28px; }
  .fv-glow1 { position: absolute; top: -160px; left: 50%; transform: translateX(-50%); width: 1100px; height: 620px; background: radial-gradient(ellipse at center, rgba(11,109,240,0.5) 0%, transparent 65%); pointer-events: none; }
  .fv-glow2 { position: absolute; bottom: -120px; right: -120px; width: 640px; height: 460px; background: radial-gradient(ellipse at center, rgba(77,163,255,0.18) 0%, transparent 65%); pointer-events: none; }

  .fv-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: 100%;
    padding: 15px 22px; border: none; border-radius: 12px; background: #4da3ff; color: #0a1656;
    font-size: 16px; font-weight: 700; font-family: inherit; cursor: pointer; text-decoration: none; transition: background .15s, transform .15s;
  }
  .fv-btn:hover { background: #5eb4ff; }
