---
/**
 * blackfriday.holandesnawar.com/oferta — la oferta de Black Friday de la
 * Formación Nawar A0-A1 (29/10 → lunes 30/11/2026). En www vive en
 * /black-friday/oferta.
 *
 * El camino (usuario, 28/10, tercera vuelta): la portada (/) es solo el
 * formulario para desbloquear la oferta, la oferta desbloqueada es el ebook a
 * 1 € y ESTA es la página de después de comprarlo, el upsell:
 *  - Al pagar el ebook, Stripe vuelve aquí con ?compra=cs_….
 *  - Los botones de los correos de la campaña (solo a quien compró) traen aquí
 *    ?nombre=&email=.
 *  - SIN precio: las condiciones las cuenta el equipo en la llamada.
 *  - Todos los botones, al formulario de admisión (/admision), con los datos
 *    puestos: allí solo quedan las preguntas.
 *  - Solo hechos de la escuela. Nada de opiniones de alumnos, cifras de
 *    seguidores ni caras: no hay de verdad todavía, y no se inventan.
 *
 * Qué cabecera ve cada uno (lo decide un script en línea ANTES de pintar, con
 * clases en <html>; sin parpadeo):
 *  - `bf-recien` (acaba de pagar el ebook): la barra roja «¡No cierres esta
 *    página!».
 *  - `bf-comprador` (compró el ebook: recién, desde los correos o recordado
 *    por el navegador, `CLAVE_COMPRADOR`): «Ya tienes tu ebook» y «[Nombre],
 *    acabas de desbloquear nuestra mejor oferta». Si vuelve otro día, «tu
 *    oferta de Black Friday te está esperando».
 *  - El resto: «Adelántate al Black Friday».
 *
 * Las SECCIONES (28/10, quinta vuelta: "puede ser bastante mejor, más estilo
 * YouTalk TV y como teníamos la landing, esas secciones mucho más guays"): de
 * la cabecera para abajo es la landing de la formación
 * (components/landing-08-08-2026, las mismas piezas que /formacion-nawar-a0-a1)
 * dentro de `.l8`, con los botones a la llamada y sin precio; lo de Black
 * Friday (cabecera, plan de estudios, los pasos de la llamada, dudas y
 * cierre) va alrededor. Fuera, a propósito: las opiniones de la landing (una
 * dice «me ascendieron a los 4 meses», que no se puede sostener) y el
 * cronograma (habla de pagar ya).
 *
 * La CABECERA (29/10, usuario: "me gustaba más la landing que usábamos…
 * primera sección como la antigua, tenía esa vida"): el banner de
 * /formacion-nawar (LandingCaptacion.astro) dentro de `.l8`, con su titular,
 * sus viñetas, la nota a mano y la escuela dibujada; lo de Black Friday va en
 * la etiqueta, la entradilla y la etiqueta flotante. La de antes (titular
 * grande «Adelántate al Black Friday» y la captura en el portátil) se quitó.
 *
 * El EQUIPO («Quién te acompaña en el camino», EquipoNawar.astro) va después
 * del método y no sale hasta que haya alguien en src/lib/equipo.ts.
 *
 * La LUZ de las otras secciones (28/10): el brillo de los botones y el borde de
 * luz de la tarjeta salen de black-friday.css (`bf-brillo`, `bf-borde-luz`);
 * en el ordenador, las tarjetas oscuras se iluminan donde está el ratón
 * (`bf-sigue`). Todo quieto con «reducir movimiento».
 *
 * Al volver de pagar el ebook, se pregunta a la escuela si está pagado
 * (/api/ebook-compra) y, si lo está: "te llega a tu correo", el «Purchase» del
 * píxel (con el id de la sesión de pago, el mismo que manda el servidor) y sus
 * datos guardados para el formulario.
 *
 * Sin cuenta atrás (no le convencía al usuario). Pasado el lunes 30 a las
 * 23:59 sale "la oferta ha terminado" y el botón lleva al proceso de admisión
 * de siempre.
 */
import Layout from '../../layouts/Layout.astro'
import { icono } from '../../components/black-friday/iconos'
import { BF_HASTA_TEXTO, EBOOK_NOMBRE, bfRuta } from '../../lib/blackFriday'
import LoQueCambia from '../../components/landing-08-08-2026/LoQueCambia.astro'
import PorQueNawar from '../../components/landing-08-08-2026/PorQueNawar.astro'
import MarcaSection from '../../components/landing-08-08-2026/MarcaSection.astro'
import PilaresSection from '../../components/landing-08-08-2026/PilaresSection.astro'
import PresentacionNawar from '../../components/landing-08-08-2026/PresentacionNawar.astro'
import MetodoFunciona from '../../components/landing-08-08-2026/MetodoFunciona.astro'
import QueIncluye from '../../components/landing-08-08-2026/QueIncluye.astro'
import CadaUnidad from '../../components/landing-08-08-2026/CadaUnidad.astro'
import BonusSection from '../../components/landing-08-08-2026/BonusSection.astro'
import ParaTiSection from '../../components/landing-08-08-2026/ParaTiSection.astro'
import AccesoIncluye from '../../components/landing-08-08-2026/AccesoIncluye.astro'
import EquipoNawar from '../../components/black-friday/EquipoNawar.astro'
import '../../styles/fuentes-locales.css'
import '../../styles/nawar-sections.css'
import '../../styles/landing-08-08-2026.css'
import '../../styles/black-friday.css'

export const prerender = true

const LOGO = 'https://d1yei2z3i6k35z.cloudfront.net/9533860/671a9c9265e23_Logo_Nawar_2.png'
const WWW = 'https://www.holandesnawar.com'
const ADMISION = bfRuta('/admision')
const DESPUES = `${WWW}/proceso-de-admision`
const flecha = icono('flecha', 16, 2.5)
/** El botón de las secciones de la landing. */
const QUIERO = 'Quiero mi oferta de Black Friday'
/** «hasta el 30 de noviembre», para la etiqueta de la cabecera. */
const BF_HASTA_CORTO = BF_HASTA_TEXTO.replace(/^lunes\s+/, '')

/** Las tres viñetas del banner de la landing de la formación, tal cual. */
const HERO_PUNTOS = [
  'Desde cero: 10 módulos, +15 h de vídeo y +360 lecciones',
  'Masterclass y grupos de conversación en directo cada semana',
  'Explicado desde el español, sin pasar por el inglés',
]
const check = `<svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>`

/** Lo que pasa en la llamada (junto a los pasos de admisión). */
const EN_LA_LLAMADA = [
  'Te contamos las condiciones especiales de Black Friday',
  'Vemos tu nivel, para qué lo necesitas y cuánto tiempo tienes',
  'Te decimos con sinceridad si podemos ayudarte',
]

const PASOS = [
  { t: 'Completa el formulario', d: 'Cuéntanos tu situación. Te lleva dos minutos.' },
  { t: 'Revisamos tu caso', d: 'Vemos si la Formación Nawar encaja contigo.' },
  { t: 'Habla con admisiones', d: 'Una llamada de media hora en la que te contamos las condiciones de Black Friday.' },
]

/** Las cuatro etapas del plan de estudios (las de /formacion-nawar-fb). */
const ETAPAS = [
  { n: '01', c: '#4da3ff', nombre: 'Los cimientos', semanas: 'Semanas 1-4', objetivo: 'Pasas de cero a mantener tu primera conversación: quién eres, tu familia, tu día y lo que quieres tomar.', hito: 'Te presentas y mantienes tu primera conversación en un grupo de conversación.' },
  { n: '02', c: '#5ad1c5', nombre: 'Tu vida aquí', semanas: 'Semanas 5-10', objetivo: 'Hablas de lo que te preguntan en cualquier conversación: a qué te dedicas, qué te gusta y dónde vives.', hito: 'Hablas de tu trabajo y de tu vida sin pasarte al inglés.' },
  { n: '03', c: '#8e9cff', nombre: 'Valerte por ti mismo', semanas: 'Semanas 11-13', objetivo: 'Resuelves por tu cuenta las situaciones que hoy te obligan a pedir ayuda.', hito: 'Vas al médico o haces una gestión sin que nadie te acompañe.' },
  { n: '04', c: '#f2cd6b', nombre: 'Consolidación', semanas: 'Semanas 14-16', objetivo: 'Juntas todo lo aprendido y lo usas con soltura en tu día a día. Aquí el nivel se asienta.', hito: 'Cierras el nivel A1 y recibes tu certificado.' },
]

const DUDAS = [
  { q: '¿En qué consiste la oferta de Black Friday?', a: `Son condiciones especiales para entrar en la Formación Nawar A0-A1 durante el Black Friday, solo hasta el ${BF_HASTA_TEXTO}. Te las contamos en la llamada de admisión, donde además vemos si la formación encaja contigo.` },
  { q: '¿La llamada cuesta algo?', a: 'No. Es una llamada gratuita de media hora con el equipo, sin compromiso. Puedes hacernos todas las preguntas que tengas.' },
  { q: '¿Necesito saber algo de neerlandés?', a: 'No. La formación empieza desde cero y todo está explicado en español.' },
  { q: '¿Cuánto tiempo tengo que dedicarle?', a: 'Con 20-30 minutos al día mantienes el ritmo. Te pedimos al menos dos horas a la semana: con menos, no es para ti ahora.' },
  { q: '¿Y si no puedo ir a la masterclass en directo?', a: 'Queda grabada, y la ves cuando quieras.' },
  { q: '¿Cuándo empiezo?', a: 'En cuanto te matriculas entras en la escuela, y los módulos se van abriendo a medida que avanzas.' },
  { q: '¿Hay garantía?', a: 'Sí. Tienes 15 días de garantía de devolución total y sin preguntas.' },
  { q: `¿Y el ebook «${EBOOK_NOMBRE}»?`, a: 'Es tuyo: te llega por correo para descargarlo en PDF. Si no lo encuentras, mira en spam o en promociones, o escríbenos a info@holandesnawar.com.' },
]
---

<Layout
  fuentesLocales
  title="Black Friday · Acceso anticipado a la Formación Nawar A0-A1 | Holandés Nawar"
  description="Adelántate al Black Friday: acceso anticipado a las condiciones especiales de la Formación Nawar A0-A1. Neerlandés de cero a A1 en 16 semanas, explicado en español."
  noindex={true}
>
  <div class="bf lp">
    <!-- Antes de pintar nada: ¿acaba de pagar el ebook? ¿ya lo tenía? -->
    <script is:inline>
      (function () {
        try {
          var q = new URLSearchParams(location.search)
          var h = document.documentElement
          var ebook = /^cs_(test|live)_[A-Za-z0-9]{10,240}$/.test(q.get('compra') || '')
          var deCorreo = q.get('utm_source') === 'email' && q.get('utm_campaign') === 'black-friday'
          var antes = false
          try { antes = localStorage.getItem('nawar.bf.comprador') === '1' } catch (e) {}
          if (ebook) h.classList.add('bf-recien')
          h.classList.add(ebook ? 'bf-de-ebook' : 'bf-de-vuelta')
          if (ebook || deCorreo || antes) h.classList.add('bf-comprador')
        } catch (e) {}
      })()
    </script>

    <!-- Recién pagado: que no se vaya. -->
    <div class="lp-alerta" role="status">
      <div class="lp-alerta-in">
        <span set:html={icono('alerta', 20, 2.2)} />
        <p><strong>¡No cierres esta página!</strong> <span>Tu oferta de Black Friday está justo aquí debajo.</span></p>
      </div>
    </div>

    <!-- ═══ Cabecera: la de /formacion-nawar, con lo de Black Friday ═══
         (29/10, usuario: "me gustaba más la landing que usábamos, la primera
         sección como la antigua, tenía esa vida que la de Black Friday no
         tenía"). Es el mismo marcado que el banner de LandingCaptacion.astro
         dentro de `.l8`, así que lo pintan las mismas reglas de
         landing-08-08-2026.css, animaciones de entrada incluidas. Si se
         cambia el banner de la landing, mirar si hay que traerlo aquí. -->
    <div class="l8 lp-top">
      <section class="hero lp-hero" id="lp-hero">
        <div class="hero-glow1" aria-hidden="true"></div>
        <div class="hero-glow2" aria-hidden="true"></div>
        <div class="hero-dots dots-dark" aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;"></div>

        <nav class="bf-nav lp-nav">
          <a href={`${WWW}/`} aria-label="Holandés Nawar">
            <img src={LOGO} alt="Holandés Nawar" class="bf-logo" width="150" height="38" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'bf-logo-txt',textContent:'Holandés Nawar'}))" />
          </a>
        </nav>

        <div class="hero-inner">
          <div class="hero-texto-col">
            <!-- Quien ha comprado el ebook: que lo sepa antes que nada. -->
            <p class="lp-ya lp-comp">
              <span class="lp-ya-ico" set:html={icono('check', 13, 3)} />
              <span id="lp-ya-t">
                <span class="lp-ya-ebook">Ya tienes tu ebook «{EBOOK_NOMBRE}».</span>
                <span class="lp-ya-vuelta">Tu oferta de Black Friday sigue desbloqueada.</span>
              </span>
            </p>
            <div class="hero-badge">
              <span class="badge-dot" aria-hidden="true"></span>
              <span class="lp-comp">Black Friday · Oferta desbloqueada</span>
              <span class="lp-gen">Black Friday · Acceso anticipado</span>
            </div>
            <h1 class="hero-headline">
              <span class="text-gradient-white">El neerlandés no se te da mal.</span>
              <em>Te lo estaban enseñando en inglés.</em>
            </h1>
            <p class="hero-sub lp-comp">
              <strong class="lp-quien" data-titulo="Acabas de desbloquear nuestra mejor oferta" data-vuelta="Tu oferta de Black Friday te está esperando">Acabas de desbloquear nuestra mejor oferta</strong>:
              la Formación Nawar A0-A1 con <strong>condiciones de Black Friday</strong>, antes que nadie. De A0 a A1 en
              <strong>16 semanas</strong>, pensada para hispanohablantes.
            </p>
            <p class="hero-sub lp-gen">
              <strong class="lp-quien" data-titulo="Adelántate al Black Friday">Adelántate al Black Friday</strong>:
              accede antes que nadie a las <strong>condiciones especiales</strong> de la primera formación de neerlandés
              diseñada para hispanohablantes. De A0 a A1 en <strong>16 semanas</strong>.
            </p>
            <ul class="hero-bullets">
              {HERO_PUNTOS.map((p) => (
                <li><span class="hero-check" set:html={check} />{p}</li>
              ))}
            </ul>

            <div class="hero-ctas bf-solo-activa">
              <div class="hero-cta-fila">
                <div class="hero-cta-col">
                  <a href={ADMISION} class="btn btn-primary btn-lg" data-bf-cta>{QUIERO}</a>
                  <p class="hero-nota">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    Sin compromiso: te la contamos en una llamada de media hora
                  </p>
                </div>
                <span class="hero-empieza" aria-hidden="true">
                  <span class="hero-empieza-txt">empieza hoy</span>
                  <svg class="hero-empieza-flecha" viewBox="0 0 64 52" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M58 4C57 20 47 34 30 40" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                    <path d="M38 41l-9 1 3-9" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </div>
            <div class="lp-fin bf-fin">
              <p><strong>La oferta de Black Friday ha terminado.</strong> Puedes seguir pidiendo información sobre la formación.</p>
              <a href={DESPUES} class="bf-btn">Solicitar información <Fragment set:html={flecha} /></a>
            </div>
          </div>

          <!-- La escuela por dentro, dibujada como en la landing (con datos de
               las lecciones de verdad). En el móvil no sale: empujaba el botón
               fuera de la primera pantalla. -->
          <div class="hero-mockup-col" aria-hidden="true">
            <div class="platform-mockup">
              <div class="mockup-header">
                <div class="mockup-dots"><span></span><span></span><span></span></div>
                <span class="mockup-title">Formación Nawar A0-A1</span>
              </div>
              <div class="mockup-body">
                <div>
                  <div class="mockup-label">Tu progreso — Módulo 1</div>
                  <div class="mockup-progress-bar"><div class="mockup-progress-fill" style="width:65%"></div></div>
                  <div class="mockup-pct">65% completado</div>
                </div>
                <div class="mockup-modules">
                  <div class="mockup-module active">
                    <div class="module-icon">📹</div>
                    <div class="module-info"><span class="module-title">Les 1 — Woordenschat</span><span class="module-sub">Vocabulario · 20 min</span></div>
                    <span class="module-badge done">✓</span>
                  </div>
                  <div class="mockup-module active">
                    <div class="module-icon">📝</div>
                    <div class="module-info"><span class="module-title">Les 2 — Grammatica</span><span class="module-sub">Gramática · 18 min</span></div>
                    <span class="module-badge done">✓</span>
                  </div>
                  <div class="mockup-module current">
                    <div class="module-icon">🎯</div>
                    <div class="module-info"><span class="module-title">Les 3 — Uitspraak</span><span class="module-sub">Pronunciación · 15 min</span></div>
                    <span class="module-badge current-badge">→</span>
                  </div>
                  <div class="mockup-module locked">
                    <div class="module-icon">🔒</div>
                    <div class="module-info"><span class="module-title">Les 4 — Spreken</span><span class="module-sub">Hablar · 25 min</span></div>
                  </div>
                </div>
                <div class="mockup-vocab-card">
                  <div class="vocab-article">de</div>
                  <div class="vocab-word">naam</div>
                  <div class="vocab-translation">el nombre</div>
                  <div class="vocab-example">"Mijn naam is Anna."</div>
                </div>
              </div>
            </div>
            <div class="float-badge hero-fb-top">
              <span style="font-size:18px;">🏷️</span>
              <div><p>Black Friday</p><p>condiciones solo hasta el {BF_HASTA_CORTO}</p></div>
            </div>
            <div class="float-badge hero-fb-bot">
              <span style="font-size:18px;">🎥</span>
              <div><p>Clases en directo</p><p>masterclass y grupos de conversación</p></div>
            </div>
          </div>
        </div>
        <div class="hero-scroll-hint" aria-hidden="true">↓</div>
      </section>
    </div>

    <!-- ═══ La landing de la formación (las mismas piezas que /formacion-nawar-a0-a1) ═══ -->
    <div class="l8 lp-l8">
      <LoQueCambia />
      <PorQueNawar />
      <MarcaSection />
      <PilaresSection />
      <PresentacionNawar ctaUrl={ADMISION} ctaTexto={QUIERO} />
      <MetodoFunciona ads={true} />
      <!-- Quién te acompaña: no sale hasta que haya alguien en src/lib/equipo.ts. -->
      <EquipoNawar />
    </div>

    <!-- ═══ El plan de estudios ═══ -->
    <section class="bf-sec lp-plan">
      <span class="bf-dots lp-plan-dots" aria-hidden="true"></span>
      <div class="bf-in">
        <div class="bf-cab">
          <span class="bf-badge-dark">4 etapas · 16 semanas · certificado</span>
          <h2 class="bf-h2 bf-h2-blanco"><span class="bf-grad">Plan de estudios: </span><span class="bf-azul bf-nw">de cero a independiente</span></h2>
          <p class="bf-lead bf-lead-blanco">Cada etapa termina con un hito concreto. Sabes en todo momento dónde estás y qué viene después.</p>
        </div>
        <div class="lp-etapas">
          {ETAPAS.map((e) => (
            <article class="lp-etapa bf-sigue" style={`--c:${e.c}`}>
              <div class="lp-etapa-cab">
                <span class="lp-etapa-n">{e.n}</span>
                <div><h3>{e.nombre}</h3><p>{e.semanas}</p></div>
              </div>
              <p class="lp-etapa-obj">{e.objetivo}</p>
              <p class="lp-etapa-hito"><span set:html={icono('diana', 17, 2)} /><span><b>Hito:</b> {e.hito}</span></p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <div class="l8 lp-l8">
      <QueIncluye />
      <CadaUnidad />
      <section class="l8-cta-band bf-solo-activa">
        <div class="inner">
          <div class="l8-cta-band-inner sr">
            <a href={ADMISION} class="l8-cta-band-btn" data-bf-cta>{QUIERO} <Fragment set:html={flecha} /></a>
          </div>
        </div>
      </section>
      <BonusSection />
      <ParaTiSection />

      <!-- Garantía: la de la landing, tal cual. -->
      <section class="guarantee">
        <div class="container">
          <div class="guarantee-content sr">
            <div class="guarantee-badge-wrap">
              <span class="lp-escudo" set:html={icono('escudo', 34, 1.6)} />
            </div>
            <div class="eyebrow eyebrow-light">Garantía total</div>
            <h2 class="section-title dark">Pruébala 15 días.<br />Si no es para ti, te devolvemos el dinero.</h2>
            <p class="guarantee-lead">
              Entra, mira los módulos, haz los ejercicios, métete en una clase en directo y pregunta en la comunidad.
              Si en <strong>15 días</strong> sientes que no es lo que esperabas, escribes un email y te devolvemos el
              importe íntegro. Sin formularios, sin burocracia y sin preguntas incómodas.
            </p>
            <div class="guarantee-pills">
              {['Devolución en 48h', 'Sin formularios', 'Sin preguntas', 'Dinero completo'].map((t) => (
                <span class="guarantee-pill">
                  <svg class="check-icon" fill="none" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6.5l2.5 2.5 5.5-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {t}
                </span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <AccesoIncluye plazas={false} conPrecio={false} ctaUrl={ADMISION} ctaTexto={QUIERO} nota="Llamada gratuita de media hora · Sin compromiso" />
    </div>

    <!-- ═══ Admisiones: tres pasos ═══ -->
    <section class="bf-sec bf-oscuro lp-pasos-sec">
      <div class="bf-capas" aria-hidden="true"><span class="bf-luz1"></span><span class="bf-luz2"></span><span class="bf-dots"></span></div>
      <div class="bf-in lp-centro">
        <span class="bf-badge-dark">Acceso anticipado</span>
        <h2 class="bf-h2 bf-h2-blanco"><span class="bf-grad">Habla con nuestro </span><span class="bf-azul bf-nw">equipo de admisiones</span></h2>
        <p class="bf-lead bf-lead-blanco">Haz una llamada con el equipo y descubre si esta oferta encaja contigo.</p>
        <ol class="lp-pasos">
          {PASOS.map((p, k) => (
            <li><span class="lp-pasos-n"><i>{k + 1}</i></span><b>{p.t}</b><p>{p.d}</p></li>
          ))}
        </ol>
        <div class="lp-tarjeta bf-borde-luz bf-sigue">
          <p class="lp-tarjeta-t">En tu llamada de admisión</p>
          <ul class="lp-tarjeta-lista">
            {EN_LA_LLAMADA.map((x) => <li><span set:html={icono('check', 13, 3)} />{x}</li>)}
          </ul>
        </div>
        <a href={ADMISION} class="bf-btn bf-brillo bf-solo-activa" data-bf-cta>Agendar mi llamada gratuita <Fragment set:html={flecha} /></a>
