        <div class="lp-cierre-cta bf-solo-activa">
          <a href={ADMISION} class="bf-btn bf-brillo" data-bf-cta id="lp-cierre-btn">Agendar mi llamada gratuita <Fragment set:html={flecha} /></a>
          <p class="bf-nota">Llamada gratuita de media hora · Sin compromiso</p>
        </div>
