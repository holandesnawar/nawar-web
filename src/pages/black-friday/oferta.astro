---
/**
 * blackfriday.holandesnawar.com/oferta — la oferta de Black Friday de la
 * Formación Nawar A0-A1 (29/10 → lunes 30/11/2026). En www vive en
 * /black-friday/oferta.
 *
 * El camino, como el de YouTalk (usuario, 28/10: "el dominio blackfriday solo
 * tiene el formulario para desbloquear la oferta, luego mails con CTA a la
 * oferta con nombre y mail rellenos, y de ahí formulario para agendar"):
 *  - La portada (/) es el formulario para desbloquearla (nombre, correo y
 *    WhatsApp). Al enviarlo, aquí con ?desbloqueada=1.
 *  - Al pagar el ebook de 1 €, Stripe vuelve aquí con ?compra=cs_….
 *  - Todos los botones de los correos traen aquí ?nombre=&email=.
 *  - SIN precio: las condiciones las cuenta el equipo en la llamada.
 *  - Todos los botones, al formulario de admisión (/admision), con los datos
 *    puestos: allí solo quedan las preguntas.
 *  - Solo hechos de la escuela. Nada de opiniones de alumnos, cifras de
 *    seguidores ni caras: no hay de verdad todavía, y no se inventan.
 *
 * Qué cabecera ve cada uno (lo decide un script en línea ANTES de pintar, con
 * clases en <html>; sin parpadeo):
 *  - `bf-recien` (acaba de pagar el ebook o de desbloquearla): la barra roja
 *    «¡No cierres esta página!».
 *  - `bf-comprador` (desbloqueada: recién, desde los correos o recordado por
 *    el navegador): «Ya tienes tu ebook» / «Oferta desbloqueada» y «[Nombre],
 *    acabas de desbloquear nuestra mejor oferta». Si vuelve otro día, «tu
 *    oferta de Black Friday te está esperando».
 *  - El resto: «Adelántate al Black Friday».
 *
 * La LUZ (28/10, "más chula, con luz"): el foco de arriba, la línea del
 * horizonte, el brillo de los botones y el borde de luz de la tarjeta salen de
 * black-friday.css (`bf-foco`, `bf-horizonte`, `bf-brillo`, `bf-borde-luz`);
 * en el ordenador, las tarjetas oscuras se iluminan donde está el ratón
 * (`bf-sigue`). Todo quieto con «reducir movimiento».
 *
 * Al volver de pagar el ebook, se pregunta a la escuela si está pagado
 * (/api/ebook-compra) y, si lo está: "te llega a tu correo", el «Purchase» del
 * píxel (con el id de la sesión de pago, el mismo que manda el servidor) y sus
 * datos guardados para el formulario.
 *
 * Sin cuenta atrás (no le convencía al usuario). Pasado el lunes 30 a las
 * 23:59 sale "la oferta ha terminado" y el botón lleva al proceso de admisión
 * de siempre.
 */
import Layout from '../../layouts/Layout.astro'
import { icono } from '../../components/black-friday/iconos'
import { BF_HASTA_TEXTO, EBOOK_NOMBRE, bfRuta } from '../../lib/blackFriday'
import '../../styles/fuentes-locales.css'
import '../../styles/black-friday.css'

export const prerender = true

const LOGO = 'https://d1yei2z3i6k35z.cloudfront.net/9533860/671a9c9265e23_Logo_Nawar_2.png'
const WWW = 'https://www.holandesnawar.com'
const ADMISION = bfRuta('/admision')
const DESPUES = `${WWW}/proceso-de-admision`
const flecha = icono('flecha', 16, 2.5)

/** Lo que se lleva quien entra: el programa y lo que lo rodea. Solo lo que
 *  la escuela tiene de verdad hoy (28/10). */
const TODO = [
  { i: 'libro', t: 'La Formación Nawar A0-A1 completa', d: '16 semanas y 10 módulos, con más de 360 lecciones explicadas en español.' },
  { i: 'altavoz', t: 'Ejercicios interactivos con audio', d: 'Escuchas, lees, escribes y hablas, y cada ejercicio se corrige al momento.' },
  { i: 'video', t: 'Masterclass semanal en directo', d: 'Un tema concreto explicado por un profesor. Queda grabada si no puedes venir.' },
  { i: 'charla', t: 'Grupos de conversación', d: 'Dos veces por semana, para hablar con otros alumnos y un profe que te guía.' },
  { i: 'micro', t: 'Tu tarea, corregida cada semana', d: 'La entregas por escrito o con una nota de voz, y te la devolvemos corregida.' },
  { i: 'consulta', t: 'Consultas con el equipo', d: 'Resuelves tus dudas en español, para no quedarte nunca bloqueado.' },
  { i: 'calendario', t: 'Seguimiento cada 4 semanas', d: 'Un check-in con el equipo para ver cómo vas y qué ajustar.' },
  { i: 'imprimir', t: 'Werkboek para imprimir', d: 'Un cuaderno en PDF por lección, para repasar en papel.' },
  { i: 'grupo', t: 'La comunidad Nawar', d: 'Alumnos que están en tu mismo camino, para preguntar, practicar y compartir.' },
  { i: 'premio', t: 'Certificado', d: 'Al completar la formación, con tu nombre.' },
]

/** La escuela por dentro: capturas reales (las de /formacion-nawar-fb). */
const DENTRO = [
  { img: '/img/formacion-v2/leccion.webp', t: 'Lecciones explicadas en español', d: 'Cada lección con su vídeo, el vocabulario con audio y la teoría clara.' },
  { img: '/img/formacion-v2/ejercicios.webp', t: 'Ejercicios que se corrigen solos', d: 'Escuchas, lees, escribes y hablas, y sabes al momento si lo tienes.' },
  { img: '/img/formacion-v2/consultas.webp', t: 'Consultas con el equipo', d: 'Tus dudas, resueltas en español por un profe. Nunca te quedas bloqueado.' },
  { img: '/img/formacion-v2/certificado.webp', t: 'Tu certificado', d: 'Al completar la formación, con tu nombre.' },
]

/** Lo que pasa en la llamada (la tarjeta de la cabecera). */
const EN_LA_LLAMADA = [
  'Te contamos las condiciones especiales de Black Friday',
  'Vemos tu nivel, para qué lo necesitas y cuánto tiempo tienes',
  'Te decimos con sinceridad si podemos ayudarte',
]

const PASOS = [
  { t: 'Completa el formulario', d: 'Cuéntanos tu situación. Te lleva dos minutos.' },
  { t: 'Revisamos tu caso', d: 'Vemos si la Formación Nawar encaja contigo.' },
  { t: 'Habla con admisiones', d: 'Una llamada de media hora en la que te contamos las condiciones de Black Friday.' },
]

const DOLORES = [
  { i: 'medico', t: 'Al médico, siempre acompañado', d: 'Alguien tiene que entrar contigo para explicar qué te pasa y entender lo que te dicen. Hasta para pedir cita.' },
  { i: 'carta', t: 'Llega una carta y ya no estás tranquilo', d: 'La gemeente, el seguro, el colegio. Foto al traductor del móvil y a cruzar los dedos para no equivocarte.' },
  { i: 'familia', t: 'Tu pareja o tus hijos hablan por ti', d: 'En la tienda, en la reunión del colegio, al teléfono. Te ayudan con todo el cariño, pero tú quieres poder hacerlo por tu cuenta.' },
  { i: 'charla', t: 'Fuera de la conversación', d: 'Con los vecinos, en el trabajo, en un cumpleaños. Sonríes, asientes y esperas a que alguien te lo cuente después.' },
  { i: 'compra', t: 'Lo básico, en inglés o por señas', d: 'La compra, el tren, una pregunta en la ventanilla. Sales del paso, pero así nunca terminas de sentirte de aquí.' },
  { i: 'candado', t: 'Puertas que ni te planteas abrir', d: 'Un trabajo mejor, amigos holandeses, algo tuyo. Todo pasa por el idioma, y el idioma se queda para “algún día”.' },
]

const CAMBIO = [
  { i: 'medico', t: 'En el médico', hoy: 'Alguien entra contigo para explicar qué te pasa.', con: 'Pides la cita y explicas qué te pasa con tus palabras.' },
  { i: 'carta', t: 'Con las cartas', hoy: 'Foto al traductor y a cruzar los dedos.', con: 'Entiendes los avisos sencillos y sabes qué te piden.' },
  { i: 'familia', t: 'En casa', hoy: 'Tu pareja o tus hijos hacen de intérpretes.', con: 'Hablas tú. Ellos dejan de traducirte.' },
  { i: 'charla', t: 'Con la gente', hoy: 'Sonríes y asientes mientras hablan los demás.', con: 'Entras en la conversación con vecinos y compañeros.' },
  { i: 'maletin', t: 'En el trabajo', hoy: 'Todo en inglés, siempre un paso por detrás.', con: 'Te presentas y te desenvuelves en el día a día.' },
]

/** Las cuatro etapas del plan de estudios (las de /formacion-nawar-fb). */
const ETAPAS = [
  { n: '01', c: '#4da3ff', nombre: 'Los cimientos', semanas: 'Semanas 1-4', objetivo: 'Pasas de cero a mantener tu primera conversación: quién eres, tu familia, tu día y lo que quieres tomar.', hito: 'Te presentas y mantienes tu primera conversación en un grupo de conversación.' },
  { n: '02', c: '#5ad1c5', nombre: 'Tu vida aquí', semanas: 'Semanas 5-10', objetivo: 'Hablas de lo que te preguntan en cualquier conversación: a qué te dedicas, qué te gusta y dónde vives.', hito: 'Hablas de tu trabajo y de tu vida sin pasarte al inglés.' },
  { n: '03', c: '#8e9cff', nombre: 'Valerte por ti mismo', semanas: 'Semanas 11-13', objetivo: 'Resuelves por tu cuenta las situaciones que hoy te obligan a pedir ayuda.', hito: 'Vas al médico o haces una gestión sin que nadie te acompañe.' },
  { n: '04', c: '#f2cd6b', nombre: 'Consolidación', semanas: 'Semanas 14-16', objetivo: 'Juntas todo lo aprendido y lo usas con soltura en tu día a día. Aquí el nivel se asienta.', hito: 'Cierras el nivel A1 y recibes tu certificado.' },
]

/** «Imagina…»: lo que hace alguien con un A1 que vive en Países Bajos. Nada
 *  de prometer hablar como un nativo. */
const IMAGINA = [
  'Pedir cita con el huisarts y explicar tú qué te pasa, con tus palabras.',
  'Leer un aviso sencillo de la gemeente y saber qué te piden.',
  'Hablar tú con la profesora de tus hijos en la reunión del colegio.',
  'Contestar en la caja del supermercado sin pasarte al inglés.',
  'Entrar en la conversación con tus vecinos y tus compañeros.',
  'Que tu pareja o tus hijos dejen de traducirte.',
]

const DUDAS = [
  { q: '¿En qué consiste la oferta de Black Friday?', a: `Son condiciones especiales para entrar en la Formación Nawar A0-A1 durante el Black Friday, solo hasta el ${BF_HASTA_TEXTO}. Te las contamos en la llamada de admisión, donde además vemos si la formación encaja contigo.` },
  { q: '¿La llamada cuesta algo?', a: 'No. Es una llamada gratuita de media hora con el equipo, sin compromiso. Puedes hacernos todas las preguntas que tengas.' },
  { q: '¿Necesito saber algo de neerlandés?', a: 'No. La formación empieza desde cero y todo está explicado en español.' },
  { q: '¿Cuánto tiempo tengo que dedicarle?', a: 'Con 20-30 minutos al día mantienes el ritmo. Te pedimos al menos dos horas a la semana: con menos, no es para ti ahora.' },
  { q: '¿Y si no puedo ir a la masterclass en directo?', a: 'Queda grabada, y la ves cuando quieras.' },
  { q: '¿Cuándo empiezo?', a: 'En cuanto te matriculas entras en la escuela, y los módulos se van abriendo a medida que avanzas.' },
  { q: '¿Hay garantía?', a: 'Sí. Tienes 15 días de garantía de devolución total y sin preguntas.' },
  { q: `¿Y el ebook «${EBOOK_NOMBRE}»?`, a: 'Es tuyo: te llega por correo para descargarlo en PDF. Si no lo encuentras, mira en spam o en promociones, o escríbenos a info@holandesnawar.com.' },
]
---

<Layout
  fuentesLocales
  title="Black Friday · Acceso anticipado a la Formación Nawar A0-A1 | Holandés Nawar"
  description="Adelántate al Black Friday: acceso anticipado a las condiciones especiales de la Formación Nawar A0-A1. Neerlandés de cero a A1 en 16 semanas, explicado en español."
  noindex={true}
>
  <div class="bf lp">
    <!-- Antes de pintar nada: ¿acaba de pagar o de desbloquearla? ¿la tiene desbloqueada? -->
    <script is:inline>
      (function () {
        try {
          var q = new URLSearchParams(location.search)
          var h = document.documentElement
          var ebook = /^cs_(test|live)_[A-Za-z0-9]{10,240}$/.test(q.get('compra') || '')
          var lista = q.get('desbloqueada') === '1'
          var deCorreo = q.get('utm_source') === 'email' && q.get('utm_campaign') === 'black-friday'
          var antes = false
          try { antes = localStorage.getItem('nawar.bf.comprador') === '1' || localStorage.getItem('nawar.bf.desbloqueada') === '1' } catch (e) {}
          if (ebook || lista) h.classList.add('bf-recien')
          h.classList.add(ebook ? 'bf-de-ebook' : lista ? 'bf-de-lista' : 'bf-de-vuelta')
          if (ebook || lista || deCorreo || antes) h.classList.add('bf-comprador')
        } catch (e) {}
      })()
    </script>

    <!-- Recién pagado: que no se vaya. -->
    <div class="lp-alerta" role="status">
      <div class="lp-alerta-in">
        <span set:html={icono('alerta', 20, 2.2)} />
        <p><strong>¡No cierres esta página!</strong> <span>Tu oferta de Black Friday está justo aquí debajo.</span></p>
      </div>
    </div>

    <!-- ═══ Cabecera ═══ -->
    <header class="bf-oscuro lp-hero" id="lp-hero">
      <div class="bf-capas" aria-hidden="true"><span class="bf-luz1"></span><span class="bf-luz2"></span><span class="bf-dots"></span></div>
      <div class="bf-foco lp-foco" aria-hidden="true"></div>
      <nav class="bf-nav">
        <a href={`${WWW}/`} aria-label="Holandés Nawar">
          <img src={LOGO} alt="Holandés Nawar" class="bf-logo" width="150" height="38" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'bf-logo-txt',textContent:'Holandés Nawar'}))" />
        </a>
      </nav>

      <div class="lp-hero-in">
        <div class="lp-hero-texto">
          <!-- Quien ha comprado el ebook: la oferta desbloqueada. -->
          <div class="lp-comp">
            <p class="lp-ya">
              <span class="lp-ya-ico" set:html={icono('check', 13, 3)} />
              <span id="lp-ya-t">
                <span class="lp-ya-ebook">Ya tienes tu ebook «{EBOOK_NOMBRE}».</span>
                <span class="lp-ya-lista">Oferta desbloqueada. También te la hemos mandado a tu correo.</span>
                <span class="lp-ya-vuelta">Tu oferta de Black Friday sigue desbloqueada.</span>
              </span>
            </p>
            <span class="bf-badge-dark">Black Friday <i>·</i> Oferta desbloqueada</span>
            <h1 class="bf-h1 lp-h1-luz" data-titulo="Acabas de desbloquear nuestra mejor oferta" data-vuelta="Tu oferta de Black Friday te está esperando">Acabas de desbloquear nuestra mejor oferta</h1>
            <p class="bf-hero-sub">
              Tienes acceso antes que nadie a las <strong>condiciones de Black Friday de la Formación Nawar A0-A1</strong>:
              neerlandés de cero a A1 en 16 semanas, explicado en español y con clases en directo cada semana.
            </p>
          </div>
          <!-- Los demás. -->
          <div class="lp-gen">
            <span class="bf-badge-dark">Black Friday <i>·</i> Acceso anticipado</span>
            <h1 class="bf-h1 lp-h1-luz" data-titulo="Adelántate al Black Friday">Adelántate al Black Friday</h1>
            <p class="bf-hero-sub">
              Accede antes que nadie a las <strong>condiciones especiales de la Formación Nawar A0-A1</strong>: neerlandés de cero a A1 en
              16 semanas, explicado en español y con clases en directo cada semana.
            </p>
          </div>
          <div class="lp-hero-cta bf-solo-activa">
            <a href={ADMISION} class="bf-btn bf-brillo lp-comp" data-bf-cta>Quiero mi oferta de Black Friday <Fragment set:html={flecha} /></a>
            <a href={ADMISION} class="bf-btn bf-brillo lp-gen" data-bf-cta>Agendar mi llamada gratuita <Fragment set:html={flecha} /></a>
            <p class="bf-nota lp-comp">Rellenas un formulario corto y te contamos la oferta en una llamada de media hora · Sin compromiso</p>
            <p class="bf-nota lp-gen">Media hora con el equipo · Sin compromiso</p>
          </div>
          <div class="lp-fin bf-fin">
            <p><strong>La oferta de Black Friday ha terminado.</strong> Puedes seguir pidiendo información sobre la formación.</p>
            <a href={DESPUES} class="bf-btn">Solicitar información <Fragment set:html={flecha} /></a>
          </div>
        </div>

        <aside class="lp-tarjeta bf-borde-luz bf-sigue bf-solo-activa">
          <p class="lp-tarjeta-t">En tu llamada de admisión</p>
          <ul class="lp-tarjeta-lista">
            {EN_LA_LLAMADA.map((x) => <li><span set:html={icono('check', 13, 3)} />{x}</li>)}
          </ul>
        </aside>
      </div>
      <span class="bf-horizonte" aria-hidden="true"></span>
    </header>

    <!-- ═══ Todo lo que te llevas ═══ -->
    <section class="bf-sec bf-blanco">
      <div class="bf-in">
        <div class="bf-cab">
          <span class="bf-badge">Tu programa y todo lo que lo rodea</span>
          <h2 class="bf-h2">Todo lo que te llevas con la <span class="bf-acento bf-nw">Formación Nawar</span></h2>
          <p class="bf-lead">Un programa completo, práctica en directo cada semana y un equipo que te acompaña hasta el final.</p>
        </div>
        <ul class="lp-todo">
          {TODO.map((x) => (
            <li>
              <span class="bf-ico" set:html={icono(x.i, 26, 1.6)} />
              <div><b>{x.t}</b><p>{x.d}</p></div>
            </li>
          ))}
        </ul>
        <div class="lp-garantia">
          <span class="bf-ico" set:html={icono('escudo', 26, 1.6)} />
          <p><strong>15 días de garantía.</strong> Devolución total y sin preguntas.</p>
        </div>
      </div>
    </section>

    <!-- ═══ La escuela por dentro ═══ -->
    <section class="bf-sec bf-oscuro lp-dentro-sec">
      <div class="bf-capas" aria-hidden="true"><span class="bf-luz1"></span><span class="bf-dots"></span></div>
      <div class="bf-foco" aria-hidden="true"></div>
      <div class="bf-in">
        <div class="bf-cab">
          <span class="bf-badge-dark">La escuela por dentro</span>
          <h2 class="bf-h2 bf-h2-blanco"><span class="bf-grad">Así es aprender en </span><span class="bf-azul bf-nw">Holandés Nawar</span></h2>
          <p class="bf-lead bf-lead-blanco">Todo en un sitio, desde el móvil o el ordenador, y a tu ritmo entre clase y clase.</p>
        </div>
        <div class="lp-dentro">
          {DENTRO.map((x) => (
            <figure class="lp-dentro-item bf-sigue">
              <div class="lp-dentro-marco">
                <img src={x.img} alt={x.t} loading="lazy" decoding="async" width="1200" height="675" />
              </div>
              <figcaption><b>{x.t}</b><span>{x.d}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ Los dolores ═══ -->
    <section class="bf-sec bf-blanco">
      <div class="bf-in">
        <div class="bf-cab">
          <span class="bf-badge">¿Te suena?</span>
          <h2 class="bf-h2">Vives aquí, pero <span class="bf-acento">otros hablan por ti</span></h2>
          <p class="bf-lead">Llevas tiempo en Países Bajos y para lo importante todavía necesitas a alguien al lado.</p>
        </div>
        <div class="lp-dolores">
          {DOLORES.map((d) => (
            <article>
              <span class="bf-ico" set:html={icono(d.i, 26, 1.6)} />
              <div><h3>{d.t}</h3><p>{d.d}</p></div>
            </article>
          ))}
        </div>
        <p class="lp-giro">
          No es falta de capacidad. Es que nunca has tenido <strong>un método pensado para ti</strong>: en español, paso a paso y con alguien que te corrija.
        </p>
      </div>
    </section>

    <!-- ═══ Antes / después ═══ -->
    <section class="bf-sec bf-claro">
      <div class="bf-in">
        <div class="bf-cab">
          <span class="bf-badge">Lo que cambia</span>
          <h2 class="bf-h2">Lo que hoy hacen por ti, <span class="bf-acento">en 16 semanas lo haces tú</span></h2>
        </div>
        <div class="lp-cambio" role="table" aria-label="Antes y después de la formación">
          <div class="lp-cambio-fila lp-cambio-cab" role="row">
            <span role="columnheader"></span>
            <span role="columnheader" class="lp-hoy">Hoy</span>
            <span role="columnheader" class="lp-con">Con la Formación Nawar</span>
          </div>
          {CAMBIO.map((c, k) => (
            <div class={`lp-cambio-fila${k === CAMBIO.length - 1 ? ' ultima' : ''}`} role="row">
              <span class="lp-cambio-t" role="cell"><span set:html={icono(c.i, 22, 1.7)} />{c.t}</span>
              <span class="lp-hoy" role="cell"><span class="lp-x" set:html={icono('x', 15, 2.2)} />{c.hoy}</span>
              <span class="lp-con" role="cell"><span class="lp-ok" set:html={icono('check', 14, 2.8)} />{c.con}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ El plan de estudios ═══ -->
    <section class="bf-sec lp-plan">
      <span class="bf-dots lp-plan-dots" aria-hidden="true"></span>
      <div class="bf-in">
        <div class="bf-cab">
          <span class="bf-badge-dark">4 etapas · 16 semanas · certificado</span>
          <h2 class="bf-h2 bf-h2-blanco"><span class="bf-grad">Plan de estudios: </span><span class="bf-azul bf-nw">de cero a independiente</span></h2>
          <p class="bf-lead bf-lead-blanco">Cada etapa termina con un hito concreto. Sabes en todo momento dónde estás y qué viene después.</p>
        </div>
        <div class="lp-etapas">
          {ETAPAS.map((e) => (
            <article class="lp-etapa bf-sigue" style={`--c:${e.c}`}>
              <div class="lp-etapa-cab">
                <span class="lp-etapa-n">{e.n}</span>
                <div><h3>{e.nombre}</h3><p>{e.semanas}</p></div>
              </div>
              <p class="lp-etapa-obj">{e.objetivo}</p>
              <p class="lp-etapa-hito"><span set:html={icono('diana', 17, 2)} /><span><b>Hito:</b> {e.hito}</span></p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ Imagina ═══ -->
    <section class="bf-sec bf-blanco">
      <div class="bf-in lp-imagina">
        <div class="lp-imagina-cab">
          <span class="bf-badge">Imagina</span>
          <h2 class="bf-h2">Tu día a día, <span class="bf-acento">en neerlandés</span></h2>
          <p class="bf-lead">En 16 semanas no vas a hablar como un nativo. Pero sí lo bastante para hacer todo esto por tu cuenta.</p>
