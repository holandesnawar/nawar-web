    border: 1px solid rgba(170,210,255,0.24); box-shadow: inset 0 1px 0 rgba(255,255,255,0.14);
  }
  .lp-tarjeta-t { margin: 0 0 16px; font-size: 11.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #9fd0ff; }
