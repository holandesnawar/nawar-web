<script>
  import { guardarUTM } from '../../lib/utm'
  import { CLAVE_DATOS, type DatosAdmision } from '../../lib/admision'
  import { CLAVE_COMPRA, CLAVE_COMPRADOR, META_EBOOK, arrancarCuentaAtras, conLaEntradaBF, datoDeLaDireccion, iluminarAlPasar } from '../../lib/blackFriday'
  guardarUTM()
  arrancarCuentaAtras()
  iluminarAlPasar()

  const q = new URLSearchParams(location.search)
  const limpio = (v: string | null | undefined, n = 120) => (v || '').replace(/[<>]/g, '').trim().slice(0, n)
  let nombre = limpio(datoDeLaDireccion(q, 'nombre'))
  let email = limpio(datoDeLaDireccion(q, 'email'), 200)
  // Sin datos en la dirección, los que dejó en este navegador (en la portada o
  // al comprar el ebook): el formulario sale relleno igual.
  if (!email) {
    try {
      const d = JSON.parse(localStorage.getItem(CLAVE_DATOS) || 'null') as DatosAdmision | null
      if (d?.email) { email = limpio(d.email, 200).toLowerCase(); nombre = nombre || limpio(d.first_name) }
    } catch {}
  }

  // Los botones al formulario, con el nombre, el correo y la procedencia: los
  // de Black Friday (data-bf-cta) y los de las secciones de la landing, que
  // apuntan al mismo sitio.
  const base = document.querySelector('a[data-bf-cta]')?.getAttribute('href') || ''
  const ctas = Array.from(document.querySelectorAll<HTMLAnchorElement>('a')).filter(
    (a) => a.hasAttribute('data-bf-cta') || (!!base && a.getAttribute('href') === base),
  )
  const ponerEnlaces = () => {
    const destino = conLaEntradaBF(base, { nombre, email })
    ctas.forEach((a) => { a.href = destino })
  }
  // El nombre delante del titular: «Ana, acabas de desbloquear…» o «Ana,
  // adelántate al Black Friday».
  // Quien vuelve otro día (correos, navegador): «tu oferta te está esperando».
  const deVuelta = document.documentElement.classList.contains('bf-de-vuelta')
  const ponerNombre = () => {
    const pila = nombre.split(/\s+/)[0]
    document.querySelectorAll<HTMLElement>('[data-titulo]').forEach((h1) => {
      const t = (deVuelta && h1.dataset.vuelta) || h1.dataset.titulo || ''
      h1.textContent = pila ? `${pila}, ${t.charAt(0).toLowerCase()}${t.slice(1)}` : t
    })
  }
  ponerEnlaces()
  ponerNombre()

  // ── Al volver de pagar el ebook ───────────────────────────────────────
  const cs = q.get('compra') || ''
  if (/^cs_(test|live)_[A-Za-z0-9]{10,240}$/.test(cs)) comprobarCompra(cs, 0)

  async function comprobarCompra(cs: string, intento: number) {
    let d: { pagado?: boolean; nombre?: string; email?: string; importe_cents?: number } | null = null
    try {
      const r = await fetch(`/api/ebook-compra?cs=${encodeURIComponent(cs)}&pagina=${encodeURIComponent(location.href)}`)
      d = await r.json().catch(() => null)
    } catch {}
    // Stripe ya cobró al volver, pero por si la escuela tarda un momento.
    if (!d?.pagado) {
      if (intento < 2) setTimeout(() => comprobarCompra(cs, intento + 1), 2500)
      return
    }
    nombre = limpio(d.nombre) || nombre
    email = limpio(d.email, 200).toLowerCase() || email
    ;(document.getElementById('lp-ya-t') as HTMLElement).textContent =
      `Ya tienes tu ebook: te llega${email ? ` a ${email}` : ' a tu correo'} en un minuto. Revisa también spam o promociones.`
    // Si vuelve otro día a esta página, que siga viendo su oferta.
    try { localStorage.setItem(CLAVE_COMPRADOR, '1') } catch {}
    ponerNombre()
    ponerEnlaces()

    // Para el formulario de la llamada: sus datos, sin perder el teléfono si ya lo dejó.
    try {
      const antes = JSON.parse(localStorage.getItem(CLAVE_DATOS) || 'null') as DatosAdmision | null
      const mismo = antes?.email === email
      localStorage.setItem(CLAVE_DATOS, JSON.stringify({ first_name: nombre, email, phone: mismo ? antes?.phone || '' : '', pais: mismo ? antes?.pais || '' : '' }))
    } catch {}

    // «Purchase», una vez por visita y con el id de la sesión de pago: el
    // servidor (/api/ebook-compra) manda el mismo y Meta lo cuenta una vez.
    try {
      const k = `${CLAVE_COMPRA}.${cs}`
      if (!sessionStorage.getItem(k)) {
        sessionStorage.setItem(k, '1')
        ;(window as any).fbq?.('track', 'Purchase', { value: (d.importe_cents || 0) / 100, currency: 'EUR', content_name: META_EBOOK }, { eventID: cs })
      }
    } catch {}

    // La dirección sin el ?compra=: si la comparte o la recarga, no vuelve a salir el aviso.
    try {
      const u = new URL(location.href)
      u.searchParams.delete('compra')
      history.replaceState(null, '', u.toString())
    } catch {}
  }

  // ── El botón pegado: cuando no se ve ningún otro botón de agendar ─────
  const pegado = document.getElementById('lp-pegado') as HTMLElement
  const vigilados = ctas.filter((a) => !a.closest('#lp-pegado'))
  const hero = document.getElementById('lp-hero') as HTMLElement
  if ('IntersectionObserver' in window) {
    const visibles = new Set<Element>()
    const pintar = () => {
      const pasadoHero = hero.getBoundingClientRect().bottom < 0
      const ver = visibles.size === 0 && pasadoHero
      pegado.classList.toggle('visible', ver)
      pegado.setAttribute('aria-hidden', ver ? 'false' : 'true')
    }
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => (e.isIntersecting ? visibles.add(e.target) : visibles.delete(e.target)))
      pintar()
    })
    vigilados.forEach((a) => io.observe(a))
    const pie = document.querySelector('.bf-pie')
    if (pie) io.observe(pie)
    // La cabecera aparte: al acabar de salir de la pantalla no cambia ningún
    // botón, y sin esto el pegado no saldría hasta el siguiente.
    new IntersectionObserver(pintar).observe(hero)
  }
</script>

