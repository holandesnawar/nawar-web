  .lp-tarjeta-lista li { display: flex; gap: 11px; align-items: flex-start; font-size: 15.5px; line-height: 1.5; color: #fff; }
  .lp-tarjeta-lista li > span { flex-shrink: 0; margin-top: 2px; width: 22px; height: 22px; border-radius: 9999px; background: #4da3ff; color: #0a1656; display: inline-flex; align-items: center; justify-content: center; }

