  .lp-etapa-hito { display: flex; gap: 10px; align-items: flex-start; margin: 18px 0 0; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.09); font-size: 14.5px; line-height: 1.55; color: rgba(255,255,255,0.9); }
