---
import Layout from '../layouts/Layout.astro'
import landing from '../data/landing.json'

import NavbarLanding from '../components/NavbarLanding'
import HeroNuevo from '../components/HeroNuevo.astro'
import GuidePopup from '../components/GuidePopup.astro'
import PilaresSection from '../components/PilaresSection.astro'
import MetodoFunciona from '../components/MetodoFunciona.astro'
import QueIncluye from '../components/QueIncluye.astro'
import BonusSection from '../components/BonusSection.astro'
import ParaTiSection from '../components/ParaTiSection.astro'
import PrecioSection from '../components/PrecioSection.astro'
import EmpienzaHoy from '../components/EmpienzaHoy.astro'
// PainPointsSection eliminada temporalmente — para restaurar: import PainPointsSection from '../components/PainPointsSection.astro'
import StickyComparisonSection from '../components/StickyComparisonSection'
import TestimonialsSection from '../components/TestimonialsSection.astro'
import PorQueNawar from '../components/PorQueNawar.astro'
// BenefitsSection oculta temporalmente hasta que la formación esté lista — para restaurar: import BenefitsSection from '../components/BenefitsSection.astro'
import ProcesoSection from '../components/ProcesoSection.astro'
import ParaQuienSection from '../components/ParaQuienSection.astro'
import ValorNuevo from '../components/ValorNuevo.astro'
import BlogNuevo from '../components/BlogNuevo.astro'
import FAQNuevo from '../components/FAQNuevo.astro'
import FooterNuevo from '../components/FooterNuevo.astro'
import '../styles/nawar-sections.css'

export const prerender = true

const hero         = (landing as any).hero         ?? null
const comparison   = (landing as any).comparison   ?? []
const testimonials = (landing as any).testimonials ?? []
const porQueNawar  = (landing as any).porQueNawar  ?? null
const proceso      = (landing as any).proceso      ?? null
const valor        = (landing as any).valor        ?? null
const paraQuien    = (landing as any).paraQuien    ?? null
const faq          = (landing as any).faq          ?? null
---

<Layout
  title="Nawar | Aprende Holandés desde el Español"
  description="Domina el neerlandés con Nawar, la academia online exclusiva para hispanohablantes. Método probado desde el español, clases en vivo y comunidad. ¡Empieza hoy!"
  keywords="curso neerlandés online, aprender neerlandés desde el español, holandés para hispanohablantes, inburgering, academia neerlandés"
>
  <NavbarLanding client:load />
  <GuidePopup />

  {/* ── Estructura de venta de la formación ──
      Hero (lo que somos) → lo que te han enseñado vs Nawar → 3 pilares →
      el Método (así funciona) → qué incluye → bonus + certificado →
      testimonios → ¿es para ti? → empieza hoy → precio → FAQ → blog. */}
  <HeroNuevo data={hero} />
  <PorQueNawar data={porQueNawar} />
  <PilaresSection />
  <MetodoFunciona />
  <QueIncluye />
  <BonusSection />
  <TestimonialsSection testimonials={testimonials} />
  <ParaTiSection />
  <EmpienzaHoy />
  <PrecioSection />
  <FAQNuevo data={faq} />
  <BlogNuevo />
  <FooterNuevo />
  {/* Secciones anteriores fuera de la nueva estructura (siguen en el repo):
      ProcesoSection, ValorNuevo, StickyComparisonSection, ParaQuienSection */}
</Layout>
