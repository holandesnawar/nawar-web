---
import Layout from '../layouts/Layout.astro'
import landing from '../data/landing.json'

import NavbarLanding from '../components/NavbarLanding'
import HeroNuevo from '../components/HeroNuevo.astro'
import GuidePopup from '../components/GuidePopup.astro'
// PainPointsSection eliminada temporalmente — para restaurar: import PainPointsSection from '../components/PainPointsSection.astro'
import StickyComparisonSection from '../components/StickyComparisonSection'
import TestimonialsSection from '../components/TestimonialsSection.astro'
import PorQueNawar from '../components/PorQueNawar.astro'
// BenefitsSection oculta temporalmente hasta que la formación esté lista — para restaurar: import BenefitsSection from '../components/BenefitsSection.astro'
import ProcesoSection from '../components/ProcesoSection.astro'
import ParaQuienSection from '../components/ParaQuienSection.astro'
import ValorNuevo from '../components/ValorNuevo.astro'
import BlogNuevo from '../components/BlogNuevo.astro'
import FAQNuevo from '../components/FAQNuevo.astro'
import FooterNuevo from '../components/FooterNuevo.astro'
import '../styles/nawar-sections.css'

export const prerender = true

const hero         = (landing as any).hero         ?? null
const comparison   = (landing as any).comparison   ?? []
const testimonials = (landing as any).testimonials ?? []
const porQueNawar  = (landing as any).porQueNawar  ?? null
const proceso      = (landing as any).proceso      ?? null
const valor        = (landing as any).valor        ?? null
const paraQuien    = (landing as any).paraQuien    ?? null
const faq          = (landing as any).faq          ?? null
---

<Layout
  title="Curso de neerlandés online para hispanohablantes | Holandés Nawar"
  description="Aprende neerlandés desde cero y en español: módulos interactivos, clases de conversación en vivo, consultas con profesores y comunidad de hispanohablantes."
  keywords="curso de neerlandés online, curso de holandés online, aprender neerlandés desde cero, clases de neerlandés en español, neerlandés para hispanohablantes, neerlandés A1, inburgering"
>
  {/* Ficha del curso para Google y las IAs (la de la organización va en el
      Layout). Solo datos que se pueden comprobar: si cambia la formación
      (módulos, nivel), cambiarlo también aquí y en public/llms.txt. */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Course",
    "name": "Formación Nawar A0-A1: neerlandés desde cero para hispanohablantes",
    "description": "Curso online de neerlandés para hispanohablantes, desde cero hasta el nivel A1, explicado en español: 10 módulos interactivos con ejercicios y audio, clases de conversación en vivo cada semana, sistema de consultas con profesores que hablan español, progreso siempre a la vista y comunidad privada. Todo el material es propio.",
    "provider": {
      "@type": "EducationalOrganization",
      "name": "Holandés Nawar",
      "url": "https://www.holandesnawar.com"
    },
    "inLanguage": "es",
    "teaches": "Neerlandés (holandés)",
    "educationalLevel": "Principiante (A0-A1)",
    "hasCourseInstance": {
      "@type": "CourseInstance",
      "courseMode": "online",
      "inLanguage": "es"
    }
  })} />
  <NavbarLanding client:load />
  <GuidePopup />

  <HeroNuevo data={hero} />
  <PorQueNawar data={porQueNawar} />
  {/* <BenefitsSection data={benefits} /> — oculta hasta que la formación esté lista */}
  <ProcesoSection data={proceso} />
  <ValorNuevo data={valor} />
  <StickyComparisonSection items={comparison} client:load />
  <ParaQuienSection data={paraQuien} />
  {/* <PainPointsSection painPoints={painPoints} /> — eliminada temporalmente */}
  <BlogNuevo />
  <FAQNuevo data={faq} />
  <TestimonialsSection testimonials={testimonials} />
  <FooterNuevo />
</Layout>
