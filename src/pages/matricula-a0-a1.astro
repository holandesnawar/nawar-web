---
/**
 * Matrícula SIN pago: recoge el contacto y la venta se cierra hablando.
 *
 * Es la misma página que la de anuncios
 * (/matricula-formacion-nawar-a0-a1-ads); esta tiene la URL limpia, para
 * mandarla a mano por WhatsApp, en la bio o en un correo. Lo único que
 * cambia entre las dos es la etiqueta del CRM, el origen que se guarda y
 * que aquella dispara el píxel de Meta en su gracias.
 *
 * Por qué no se reutiliza /matricula-formacion-nawar (la de pago):
 *
 *   1. Aquella crea una sesión de pago en Stripe y manda al checkout.
 *      Esta no cobra nada: recoge el contacto y ya está. La venta se
 *      cierra después, hablando con la persona.
 *   2. Aquella está detrás de la puerta de plazas (getEstadoPlazas):
 *      con la convocatoria cerrada redirige a la lista de espera. El
 *      tráfico de anuncios no puede toparse con eso, porque aquí no
 *      hay convocatoria que cerrar: se recogen solicitudes siempre.
 *
 * Los datos van a DOS sitios, y cada uno hace un trabajo distinto:
 *
 *   · systeme.io (vía /api/waitlist), con su etiqueta, que es lo que
 *     dispara la secuencia de correos de seguimiento.
 *   · la escuela (vía /api/solicitud), para que la persona salga en
 *     Panel → Estadísticas → "Matrículas nuevas" y se la pueda llamar.
 *
 * El del CRM es el que manda: si falla, se avisa y no se pasa de
 * pantalla. El de la escuela es de propina y va en paralelo; si falla,
 * el contacto sigue en el CRM y solo se pierde la línea del panel.
 */
import Layout from '../layouts/Layout.astro'

export const prerender = true

/* ⚠️ La etiqueta del CRM ("Matrícula") y la ruta de la página de
   gracias viven en el bloque de script del final, no aquí: es un
   módulo aparte y no ve las constantes del frontmatter. Si hay que
   cambiar alguna de las dos, es ahí abajo.
   La etiqueta tiene que existir con ese mismo nombre en systeme.io; si
   no, el contacto entra sin etiquetar y se queda fuera de la
   automatización de seguimiento. */

const LOGO = 'https://d1yei2z3i6k35z.cloudfront.net/9533860/671a9c9265e23_Logo_Nawar_2.png'
---

<Layout
  title="Reserva tu plaza — Formación Nawar A0-A1"
  description="Déjanos tus datos y el equipo de Holandés Nawar te contacta para completar tu matrícula en la Formación A0-A1."
  noindex={true}
>
  <!-- Banner de error global -->
  <div id="err" class="mx-toast" role="alert">
    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/>
    </svg>
    <span id="errText"></span>
    <button class="mx-toast-close" type="button" id="errClose" aria-label="Cerrar">×</button>
  </div>

  <div class="mx-page">
    <div class="mx-glow1" aria-hidden="true"></div>
    <div class="mx-glow2" aria-hidden="true"></div>
    <div class="mx-dots" aria-hidden="true"></div>

    <div class="mx-shell">
      <a href="/" class="mx-logo-link" aria-label="Volver al inicio">
        <img
          src={LOGO}
          alt="Holandés Nawar"
          class="mx-logo"
          width="150"
          height="38"
        />
      </a>

      <header class="mx-header">
        {/* Sin "Paso 1 de 2": aquí no hay paso 2 automático. El
            siguiente paso lo da una persona, y eso se cuenta abajo
            del botón con todas las letras para que nadie se quede
            esperando un correo de acceso que no va a llegar. */}
        <span class="mx-badge">Formación A0 → A1</span>
        <h1 class="mx-title"><span class="mx-title-gradient">Reserva tu plaza</span></h1>
        <p class="mx-lead">
          Déjanos tus datos y te escribimos para resolver tus dudas y
          completar la matrícula contigo.
        </p>
      </header>

      <form id="form" class="mx-form" novalidate>
        {/* Honeypot anti-bot: /api/waitlist descarta el envío si viene
            relleno, y le responde éxito al bot para no avisarle. */}
        <div class="mx-honeypot" aria-hidden="true">
          <label>No rellenar
            <input type="text" id="mx-honeypot" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div class="mx-row mx-row--uno">
          <div class="mx-field">
            <label class="mx-label" for="first_name">Nombre <span class="mx-req">*</span></label>
            <input id="first_name" name="first_name" type="text" class="mx-input" placeholder="Tu nombre" autocomplete="given-name" required />
            <span class="mx-err" data-for="first_name">Completa este campo</span>
          </div>
        </div>

        <div class="mx-row">
          <div class="mx-field">
            <label class="mx-label" for="email">Correo electrónico <span class="mx-req">*</span></label>
            <input id="email" name="email" type="email" class="mx-input" placeholder="tu@email.com" autocomplete="email" required />
            <span class="mx-err" data-for="email">Introduce un email válido</span>
          </div>
          <div class="mx-field">
            {/* El teléfono es obligatorio aquí y en la otra matrícula no,
                y no es un descuido: allí el siguiente paso lo daba la
                persona sola en Stripe, y aquí el siguiente paso lo damos
                nosotros escribiéndole. Sin número no hay conversación.
                El prefijo va en la ayuda porque el público está repartido
                entre Países Bajos, Bélgica y España. */}
            <label class="mx-label" for="phone">
              WhatsApp <span class="mx-req">*</span>
              <span class="mx-hint">con prefijo: +31, +32, +34…</span>
            </label>
            <input id="phone" name="phone" type="tel" class="mx-input" placeholder="+31 6 12 34 56 78" autocomplete="tel" required />
            <span class="mx-err" data-for="phone">Necesitamos un número para poder escribirte</span>
          </div>
        </div>

        <div class="mx-btn-wrap">
          <button id="submit" type="submit" class="mx-btn">
            <span id="mx-btn-text">Reservar mi plaza</span>
            <svg id="mx-btn-arrow" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
            <svg id="mx-btn-spinner" class="mx-spinner" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="display:none;" aria-hidden="true">
              <path stroke-linecap="round" d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
            </svg>
          </button>

          {/* Lo que espera al otro lado del botón, antes de pulsarlo:
              nadie deja un teléfono a ciegas, y decir que no se cobra
              nada es justo lo que quita el miedo a pulsar. */}
          <p class="mx-tras">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.6" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            No se te cobra nada ahora. Te escribimos y decides con toda la información.
          </p>

          <p class="mx-legal">
            {/* Sin condiciones de contratación: aquí no se contrata nada
                todavía. Lo que sí hay es tratamiento de datos, y eso es
                lo que se enlaza. */}
            Al enviar aceptas nuestra
            <a href="/politica-de-privacidad" target="_blank" rel="noreferrer">Política de privacidad</a>
            y que te contactemos por WhatsApp, teléfono o correo.
          </p>
        </div>
      </form>
    </div>
  </div>
</Layout>

<style>
  /* ── Página ── */
  .mx-page {
    min-height: 100vh;
    background: #1D0084;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 52px 32px 96px;
  }
  .mx-glow1 {
    position: absolute; top: -140px; left: 50%; transform: translateX(-50%);
    width: 960px; height: 560px;
    background: radial-gradient(ellipse at center, rgba(11,109,240,0.5) 0%, transparent 65%);
    pointer-events: none;
  }
  .mx-glow2 {
    position: absolute; bottom: -60px; right: -80px;
    width: 600px; height: 400px;
    background: radial-gradient(ellipse at center, rgba(77,163,255,0.16) 0%, transparent 65%);
    pointer-events: none;
  }
  .mx-dots {
    position: absolute; inset: 0; pointer-events: none; opacity: 0.4;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  /* ── Shell ── */
  .mx-shell {
    position: relative; z-index: 1;
    width: 100%; max-width: 700px;
    display: flex; flex-direction: column; align-items: flex-start;
    color: #fff;
  }

  .mx-logo-link { display: inline-block; margin-bottom: 44px; }
  .mx-logo { height: 38px; width: auto; object-fit: contain; }

  .mx-badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 16px; border-radius: 9999px;
    background: #025dc7;
    border: 1px solid rgba(77, 163, 255, 0.2);
    color: #e0f2ff;
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase;
    margin-bottom: 6px;
  }

  .mx-header {
    width: 100%;
    display: flex; flex-direction: column; align-items: flex-start;
    gap: 14px; margin-bottom: 48px;
  }
  .mx-title {
    font-family: var(--font-poppins), system-ui, sans-serif;
    font-size: clamp(38px, 5.5vw, 56px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
    margin: 0; margin-top: 10px;
  }
  .mx-title-gradient {
    background: linear-gradient(180deg, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.45) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .mx-lead {
    font-size: clamp(15px, 1.5vw, 18px);
    font-weight: 400; line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    max-width: 600px; margin: 0;
  }

  /* ── Formulario, directo sobre el azul ── */
  .mx-form {
    width: 100%;
    display: flex; flex-direction: column; gap: 32px;
  }

  .mx-honeypot {
    position: absolute !important; left: -10000px !important;
    width: 1px !important; height: 1px !important;
    overflow: hidden !important; opacity: 0 !important; pointer-events: none !important;
  }

  .mx-row { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  /* El nombre va solo en su fila. Con una rejilla de dos columnas se
     quedaba a media anchura y con un hueco vacío al lado, que se lee
     como un campo que falta. */
  .mx-row--uno { grid-template-columns: 1fr; }
  .mx-field { display: flex; flex-direction: column; gap: 8px; position: relative; }

  .mx-label { font-size: 14px; font-weight: 600; color: #fff; line-height: 1.4; }
  .mx-req { color: rgba(255, 255, 255, 0.45); font-weight: 500; }
  /* La ayuda del prefijo, en su propia línea: al lado de la etiqueta
     empujaba el asterisco fuera en pantallas estrechas. */
  .mx-hint {
    display: block;
    font-weight: 400; font-size: 12px; color: rgba(255, 255, 255, 0.5);
    margin-top: 2px;
  }

  .mx-input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1.5px solid rgba(255, 255, 255, 0.28);
    border-radius: 0;
    padding: 10px 0;
    color: #fff; font-size: 16px; font-family: inherit;
    outline: none; transition: border-color 0.2s; box-sizing: border-box;
  }
  .mx-input::placeholder { color: rgba(255, 255, 255, 0.28); }
  .mx-input:focus { border-bottom-color: #4da3ff; }
  .mx-input.invalid { border-bottom-color: rgba(255, 100, 100, 0.8); }

  .mx-err { display: none; font-size: 12px; color: rgba(255, 120, 120, 0.9); font-weight: 500; }
  .mx-err.visible { display: block; }

  /* ── Botón ── */
  .mx-btn-wrap {
    display: flex; flex-direction: column; align-items: stretch;
    gap: 14px; padding-top: 8px;
  }
  .mx-btn {
    display: flex; align-items: center; justify-content: center; gap: 9px;
    width: 100%; padding: 16px 36px;
    border-radius: 12px; border: none; cursor: pointer;
    background: #4da3ff; color: #1D0084;
    font-size: 17px; font-weight: 700; font-family: inherit;
    transition: background-color 0.15s;
  }
  .mx-btn:hover:not(:disabled) { background: #6cb5ff; }
  .mx-btn:disabled { opacity: 0.7; cursor: not-allowed; }

  @keyframes mx-spin { to { transform: rotate(360deg); } }
  .mx-spinner { animation: mx-spin 0.8s linear infinite; }

  /* La promesa de debajo del botón: bloque, no flex, para que la
     palomita quede pegada a la primera palabra y el texto siga
     sangrado si parte en dos líneas. */
  .mx-tras {
    display: block;
    font-size: 13.5px; line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
    margin: 0; text-align: center;
  }
  .mx-tras svg {
    display: inline-block; vertical-align: -2px;
    margin-right: 6px; color: #4da3ff;
  }

  .mx-legal {
    width: 100%; text-align: center;
    font-size: 12px; line-height: 1.6;
    color: rgba(255, 255, 255, 0.4); margin: 0;
  }
  .mx-legal a {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: underline; text-decoration-color: rgba(255, 255, 255, 0.2);
  }
  .mx-legal a:hover { color: rgba(255, 255, 255, 0.75); }

  /* ── Toast de error ── */
  .mx-toast {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    display: none; align-items: center; gap: 10px;
    padding: 13px 18px;
    background: #ef4444; color: #fff;
    font-size: 14px; font-weight: 500;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  }
  .mx-toast.show { display: flex; }
  .mx-toast span { flex: 1; }
  .mx-toast-close {
    background: transparent; border: none; color: #fff;
    font-size: 20px; font-weight: 700; line-height: 1;
    cursor: pointer; padding: 2px 6px;
  }

  @media (max-width: 640px) {
    .mx-page { padding: 36px 20px 72px; }
    .mx-row { grid-template-columns: 1fr; gap: 28px; }
    .mx-title { font-size: clamp(28px, 9vw, 38px); }
  }
</style>

<script>
  const ETIQUETA = 'Matrícula'
  const GRACIAS = '/matricula-a0-a1/gracias'

  const form = document.getElementById('form') as HTMLFormElement | null
  const btn = document.getElementById('submit') as HTMLButtonElement | null
  const btnText = document.getElementById('mx-btn-text') as HTMLElement | null
  const btnArrow = document.getElementById('mx-btn-arrow') as HTMLElement | null
  const spinner = document.getElementById('mx-btn-spinner') as HTMLElement | null
  const toast = document.getElementById('err') as HTMLElement | null
  const toastText = document.getElementById('errText') as HTMLElement | null
  const toastClose = document.getElementById('errClose') as HTMLButtonElement | null

  function setLoading(on: boolean) {
    if (!btn) return
    btn.disabled = on
    if (btnText) btnText.textContent = on ? 'Reservando…' : 'Reservar mi plaza'
    if (btnArrow) btnArrow.style.display = on ? 'none' : 'block'
    if (spinner) spinner.style.display = on ? 'block' : 'none'
  }

  function showToast(msg: string) {
    if (toastText) toastText.textContent = msg
    toast?.classList.add('show')
    window.scrollTo({ top: 0, behavior: 'smooth' })
  }
  toastClose?.addEventListener('click', () => toast?.classList.remove('show'))

  function showError(id: string, show: boolean) {
    const input = document.getElementById(id) as HTMLInputElement | null
    const err = document.querySelector(`[data-for="${id}"]`) as HTMLElement | null
    input?.classList.toggle('invalid', show)
    err?.classList.toggle('visible', show)
  }

  const val = (id: string) =>
    ((document.getElementById(id) as HTMLInputElement | null)?.value ?? '').trim()

  function validate(): boolean {
    let ok = true
    const first = val('first_name')
    showError('first_name', !first); if (!first) ok = false

    const email = val('email')
    const emailMal = !email || !email.includes('@')
    showError('email', emailMal); if (emailMal) ok = false

    /* Seis dígitos como mínimo, contando sólo dígitos: así "+31 6 12 34
       56 78" pasa y "no tengo" no. No validamos el formato de verdad
       —los prefijos de tres países no caben en una expresión regular
       sin dejar fuera a alguien— sólo que haya un número dentro. */
    const tel = val('phone')
    const telMal = (tel.match(/\d/g) || []).length < 6
    showError('phone', telMal); if (telMal) ok = false

    return ok
  }

  ;['first_name', 'email', 'phone'].forEach((id) => {
    document.getElementById(id)?.addEventListener('input', () => showError(id, false))
  })

  form?.addEventListener('submit', async (ev) => {
    ev.preventDefault()
    toast?.classList.remove('show')
    if (!validate()) return
    setLoading(true)

    const payload = {
      firstName: val('first_name'),
      email: val('email').toLowerCase(),
      phone: val('phone'),
      tagName: ETIQUETA,
      website: (document.getElementById('mx-honeypot') as HTMLInputElement | null)?.value ?? '',
    }

    try {
      /* Los dos a la vez. El del CRM decide si la persona pasa de
         pantalla; el de la escuela es para que salga en el panel, así
         que se le deja fallar solo sin tocar nada de lo demás. */
      const aviso = fetch('/api/solicitud', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...payload, source: 'web' }),
      }).catch(() => null)

      const res = await fetch('/api/waitlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
      await aviso
      const data = await res.json().catch(() => null)
      if (!res.ok || !data?.success) {
        showToast((data && data.error) || 'No se pudo enviar. Vuelve a intentarlo en un momento.')
        setLoading(false)
        return
      }
      /* El Lead se cuenta en la página de gracias, no aquí: ahí no se
         puede inflar con recargas ni contar envíos que fallaron. */
      window.location.href = GRACIAS
    } catch {
      showToast('Hubo un problema de red. Revisa tu conexión y vuelve a intentarlo.')
      setLoading(false)
    }
  })
</script>
