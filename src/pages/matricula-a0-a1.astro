---
/**
 * /matricula-a0-a1 → /agendar.
 *
 * Aquí estaba el formulario corto de matrícula (nombre, correo y teléfono),
 * retirado el 29/09/2026: la matrícula es /agendar. La dirección sigue viva
 * porque circula en correos, anuncios y WhatsApp.
 *
 * Es una página y no una redirección de src/lib/redirecciones.ts a
 * propósito: la redirección tiraba los ?utm_… y el lead llegaba a /agendar
 * sin saber de qué anuncio venía. Aquí se pasan tal cual.
 */
export const prerender = true
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content="0; url=/agendar" />
    <title>Holandés Nawar</title>
    <script is:inline>location.replace('/agendar' + location.search + location.hash)</script>
  </head>
  <body style="font-family:system-ui,sans-serif;background:#1D0084;color:#fff;padding:40px">
    <a href="/agendar" style="color:#4da3ff">Ir a la matrícula</a>
  </body>
</html>
