---
import Layout from '../../layouts/Layout.astro'
import NavbarLanding from '../../components/NavbarLanding'
import FooterNuevo from '../../components/FooterNuevo.astro'
import '../../styles/nawar-sections.css'

export const prerender = false

/* ══════════════════════════════════════════════════════════════
   GUÍA DE LAS BASES DEL NEERLANDÉS — versión de ANUNCIOS

   Copia de /guia/bases-neerlandes para el tráfico de pago. Misma
   página, misma guía y misma etiqueta en systeme.io; cambian tres
   cosas, y las tres son por medición:

     · Va sin indexar y con la canónica apuntando a la original, para
       que Google no vea dos páginas iguales.
     · El contacto llega al CRM con "Anuncio" en "Cómo conociste
       Nawar", así que se distingue de quién vino por su cuenta sin
       depender de la URL.
     · No enseña el "gracias" en la misma página: salta a una URL
       propia, que es lo que Meta mide bien y donde se dispara el
       evento Lead.

   ⚠️ Si se toca el copy de la original, hay que tocarlo aquí también:
   este archivo está duplicado a propósito, no comparte cuerpo.

   El copy sale de la guía real. Si la guía cambia, lo que hay que
   tocar son TITULO, ENTRADILLA y PUNTOS: el resto no depende de ellos.
══════════════════════════════════════════════════════════════ */

/* ⚠️ La etiqueta del CRM ("Guía Bases") NO vive aquí sino en el
   <script> del final del archivo. No es por gusto: ese <script> es un
   módulo aparte que se ejecuta en el navegador y no ve las constantes
   del frontmatter, que sólo existen al generar el HTML. Puesta aquí,
   el navegador lanzaba un ReferenceError al montar el envío, el
   try/catch del formulario se lo tragaba sin decir nada y el botón se
   quedaba en "Inténtalo de nuevo" para siempre.
   La etiqueta tiene que existir en systeme.io con ese nombre EXACTO o
   el alta se crea sin etiquetar, se queda fuera de la automatización
   y esa persona nunca recibe la guía. */

/* ── El copy ──────────────────────────────────────────────────
   Sale de la guía real (15 páginas, 6 capítulos, nivel 0), no de
   suposiciones: artículos de/het/een, pronombres personales y
   posesivos, verbos regulares e irregulares en presente con zijn y
   hebben, vocabulario y expresiones, y estructura de la frase. */
const TITULO = 'Las bases del neerlandés'
const ENTRADILLA = `
  Deja tu email y recibe <strong>gratis</strong> esta guía de
  <strong>15 páginas</strong> para empezar desde cero: los artículos,
  los pronombres, los verbos en presente y el vocabulario que de
  verdad se usa. Todo explicado desde el español, en seis capítulos,
  para que <strong>te defiendas en tu primer mes aquí</strong>.
`
const PUNTOS = [
  'Desde cero, sin experiencia previa',
  'Explicado desde el español',
  'Con ejemplos y frases del día a día',
]

/* Lo que ve Google y lo que sale en la pestaña del navegador. */
const TITULO_PESTANA = `${TITULO} — Guía gratuita | Holandés Nawar`
const DESCRIPCION =
  'Descarga gratis la guía de las bases del neerlandés para hispanohablantes: ' +
  '15 páginas y 6 capítulos desde cero con los artículos de, het y een, los ' +
  'pronombres, los verbos zijn y hebben en presente, vocabulario esencial y la ' +
  'estructura de la frase. Explicado desde el español.'

/* ── La portada, en la columna de la derecha ──────────────────
   ⚠️ VACÍO = la columna no se pinta y la página se queda a una sola
   columna, a ancho completo. Está así a propósito mientras se hace el
   mockup: cuando exista, se pega aquí su URL y aparece sola. */
const PORTADA = ''
const PORTADA_ALT = 'Portada de la guía gratuita: las bases del neerlandés para hispanohablantes'
---

<Layout
  title={TITULO_PESTANA}
  description={DESCRIPCION}
  keywords="bases del neerlandés, guía gratuita neerlandés, aprender neerlandés desde cero, neerlandés para hispanohablantes, gramática neerlandesa en español"
  canonicalURL="https://www.holandesnawar.com/guia/bases-neerlandes"
  noindex={true}
>
  <NavbarLanding client:load />

  <section data-navbar="dark" class="guide-hero">
    <div class="hero-glow1" aria-hidden="true"></div>
    <div class="hero-glow2" aria-hidden="true"></div>
    <div class="dots-dark" aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;"></div>

    <div class="guide-shell">
      <div class="guide-grid">
        <div class="guide-copy sr">
          <span class="badge-dark">
            <svg class="check-icon" fill="none" viewBox="0 0 12 12">
              <path d="M2 6.5l2.5 2.5 5.5-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            Guía gratuita
          </span>

          <h1 class="guide-title text-gradient-white">{TITULO}</h1>

          <p class="guide-lead" set:html={ENTRADILLA} />

          <div class="guide-points">
            {PUNTOS.map((punto) => (
              <p class="guide-point">
                <span class="guide-check">
                  <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </span>
                {punto}
              </p>
            ))}
          </div>

          <div class="guide-form-wrap">
            <div id="guide-success" class="guide-success" style="display:none;">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>¡Gracias! Revisa tu correo para ver tu guía. <br/> No olvides revisar la carpeta de spam.</span>
            </div>

            <form id="guide-form" class="guide-form">
              {/* Honeypot anti-bot — invisible */}
              <div class="guide-honeypot" aria-hidden="true">
                <label>No rellenar
                  <input type="text" id="guide-honeypot" name="website" tabindex="-1" autocomplete="off" />
                </label>
              </div>
              <input
                id="guide-name"
                type="text"
                class="guide-input"
                placeholder="Nombre"
                autocomplete="name"
                required
              />
              <input
                id="guide-email"
                type="email"
                class="guide-input"
                placeholder="Correo electrónico"
                autocomplete="email"
                required
              />
              <p class="guide-privacy">
                Al hacer clic, confirmo que he leído y aceptado la
                <a href="https://holandesnawar.com/politica-de-privacidad" target="_blank" rel="noopener noreferrer">política de privacidad</a>
                y los
                <a href="https://holandesnawar.com/terminos-y-condiciones" target="_blank" rel="noopener noreferrer">términos y condiciones</a>.
              </p>
              <button id="guide-submit" type="submit" class="guide-submit">
                ¡Descargar!
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v10m0 0l-4-4m4 4l4-4M5 19h14" />
                </svg>
              </button>
            </form>
          </div>
        </div>

        {/* La columna de la derecha. Vacía a propósito mientras se
            hace el mockup de la portada: en cuanto exista, se pega su
            URL en PORTADA ahí arriba y aparece sola, sin tocar nada
            más. Con la constante vacía no se pinta ni el contenedor,
            así que la rejilla se queda en una sola columna y no hay
            medio ancho en blanco esperando. */}
        {PORTADA && (
          <div class="guide-visual sr d1">
            <img src={PORTADA} alt={PORTADA_ALT} class="guide-image" />
          </div>
        )}
      </div>
    </div>
  </section>

  <FooterNuevo />
</Layout>

<style>
  .guide-hero {
    background: #1D0084;
    position: relative;
    overflow: hidden;
    padding: 120px 0 0;
  }

  .guide-shell {
    position: relative;
    z-index: 1;
    max-width: 1152px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  /* Mientras no haya portada sólo hay un hijo en la rejilla. Con dos
     columnas fijas ese hijo se quedaba en la mitad izquierda y la otra
     mitad en blanco, que no es "vacío", es "roto". Con :only-child la
     columna ocupa el ancho y el texto se limita solo por sus propios
     max-width, que ya los tiene. */
  .guide-copy:only-child {
    grid-column: 1 / -1;
    /* Ancho para que el titular quepa en una línea. No arrastra al
       resto: la entradilla se queda en sus 560 px y el formulario en
       sus 540, que son los que dan una línea de lectura cómoda. Aquí
       el ancho sólo lo usa el titular. */
    max-width: 1000px;
  }

  .guide-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-bottom: 56px;
  }

  /* Baja de 72 px a 60. Medido, no a ojo: "Las bases del neerlandés"
     ocupa 947 px a 72 px y la columna da 720, así que se partía en dos
     líneas en cualquier pantalla de ordenador. A 60 px baja a 789 y,
     con la columna ensanchada de abajo, entra en una sola con holgura
     de sobra para cuando cargue la Poppins de verdad, que es más ancha
     que la de reserva con la que se mide aquí.
     ⚠️ Esto vale mientras la columna de la derecha esté vacía. El día
     que se ponga la portada, la rejilla vuelve a dos columnas de media
     pantalla y el titular se partirá otra vez: ahí habrá que acortarlo
     o bajarlo más. */
  .guide-title {
    font-family: var(--font-poppins), system-ui, sans-serif;
    font-size: clamp(38px, 6vw, 60px);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.05;
    padding-bottom: 0.1em;
    margin: 0 0 16px;
  }

  .guide-lead {
    margin: 0;
    max-width: 560px;
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.65;
    color: #ffffff;
  }

  .guide-lead strong {
    font-weight: 800;
  }

  .guide-points {
    display: grid;
    gap: 12px;
    margin: 28px 0;
  }

  .guide-point {
    display: flex;
    align-items: center;
    gap: 11px;
    margin: 0;
    font-size: clamp(15px, 1.4vw, 17px);
    font-weight: 600;
    line-height: 1.45;
    color: #ffffff;
  }

  .guide-check {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #025dc7;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
  }

  .guide-form-wrap {
    width: 100%;
    max-width: 540px;
  }

  .guide-form {
    display: grid;
    gap: 16px;
    width: 100%;
  }

  /* Honeypot — invisible para humanos */
  .guide-honeypot {
    position: absolute !important;
    left: -10000px !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .guide-input {
    width: 100%;
    min-width: 0;
    padding: 15px 18px;
    border-radius: 12px;
    background: #F0F5FF;
    border: 1px solid transparent;
    color: #1D0084;
    font-size: 15px;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
  }

  .guide-input::placeholder {
    color: rgba(29,0,132,0.45);
  }

  .guide-input:hover {
    background: #E5ECFF;
  }

  .guide-input:focus {
    border-color: #4da3ff;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(77,163,255,0.22);
  }

  .guide-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    width: 100%;
    padding: 16px 24px;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    background: #4da3ff;
    color: #1D0084;
    font-size: 14px;
    font-weight: 700;
    font-family: inherit;
    white-space: nowrap;
    transition: background 0.2s ease, transform 0.18s ease;
  }

  .guide-submit:hover {
    background: #5eb4ff;
    transform: translateY(-1px);
  }

  .guide-success {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: rgba(255,255,255,0.85);
    padding: 12px 0;
  }

  .guide-privacy {
    margin: 0;
    font-size: 12px;
    line-height: 1.65;
    color: rgba(255,253,253,0.8);
  }

  .guide-privacy a {
    color: rgba(255,255,255,0.55);
    text-decoration: underline;
    margin: 0 3px;
  }

  .guide-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    align-self: stretch;
  }

  .guide-image {
    display: block;
    width: 108%;
    max-width: 108%;
    height: auto;
    margin: 0 auto;
  }

  @media (max-width: 980px) {
    .guide-shell {
      padding: 0 24px;
    }

    .guide-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .guide-copy {
      padding-bottom: 0;
    }

    .guide-visual {
      justify-content: flex-start;
      padding-bottom: 28px;
    }

    .guide-image {
      max-width: 560px;
    }
  }

  @media (max-width: 640px) {
    .guide-hero {
      padding: 100px 0 0;
    }

    .guide-shell {
      padding: 0 20px;
    }

    .guide-title {
      font-size: clamp(34px, 12vw, 52px);
    }

    .guide-lead {
      max-width: none;
      font-size: 16px;
      line-height: 1.55;
    }

    .guide-point {
      align-items: flex-start;
      font-size: 16px;
    }

    .guide-visual {
      padding-bottom: 20px;
    }

    .guide-image {
      max-width: 100%;
    }
  }
</style>

<script>
  /* La etiqueta del CRM va aquí y no en el frontmatter: este script
     corre en el navegador y no ve nada de allá arriba. Tiene que
     existir con este nombre exacto en systeme.io. */
  const ETIQUETA_CRM = 'Guía Bases'

  const form = document.getElementById('guide-form') as HTMLFormElement | null
  const nameInput = document.getElementById('guide-name') as HTMLInputElement | null
  const emailInput = document.getElementById('guide-email') as HTMLInputElement | null
  const submitBtn = document.getElementById('guide-submit') as HTMLButtonElement | null
  const success = document.getElementById('guide-success') as HTMLElement | null

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()

    const name = nameInput?.value?.trim()
    const email = emailInput?.value?.trim()
    const website = (document.getElementById('guide-honeypot') as HTMLInputElement | null)?.value || ''
    if (!name || !email) return

    if (submitBtn) {
      submitBtn.disabled = true
      submitBtn.textContent = 'Enviando...'
    }

    try {
      const res = await fetch('/api/waitlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        // "conociste" va al campo "Cómo conociste Nawar" de systeme.io: así se
        // distingue en el CRM quién vino del anuncio, no solo por la URL.
        body: JSON.stringify({ name, email, tagName: ETIQUETA_CRM, website, conociste: 'Anuncio' }),
      })

      const data = await res.json().catch(() => null)

      if (res.ok && data?.success) {
        // A diferencia de la original, aquí no se enseña el "gracias" en la
        // misma página: se va a una URL propia, que es lo que Meta mide bien
        // (y donde se dispara el evento Lead).
        window.location.href = '/guia/bases-neerlandes-a/gracias'
        return
      }
    } catch {
      // Error state handled below.
    }

    if (submitBtn) {
      submitBtn.disabled = false
      submitBtn.textContent = 'Inténtalo de nuevo'
    }
  })
</script>
