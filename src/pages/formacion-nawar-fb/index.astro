  .fv-mock.sin-foto { background: linear-gradient(135deg, #F5F8FF, #EAF2FF); border-radius: 24px; }
  .fv-mock.sin-foto .fv-mock-plan-b { display: inline-flex; }
  @media (prefers-reduced-motion: reduce) { .fv-mock { transition: none; } }

  /* ── La videollamada dibujada (paso 4) ──────────────────────────────
     Mismo lenguaje que las ilustraciones de las landings: un portátil sobre
     dos bloques de color (azul oscuro arriba a la izquierda, azul claro abajo
     a la derecha), con aire a los lados como la tableta de las consultas.
     Pocas piezas y grandes: la diapositiva a todo lo ancho, la cámara del
     profe en una esquina y los alumnos en una fila de letras abajo (07/10:
     con la rejilla de seis cuadros "quedó muy apretado"). Todo en cqw (el
     ancho de la figura): en el móvil es la misma imagen, más pequeña. */
  .fv-mock { container-type: inline-size; }
  .vc { position: absolute; inset: 0; }
  .vc-bloque { position: absolute; border-radius: 2.2cqw; }
  .vc-b1 { left: 8%; top: 9%; width: 32%; height: 40%; background: radial-gradient(circle at 30% 30%, #1d3fd8, #1D0084 75%); }
  .vc-b2 { right: 8%; bottom: 9%; width: 34%; height: 44%; background: #9fd5ff; }
  .vc-portatil { position: absolute; left: 18%; right: 18%; top: 13%; bottom: 19%; background: #111827; border-radius: 1.8cqw 1.8cqw 0.6cqw 0.6cqw; padding: 1cqw; box-shadow: 0 3cqw 5cqw -2.5cqw rgba(10,22,86,0.45); }
  .vc-base { position: absolute; left: 14%; right: 14%; bottom: 16%; height: 3.2%; background: linear-gradient(#e5e7eb, #b9bec8); border-radius: 0 0 2cqw 2cqw; }
  .vc-pantalla { width: 100%; height: 100%; border-radius: 0.8cqw; overflow: hidden; background: #0f1530; display: flex; flex-direction: column; font-family: 'Inter', system-ui, sans-serif; }
  .vc-top { display: flex; align-items: center; justify-content: space-between; gap: 1cqw; padding: 0.8cqw 1.3cqw; font-size: 1.05cqw; color: rgba(255,255,255,0.7); }
  .vc-vivo { display: inline-flex; align-items: center; gap: 0.6cqw; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #fff; font-size: 0.95cqw; }
  .vc-vivo i { width: 0.8cqw; height: 0.8cqw; border-radius: 9999px; background: #ef4444; box-shadow: 0 0 0 0.4cqw rgba(239,68,68,0.25); }
  .vc-tit { font-weight: 600; color: #fff; }
  .vc-hora { font-variant-numeric: tabular-nums; }
  .vc-cuerpo { position: relative; flex: 1; min-height: 0; padding: 0 1cqw; display: flex; }
  /* La diapositiva compartida: la de la lección, en blanco y azul. El texto
     va a la izquierda; la cámara del profe ocupa la esquina de arriba. */
  .vc-slide { flex: 1; background: linear-gradient(160deg, #ffffff, #EEF4FF); border-radius: 0.8cqw; padding: 2.2cqw 2.6cqw; display: flex; flex-direction: column; justify-content: center; overflow: hidden; }
  .vc-slide-et { margin: 0; font-size: 1.05cqw; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #025dc7; }
  .vc-slide-t { margin: 0.5cqw 0 1.4cqw; font-family: 'Poppins', system-ui, sans-serif; font-size: 3.1cqw; font-weight: 700; line-height: 1.1; letter-spacing: -0.02em; color: #1D0084; }
  .vc-l { margin: 0 0 0.8cqw; max-width: 64%; display: grid; grid-template-columns: 6cqw minmax(0, 1fr); font-size: 1.55cqw; line-height: 1.35; color: #0a1656; }
  .vc-l b { font-size: 1.25cqw; font-weight: 600; color: #025dc7; padding-top: 0.15cqw; }
  .vc-turno { margin: 1cqw 0 0; align-self: flex-start; display: inline-flex; align-items: center; gap: 0.7cqw; padding: 0.8cqw 1.4cqw; border-radius: 9999px; background: #4da3ff; color: #0a1656; font-size: 1.3cqw; font-weight: 700; }
  .vc-turno :global(svg) { width: 1.4cqw; height: 1.4cqw; }
  /* La cámara del profe, hablando (el filo azul), encima de la diapositiva. */
  .vc-profe { position: absolute; top: 1.2cqw; right: 2.2cqw; width: 30%; aspect-ratio: 4 / 3; border-radius: 0.8cqw; overflow: hidden; background: #2a3458; box-shadow: 0 0 0 0.25cqw #4da3ff, 0 1.5cqw 3cqw -1.5cqw rgba(10,22,86,0.5); }
  .vc-profe img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vc-nombre { position: absolute; left: 0.5cqw; bottom: 0.5cqw; display: inline-flex; align-items: center; gap: 0.35cqw; padding: 0.25cqw 0.6cqw; border-radius: 0.4cqw; background: rgba(10,15,40,0.7); color: #fff; font-size: 0.95cqw; font-weight: 600; }
  .vc-nombre i { display: inline-flex; color: #4da3ff; }
  .vc-nombre :global(svg) { width: 0.95cqw; height: 0.95cqw; }
  /* Abajo: los alumnos (solo la letra, como sin foto de perfil) y los botones. */
  .vc-barra { display: flex; align-items: center; justify-content: space-between; gap: 1cqw; padding: 0.9cqw 1.3cqw; }
  .vc-grupo { position: relative; display: flex; align-items: center; }
  .vc-ini { width: 2.6cqw; height: 2.6cqw; margin-left: -0.6cqw; border-radius: 9999px; background: var(--c, #4da3ff); box-shadow: 0 0 0 0.25cqw #0f1530; color: #fff; font-size: 1.15cqw; font-weight: 600; display: inline-flex; align-items: center; justify-content: center; }
  .vc-ini:first-child { margin-left: 0; }
  .vc-tu { background: #4da3ff; color: #0a1656; font-size: 1cqw; font-weight: 700; }
  .vc-mano { margin-left: 0.5cqw; font-style: normal; font-size: 1.3cqw; }
  .vc-botones { display: flex; align-items: center; gap: 0.8cqw; }
  .vc-botones > span { width: 2.6cqw; height: 2.6cqw; border-radius: 9999px; background: #263055; color: #fff; display: inline-flex; align-items: center; justify-content: center; }
  .vc-botones :global(svg) { width: 1.2cqw; height: 1.2cqw; }
  .vc-botones > .vc-salir { width: auto; padding: 0 1.3cqw; border-radius: 9999px; background: #dc2626; font-weight: 600; font-size: 1.05cqw; }

  /* ── El plan de estudios (oscuro, como UDIA) ───────────────────────── */
  .fv-prog-sec { background: #120a5c; color: #fff; padding-bottom: 120px;
    background-image: radial-gradient(circle 900px at 85% 0%, rgba(11,109,240,0.28) 0%, transparent 60%), radial-gradient(circle 700px at 0% 100%, rgba(77,163,255,0.10) 0%, transparent 60%); }
  .fv-prog-sec > .fv-dots { opacity: 0.5; }
  .fv-prog-sec .fv-cab { margin-bottom: 44px; }
  /* 08/10: la entradilla quedaba muy separada de los dolores. */
  .fv-cab.fv-cab-dolores { margin-bottom: 36px; }
  .fv-flujo { color: #fff; font-weight: 600; white-space: nowrap; }
  .fv-prog { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 36px; align-items: start; }
  .fv-prog-nav { position: sticky; top: 32px; }
  .fv-prog-nav-caja { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 20px 14px 14px; }
  .fv-prog-nav-top { display: flex; justify-content: space-between; align-items: baseline; padding: 0 8px; }
  .fv-prog-nav-titulo { margin: 0; font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.5); }
  .fv-prog-nav-paso { margin: 0; font-size: 12px; font-weight: 600; color: #fff; font-variant-numeric: tabular-nums; }
  .fv-raya-lateral { margin: 12px 8px 12px; }
  .fv-prog-nav ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .fv-prog-nav a { display: flex; align-items: center; gap: 12px; padding: 10px 8px; border-radius: 12px; text-decoration: none; transition: background .2s; }
  .fv-prog-nav a:hover { background: rgba(255,255,255,0.05); }
  .fv-prog-nav a b { display: block; font-size: 14.5px; font-weight: 600; color: rgba(255,255,255,0.62); transition: color .2s; }
  .fv-prog-nav a small { display: block; font-size: 12px; color: rgba(255,255,255,0.4); margin-top: 1px; }
  .fv-prog-bola { flex-shrink: 0; width: 32px; height: 32px; border-radius: 9999px; border: 1.5px solid rgba(255,255,255,0.18); font-size: 11.5px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.5); transition: background .25s, border-color .25s, color .25s; }
  .fv-prog-nav a.hecho .fv-prog-bola { border-color: var(--c); color: var(--c); }
  .fv-prog-nav a.activo { background: rgba(255,255,255,0.06); }
  .fv-prog-nav a.activo b { color: #fff; }
  .fv-prog-nav a.activo .fv-prog-bola { background: var(--c); border-color: var(--c); color: #0a1656; }

  /* La raya de progreso (la misma en la barra del móvil y en la columna):
     avanza por etapas, con su transición; no sigue al dedo. */
  .fv-fases-raya { height: 4px; border-radius: 9999px; background: rgba(255,255,255,0.1); overflow: hidden; }
  .fv-raya-fill { display: block; height: 100%; width: 100%; transform-origin: left; transform: scaleX(0); transition: transform .45s ease; background: linear-gradient(90deg, #4da3ff, #5ad1c5 35%, #8e9cff 65%, #c9b6ff); border-radius: 9999px; }

  /* La barra de etapas del móvil: escondida en el ordenador. */
  .fv-fases-barra, .fv-fases-fija { display: none; }

  /* Las etapas: tarjetas oscuras, sin tarjetas dentro (07/10: "que no
     parezcan popups"). Lo de dentro se separa con filetes, no con cajas. */
  .fv-prog-fases { display: flex; flex-direction: column; gap: 18px; }
  .fv-fase { position: relative; background: rgba(255,255,255,0.035); border: 1px solid rgba(255,255,255,0.09); border-radius: 22px; padding: 30px 32px 26px; scroll-margin-top: 28px; transition: border-color .3s, background .3s; }
  .fv-fase.activa { border-color: color-mix(in srgb, var(--c) 45%, transparent); background: rgba(255,255,255,0.05); }
  .fv-fase::before { content: ''; position: absolute; left: 32px; right: 32px; top: -1px; height: 2px; border-radius: 0 0 4px 4px; background: var(--c); opacity: 0; transition: opacity .3s; }
  .fv-fase.activa::before { opacity: 1; }
  .fv-fase-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .fv-fase-chip { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 9999px; font-size: 11.5px; font-weight: 600; color: rgba(255,255,255,0.6); border: 1px solid rgba(255,255,255,0.12); }
  .fv-fase-chip-c { color: var(--c); border-color: color-mix(in srgb, var(--c) 40%, transparent); letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700; font-size: 11px; }
  .fv-fase-cab { display: flex; align-items: center; gap: 18px; margin-bottom: 20px; }
  .fv-fase-n { font-family: 'Poppins', system-ui, sans-serif; font-size: 54px; font-weight: 700; line-height: 0.9; letter-spacing: -0.05em; color: color-mix(in srgb, var(--c) 55%, transparent); }
  .fv-fase h3 { font-family: 'Poppins', system-ui, sans-serif; font-size: 24px; font-weight: 600; letter-spacing: -0.018em; color: #fff; margin: 0; }
  .fv-fase-cab p { margin: 3px 0 0; font-size: 14.5px; color: rgba(255,255,255,0.6); }
  .fv-fase-promesa { border-left: 2px solid var(--c); padding: 2px 0 2px 18px; margin-bottom: 24px; }
  .fv-fase-promesa span { display: block; font-size: 10.5px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.5); margin-bottom: 5px; }
  .fv-fase-promesa p { margin: 0; font-size: 16.5px; line-height: 1.55; color: #fff; font-weight: 500; }
  .fv-fase-sub { margin: 0 0 12px; font-size: 10.5px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.5); }
  .fv-fase-temas { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 28px; }
  .fv-fase-temas li { position: relative; padding-left: 18px; font-size: 14.5px; line-height: 1.55; color: rgba(255,255,255,0.85); }
  .fv-fase-temas li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 6px; height: 6px; border-radius: 9999px; background: var(--c); }
  .fv-fase-hito { display: flex; align-items: flex-start; gap: 12px; margin-top: 22px; padding-top: 18px; border-top: 1px solid rgba(255,255,255,0.09); }
  .fv-fase-hito-ico { flex-shrink: 0; color: var(--c); display: inline-flex; padding-top: 2px; }
  .fv-fase-hito p { margin: 0; font-size: 15px; line-height: 1.55; color: rgba(255,255,255,0.9); }
  .fv-fase-hito b { color: #fff; font-weight: 600; }
  .fv-fase-mods { margin: 16px 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 12.5px; color: rgba(255,255,255,0.5); }
  .fv-fase-mods span { margin-right: 4px; font-size: 10.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.45); }
  .fv-fase-mods i { font-style: normal; padding: 3px 10px; border-radius: 9999px; border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.75); }

  /* El certificado: el de las landings (fondo + papel girado). */
  .fv-cert-titulo { margin-bottom: 18px !important; }
  .fv-cert-visual { margin-bottom: 18px; }
  .fv-cert-foto { position: relative; margin: 0; aspect-ratio: 16 / 9; }
  /* Las medidas y colores de fondo.certificado.png (1920×1080). */
  .fv-cert-b1 { position: absolute; left: 5.6%; top: 11.5%; width: 51.7%; height: 72.8%; border-radius: 3.2% / 5.6%; background: radial-gradient(ellipse at 50% 50%, #0a5fd0 0%, #0b3fb0 45%, #170a8c 100%); }
  .fv-cert-b2 { position: absolute; left: 69.3%; top: 64.4%; width: 25.1%; height: 26.2%; border-radius: 6.5% / 11%; background: #9fd8ff; }
  .fv-cert-papel { position: absolute; left: 50%; top: 50%; width: 62%; transform: translate(-50%, -50%) rotate(-7deg); filter: drop-shadow(0 18px 28px rgba(3,9,33,0.45)); }
  .fv-cert-papel img { width: 100%; height: auto; display: block; border-radius: 8px; }
  .fv-cert-dibujo { max-width: 420px; margin: 28px auto; background: linear-gradient(160deg, #fff, #eef4ff); border-radius: 12px; padding: 26px 22px 22px; text-align: center; transform: rotate(-2deg); border: 6px solid #fff; outline: 1px solid #c9d8f2; outline-offset: -12px; box-shadow: 0 24px 50px -24px rgba(29,0,132,0.4); }
  .fv-cert-dibujo[hidden] { display: none; }
  .fv-cert-marca { margin: 0 0 10px; font-family: 'Poppins', system-ui, sans-serif; font-size: 15px; font-weight: 700; color: #1D0084; }
  .fv-cert-tipo { margin: 0; font-size: 10px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: #6b7aa6; }
  .fv-cert-nombre { margin: 10px 0 6px; font-family: 'Poppins', system-ui, sans-serif; font-size: 22px; font-weight: 600; font-style: italic; color: #1D0084; }
  .fv-cert-texto { margin: 0; font-size: 12.5px; line-height: 1.5; color: #47557f; }
  .fv-cert-tres { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; border-top: 1px solid rgba(255,255,255,0.09); }
  .fv-cert-tres div { padding: 16px 18px 2px 0; }
  .fv-cert-tres div + div { padding-left: 18px; border-left: 1px solid rgba(255,255,255,0.09); }
  .fv-cert-tres span { display: block; font-size: 10.5px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.5); margin-bottom: 5px; }
  .fv-cert-tres p { margin: 0; font-size: 14px; line-height: 1.55; color: rgba(255,255,255,0.88); }

  /* ── ¿Te reconoces? ────────────────────────────────────────────────── */
  .fv-perfiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; max-width: 980px; margin: 0 auto; }
  .fv-perfil { position: relative; background: #F5F8FF; border-radius: 22px; padding: 34px 32px 26px; display: flex; flex-direction: column; }
  .fv-comillas { position: absolute; top: 6px; left: 24px; font-family: 'Poppins', system-ui, sans-serif; font-size: 72px; line-height: 1; color: #4da3ff; opacity: 0.55; }
  .fv-perfil-q { position: relative; margin: 14px 0 22px; font-family: 'Poppins', system-ui, sans-serif; font-size: clamp(19px, 2vw, 22px); font-weight: 600; line-height: 1.35; letter-spacing: -0.015em; color: #1D0084; flex: 1; }
  .fv-perfil-r { margin: 0; padding-top: 16px; border-top: 1px solid #DDE6F5; display: flex; gap: 10px; align-items: flex-start; font-size: 15px; line-height: 1.55; color: #171a2e; }
  .fv-perfil-r :global(svg) { flex-shrink: 0; color: #025dc7; margin-top: 2px; }
  .fv-noes { max-width: 980px; margin: 28px auto 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px 26px; }
  .fv-noes-t { margin: 0; font-size: 14px; font-weight: 600; color: #171a2e; }
  .fv-noes ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 22px; }
  .fv-noes li { display: inline-flex; align-items: center; gap: 7px; font-size: 14px; color: #171a2e; }
  .fv-noes li :global(svg) { color: #b4bdd6; }

  /* ── Competencias: panel oscuro dentro de una sección blanca ─────────── */
  .fv-comp-sec { padding-top: 0; }
  .fv-comp { position: relative; overflow: hidden; display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 56px; align-items: center;
    background: #1D0084; border-radius: 28px; padding: 56px 52px; color: #fff;
    background-image: radial-gradient(circle, rgba(255,255,255,0.06) 1px, transparent 1px), radial-gradient(circle 520px at 100% 0%, rgba(11,109,240,0.45) 0%, transparent 65%);
    background-size: 28px 28px, auto; }
  .fv-comp-cab { position: relative; z-index: 1; }
  .fv-comp-cab .fv-lead { max-width: 420px; }
  .fv-comp-lista { position: relative; z-index: 1; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 28px; }
  .fv-comp-lista li { display: flex; gap: 14px; align-items: flex-start; }
  .fv-num { flex-shrink: 0; width: 30px; height: 30px; border-radius: 9999px; border: 1.5px solid #fff; font-size: 13px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; padding-top: 2px; color: #fff; display: inline-flex; align-items: center; justify-content: center; }
  /* 07/10: "letra más blanca en las descripciones, que destaque". */
  .fv-comp-lista p { margin: 3px 0 0; font-size: 15.5px; line-height: 1.6; color: rgba(255,255,255,0.94); }
  .fv-comp-lista :global(.fv-chip) { color: #9fd0ff; }

  /* ── Cierre: oscuro por capas, los tres pasos y un botón que sube ── */
  .fv-cierre { position: relative; background: #1D0084; color: #fff; overflow: clip; padding: 112px 24px 0; }
  .fv-cierre-in { position: relative; z-index: 1; max-width: 980px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .fv-cierre .fv-h2 { font-size: clamp(30px, 4.2vw, 48px); margin-bottom: 44px; }
  .fv-pasos { list-style: none; margin: 0; padding: 0; position: relative; width: 100%; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  /* El hilo que une los tres pasos. */
  .fv-pasos::before { content: ''; position: absolute; top: 19px; left: 16.6%; right: 16.6%; height: 1px; background: linear-gradient(90deg, #4da3ff, rgba(77,163,255,0.25)); }
  .fv-pasos li { position: relative; display: flex; flex-direction: column; align-items: center; }
  .fv-pasos-n { width: 38px; height: 38px; border-radius: 9999px; background: #1D0084; border: 1px solid #4da3ff; color: #fff; font-weight: 700; font-size: 14px; line-height: 1; font-variant-numeric: tabular-nums; padding-top: 2px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px; }
  .fv-pasos b { display: block; font-family: 'Poppins', system-ui, sans-serif; font-size: 18px; font-weight: 600; color: #fff; margin-bottom: 6px; }
  .fv-pasos p { margin: 0; font-size: 15px; line-height: 1.55; color: rgba(255,255,255,0.75); max-width: 260px; }
  .fv-cierre-btn { margin-top: 48px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 17px 34px; border-radius: 12px;
    background: #4da3ff; color: #0a1656; font-size: 16.5px; font-weight: 700; text-decoration: none; transition: background .15s, transform .15s; }
  .fv-cierre-btn:hover { background: #5eb4ff; }
  .fv-cierre-btn:active { transform: translateY(1px); }

  .fv-pie { position: relative; z-index: 1; max-width: 1120px; margin: 96px auto 0; padding: 26px 0 34px; border-top: 1px solid rgba(255,255,255,0.1);
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 24px; font-size: 13px; color: rgba(255,255,255,0.55); }
  .fv-logo-pie { height: 26px; width: auto; opacity: 0.85; }
  .fv-pie nav { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .fv-pie a { color: rgba(255,255,255,0.7); text-decoration: none; }
  .fv-pie a:hover { color: #fff; }
  .fv-pie p { margin: 0; }

  .fv-pegado { display: none; }

  /* ── Tableta ────────────────────────────────────────────────────────── */
  @media (max-width: 1023px) {
    .fv-hero-in { grid-template-columns: minmax(0, 1fr); grid-template-areas: "texto" "form" "pruebas"; row-gap: 32px; padding-top: 12px; }
    .fv-hero-texto { max-width: 680px; }
    .fv-hero-form { max-width: 520px; width: 100%; }
    .fv-pruebas { margin-top: 0; }
    .fv-dolores { grid-template-columns: repeat(2, minmax(0, 1fr)); }
