  /* El fondo por capas de la marca (cabecera y cierre): dos luces, la malla
     de 78 px con máscara y la trama de puntos. Un degradado liso "se lee
     plantilla". */
  .fv-capas { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .fv-capas span { position: absolute; }
  .fv-luz1 { top: -260px; right: -200px; width: 900px; height: 760px; background: radial-gradient(closest-side, rgba(11,109,240,0.55), transparent); }
  .fv-luz2 { bottom: -320px; left: -260px; width: 820px; height: 680px; background: radial-gradient(closest-side, rgba(77,163,255,0.20), transparent); }
  .fv-malla { inset: 0; background-image: linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px); background-size: 78px 78px;
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 72% 30%, #000 0%, transparent 72%); mask-image: radial-gradient(ellipse 60% 70% at 72% 30%, #000 0%, transparent 72%); }
  .fv-capas .fv-dots { inset: 0; opacity: 0.6; }

  /* ── Cabecera ───────────────────────────────────────────────────────── */
  .fv-hero { position: relative; background: #1D0084; color: #fff; overflow: clip; padding: 0 24px 96px; }
