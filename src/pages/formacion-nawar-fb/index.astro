  .fv-cinta-grupo i { font-style: normal; color: #4da3ff; padding-left: 24px; }
  @keyframes fv-cinta { from { transform: translateX(0); } to { transform: translateX(-25%); } }
  @media (prefers-reduced-motion: reduce) { .fv-cinta-pista { animation: none; } }

  /* ── Dolores: el icono solo, sin baldosa ────────────────────────────── */
  .fv-dolores { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; border: 1px solid #E3EAF6; border-radius: 22px; overflow: hidden; background: #fff; }
  .fv-dolor { display: flex; flex-direction: column; gap: 18px; padding: 32px 30px; border-right: 1px solid #E3EAF6; border-bottom: 1px solid #E3EAF6; }
  .fv-dolor:nth-child(3n) { border-right: 0; }
