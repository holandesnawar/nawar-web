  .fv-sem-n { font-family: 'Poppins', system-ui, sans-serif; font-size: 14px; font-weight: 600; color: #171a2e; padding-top: 2px; font-variant-numeric: tabular-nums; transition: color .2s; }
  .fv-sem-txt b { display: block; font-family: 'Poppins', system-ui, sans-serif; font-size: 18px; font-weight: 600; letter-spacing: -0.012em; color: #171a2e; transition: color .2s; }
  .fv-sem-d { display: block; max-height: 0; opacity: 0; overflow: hidden; font-size: 15px; line-height: 1.62; color: #171a2e; transition: max-height .4s ease, opacity .3s ease, margin .4s ease; }
