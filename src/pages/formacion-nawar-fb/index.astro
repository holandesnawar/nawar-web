  .fv-grad { background: linear-gradient(180deg, #fff 0%, rgba(255,255,255,0.72) 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .fv-nw { white-space: nowrap; }
  .fv-lead { font-size: clamp(16px, 1.45vw, 18px); line-height: 1.65; color: #171a2e; margin: 0; max-width: 620px; }
