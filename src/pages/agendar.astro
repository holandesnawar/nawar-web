---
/**
 * /agendar — pedir una llamada, pasando antes por la cualificación.
 *
 * Pantalla 0: qué es la llamada y qué vamos a hacer (que la persona sepa a
 * qué viene antes de dar sus datos). Pantalla 1: nombre, correo y WhatsApp.
 * Después, una pregunta por pantalla (src/lib/cualificacion.ts). Al final,
 * según la nota que calcula el servidor: el botón para agendar o la guía.
 *
 * Por qué filtrar: la llamada es lo más caro de la escuela (tiempo de una
 * persona). A ella llegan los que tienen el nivel, el momento y la
 * disposición; los demás reciben lo que les sirve ahora, sin sentirse
 * rechazados.
 *
 * Diseño (pedido 22/09, con UDIA e ICO de referencia): solo la línea de
 * progreso, sin "paso X de N"; cajas de cristal azul marino; la pregunta del
 * dinero sin cifra. Y lo que hace ICO con Typeform, hecho aquí:
 *  - cada opción lleva su letra (A, B, C…) y se puede contestar con el
 *    teclado; al tocar una opción se pasa sola a la siguiente pregunta;
 *  - preguntas que venden mientras preguntan (el texto largo antes de la
 *    pregunta), una abierta ("¿qué esperas conseguir?") con el marco de
 *    "de esto depende que te propongamos plaza" y una escala del 1 al 5 de
 *    compromiso. Nueve preguntas ("cuándo empiezas" y "quién decide" se
 *    quitaron el 23/09; edad y ocupación se quedan);
 *  - el contacto se guarda al pasar la pantalla de datos, no al final: si
 *    abandona a mitad, sale en Panel → Llamadas como "No terminó";
 *  - foto de fondo con velo azul (FOTO_FONDO; vacío = sin foto, solo el
 *    fondo de la marca).
 *
 * Qué pasa al terminar: si encaja, el botón de reservar día y hora
 * (PUBLIC_AGENDA_URL o WhatsApp); si no, la guía gratis. En los dos casos la
 * escuela guarda las respuestas (Panel → Llamadas) y avisa por correo al
 * equipo. Nada se queda en el aire.
 */
import Layout from '../layouts/Layout.astro'
import { LETRAS, PREGUNTAS } from '../lib/cualificacion'

export const prerender = true

/** Foto de fondo, a la derecha, con velo. Vacío = sin foto. */
const FOTO_FONDO = ''

/**
 * El calendario de la llamada (Calendly), incrustado en la última pantalla
 * como hace ICO: texto que prepara la llamada a un lado y el calendario al
 * otro. PUBLIC_AGENDA_URL en Vercel lo cambia sin tocar código.
 */
const CALENDLY_URL = (import.meta.env.PUBLIC_AGENDA_URL as string | undefined) || 'https://calendly.com/holandesconnawar/llamada-de-consultoria'
const WHATSAPP_URL = 'https://wa.me/31616084212'

const parrafos = (t: string) => t.split(/\n\n+/).map((s) => s.trim()).filter(Boolean)
---

<Layout
  title="Agenda una llamada — Holandés Nawar"
  description="Cuéntanos en un minuto dónde estás con el neerlandés y agenda una llamada con el equipo de Holandés Nawar."
  noindex={true}
>
  <div class="ag-page">
    {FOTO_FONDO ? <div class="ag-photo" style={`background-image:url('${FOTO_FONDO}')`} aria-hidden="true"></div> : null}
    {FOTO_FONDO ? <div class="ag-veil" aria-hidden="true"></div> : null}
    <div class="ag-glow1" aria-hidden="true"></div>
    <div class="ag-glow2" aria-hidden="true"></div>
    <div class="ag-dots" aria-hidden="true"></div>

    <div class="ag-shell">
      <a href="/" class="ag-logo-link" aria-label="Volver al inicio">
        <img src="https://d1yei2z3i6k35z.cloudfront.net/9533860/671a9c9265e23_Logo_Nawar_2.png" alt="Holandés Nawar" class="ag-logo" width="150" height="38" />
      </a>

      <div class="ag-progress" aria-hidden="true"><div class="ag-progress-fill" id="ag-fill"></div></div>

      <form id="ag-form" novalidate>
        <div class="ag-honeypot" aria-hidden="true">
          <label>No rellenar <input type="text" id="ag-hp" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <!-- 0 · Qué es esto -->
        <section class="ag-pane" data-pane="intro">
          <h1 class="ag-title-sm">Tu plan para llegar al A1 en tres meses</h1>
          <p class="ag-lead">
            Esta llamada no es una demo bonita. Es un <strong>diagnóstico directo</strong> para que tomes una decisión clara:
            <strong>¿la formación de Nawar es el camino correcto para ti ahora… o no?</strong> En 15–20 minutos te damos claridad
            y un plan concreto.
          </p>
          <p class="ag-sub">Qué haremos contigo:</p>
          <ul class="ag-list">
            <li><strong>Revisar tu situación:</strong> dónde vives, tu nivel y para qué necesitas el idioma.</li>
            <li><strong>Detectar lo que te frena:</strong> los dos o tres puntos que deciden si avanzas o no.</li>
            <li><strong>Darte un plan claro:</strong> qué hacer cada semana y con qué.</li>
            <li><strong>Ver si encajas con Nawar</strong> y cómo te acompañaríamos en tu caso.</li>
          </ul>
          <p class="ag-lead">
            Así de simple: si vemos que encajas, <strong>podrás reservar tu llamada al final</strong>. Solo te pedimos
            <strong>honestidad</strong>; del resto nos encargamos nosotros.
          </p>
          <div class="ag-actions">
            <button type="button" class="ag-btn" data-go="datos">Comenzar</button>
            <span class="ag-hint">Tarda dos minutos</span>
          </div>
        </section>

        <!-- 1 · Tu contacto -->
        <section class="ag-pane" data-pane="datos" hidden>
          <h2 class="ag-q">Tu contacto</h2>
          <p class="ag-lead">Antes de continuar, necesitamos conocerte un poquito mejor.</p>
          <div class="ag-fields">
            <div class="ag-field">
              <label class="ag-label" for="first_name">Nombre <span class="ag-req">*</span></label>
              <input id="first_name" name="first_name" type="text" class="ag-input" placeholder="Juan" autocomplete="given-name" required />
            </div>
            <div class="ag-field">
              <label class="ag-label" for="last_name">Apellidos <span class="ag-req">*</span></label>
              <input id="last_name" name="last_name" type="text" class="ag-input" placeholder="García" autocomplete="family-name" />
            </div>
            <div class="ag-field">
              <label class="ag-label" for="email">Tu mejor email <span class="ag-req">*</span></label>
              <p class="ag-help">Te mandamos tu plan y el acceso. Nada de spam.</p>
              <input id="email" name="email" type="email" class="ag-input" placeholder="correo@ejemplo.com" autocomplete="email" required />
            </div>
            <div class="ag-field">
              <label class="ag-label" for="phone">Teléfono con WhatsApp <span class="ag-req">*</span></label>
              <p class="ag-help">Para confirmarte la cita y mandarte recordatorios útiles.</p>
              <input id="phone" name="phone" type="tel" class="ag-input" placeholder="+31 6 …" autocomplete="tel" required />
            </div>
          </div>
          <p class="ag-err" id="ag-err-datos">Revisa el nombre, el correo y el teléfono.</p>
          <div class="ag-actions ag-between">
            <button type="button" class="ag-btn-ghost" data-go="intro">‹ Anterior</button>
            <button type="button" class="ag-btn" data-go="q0">Aceptar ›</button>
          </div>
        </section>

        <!-- Preguntas -->
        {PREGUNTAS.map((p, i) => {
          const partes = parrafos(p.titulo)
          const pregunta = partes[partes.length - 1]
          const intro = partes.slice(0, -1)
          return (
            <section class="ag-pane" data-pane={`q${i}`} data-clave={p.clave} data-tipo={p.tipo} hidden>
              {intro.map((t) => <p class="ag-intro">{t}</p>)}
              <h2 class="ag-q">{pregunta} <span class="ag-req">*</span></h2>
              {p.ayuda ? <p class="ag-lead">{p.ayuda}</p> : null}

              {p.tipo === 'opciones' ? (
                <div class="ag-options" role="radiogroup" aria-label={pregunta}>
                  {p.opciones.map((o, j) => (
                    <button type="button" class="ag-option" data-valor={o.valor} data-letra={LETRAS[j]} role="radio" aria-checked="false">
                      <span class="ag-key" aria-hidden="true">{LETRAS[j]}</span>
                      <span>{o.texto}</span>
                    </button>
                  ))}
                </div>
              ) : p.tipo === 'escala' ? (
                <div class="ag-scale-wrap">
                  <div class="ag-scale" role="radiogroup" aria-label={pregunta}>
                    {[1, 2, 3, 4, 5].map((n) => (
                      <button type="button" class="ag-scale-btn" data-valor={String(n)} data-letra={String(n)} role="radio" aria-checked="false">{n}</button>
                    ))}
                  </div>
                  <div class="ag-scale-labels" aria-hidden="true">
                    <span>{p.extremos[0]}</span>
                    <span>{p.extremos[1]}</span>
                    <span>{p.extremos[2]}</span>
                  </div>
                </div>
              ) : (
                <div class="ag-textwrap">
                  <textarea class="ag-textarea" data-texto={p.clave} data-minimo={String(p.minimo)} rows="3" placeholder={p.placeholder ?? 'Escribe aquí…'} maxlength="800"></textarea>
                  <p class="ag-hint">Pulsa <strong>Mayús ⇧ + Intro ↵</strong> para añadir un párrafo.</p>
                </div>
              )}

              <p class="ag-err" data-err={`q${i}`}>
                {p.tipo === 'texto' ? 'Cuéntanoslo con un poco más de detalle para continuar.' : 'Elige una opción para continuar.'}
              </p>
              <div class="ag-actions ag-between">
                <button type="button" class="ag-btn-ghost" data-go={i === 0 ? 'datos' : `q${i - 1}`}>‹ Anterior</button>
                <button type="button" class="ag-btn" data-continuar={`q${i}`}>{i === PREGUNTAS.length - 1 ? 'Ver si encajo ›' : 'Aceptar ›'}</button>
              </div>
            </section>
          )
        })}

        <section class="ag-pane" data-pane="enviando" hidden>
          <h2 class="ag-q">Un segundo…</h2>
          <p class="ag-lead">Guardando tus respuestas.</p>
        </section>

        <!-- Encajas: se dice qué viene (una llamada) y se pide el compromiso de
             asistir antes de enseñar el calendario, como ICO. Un "sí" aquí
             es una cita que casi seguro se cumple; un "no" no gasta hueco. -->
        <section class="ag-pane" data-pane="encajas" hidden>
          <span class="ag-badge">Encajas</span>
          <h2 class="ag-q"><span data-nombre></span>por lo que nos cuentas, la formación es para ti.</h2>
          <p class="ag-lead">
            El siguiente paso es una <strong>llamada de 15–20 minutos</strong> con alguien del equipo: vemos tu caso,
            te damos un plan concreto y decidimos juntos si es tu momento. Después de reservar te escribimos por
            WhatsApp para confirmar la cita.
          </p>
          <div class="ag-separador" aria-hidden="true"></div>
          <p class="ag-intro">Tenemos pocos huecos de llamada a la semana, y cada uno que se queda vacío es una llamada que otra persona no ha podido tener.</p>
          <h2 class="ag-q">¿Te comprometes a asistir a la llamada que reserves? <span class="ag-req">*</span></h2>
          <div class="ag-options" role="radiogroup" aria-label="Compromiso de asistir" id="ag-compromiso">
            <button type="button" class="ag-option" data-valor="si" data-letra="A" role="radio" aria-checked="false">
              <span class="ag-key" aria-hidden="true">A</span>
              <span>Sí, entiendo y voy a asistir a la llamada</span>
            </button>
            <button type="button" class="ag-option" data-valor="no" data-letra="B" role="radio" aria-checked="false">
              <span class="ag-key" aria-hidden="true">B</span>
              <span>No, prefiero no reservar la llamada ahora</span>
            </button>
          </div>
        </section>

        <section class="ag-pane" data-pane="noreserva" hidden>
          <h2 class="ag-title-sm">Sin problema</h2>
          <p class="ag-lead">
            Cuando sea tu momento, vuelve a esta página o escríbenos por <a class="ag-enlace" href={WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp</a>.
            Mientras tanto, la guía de las bases te sirve para ir avanzando, gratis.
          </p>
          <div class="ag-actions">
            <a class="ag-btn" href="/guia/bases-neerlandes">Descargar la guía gratis ›</a>
            <button type="button" class="ag-btn-ghost" id="ag-volver-reservar">‹ Mejor sí, quiero reservar</button>
          </div>
        </section>

        <section class="ag-pane ag-pane-reserva" data-pane="apto" hidden>
          <div class="ag-reserva">
            <div class="ag-reserva-texto">
              <span class="ag-badge">Último paso</span>
              <h2 class="ag-q"><span data-nombre></span>ahora solo te queda elegir el día y la hora que mejor te vengan para tu llamada con el equipo.</h2>
              <p class="ag-lead">
                Nos tomamos en serio cada llamada: trabajamos con grupos reducidos y cada plaza cuenta. Es una
                llamada para ver tu caso y darte un plan; si solo quieres información general, la tienes en la web.
              </p>
              <p class="ag-sub">Así que asegúrate de esto:</p>
              <ul class="ag-list">
                <li>Estar en un sitio tranquilo, sin ruido y con buena conexión.</li>
                <li>Tener claro lo que nos has contado: tu nivel y para qué necesitas el idioma.</li>
                <li>Ser puntual.</li>
              </ul>
              <p class="ag-lead ag-nota">
                Si te surge algo y no puedes, avísanos cuanto antes por
                <a href={WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp</a>.
              </p>
            </div>
            <div class="ag-calendario" id="ag-calendario" data-url={CALENDLY_URL}>
              <div class="ag-cal-barra">
                <span>Elige día y hora</span>
                <button type="button" class="ag-cal-cerrar" id="ag-cal-cerrar" aria-label="Cerrar el calendario">×</button>
              </div>
              <div class="ag-calendario-caja" id="ag-calendly"></div>
              <p class="ag-cal-alt">¿No ves el calendario? <a id="ag-agenda" href={CALENDLY_URL} target="_blank" rel="noopener">Ábrelo aquí</a></p>
            </div>
          </div>
        </section>

        <section class="ag-pane" data-pane="reservada" hidden>
          <span class="ag-badge">Llamada reservada</span>
          <h2 class="ag-title-sm">¡Hecho! Nos vemos en la llamada</h2>
          <p class="ag-lead">Te acaba de llegar un correo con el día, la hora y el enlace. Si necesitas cambiarla, en ese mismo correo tienes el botón para hacerlo.</p>
        </section>

        <section class="ag-pane" data-pane="noapto" hidden>
          <h2 class="ag-title-sm">Gracias por contarnos</h2>
          <p class="ag-lead">Ahora mismo la formación no es lo que más te ayuda: es un camino de tres meses con clases en vivo, y pide un momento que ahora mismo no es el tuyo. Lo que sí te sirve ya es la guía de las bases, gratis. Cuando sea el momento, aquí estamos.</p>
          <div class="ag-actions">
            <a class="ag-btn" href="/guia/bases-neerlandes">Descargar la guía gratis ›</a>
          </div>
        </section>

        <p class="ag-err" id="ag-err-envio">No se pudo enviar. Vuelve a intentarlo en un momento.</p>
      </form>

      <p class="ag-legal">Al continuar aceptas la <a href="/politica-de-privacidad">política de privacidad</a>.</p>
    </div>
  </div>
</Layout>

<script>
  import { leerUTM, guardarUTM } from '../lib/utm'
  import { contextoDelLead } from '../lib/recorrido'
  guardarUTM()

  const form = document.getElementById('ag-form') as HTMLFormElement
  const panes = Array.from(form.querySelectorAll<HTMLElement>('.ag-pane'))
  const preguntas = panes.filter((p) => p.dataset.clave)
  const fill = document.getElementById('ag-fill') as HTMLElement
  const respuestas: Record<string, string> = {}
  const textos: Record<string, string> = {}
  // La línea: intro 0 %, datos un tramo, y cada pregunta otro.
  const tramos = preguntas.length + 1
  let actual = 'intro'
  let saltando: number | null = null

  const mostrar = (id: string) => {
    if (saltando) { clearTimeout(saltando); saltando = null }
    actual = id
    panes.forEach((p) => { p.hidden = p.dataset.pane !== id })
    let hecho = 0
    if (id === 'datos') hecho = 0.5
    else if (id.startsWith('q')) hecho = 1 + Number(id.slice(1))
    else if (['enviando', 'encajas', 'noreserva', 'apto', 'noapto', 'reservada'].includes(id)) hecho = tramos
    fill.style.width = `${Math.min(100, Math.round((hecho / tramos) * 100))}%`
    window.scrollTo({ top: 0, behavior: 'smooth' })
    // La pregunta abierta: el cursor ya dentro, sin tener que tocar.
    const pane = panes.find((p) => p.dataset.pane === id)
    const area = pane?.querySelector<HTMLTextAreaElement>('.ag-textarea')
    if (area) setTimeout(() => area.focus(), 60)
  }

  const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim()
  const datosOk = () => {
    const ok = val('first_name').length > 0 && /\S+@\S+\.\S+/.test(val('email')) && val('phone').replace(/\D/g, '').length >= 7
    ;(document.getElementById('ag-err-datos') as HTMLElement).classList.toggle('visible', !ok)
    return ok
  }

  form.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) => {
    b.addEventListener('click', () => {
      const destino = b.dataset.go as string
      if (destino === 'q0') {
        if (!datosOk()) return
        guardarParcial()
      }
      mostrar(destino)
    })
  })

  // En cuanto deja sus datos, la escuela ya lo sabe: si cierra a mitad, sale
  // en Panel → Llamadas como "No terminó" y se le puede escribir. Una vez por
  // correo (si vuelve atrás y lo cambia, se manda otra vez). Sin esperar la
  // respuesta: la persona no nota nada, y keepalive lo deja salir aunque
  // cierre la pestaña justo después.
  let parcialEnviado = ''
  const guardarParcial = () => {
    const email = val('email').toLowerCase()
    if (!email || email === parcialEnviado) return
    parcialEnviado = email
    try {
      fetch('/api/cualificacion', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        keepalive: true,
        body: JSON.stringify({
          parcial: true,
          first_name: val('first_name'),
          last_name: val('last_name'),
          email,
          phone: val('phone'),
          website: (document.getElementById('ag-hp') as HTMLInputElement).value,
          ...contextoDelLead(),
        }),
      }).catch(() => {})
    } catch {}
  }

  const indice = (pane: HTMLElement) => Number((pane.dataset.pane as string).slice(1))
  const siguiente = async (pane: HTMLElement) => {
    const i = indice(pane)
    if (i + 1 < preguntas.length) mostrar(`q${i + 1}`)
    else await enviar()
  }

  /** Elegir una opción (o un punto de la escala): se marca y, tras un
   *  respiro para verla marcada, pasa sola a la siguiente. Como Typeform. */
  const elegir = (pane: HTMLElement, btn: HTMLButtonElement) => {
    pane.querySelectorAll('[role="radio"]').forEach((b) => b.setAttribute('aria-checked', 'false'))
    btn.setAttribute('aria-checked', 'true')
    respuestas[pane.dataset.clave as string] = btn.dataset.valor as string
    pane.querySelector('[data-err]')?.classList.remove('visible')
    if (saltando) clearTimeout(saltando)
    saltando = window.setTimeout(() => { saltando = null; siguiente(pane) }, 420)
  }

  preguntas.forEach((pane) => {
    pane.querySelectorAll<HTMLButtonElement>('[role="radio"]').forEach((btn) => {
      btn.addEventListener('click', () => elegir(pane, btn))
    })
    const area = pane.querySelector<HTMLTextAreaElement>('.ag-textarea')
    if (area) {
      area.addEventListener('input', () => {
        textos[pane.dataset.clave as string] = area.value
        if (area.value.trim().length >= Number(area.dataset.minimo || 0)) pane.querySelector('[data-err]')?.classList.remove('visible')
      })
      // Intro = continuar; Mayús+Intro = párrafo nuevo (como Typeform).
      area.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); continuar(pane) }
      })
    }
  })

  const completa = (pane: HTMLElement) => {
    const area = pane.querySelector<HTMLTextAreaElement>('.ag-textarea')
    if (area) return area.value.trim().length >= Number(area.dataset.minimo || 0)
    return Boolean(respuestas[pane.dataset.clave as string])
  }

  const continuar = async (pane: HTMLElement) => {
    if (!completa(pane)) {
      pane.querySelector('[data-err]')?.classList.add('visible')
      return
    }
    await siguiente(pane)
  }

  form.querySelectorAll<HTMLButtonElement>('[data-continuar]').forEach((b) => {
    b.addEventListener('click', () => {
      const pane = panes.find((p) => p.dataset.pane === b.dataset.continuar) as HTMLElement
      continuar(pane)
    })
  })

  // Teclado: la letra elige la opción (o el número, en la escala); Intro
  // continúa. Solo en las preguntas, y nunca mientras se escribe en un campo.
  document.addEventListener('keydown', (e) => {
    if (actual === 'encajas' && !e.metaKey && !e.ctrlKey && !e.altKey) {
      const b = compromiso.querySelector<HTMLElement>(`[data-letra="${e.key.toUpperCase()}"]`)
      if (b) { e.preventDefault(); responderCompromiso(b) }
      return
    }
    if (!actual.startsWith('q')) return
    const objetivo = e.target as HTMLElement | null
    if (objetivo && (objetivo.tagName === 'INPUT' || objetivo.tagName === 'TEXTAREA')) return
    const pane = panes.find((p) => p.dataset.pane === actual) as HTMLElement
    if (e.key === 'Enter') { e.preventDefault(); continuar(pane); return }
    const tecla = e.key.toUpperCase()
    const btn = pane.querySelector<HTMLButtonElement>(`[role="radio"][data-letra="${tecla}"]`)
    if (btn && !e.metaKey && !e.ctrlKey && !e.altKey) { e.preventDefault(); elegir(pane, btn) }
  })

  // ── La reserva, con el calendario de Calendly dentro de la página ──────
  // El script de Calendly se carga solo aquí, al llegar a esta pantalla: los
  // que no encajan nunca lo descargan.
  const calendario = document.getElementById('ag-calendario') as HTMLElement
  const cajaCal = document.getElementById('ag-calendly') as HTMLElement
  let calendlyPuesto = false

  const cargarScript = () =>
    new Promise<void>((ok, mal) => {
      if ((window as any).Calendly) return ok()
      const sc = document.createElement('script')
      sc.src = 'https://assets.calendly.com/assets/external/widget.js'
      sc.async = true
      sc.onload = () => ok()
      sc.onerror = () => mal(new Error('calendly'))
      document.head.appendChild(sc)
    })

  const ponerCalendario = async () => {
    if (calendlyPuesto) return
    calendlyPuesto = true
    const base = calendario.dataset.url as string
    const nombre = `${val('first_name')} ${val('last_name')}`.trim()
    // Colores de la marca (Calendly los aplica si el plan lo permite; si no,
    // los ignora sin romper nada) y sin el aviso de cookies encima.
    const url = `${base}${base.includes('?') ? '&' : '?'}hide_gdpr_banner=1&primary_color=1d0084`
    try {
      await cargarScript()
      ;(window as any).Calendly.initInlineWidget({
        url,
        parentElement: cajaCal,
        prefill: { name: nombre, email: val('email').toLowerCase() },
        resize: true,
      })
    } catch {
      // Si el script no carga (bloqueador, red), queda el enlace de debajo.
      calendario.classList.add('ag-cal-fallo')
    }
  }

  const esEscritorio = () => window.matchMedia('(min-width: 900px)').matches
  const compromiso = document.getElementById('ag-compromiso') as HTMLElement

  // Encaja → primero la pantalla "Encajas" con el compromiso de asistir.
  const abrirReserva = () => {
    const nombre = val('first_name')
    document.querySelectorAll<HTMLElement>('[data-nombre]').forEach((el) => { el.textContent = nombre ? `${nombre}, ` : '' })
    compromiso.querySelectorAll('[role="radio"]').forEach((b) => b.setAttribute('aria-checked', 'false'))
    mostrar('encajas')
  }

  // "Sí, voy a asistir" → el calendario. En el ordenador, media página con el
  // texto al lado. En el móvil, a pantalla completa con una X para volver.
  const irAlCalendario = () => {
    mostrar('apto')
    calendario.classList.add('abierto')
    if (esEscritorio()) document.body.classList.add('ag-ancho')
    else document.body.classList.add('ag-cal-movil')
    ponerCalendario()
  }

  const cerrarCalendario = () => {
    calendario.classList.remove('abierto')
    document.body.classList.remove('ag-cal-movil', 'ag-ancho')
    abrirReserva()
  }

  const responderCompromiso = (btn: HTMLElement) => {
    compromiso.querySelectorAll('[role="radio"]').forEach((b) => b.setAttribute('aria-checked', 'false'))
    btn.setAttribute('aria-checked', 'true')
    setTimeout(() => (btn.dataset.valor === 'si' ? irAlCalendario() : mostrar('noreserva')), 380)
  }

  compromiso.querySelectorAll<HTMLElement>('[role="radio"]').forEach((b) => b.addEventListener('click', () => responderCompromiso(b)))
  document.getElementById('ag-cal-cerrar')?.addEventListener('click', cerrarCalendario)
  document.getElementById('ag-volver-reservar')?.addEventListener('click', abrirReserva)

  // Cuando reserva, Calendly avisa a la página. Se apunta en la escuela para
  // que en Panel → Llamadas salga "Hora reservada", y se da las gracias.
  window.addEventListener('message', (e) => {
    if (e.origin !== 'https://calendly.com') return
    const d = (e as MessageEvent).data
    if (!d || d.event !== 'calendly.event_scheduled') return
    fetch('/api/cualificacion', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      keepalive: true,
      body: JSON.stringify({
        reservada: true,
        first_name: val('first_name'),
        last_name: val('last_name'),
        email: val('email').toLowerCase(),
        phone: val('phone'),
        calendly_evento: d.payload?.event?.uri ?? '',
      }),
    }).catch(() => {})
    setTimeout(() => {
      calendario.classList.remove('abierto')
      document.body.classList.remove('ag-ancho', 'ag-cal-movil')
      mostrar('reservada')
    }, 1800)
  })

  async function enviar() {
    mostrar('enviando')
    const errEnvio = document.getElementById('ag-err-envio') as HTMLElement
    errEnvio.classList.remove('visible')
    try {
      const res = await fetch('/api/cualificacion', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          first_name: val('first_name'),
          last_name: val('last_name'),
          email: val('email').toLowerCase(),
          phone: val('phone'),
          website: (document.getElementById('ag-hp') as HTMLInputElement).value,
          respuestas,
          textos,
          ...leerUTM(),
          ...contextoDelLead(),
        }),
      })
      const data = await res.json().catch(() => null)
      if (!res.ok || !data?.ok) throw new Error('no ok')
      if (data.apto) {
        abrirReserva()
      } else {
        mostrar('noapto')
      }
    } catch {
      errEnvio.classList.add('visible')
      mostrar(`q${preguntas.length - 1}`)
    }
  }
</script>

<style>
  .ag-page {
