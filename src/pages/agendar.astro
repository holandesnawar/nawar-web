---
/**
 * /agendar — pedir una llamada, pasando antes por la cualificación.
 *
 * Pantalla 0: qué es la llamada y qué vamos a hacer (que la persona sepa a
 * qué viene antes de dar sus datos). Pantalla 1: nombre, correo y WhatsApp.
 * Después, una pregunta por pantalla (nivel, situación, motivo, cuándo,
 * horas, disponibilidad económica), con "Continuar". Al final, según la
 * nota que calcula el servidor: el botón para agendar o la guía gratis.
 *
 * Por qué filtrar: la llamada es lo más caro de la escuela (tiempo de una
 * persona). A ella llegan los que tienen el nivel, el momento y la
 * disposición; los demás reciben lo que les sirve ahora, sin sentirse
 * rechazados. Preguntas y puntos: src/lib/cualificacion.ts.
 *
 * Diseño (pedido 22/09, con UDIA de referencia): solo la línea de progreso,
 * sin "paso X de N"; cajas de respuesta de cristal, no azules; la pregunta
 * del dinero sin cifra. El precio se cuenta en la llamada.
 */
import Layout from '../layouts/Layout.astro'
import { PREGUNTAS } from '../lib/cualificacion'

export const prerender = true
---

<Layout
  title="Agenda una llamada — Holandés Nawar"
  description="Cuéntanos en un minuto dónde estás con el neerlandés y agenda una llamada con el equipo de Holandés Nawar."
  noindex={true}
>
  <div class="ag-page">
    <div class="ag-glow1" aria-hidden="true"></div>
    <div class="ag-glow2" aria-hidden="true"></div>
    <div class="ag-dots" aria-hidden="true"></div>

    <div class="ag-shell">
      <a href="/" class="ag-logo-link" aria-label="Volver al inicio">
        <img src="https://d1yei2z3i6k35z.cloudfront.net/9533860/671a9c9265e23_Logo_Nawar_2.png" alt="Holandés Nawar" class="ag-logo" width="150" height="38" />
      </a>

      <div class="ag-progress" aria-hidden="true"><div class="ag-progress-fill" id="ag-fill"></div></div>

      <form id="ag-form" novalidate>
        <div class="ag-honeypot" aria-hidden="true">
          <label>No rellenar <input type="text" id="ag-hp" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <!-- 0 · Qué es esto -->
        <section class="ag-pane" data-pane="intro">
          <h1 class="ag-title-sm">Tu plan para llegar al A1 en tres meses</h1>
          <p class="ag-lead">
            Esta llamada no es una demo bonita. Es un <strong>diagnóstico directo</strong> para que tomes una decisión clara:
            <strong>¿la formación de Nawar es el camino correcto para ti ahora… o no?</strong> En 15–20 minutos te damos claridad
            y un plan concreto.
          </p>
          <p class="ag-sub">Qué haremos contigo:</p>
          <ul class="ag-list">
            <li><strong>Revisar tu situación:</strong> dónde vives, tu nivel y para qué necesitas el idioma.</li>
            <li><strong>Detectar lo que te frena:</strong> los dos o tres puntos que deciden si avanzas o no.</li>
            <li><strong>Darte un plan claro:</strong> qué hacer cada semana y con qué.</li>
            <li><strong>Ver si encajas con Nawar</strong> y cómo te acompañaríamos en tu caso.</li>
          </ul>
          <p class="ag-lead">
            Así de simple: si vemos que encajas, <strong>podrás reservar tu llamada al final</strong>. Solo te pedimos
            <strong>honestidad</strong>; del resto nos encargamos nosotros.
          </p>
          <div class="ag-actions">
            <button type="button" class="ag-btn" data-go="datos">Comenzar</button>
          </div>
        </section>

        <!-- 1 · Tu contacto -->
        <section class="ag-pane" data-pane="datos" hidden>
          <h2 class="ag-q ag-center">Tu contacto</h2>
          <p class="ag-lead ag-center">Antes de continuar, necesitamos conocerte un poquito mejor.</p>
          <div class="ag-fields">
            <div class="ag-field">
              <label class="ag-label" for="first_name">Nombre <span class="ag-req">*</span></label>
              <input id="first_name" name="first_name" type="text" class="ag-input" placeholder="Juan" autocomplete="given-name" required />
            </div>
            <div class="ag-field">
              <label class="ag-label" for="last_name">Apellidos <span class="ag-req">*</span></label>
              <input id="last_name" name="last_name" type="text" class="ag-input" placeholder="García" autocomplete="family-name" />
            </div>
            <div class="ag-field">
              <label class="ag-label" for="email">Tu mejor email <span class="ag-req">*</span></label>
              <p class="ag-help">Te mandamos tu plan y el acceso. Nada de spam.</p>
              <input id="email" name="email" type="email" class="ag-input" placeholder="correo@ejemplo.com" autocomplete="email" required />
            </div>
            <div class="ag-field">
              <label class="ag-label" for="phone">Teléfono con WhatsApp <span class="ag-req">*</span></label>
              <p class="ag-help">Para confirmarte la cita y mandarte recordatorios útiles.</p>
              <input id="phone" name="phone" type="tel" class="ag-input" placeholder="+31 6 …" autocomplete="tel" required />
            </div>
          </div>
          <p class="ag-err" id="ag-err-datos">Revisa el nombre, el correo y el teléfono.</p>
          <div class="ag-actions ag-between">
            <button type="button" class="ag-btn-ghost" data-go="intro">‹ Anterior</button>
            <button type="button" class="ag-btn" data-go="q0">Continuar ›</button>
          </div>
        </section>

        <!-- Preguntas -->
        {PREGUNTAS.map((p, i) => (
          <section class="ag-pane" data-pane={`q${i}`} data-clave={p.clave} hidden>
            <h2 class="ag-q ag-center">{p.titulo} <span class="ag-req">*</span></h2>
            {p.ayuda ? <p class="ag-lead ag-center">{p.ayuda}</p> : null}
            <div class="ag-options" role="radiogroup" aria-label={p.titulo}>
              {p.opciones.map((o) => (
                <button type="button" class="ag-option" data-valor={o.valor} role="radio" aria-checked="false">
                  <span class="ag-option-dot" aria-hidden="true"></span>
                  <span>{o.texto}</span>
                </button>
              ))}
            </div>
            <p class="ag-err" data-err={`q${i}`}>Elige una opción para continuar.</p>
            <div class="ag-actions ag-between">
              <button type="button" class="ag-btn-ghost" data-go={i === 0 ? 'datos' : `q${i - 1}`}>‹ Anterior</button>
              <button type="button" class="ag-btn" data-continuar={`q${i}`}>{i === PREGUNTAS.length - 1 ? 'Ver si encajo ›' : 'Continuar ›'}</button>
            </div>
          </section>
        ))}

        <section class="ag-pane" data-pane="enviando" hidden>
          <h2 class="ag-q ag-center">Un segundo…</h2>
          <p class="ag-lead ag-center">Guardando tus respuestas.</p>
        </section>

        <section class="ag-pane" data-pane="apto" hidden>
          <span class="ag-badge">Encajas</span>
          <h2 class="ag-title-sm">Reserva tu llamada</h2>
          <p class="ag-lead">Por lo que cuentas, la formación es para ti. Elige un hueco y hablamos: quince o veinte minutos, sin compromiso, para ver cómo llegar al A1 desde donde estás.</p>
          <div class="ag-actions">
            <a id="ag-agenda" class="ag-btn" href="#" target="_blank" rel="noopener">Elegir día y hora ›</a>
          </div>
        </section>

        <section class="ag-pane" data-pane="noapto" hidden>
          <h2 class="ag-title-sm">Gracias por contarnos</h2>
          <p class="ag-lead">Ahora mismo la formación no es lo que más te ayuda: es un camino de tres meses con clases en vivo, y pide un momento y unas horas que hoy no tienes. Lo que sí te sirve ya es la guía de las bases, gratis. Cuando sea el momento, aquí estamos.</p>
          <div class="ag-actions">
            <a class="ag-btn" href="/guia/bases-neerlandes">Descargar la guía gratis ›</a>
          </div>
        </section>

        <p class="ag-err" id="ag-err-envio">No se pudo enviar. Vuelve a intentarlo en un momento.</p>
      </form>

      <p class="ag-legal">Al continuar aceptas la <a href="/politica-de-privacidad">política de privacidad</a>.</p>
    </div>
  </div>
</Layout>

<script>
  import { leerUTM, guardarUTM } from '../lib/utm'
  import { contextoDelLead } from '../lib/recorrido'
  guardarUTM()

  const form = document.getElementById('ag-form') as HTMLFormElement
  const panes = Array.from(form.querySelectorAll<HTMLElement>('.ag-pane'))
  const preguntas = panes.filter((p) => p.dataset.clave)
  const fill = document.getElementById('ag-fill') as HTMLElement
  const respuestas: Record<string, string> = {}
  // La línea: intro 0 %, datos un tramo, y cada pregunta otro.
  const tramos = preguntas.length + 1

  const mostrar = (id: string) => {
    panes.forEach((p) => { p.hidden = p.dataset.pane !== id })
    let hecho = 0
    if (id === 'datos') hecho = 0.5
    else if (id.startsWith('q')) hecho = 1 + Number(id.slice(1))
    else if (id === 'enviando' || id === 'apto' || id === 'noapto') hecho = tramos
    fill.style.width = `${Math.min(100, Math.round((hecho / tramos) * 100))}%`
    window.scrollTo({ top: 0, behavior: 'smooth' })
  }

  const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim()
  const datosOk = () => {
    const ok = val('first_name').length > 0 && /\S+@\S+\.\S+/.test(val('email')) && val('phone').replace(/\D/g, '').length >= 7
    ;(document.getElementById('ag-err-datos') as HTMLElement).classList.toggle('visible', !ok)
    return ok
  }

  form.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) => {
    b.addEventListener('click', () => {
      const destino = b.dataset.go as string
      if (destino === 'q0' && !datosOk()) return
      mostrar(destino)
    })
  })

  preguntas.forEach((pane) => {
    pane.querySelectorAll<HTMLButtonElement>('.ag-option').forEach((btn) => {
      btn.addEventListener('click', () => {
        pane.querySelectorAll('.ag-option').forEach((b) => b.setAttribute('aria-checked', 'false'))
        btn.setAttribute('aria-checked', 'true')
        respuestas[pane.dataset.clave as string] = btn.dataset.valor as string
        pane.querySelector('[data-err]')?.classList.remove('visible')
      })
    })
  })

  form.querySelectorAll<HTMLButtonElement>('[data-continuar]').forEach((b) => {
    b.addEventListener('click', async () => {
      const id = b.dataset.continuar as string
      const pane = panes.find((p) => p.dataset.pane === id) as HTMLElement
      if (!respuestas[pane.dataset.clave as string]) {
        pane.querySelector('[data-err]')?.classList.add('visible')
        return
      }
      const i = Number(id.slice(1))
      if (i + 1 < preguntas.length) mostrar(`q${i + 1}`)
      else await enviar()
    })
  })

  async function enviar() {
    mostrar('enviando')
    const errEnvio = document.getElementById('ag-err-envio') as HTMLElement
    errEnvio.classList.remove('visible')
    try {
      const res = await fetch('/api/cualificacion', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          first_name: val('first_name'),
          last_name: val('last_name'),
          email: val('email').toLowerCase(),
          phone: val('phone'),
          website: (document.getElementById('ag-hp') as HTMLInputElement).value,
          respuestas,
          ...leerUTM(),
          ...contextoDelLead(),
        }),
      })
      const data = await res.json().catch(() => null)
      if (!res.ok || !data?.ok) throw new Error('no ok')
      if (data.apto) {
        ;(document.getElementById('ag-agenda') as HTMLAnchorElement).href = data.agenda_url
        mostrar('apto')
      } else {
        mostrar('noapto')
      }
    } catch {
      errEnvio.classList.add('visible')
      mostrar(`q${preguntas.length - 1}`)
    }
  }
</script>

<style>
  .ag-page {
    min-height: 100vh; background: #1D0084; position: relative; overflow: hidden;
    display: flex; align-items: flex-start; justify-content: center; padding: 52px 32px 96px;
  }
  .ag-glow1 { position: absolute; top: -140px; left: 50%; transform: translateX(-50%); width: 960px; height: 560px; background: radial-gradient(ellipse at center, rgba(11,109,240,0.5) 0%, transparent 65%); pointer-events: none; }
  .ag-glow2 { position: absolute; bottom: -60px; right: -80px; width: 600px; height: 400px; background: radial-gradient(ellipse at center, rgba(77,163,255,0.16) 0%, transparent 65%); pointer-events: none; }
  .ag-dots { position: absolute; inset: 0; pointer-events: none; opacity: 0.4; background-image: radial-gradient(circle, rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 28px 28px; }
  .ag-shell { position: relative; z-index: 1; width: 100%; max-width: 640px; display: flex; flex-direction: column; align-items: flex-start; color: #fff; }
  .ag-logo-link { display: inline-block; margin-bottom: 32px; }
  .ag-logo { height: 38px; width: auto; object-fit: contain; }

  /* Solo la línea. Sin "paso X de N": la línea ya lo dice. */
  .ag-progress { width: 100%; height: 4px; border-radius: 9999px; background: rgba(255,255,255,0.14); overflow: hidden; margin-bottom: 36px; }
  .ag-progress-fill { height: 100%; width: 0%; background: #4da3ff; border-radius: 9999px; transition: width .35s ease; }

  .ag-badge { display: inline-flex; padding: 6px 16px; border-radius: 9999px; background: #025dc7; color: #e0f2ff; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 10px; }
  .ag-title-sm { font-family: var(--font-poppins), system-ui, sans-serif; font-size: clamp(26px, 3.8vw, 36px); font-weight: 700; letter-spacing: -0.03em; line-height: 1.15; margin: 0 0 8px; }
  .ag-q { font-family: var(--font-poppins), system-ui, sans-serif; font-size: clamp(24px, 3.4vw, 32px); font-weight: 700; letter-spacing: -0.03em; line-height: 1.15; margin: 0; }
  .ag-center { text-align: center; width: 100%; }
  .ag-lead { font-size: clamp(15px, 1.5vw, 17px); line-height: 1.65; color: rgba(255,255,255,0.78); margin: 14px 0 0; }
  .ag-lead strong { color: #fff; font-weight: 600; }
  .ag-sub { font-size: 16px; font-weight: 700; margin: 22px 0 8px; }
  .ag-list { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 15.5px; line-height: 1.55; color: rgba(255,255,255,0.78); }
  .ag-list strong { color: #fff; font-weight: 600; }
  .ag-req { color: #ff8a8a; font-weight: 500; }

  /* El formulario es hijo de una columna flex con align-items:flex-start:
     sin ancho, se encogía al contenido y en escritorio las preguntas
     salían pegadas a la izquierda, con el título "centrado" respecto a
     una caja de 400 px. En móvil no se notaba porque el contenido ya
     llenaba el ancho. */
  #ag-form { width: 100%; }
  .ag-pane { width: 100%; }
  .ag-honeypot { position: absolute !important; left: -10000px !important; width: 1px !important; height: 1px !important; overflow: hidden !important; opacity: 0 !important; pointer-events: none !important; }
  .ag-fields { display: flex; flex-direction: column; gap: 22px; margin-top: 32px; }
  .ag-field { display: flex; flex-direction: column; gap: 6px; }
  .ag-label { font-size: 15px; font-weight: 600; }
  .ag-help { margin: 0; font-size: 13px; color: rgba(255,255,255,0.55); }
  /* Cajas de cristal, como las respuestas. */
  .ag-input {
    width: 100%; padding: 15px 18px; border-radius: 12px; color: #fff; font-size: 16px; font-family: inherit; outline: none;
    /* Cristal: tinte azul oscuro (el #0a1656 de la marca) con un brillo
       diagonal encima. Blanco al 5 % sobre este fondo salía lila; el azul
       más oscuro que el fondo enfría y se lee como vidrio. Misma receta que
       las tarjetas del home. */
    background:
      linear-gradient(135deg, rgba(255,255,255,0.09) 0%, rgba(255,255,255,0.02) 60%, rgba(255,255,255,0.05) 100%),
      rgba(10, 22, 86, 0.34);
    border: 1.5px solid rgba(255,255,255,0.26);
    -webkit-backdrop-filter: saturate(100%) blur(16px); backdrop-filter: saturate(100%) blur(16px);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.18), 0 8px 24px rgba(3,9,33,0.25);
    transition: border-color .15s, background .15s;
  }
  .ag-input::placeholder { color: rgba(255,255,255,0.35); }
  .ag-input:focus { border-color: rgba(255,255,255,0.75); }

  .ag-options { display: flex; flex-direction: column; gap: 12px; margin-top: 28px; }
  .ag-option {
    display: flex; align-items: center; gap: 14px; width: 100%; text-align: left;
    padding: 16px 18px; border-radius: 12px; cursor: pointer; font-family: inherit;
    background:
      linear-gradient(135deg, rgba(255,255,255,0.09) 0%, rgba(255,255,255,0.02) 60%, rgba(255,255,255,0.05) 100%),
      rgba(10, 22, 86, 0.34);
    border: 1.5px solid rgba(255,255,255,0.26);
    -webkit-backdrop-filter: saturate(100%) blur(16px); backdrop-filter: saturate(100%) blur(16px);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.18), 0 8px 24px rgba(3,9,33,0.25);
    color: #fff; font-size: 16px; font-weight: 500; line-height: 1.4; transition: background .15s, border-color .15s;
  }
  .ag-option:hover { border-color: rgba(255,255,255,0.45); }
  .ag-option[aria-checked="true"] {
    background:
      linear-gradient(135deg, rgba(255,255,255,0.14) 0%, rgba(255,255,255,0.05) 60%, rgba(255,255,255,0.08) 100%),
      rgba(10, 22, 86, 0.34);
    border-color: rgba(255,255,255,0.9);
  }
  .ag-option-dot { width: 20px; height: 20px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.45); flex-shrink: 0; }
  .ag-option[aria-checked="true"] .ag-option-dot { border-color: #fff; background: #fff; box-shadow: inset 0 0 0 4px #1D0084; }

  .ag-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 32px; }
  .ag-between { justify-content: space-between; }
  .ag-btn { display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 15px 30px; border-radius: 12px; border: none; cursor: pointer; background: #fff; color: #1D0084; font-size: 16px; font-weight: 700; font-family: inherit; text-decoration: none; transition: background .15s; }
  .ag-btn:hover { background: #e9efff; }
  .ag-btn-ghost { background: transparent; border: none; color: rgba(255,255,255,0.7); font-size: 15px; font-weight: 600; cursor: pointer; font-family: inherit; padding: 8px 0; }
  .ag-btn-ghost:hover { color: #fff; }
  .ag-err { display: none; margin-top: 14px; font-size: 13px; color: #ff8a8a; font-weight: 500; }
  .ag-err.visible { display: block; }
  .ag-legal { width: 100%; text-align: center; font-size: 12px; line-height: 1.6; color: rgba(255,255,255,0.4); margin: 40px 0 0; }
  .ag-legal a { color: rgba(255,255,255,0.6); text-decoration: underline; }

  @media (max-width: 640px) {
    .ag-page { padding: 28px 20px 72px; }
    .ag-btn { flex: 1; }
  }
</style>
