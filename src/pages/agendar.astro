---
/**
 * /agendar — pedir una llamada, pasando antes por la cualificación.
 *
 * Paso 1: nombre, correo y teléfono. Pasos 2-7: una pregunta por pantalla
 * (nivel, situación, motivo, cuándo, horas, disposición a invertir). Al
 * final, según la nota que calcula el servidor: o el botón para agendar la
 * llamada, o la guía gratis y "cuando sea el momento, aquí estamos".
 *
 * Por qué filtrar: la llamada es lo más caro que tiene la escuela (tiempo de
 * una persona). A ella llegan los que tienen el nivel, el momento y la
 * disposición; los demás reciben lo que les sirve ahora, sin sentirse
 * rechazados. Las preguntas y los puntos están en src/lib/cualificacion.ts.
 *
 * Diseño: el mismo de la matrícula (azul, sin tarjeta, una cosa por
 * pantalla). Dónde enlazarla lo decide el administrador; está en el mapa de
 * Panel → Webs.
 */
import Layout from '../layouts/Layout.astro'
import { PREGUNTAS } from '../lib/cualificacion'

export const prerender = true
---

<Layout
  title="Agenda una llamada — Holandés Nawar"
  description="Cuéntanos en un minuto dónde estás con el neerlandés y agenda una llamada con el equipo de Holandés Nawar."
  noindex={true}
>
  <div class="ag-page">
    <div class="ag-glow1" aria-hidden="true"></div>
    <div class="ag-glow2" aria-hidden="true"></div>
    <div class="ag-dots" aria-hidden="true"></div>

    <div class="ag-shell">
      <a href="/" class="ag-logo-link" aria-label="Volver al inicio">
        <img src="https://d1yei2z3i6k35z.cloudfront.net/9533860/671a9c9265e23_Logo_Nawar_2.png" alt="Holandés Nawar" class="ag-logo" width="150" height="38" />
      </a>

      <div class="ag-progress" aria-hidden="true"><div class="ag-progress-fill" id="ag-fill"></div></div>
      <p class="ag-step" id="ag-step">Paso 1 de {PREGUNTAS.length + 1}</p>

      <form id="ag-form" novalidate>
        <div class="ag-honeypot" aria-hidden="true">
          <label>No rellenar <input type="text" id="ag-hp" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <!-- Paso 1: datos -->
        <section class="ag-pane" data-pane="0">
          <h1 class="ag-title"><span class="ag-title-gradient">Hablemos de tu neerlandés</span></h1>
          <p class="ag-lead">Un minuto: tus datos y seis preguntas. Al final, la llamada.</p>
          <div class="ag-fields">
            <div class="ag-row">
              <div class="ag-field">
                <label class="ag-label" for="first_name">Nombre</label>
                <input id="first_name" name="first_name" type="text" class="ag-input" placeholder="Tu nombre" autocomplete="given-name" required />
              </div>
              <div class="ag-field">
                <label class="ag-label" for="last_name">Apellidos</label>
                <input id="last_name" name="last_name" type="text" class="ag-input" placeholder="Tus apellidos" autocomplete="family-name" />
              </div>
            </div>
            <div class="ag-row">
              <div class="ag-field">
                <label class="ag-label" for="email">Correo electrónico</label>
                <input id="email" name="email" type="email" class="ag-input" placeholder="tu@email.com" autocomplete="email" required />
              </div>
              <div class="ag-field">
                <label class="ag-label" for="phone">Teléfono (con prefijo)</label>
                <input id="phone" name="phone" type="tel" class="ag-input" placeholder="+31 6 …" autocomplete="tel" required />
              </div>
            </div>
          </div>
          <p class="ag-err" id="ag-err-datos">Revisa el nombre, el correo y el teléfono.</p>
          <div class="ag-actions">
            <button type="button" class="ag-btn" data-next>Empezar →</button>
          </div>
        </section>

        <!-- Pasos 2..N: una pregunta por pantalla -->
        {PREGUNTAS.map((p, i) => (
          <section class="ag-pane" data-pane={i + 1} data-clave={p.clave} hidden>
            <h2 class="ag-q">{p.titulo}</h2>
            {p.ayuda ? <p class="ag-lead">{p.ayuda}</p> : null}
            <div class="ag-options" role="radiogroup" aria-label={p.titulo}>
              {p.opciones.map((o) => (
                <button type="button" class="ag-option" data-valor={o.valor} role="radio" aria-checked="false">
                  <span class="ag-option-dot" aria-hidden="true"></span>
                  <span>{o.texto}</span>
                </button>
              ))}
            </div>
            <div class="ag-actions">
              <button type="button" class="ag-btn-ghost" data-prev>← Atrás</button>
            </div>
          </section>
        ))}

        <!-- Enviando -->
        <section class="ag-pane" data-pane="enviando" hidden>
          <h2 class="ag-q">Un segundo…</h2>
          <p class="ag-lead">Guardando tus respuestas.</p>
        </section>

        <!-- Final: apto -->
        <section class="ag-pane" data-pane="apto" hidden>
          <span class="ag-badge">Encajas</span>
          <h2 class="ag-title"><span class="ag-title-gradient">Agenda tu llamada</span></h2>
          <p class="ag-lead">Por lo que cuentas, la formación es para ti. Elige un hueco y hablamos: veinte minutos, sin compromiso, para ver cómo llegar al A1 desde donde estás.</p>
          <div class="ag-actions">
            <a id="ag-agenda" class="ag-btn" href="#" target="_blank" rel="noopener">Elegir día y hora →</a>
          </div>
        </section>

        <!-- Final: no apto -->
        <section class="ag-pane" data-pane="noapto" hidden>
          <h2 class="ag-title"><span class="ag-title-gradient">Gracias por contarnos</span></h2>
          <p class="ag-lead">Ahora mismo la formación no es lo que más te ayuda: es un camino de tres meses con clases en vivo, y pide un momento y unas horas que hoy no tienes. Lo que sí te sirve ya es la guía de las bases, gratis. Cuando sea el momento, aquí estamos.</p>
          <div class="ag-actions">
            <a class="ag-btn" href="/guia/bases-neerlandes">Descargar la guía gratis →</a>
          </div>
        </section>

        <p class="ag-err" id="ag-err-envio">No se pudo enviar. Vuelve a intentarlo en un momento.</p>
      </form>

      <p class="ag-legal">Al continuar aceptas la <a href="/politica-de-privacidad">política de privacidad</a>.</p>
    </div>
  </div>
</Layout>

<script>
  import { leerUTM, guardarUTM } from '../lib/utm'
  import { contextoDelLead } from '../lib/recorrido'
  guardarUTM()

  const form = document.getElementById('ag-form') as HTMLFormElement
  const panes = Array.from(form.querySelectorAll<HTMLElement>('.ag-pane'))
  const preguntas = panes.filter((p) => p.dataset.clave)
  const total = preguntas.length + 1
  const fill = document.getElementById('ag-fill') as HTMLElement
  const stepEl = document.getElementById('ag-step') as HTMLElement
  const respuestas: Record<string, string> = {}
  let actual = 0

  const mostrar = (id: string | number) => {
    panes.forEach((p) => { p.hidden = p.dataset.pane !== String(id) })
    const n = typeof id === 'number' ? id + 1 : total
    fill.style.width = `${Math.min(100, Math.round((n / total) * 100))}%`
    stepEl.textContent = typeof id === 'number' ? `Paso ${n} de ${total}` : ''
    window.scrollTo({ top: 0, behavior: 'smooth' })
  }

  const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim()
  const datosOk = () => {
    const ok = val('first_name').length > 0 && /\S+@\S+\.\S+/.test(val('email')) && val('phone').replace(/\D/g, '').length >= 7
    ;(document.getElementById('ag-err-datos') as HTMLElement).classList.toggle('visible', !ok)
    return ok
  }

  form.querySelector('[data-next]')?.addEventListener('click', () => {
    if (!datosOk()) return
    actual = 1
    mostrar(actual)
  })

  preguntas.forEach((pane, i) => {
    pane.querySelectorAll<HTMLButtonElement>('.ag-option').forEach((btn) => {
      btn.addEventListener('click', async () => {
        pane.querySelectorAll('.ag-option').forEach((b) => b.setAttribute('aria-checked', 'false'))
        btn.setAttribute('aria-checked', 'true')
        respuestas[pane.dataset.clave as string] = btn.dataset.valor as string
        // Pequeña pausa para que se vea la elección antes de pasar.
        await new Promise((r) => setTimeout(r, 220))
        if (i + 1 < preguntas.length) {
          actual = i + 2
          mostrar(actual)
        } else {
          await enviar()
        }
      })
    })
    pane.querySelector('[data-prev]')?.addEventListener('click', () => {
      actual = i // la anterior (0 = datos)
      mostrar(actual)
    })
  })

  async function enviar() {
    mostrar('enviando')
    const errEnvio = document.getElementById('ag-err-envio') as HTMLElement
    errEnvio.classList.remove('visible')
    try {
      const res = await fetch('/api/cualificacion', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          first_name: val('first_name'),
          last_name: val('last_name'),
          email: val('email').toLowerCase(),
          phone: val('phone'),
          website: (document.getElementById('ag-hp') as HTMLInputElement).value,
          respuestas,
          ...leerUTM(),
          ...contextoDelLead(),
        }),
      })
      const data = await res.json().catch(() => null)
      if (!res.ok || !data?.ok) throw new Error('no ok')
      if (data.apto) {
        ;(document.getElementById('ag-agenda') as HTMLAnchorElement).href = data.agenda_url
        mostrar('apto')
      } else {
        mostrar('noapto')
      }
    } catch {
      errEnvio.classList.add('visible')
      actual = preguntas.length
      mostrar(actual)
    }
  }
</script>

<style>
  .ag-page {
    min-height: 100vh; background: #1D0084; position: relative; overflow: hidden;
    display: flex; align-items: flex-start; justify-content: center; padding: 52px 32px 96px;
  }
  .ag-glow1 { position: absolute; top: -140px; left: 50%; transform: translateX(-50%); width: 960px; height: 560px; background: radial-gradient(ellipse at center, rgba(11,109,240,0.5) 0%, transparent 65%); pointer-events: none; }
  .ag-glow2 { position: absolute; bottom: -60px; right: -80px; width: 600px; height: 400px; background: radial-gradient(ellipse at center, rgba(77,163,255,0.16) 0%, transparent 65%); pointer-events: none; }
  .ag-dots { position: absolute; inset: 0; pointer-events: none; opacity: 0.4; background-image: radial-gradient(circle, rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 28px 28px; }
  .ag-shell { position: relative; z-index: 1; width: 100%; max-width: 640px; display: flex; flex-direction: column; align-items: flex-start; color: #fff; }
  .ag-logo-link { display: inline-block; margin-bottom: 36px; }
  .ag-logo { height: 38px; width: auto; object-fit: contain; }

  .ag-progress { width: 100%; height: 4px; border-radius: 9999px; background: rgba(255,255,255,0.14); overflow: hidden; }
  .ag-progress-fill { height: 100%; width: 14%; background: #4da3ff; border-radius: 9999px; transition: width .35s ease; }
  .ag-step { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.55); margin: 12px 0 28px; min-height: 16px; }

  .ag-badge { display: inline-flex; padding: 6px 16px; border-radius: 9999px; background: #025dc7; color: #e0f2ff; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 6px; }
  .ag-title { font-family: var(--font-poppins), system-ui, sans-serif; font-size: clamp(34px, 5vw, 52px); font-weight: 700; letter-spacing: -0.04em; line-height: 1.08; margin: 8px 0 0; }
  .ag-title-gradient { background: linear-gradient(180deg, #fff 0%, rgba(255,255,255,0.45) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .ag-q { font-family: var(--font-poppins), system-ui, sans-serif; font-size: clamp(24px, 3.4vw, 34px); font-weight: 700; letter-spacing: -0.03em; line-height: 1.15; margin: 0; }
  .ag-lead { font-size: clamp(15px, 1.5vw, 17px); line-height: 1.6; color: rgba(255,255,255,0.8); max-width: 560px; margin: 14px 0 0; }

  .ag-pane { width: 100%; }
  .ag-honeypot { position: absolute !important; left: -10000px !important; width: 1px !important; height: 1px !important; overflow: hidden !important; opacity: 0 !important; pointer-events: none !important; }
  .ag-fields { display: flex; flex-direction: column; gap: 28px; margin-top: 36px; }
  .ag-row { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .ag-field { display: flex; flex-direction: column; gap: 8px; }
  .ag-label { font-size: 14px; font-weight: 600; }
  .ag-input { width: 100%; background: transparent; border: none; border-bottom: 1.5px solid rgba(255,255,255,0.28); border-radius: 0; padding: 10px 0; color: #fff; font-size: 16px; font-family: inherit; outline: none; transition: border-color .2s; }
  .ag-input::placeholder { color: rgba(255,255,255,0.28); }
  .ag-input:focus { border-bottom-color: #4da3ff; }

  .ag-options { display: flex; flex-direction: column; gap: 10px; margin-top: 28px; }
  .ag-option {
    display: flex; align-items: center; gap: 14px; width: 100%; text-align: left;
    padding: 16px 18px; border-radius: 12px; cursor: pointer; font-family: inherit;
    background: rgba(255,255,255,0.06); border: 1.5px solid rgba(255,255,255,0.16);
    color: #fff; font-size: 16px; font-weight: 600; transition: background .15s, border-color .15s;
  }
  .ag-option:hover { background: rgba(255,255,255,0.10); border-color: rgba(255,255,255,0.3); }
  .ag-option[aria-checked="true"] { background: rgba(77,163,255,0.22); border-color: #4da3ff; }
  .ag-option-dot { width: 18px; height: 18px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.4); flex-shrink: 0; }
  .ag-option[aria-checked="true"] .ag-option-dot { border-color: #4da3ff; background: #4da3ff; box-shadow: inset 0 0 0 3px #1D0084; }

  .ag-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .ag-btn { display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 16px 32px; border-radius: 12px; border: none; cursor: pointer; background: #4da3ff; color: #1D0084; font-size: 17px; font-weight: 700; font-family: inherit; text-decoration: none; transition: background .15s; }
  .ag-btn:hover { background: #6cb5ff; }
  .ag-btn-ghost { background: transparent; border: none; color: rgba(255,255,255,0.6); font-size: 14px; font-weight: 600; cursor: pointer; font-family: inherit; padding: 8px 0; }
  .ag-btn-ghost:hover { color: #fff; }
  .ag-err { display: none; margin-top: 14px; font-size: 13px; color: rgba(255,120,120,0.95); font-weight: 500; }
  .ag-err.visible { display: block; }
  .ag-legal { width: 100%; text-align: center; font-size: 12px; line-height: 1.6; color: rgba(255,255,255,0.4); margin: 40px 0 0; }
  .ag-legal a { color: rgba(255,255,255,0.6); text-decoration: underline; }

  @media (max-width: 640px) {
    .ag-page { padding: 32px 20px 72px; }
    .ag-row { grid-template-columns: 1fr; gap: 22px; }
    .ag-btn { width: 100%; }
  }
</style>
