    transition: border-color .15s, background .15s;
  }
  /* Campos de texto como Typeform (pedido 23/09: "demasiado oscuro"): sin
     caja, sin fondo y sin sombra, solo la línea de debajo. Se escribe sobre
     el fondo de la página, que es lo que les da ligereza. */
  .ag-input, .ag-textarea {
    width: 100%; background: transparent; border: 0; border-radius: 0;
