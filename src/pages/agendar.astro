  .ag-intro { font-family: var(--font-poppins), system-ui, sans-serif; font-size: clamp(18px, 2.2vw, 22px); font-weight: 400; letter-spacing: -0.01em; line-height: 1.45; margin: 0 0 18px; color: rgba(255,255,255,0.82); }
  .ag-q { font-family: var(--font-poppins), system-ui, sans-serif; font-size: clamp(21px, 2.8vw, 28px); font-weight: 500; letter-spacing: -0.015em; line-height: 1.3; margin: 0; }
  .ag-lead { font-size: clamp(15px, 1.5vw, 17px); line-height: 1.65; color: rgba(255,255,255,0.78); margin: 12px 0 0; }
  .ag-lead strong { color: #fff; font-weight: 600; }
  .ag-sub { font-size: 16px; font-weight: 700; margin: 22px 0 8px; }
  .ag-list { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 15.5px; line-height: 1.55; color: rgba(255,255,255,0.78); }
  .ag-list strong { color: #fff; font-weight: 600; }
  /* El reset global de la web quita las viñetas; aquí hacen falta. */
  .ag-list { list-style: disc; }
  .ag-list li::marker { color: #4da3ff; }
  .ag-req { color: #ff8a8a; font-weight: 500; }
  .ag-hint { font-size: 12.5px; color: rgba(255,255,255,0.5); margin: 10px 0 0; }
