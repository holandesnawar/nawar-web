  .ag-options { display: flex; flex-direction: column; gap: 12px; margin-top: 28px; }
  .ag-option {
    display: flex; align-items: center; gap: 14px; width: 100%; text-align: left;
    padding: 14px 16px; border-radius: 12px; cursor: pointer;
    font-size: 16px; font-weight: 500; line-height: 1.4;
  }
  /* Cajas de respuesta más claras (23/09): antes el tinte era un azul MÁS
     oscuro que el fondo y la columna entera se veía apagada. Ahora es un velo
     del azul claro de la marca, más claro que el fondo, y sin sombra: lo que
     separa la caja del fondo es el borde, como en Typeform. */
  .ag-option, .ag-scale-btn {
    background: rgba(77, 163, 255, 0.13);
