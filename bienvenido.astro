---
export const prerender = true;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>¡Bienvenido a Holandés Nawar!</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@800&family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box}
    html,body{margin:0;padding:0;min-height:100vh;font-family:'Inter',sans-serif;color:#fff;background:#1D0084;background-image:radial-gradient(circle,rgba(255,255,255,.06) 1px,transparent 1px),radial-gradient(circle 700px at 100% 0%,rgba(11,109,240,.40) 0%,transparent 65%),radial-gradient(circle 600px at 0% 100%,rgba(11,109,240,.18) 0%,transparent 65%);background-size:28px 28px,auto,auto;background-repeat:repeat,no-repeat,no-repeat}
    body{display:flex;align-items:center;justify-content:center;padding:4rem 1.5rem}
    .wrap{width:100%;max-width:28rem;text-align:center}
    .emoji{font-size:3rem;display:block;margin-bottom:1.5rem}
    h1{font-family:'Poppins',sans-serif;font-weight:800;font-size:clamp(28px,6vw,36px);line-height:1.15;margin:0}
    h1 span{color:#4da3ff}
    .lead{color:rgba(255,255,255,.8);line-height:1.55;margin:1rem 0 0 0;font-size:16px}
    .tip{color:rgba(255,255,255,.55);font-size:13px;margin:.75rem 0 0 0}
    .actions{margin-top:2rem}
    a.btn{display:inline-flex;align-items:center;justify-content:center;width:100%;padding:.9rem 1rem;background:#4da3ff;color:#0a1656;border-radius:.5rem;text-decoration:none;font-weight:700;font-size:16px}
    a.btn:hover{background:#6cb5ff}
    .below{color:rgba(255,255,255,.55);font-size:12px;margin:.75rem 0 0 0}
  </style>
</head>
<body>
  <div class="wrap">
    <span class="emoji">🎉</span>
    <h1>¡Bienvenid<span>@</span> a Holandés Nawar!</h1>
    <p class="lead">Tu compra está confirmada. Te acabamos de mandar un email con un enlace para crear tu contraseña.</p>
    <p class="tip">¿No lo ves? Mira la carpeta de Spam o Promociones — suele tardar un minuto.</p>
    <div class="actions">
      <a class="btn" href="https://academia.holandesnawar.nl/login">Ya creé mi contraseña — Entrar</a>
      <p class="below">Si ya pulsaste el enlace del email y pusiste tu contraseña, entra desde aquí.</p>
    </div>
  </div>
</body>
</html>
